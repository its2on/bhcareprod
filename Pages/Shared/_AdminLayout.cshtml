@using Barangay.Models
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/theme-orange.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/admin-local.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-dashboard-bhcare-new.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-orange.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin">
    @Html.AntiForgeryToken()

    <!-- Admin Layout with Persistent Sidebar -->
    <div class="admin-layout">
        <!-- Sidebar -->
        <aside class="sidebar" id="adminSidebar">
            <div class="sidebar-header">
                <div class="logo">
                    <i class="fa-solid fa-clinic-medical"></i>
                    <span class="sidebar-text">Barangay Health</span>
                </div>
                <button id="collapse-sidebar" class="collapse-btn" aria-label="Collapse sidebar">
                    <i class="fa-solid fa-chevron-left"></i>
                </button>
            </div>
            
            <div class="sidebar-user-info">
                <div class="user-avatar">
                    <span>@(User.Identity?.Name != null ? User.Identity.Name.Substring(0, 1).ToUpper() : "A")</span>
                </div>
                <div class="user-details">
                    <span class="user-welcome">Hello,</span>
                    <span class="user-name">@(User.Identity?.Name ?? "Admin")</span>
                    <span class="user-role">System Administrator</span>
                </div>
            </div>
            
            <div class="sidebar-menu">
                <!-- Main Group -->
                <div class="nav-group">
                    <div class="nav-group-label">Main</div>
                    <ul class="nav-list">
                        <li class="nav-item">
                            <a href="/Admin/AdminDashboard" class="nav-link" data-tooltip="Dashboard">
                                <i class="fa-solid fa-table-cells-large"></i>
                                <span class="sidebar-text">Dashboard</span>
                            </a>
                        </li>
                    </ul>
                </div>
                
                <!-- Administration Group -->
                <div class="nav-group">
                    <div class="nav-group-label">Administration</div>
                    <ul class="nav-list">
                        <li class="nav-item">
                            <a href="/Admin/UserManagement" class="nav-link" data-tooltip="User Management">
                                <i class="fa-solid fa-users"></i>
                                <span class="sidebar-text">User Management</span>
                                @await Component.InvokeAsync("PendingUsersCount")
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/Admin/Archive" class="nav-link" data-tooltip="Archive">
                                <i class="fa-solid fa-archive"></i>
                                <span class="sidebar-text">Archive</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/Admin/AddStaff" class="nav-link" data-tooltip="Add Staff">
                                <i class="fa-solid fa-user-plus"></i>
                                <span class="sidebar-text">Add Staff Member</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/Admin/StaffPermissions" class="nav-link" data-tooltip="Staff Permissions">
                                <i class="fa-solid fa-shield-halved"></i>
                                <span class="sidebar-text">Staff Permissions</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/Admin/AuditTrail" class="nav-link" data-tooltip="Audit Trail">
                                <i class="fa-solid fa-clipboard-list"></i>
                                <span class="sidebar-text">Audit Trail</span>
                            </a>
                        </li>
                    </ul>
                </div>
                
                <!-- Tools Group -->
                <div class="nav-group">
                    <div class="nav-group-label">System Tools</div>
                    <ul class="nav-list">
                        <li class="nav-item">
                            <a href="/Admin/FormManagement" class="nav-link" data-tooltip="Control Panel">
                                <i class="fa-solid fa-sliders-h"></i>
                                <span class="sidebar-text">Control Panel</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/Admin/NCDFormManagement" class="nav-link" data-tooltip="NCD Form Management">
                                <i class="fa-solid fa-file-medical-alt"></i>
                                <span class="sidebar-text">NCD Form Management</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/Admin/HEEADSSSFormManagement" class="nav-link" data-tooltip="HEEADSSS Form Management">
                                <i class="fa-solid fa-clipboard-list"></i>
                                <span class="sidebar-text">HEEADSSS Form Management</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
            
            <div class="sidebar-footer">
                <form method="post" asp-page="/Account/Logout">
                    <button type="submit" class="logout-btn" data-tooltip="Logout">
                        <i class="fa-solid fa-right-from-bracket"></i>
                        <span class="sidebar-text">Logout</span>
                    </button>
                </form>
            </div>
        </aside>
        <!-- Main Content Area -->
        <main class="main-content" id="mainContent" role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer bg-light border-top">
        <div class="container py-3">
            <div class="row">
                <div class="col-md-6 text-center text-md-start">
                    <p>&copy; @DateTime.Now.Year - Barangay Health Care | Barangay Baesa, Metro Manila</p>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <p>
                        <span class="me-3">(02) 8123-4567</span>
                        <a href="mailto:bhcare@barangay161.ph" class="text-decoration-none">bhcare@barangay161.ph</a>
                    </p>
                </div>
            </div>
            <div class="row">
                <div class="col-12 text-center">
                    <a href="/Privacy" class="text-decoration-none me-3">Privacy Policy</a> |
                    <a href="/Terms" class="text-decoration-none mx-3">Terms of Use</a> |
                    <a href="/Contact" class="text-decoration-none ms-3">Contact Us</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Session Timeout Modal -->
    <div class="modal fade" id="sessionTimeoutModal" tabindex="-1" aria-labelledby="sessionTimeoutModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title" id="sessionTimeoutModalLabel">
                        <i class="fa-solid fa-clock me-2"></i>Session Timeout Warning
                    </h5>
                </div>
                <div class="modal-body">
                    <div class="d-flex align-items-center mb-3">
                        <i class="fa-solid fa-triangle-exclamation text-warning me-3 fa-2x"></i>
                        <p class="mb-0">Your session will expire in <span id="timeoutCountdown" class="fw-bold">60</span> seconds due to inactivity.</p>
                    </div>
                    <p>Would you like to stay logged in or log out now?</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary" id="stayLoggedIn">
                        <i class="fa-solid fa-check me-1"></i> Stay Logged In
                    </button>
                    <button class="btn btn-secondary" id="logoutNow">
                        <i class="fa-solid fa-right-from-bracket me-1"></i> Logout Now
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Hidden logout form for session timeout -->
    <form id="logoutForm" method="post" asp-page="/Account/Logout" style="display: none;"></form>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    <script src="~/js/admin-notifications.js" asp-append-version="true"></script>
    <script src="~/js/admin-dashboard.js" asp-append-version="true"></script>

    <script>
        // Persistent Sidebar State Management - Run after all scripts load
        window.addEventListener('load', function() {
            console.log('Initializing persistent sidebar...');
            
            const sidebar = document.getElementById('adminSidebar');
            const mainContent = document.getElementById('mainContent');
            const collapseBtn = document.getElementById('collapse-sidebar');
            const expandBtn = document.getElementById('expand-sidebar');
            
            console.log('Elements found:', {
                sidebar: !!sidebar,
                mainContent: !!mainContent,
                collapseBtn: !!collapseBtn,
                expandBtn: !!expandBtn
            });
            
            if (!sidebar || !mainContent) {
                console.error('Sidebar or main content not found!');
                return;
            }
            
            // Get saved state from localStorage
            const sidebarCollapsed = localStorage.getItem('adminSidebarCollapsed') === 'true';
            
            // Apply saved state on page load
            if (sidebarCollapsed) {
                sidebar.classList.add('collapsed');
                mainContent.classList.add('expanded');
                if (collapseBtn) {
                    const icon = collapseBtn.querySelector('i');
                    if (icon) icon.className = 'fas fa-chevron-right';
                }
                if (expandBtn) {
                    expandBtn.style.display = 'flex';
                }
            }
            
            // Collapse button functionality
            if (collapseBtn) {
                console.log('Setting up collapse button handler');
                
                // Remove any existing handlers first
                const newCollapseBtn = collapseBtn.cloneNode(true);
                collapseBtn.parentNode.replaceChild(newCollapseBtn, collapseBtn);
                
                newCollapseBtn.addEventListener('click', function(e) {
                    console.log('🖱️ Collapse button clicked!');
                    e.preventDefault();
                    e.stopPropagation();
                    
                    console.log('Before toggle - sidebar classes:', sidebar.className);
                    const isCollapsed = sidebar.classList.toggle('collapsed');
                    mainContent.classList.toggle('expanded');
                    console.log('After toggle - isCollapsed:', isCollapsed);
                    console.log('After toggle - sidebar classes:', sidebar.className);
                    
                    // Update button icon
                    const icon = this.querySelector('i');
                    if (icon) {
                        const newIconClass = isCollapsed ? 'fas fa-chevron-right' : 'fas fa-chevron-left';
                        icon.className = newIconClass;
                        console.log('Icon updated to:', newIconClass);
                    }
                    
                    // Show/hide expand button
                    if (expandBtn) {
                        expandBtn.style.display = isCollapsed ? 'flex' : 'none';
                        console.log('Expand button display:', expandBtn.style.display);
                    }
                    
                    // Save state to localStorage
                    localStorage.setItem('adminSidebarCollapsed', isCollapsed.toString());
                    console.log('State saved to localStorage:', isCollapsed);
                });
                
                console.log('Collapse button handler attached');
            } else {
                console.error('Collapse button not found!');
            }
            
            // Expand button functionality
            if (expandBtn) {
                expandBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    
                    sidebar.classList.remove('collapsed');
                    mainContent.classList.remove('expanded');
                    
                    // Update collapse button icon
                    if (collapseBtn) {
                        const icon = collapseBtn.querySelector('i');
                        if (icon) icon.className = 'fas fa-chevron-left';
                    }
                    
                    // Hide expand button
                    this.style.display = 'none';
                    
                    // Save state to localStorage
                    localStorage.setItem('adminSidebarCollapsed', 'false');
                    
                    console.log('Sidebar expanded');
                });
            }
            
            // Highlight active nav link based on current URL
            const currentPath = window.location.pathname;
            const navLinks = document.querySelectorAll('.sidebar .nav-link');
            navLinks.forEach(link => {
                const href = link.getAttribute('href');
                if (href === currentPath) {
                    link.classList.add('active');
                } else {
                    link.classList.remove('active');
                }
            });
        });
    </script>

    <script>
        // Session timeout handling
        let sessionTimeoutWarning = 15 * 60 * 1000; // 15 minutes in milliseconds
        let sessionTimeout = 20 * 60 * 1000; // 20 minutes in milliseconds
        let timeoutTimer;
        let countdownTimer;
        let warningDisplayed = false;
        let lastActivity = new Date().getTime();
        
        function resetSessionTimer() {
            if (!warningDisplayed) {
                clearTimeout(timeoutTimer);
                lastActivity = new Date().getTime();
                timeoutTimer = setTimeout(showTimeoutWarning, sessionTimeoutWarning);
            }
        }
        
        function showTimeoutWarning() {
            warningDisplayed = true;
            let timeLeft = 60; // 60 seconds countdown
            
            // Show the modal
            const sessionTimeoutModal = new bootstrap.Modal(document.getElementById('sessionTimeoutModal'));
            sessionTimeoutModal.show();
            
            // Update countdown
            document.getElementById('timeoutCountdown').textContent = timeLeft;
            
            // Start countdown
            countdownTimer = setInterval(function() {
                timeLeft--;
                document.getElementById('timeoutCountdown').textContent = timeLeft;
                
                if (timeLeft <= 0) {
                    clearInterval(countdownTimer);
                    document.getElementById('logoutForm').submit();
                }
            }, 1000);
        }
        
        // Reset timer on user activity
        ['mousemove', 'mousedown', 'keypress', 'touchmove', 'click', 'scroll'].forEach(function(event) {
            document.addEventListener(event, resetSessionTimer, false);
        });
        
        // Setup stay logged in button
        document.getElementById('stayLoggedIn').addEventListener('click', function() {
            clearInterval(countdownTimer);
            warningDisplayed = false;
            bootstrap.Modal.getInstance(document.getElementById('sessionTimeoutModal')).hide();
            resetSessionTimer();
            
            // Send a ping to the server to keep the session alive
            fetch('/api/Session/KeepAlive', { method: 'POST' })
                .catch(error => console.error('Error keeping session alive:', error));
        });
        
        // Setup logout now button
        document.getElementById('logoutNow').addEventListener('click', function() {
            document.getElementById('logoutForm').submit();
        });
        
        // Initialize the session timer
        resetSessionTimer();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html> 