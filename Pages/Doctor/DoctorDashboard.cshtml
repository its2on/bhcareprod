@page
@using Barangay.Models
@model Barangay.Pages.Doctor.DoctorDashboardModel
@{
    ViewData["Title"] = "Doctor Dashboard";
    Layout = "_DoctorLayout";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Doctor Dashboard</h1>
    <p class="mb-4">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</p>

    <hr class="my-4" />
    <div class="row">
        <div class="col-xl-3 col-md-6">
            <div class="card bg-primary text-white mb-4">
                <div class="card-body">
                    <h5 class="card-title">Total Patients</h5>
                    <h2 class="display-4">@Model.TotalPatients</h2>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-primary text-white mb-4">
                <div class="card-body">
                    <h5 class="card-title">Consulted</h5>
                    <h2 class="display-4">@Model.Consulted</h2>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-primary text-white mb-4">
                <div class="card-body">
                    <h5 class="card-title">Pending</h5>
                    <h2 class="display-4">@Model.Pending</h2>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-primary text-white mb-4">
                <div class="card-body">
                    <h5 class="card-title">Urgent Cases</h5>
                    <h2 class="display-4">@Model.UrgentCases</h2>
                </div>
            </div>
        </div>
    </div>



    <hr class="my-4" />
    <div class="row">
        <!-- Today's Appointments Section -->
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-calendar-check me-1"></i>
                    Today's Appointments
                </div>
                <div class="card-body">
                    @if (Model.TodaysAppointments != null && Model.TodaysAppointments.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>Time</th>
                                        <th>Patient</th>
                                        <th>Type</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                                                <tbody>
                                    @foreach (var appointment in Model.TodaysAppointments)
                                    {
                                        <tr>
                                                                                                                                    <td>@appointment.AppointmentTime.ToString(@"hh\:mm")</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(appointment.DependentFullName))
                                                {
                                                    @appointment.DependentFullName
                                                    <small class="text-muted d-block">(Dependent of @appointment.Patient?.FullName)</small>
                                                }
                                                else
                                                {
                                                    @appointment.PatientName
                                                }
                                            </td>
                                            <td>@appointment.Type</td>
                                            <td>
                                                <span class="badge @(appointment.Status == AppointmentStatus.Completed ? "bg-success" : appointment.Status == AppointmentStatus.Cancelled ? "bg-danger" : appointment.Status == AppointmentStatus.Confirmed ? "bg-warning" : "bg-primary")">
                                                    @appointment.Status
                                                </span>
                                            </td>
                                            <td>
                                                @if (appointment.Status == AppointmentStatus.Confirmed || appointment.Status == AppointmentStatus.InProgress)
                                                {
                                                    <a href="@Url.Page("/Doctor/Consultation", new { id = appointment.Id, startConsultation = true })" class="btn btn-sm btn-outline-primary">Start Consultation</a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-center mb-0">No appointments scheduled for today.</p>
                    }
                </div>
                <div class="card-footer">
                    <small class="text-muted">Today's appointments are shown above</small>
                </div>
            </div>
        </div>

        <!-- Recent Notifications Section -->
        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-bell me-1"></i>
                    Recent Notifications
                </div>
                <div class="card-body">
                    @if (Model.RecentNotifications != null && Model.RecentNotifications.Any())
                    {
                        <div class="list-group">
                            @foreach (var notification in Model.RecentNotifications)
                            {
                                <div class="list-group-item list-group-item-action">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1">@notification.Title</h6>
                                        <small>@notification.CreatedAt.ToLocalTime().ToString("MMM dd, hh:mm tt")</small>
                                    </div>
                                    <p class="mb-1">@notification.Message</p>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-center mb-0">No recent notifications</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- First Login Notification Modal -->
<div class="modal fade" id="firstLoginModal" tabindex="-1" aria-labelledby="firstLoginModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color:rgb(255, 146, 68); color: white;">
                <h5 class="modal-title" id="firstLoginModalLabel">
                    <i class="fas fa-shield-alt me-2"></i>Security Notice
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-3">
                    <i class="fas fa-key fa-3x" style="color: #e27e38;"></i>
                </div>
                <h6 class="text-center mb-3">Welcome to BH Care!</h6>
                <p>For security reasons, we recommend changing your default password before continuing to use the system.</p>
                <div class="alert alert-warning" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Important:</strong> Using a strong, unique password helps protect patient data and system security.
                </div>
                <ul class="list-unstyled">
                    <li><i class="fas fa-check text-success me-2"></i> Use at least 8 characters</li>
                    <li><i class="fas fa-check text-success me-2"></i> Include numbers and special characters</li>
                </ul>
            </div>
            <div class="modal-footer">
                <a href="/Doctor/Settings#security" class="btn btn-primary" style="background-color: #e27e38; border-color: #e27e38;">
                    <i class="fas fa-key me-2"></i>Change Password Now
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            console.log('Doctor Dashboard initialized');
            console.log('IsFirstLogin flag:', '@ViewData["ShowFirstLoginNotification"]');
            
            // Show first login notification if needed
            @if (ViewData["ShowFirstLoginNotification"] as bool? == true)
            {
                <text>
                console.log('Showing first login modal for doctor');
                var modal = new bootstrap.Modal(document.getElementById('firstLoginModal'));
                modal.show();
                </text>
            }

            // Auto refresh every 5 minutes
            setInterval(function() {
                location.reload();
            }, 300000);
        });
    </script>
}