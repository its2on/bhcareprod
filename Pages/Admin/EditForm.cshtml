@page
@model Barangay.Pages.Admin.EditFormModel
@{
    ViewData["Title"] = "Edit Form";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">
                <i class="fa-solid fa-edit me-2"></i>Edit Form
            </h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a asp-page="./FormManagement">Form Management</a></li>
                    <li class="breadcrumb-item active">Edit Form</li>
                </ol>
            </nav>
        </div>
        <div>
            <a asp-page="./ManageFormFields" asp-route-id="@Model.FormTemplate.FormTemplateId" class="btn btn-secondary">
                <i class="fa-solid fa-arrow-left me-2"></i>Back to Fields
            </a>
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Form Information</h6>
        </div>
        <div class="card-body">
            <form method="post">
                <input type="hidden" asp-for="FormTemplate.FormTemplateId" />
                <input type="hidden" asp-for="FormTemplate.FormKey" />
                <input type="hidden" asp-for="FormTemplate.Version" />
                <input type="hidden" asp-for="FormTemplate.CreatedAt" />
                <input type="hidden" asp-for="FormTemplate.CreatedBy" />

                <div class="row g-3">
                    <div class="col-md-12">
                        <label asp-for="FormTemplate.FormName" class="form-label">Form Name <span class="text-danger">*</span></label>
                        <input asp-for="FormTemplate.FormName" class="form-control" required />
                        <span asp-validation-for="FormTemplate.FormName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Form Key</label>
                        <input value="@Model.FormTemplate.FormKey" class="form-control" readonly disabled />
                        <small class="text-muted">Cannot be changed after creation</small>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="FormTemplate.Category" class="form-label">Category</label>
                        <input asp-for="FormTemplate.Category" class="form-control" />
                    </div>

                    <div class="col-md-12">
                        <label asp-for="FormTemplate.Description" class="form-label">Description</label>
                        <textarea asp-for="FormTemplate.Description" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="FormTemplate.IconClass" class="form-label">Icon Class</label>
                        <input asp-for="FormTemplate.IconClass" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="FormTemplate.DisplayOrder" class="form-label">Display Order</label>
                        <input asp-for="FormTemplate.DisplayOrder" type="number" class="form-control" min="0" />
                    </div>

                    <div class="col-md-12">
                        <label asp-for="FormTemplate.SuccessMessage" class="form-label">Success Message</label>
                        <textarea asp-for="FormTemplate.SuccessMessage" class="form-control" rows="2"></textarea>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="FormTemplate.RedirectUrl" class="form-label">Redirect URL</label>
                        <input asp-for="FormTemplate.RedirectUrl" class="form-control" />
                    </div>

                    <div class="col-md-12">
                        <label asp-for="FormTemplate.CssClasses" class="form-label">Custom CSS Classes</label>
                        <input asp-for="FormTemplate.CssClasses" class="form-control" />
                    </div>

                    <div class="col-md-12">
                        <div class="form-check form-switch">
                            <input asp-for="FormTemplate.IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="FormTemplate.IsActive" class="form-check-label">Form is Active</label>
                        </div>
                    </div>
                </div>

                <hr class="my-4">

                <div class="d-flex justify-content-end gap-2">
                    <a asp-page="./ManageFormFields" asp-route-id="@Model.FormTemplate.FormTemplateId" class="btn btn-secondary">
                        <i class="fa-solid fa-times me-2"></i>Cancel
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-save me-2"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
