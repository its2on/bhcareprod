@page
@model Barangay.Pages.Admin.UserDetailsModel
@{
    ViewData["Title"] = "User Details";
    Layout = "_AdminLayout";
}

<link rel="stylesheet" href="~/css/admin-dashboard-bhcare-new.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/user-details-custom.css" asp-append-version="true" />

<style>
    /* Force new theme colors - override any cached CSS */
    .bg-orange {
        background-color: #FF8C42 !important;
    }
    
    .text-orange {
        color: #FF8C42 !important;
    }
    
    .border-orange {
        border-color: #FF8C42 !important;
    }
    
    .btn-orange {
        color: #fff !important;
        background-color: #FF8C42 !important;
        border-color: #FF8C42 !important;
    }
    
    .btn-orange:hover {
        color: #fff !important;
        background-color: #E67E22 !important;
        border-color: #E67E22 !important;
    }
    
    /* Minimal approve and reject buttons */
    .btn-approve-minimal {
        background-color: #FF8C42;
        color: white;
        border: none;
        font-size: 0.875rem;
        padding: 0.5rem 1rem;
        transition: all 0.2s ease;
    }
    
    .btn-approve-minimal:hover {
        background-color: #e67a30;
        color: white;
        transform: translateY(-1px);
        box-shadow: 0 2px 4px rgba(255, 140, 66, 0.3);
    }
    
    .btn-reject-minimal {
        background-color: #6c757d;
        color: white;
        border: none;
        font-size: 0.875rem;
        padding: 0.5rem 1rem;
        transition: all 0.2s ease;
    }
    
    .btn-reject-minimal:hover {
        background-color: #5a6268;
        color: white;
        transform: translateY(-1px);
        box-shadow: 0 2px 4px rgba(108, 117, 125, 0.3);
    }
    
    .user-header {
        padding: 1.25rem;
        background-color: #FF8C42 !important;
        color: white !important;
        border-radius: 8px 8px 0 0;
    }
    
    .user-header h3 {
        margin-bottom: 0;
        font-weight: 600;
        color: white !important;
    }
    
    .card-header.bg-orange {
        background-color: #FF8C42 !important;
        color: white !important;
    }
    
    /* Badge improvements */
    .badge.bg-warning {
        background-color: #ffc107 !important;
        color: #000 !important;
        font-weight: 600;
    }
    
    .badge.bg-success {
        background-color: #28a745 !important;
        color: #fff !important;
    }
    
    .badge.bg-secondary {
        background-color: #6c757d !important;
        color: #fff !important;
    }
    
    .badge.bg-orange {
        background-color: #FF8C42 !important;
        color: #fff !important;
    }
</style>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">User Details</h2>
    </div>

    @if (Model.ErrorMessage != null)
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }
    else if (Model.UserDetails != null)
    {
        <div class="card shadow">
            <div class="user-header d-flex justify-content-between align-items-center">
                <h3 class="mb-0">@Model.UserDetails.FullName</h3>
                <span class="badge rounded-pill bg-@Model.GetStatusBadgeClass() status-badge">@Model.UserDetails.Status</span>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-8">
                        <div class="row mb-4">
                            <div class="col-md-6 section-container">
                                <h5 class="border-bottom pb-2 text-orange">Basic Information</h5>
                                <dl class="row">
                                    <dt class="col-sm-4 detail-label">ID</dt>
                                    <dd class="col-sm-8 detail-value">
                                        <span class="badge bg-secondary">
                                            @try
                                            {
                                                @Model.UserDetails.FormattedId
                                            }
                                            catch
                                            {
                                                @($"BHC-{Model.UserDetails.Id.Substring(0, 6)}")
                                            }
                                        </span>
                                        <small class="text-muted ms-2">System ID: @Model.UserDetails.Id.Substring(0, 8)...</small>
                                    </dd>
                                    
                                    <dt class="col-sm-4 detail-label">Name</dt>
                                    <dd class="col-sm-8 detail-value">@Model.UserDetails.FirstName @Model.UserDetails.MiddleName @Model.UserDetails.LastName</dd>
                                    
                                    <dt class="col-sm-4 detail-label">Email</dt>
                                    <dd class="col-sm-8 detail-value">@Model.UserDetails.Email</dd>
                                    
                                    <dt class="col-sm-4 detail-label">Contact</dt>
                                    <dd class="col-sm-8 detail-value">@Model.UserDetails.PhoneNumber</dd>

                                    <dt class="col-sm-4 detail-label">Birth Date</dt>
                                    <dd class="col-sm-8 detail-value">
                                        @if (Model.GetBirthDateAsString() != "")
                                        {
                                            @Model.GetBirthDateAsString()
                                        }
                                        else
                                        {
                                            <span>Not specified</span>
                                        }
                                    </dd>
                                    
                                    <dt class="col-sm-4 detail-label">Age</dt>
                                    <dd class="col-sm-8 detail-value">@Model.CalculateAge() years old</dd>
                                    
                                    <dt class="col-sm-4 detail-label">Barangay</dt>
                                    <dd class="col-sm-8 detail-value">
                                        @(string.IsNullOrEmpty(Model.UserDetails.Barangay) ? "Not specified" : Model.UserDetails.Barangay)
                                    </dd>
                                    
                                    <dt class="col-sm-4 detail-label">Address</dt>
                                    <dd class="col-sm-8 detail-value">
                                        @(string.IsNullOrEmpty(Model.UserDetails.Address) ? "Not specified" : Model.UserDetails.Address)
                                    </dd>
                                </dl>
                            </div>
                            <div class="col-md-6 section-container">
                                <h5 class="border-bottom pb-2 text-orange">Account Information</h5>
                                <dl class="row">
                                    <dt class="col-sm-4 detail-label">Registration</dt>
                                    <dd class="col-sm-8 detail-value">@Model.FormatDateOnly(Model.UserDetails.CreatedAt)</dd>
                                    
                                    <dt class="col-sm-4 detail-label">Last Active</dt>
                                    <dd class="col-sm-8 detail-value">
                                        @if (Model.GetLastActiveAsString() != "")
                                        {
                                            @Model.GetLastActiveAsString()
                                        }
                                        else
                                        {
                                            <span>Never</span>
                                        }
                                    </dd>
                                    
                                    <dt class="col-sm-4 detail-label">User Type</dt>
                                    <dd class="col-sm-8 detail-value">
                                        @Model.GetUserTypeDisplay()
                                    </dd>
                                    
                                    <dt class="col-sm-4 detail-label">Roles</dt>
                                    <dd class="col-sm-8 detail-value">
                                        @if (Model.UserRoles != null && Model.UserRoles.Any())
                                        {
                                            @foreach (var role in Model.UserRoles)
                                            {
                                                <span class="badge bg-warning text-dark me-1">@role</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">No roles assigned</span>
                                        }
                                    </dd>
                                    
                                    <dt class="col-sm-4 detail-label">Verification Status</dt>
                                    <dd class="col-sm-8 detail-value">
                                        @if (Model.UserDetails.VerificationStatus == "Auto Verified" && Model.UserDetails.IsApproved)
                                        {
                                            <span class="badge bg-success" style="font-size: 0.9rem; padding: 0.5rem 0.75rem;">
                                                @if (Model.UserDetails.ApprovedBy != null && (Model.UserDetails.ApprovedBy.Contains("OCR") || Model.UserDetails.ApprovedBy.Contains("Barangay Match")))
                                                {
                                                    <i class="fa-solid fa-robot me-1"></i>
                                                    <text>Auto-Approved</text>
                                                }
                                                else
                                                {
                                                    <i class="fa-solid fa-robot me-1"></i>
                                                    <text>Auto Verified</text>
                                                }
                                            </span>
                                            @if (!string.IsNullOrEmpty(Model.UserDetails.VerifiedBarangay))
                                            {
                                                <small class="text-muted d-block mt-1">
                                                    <i class="fa-solid fa-map-marker-alt me-1"></i>
                                                    Barangay @Model.UserDetails.VerifiedBarangay detected via OCR
                                                </small>
                                            }
                                        }
                                        else if (Model.UserDetails.VerificationStatus == "Manual Verified" && Model.UserDetails.IsApproved)
                                        {
                                            <span class="badge bg-success" style="font-size: 0.9rem; padding: 0.5rem 0.75rem;">
                                                <i class="fa-solid fa-user-check me-1"></i> Manual Verified
                                            </span>
                                        }
                                        else if (Model.UserDetails.VerificationStatus == "Pending Review" || !Model.UserDetails.IsApproved)
                                        {
                                            <span class="badge bg-danger" style="font-size: 0.9rem; padding: 0.5rem 0.75rem;">
                                                <i class="fa-solid fa-exclamation-triangle me-1"></i> 
                                                @if (string.IsNullOrEmpty(Model.UserDetails.VerifiedBarangay))
                                                {
                                                    <text>Manual Review Needed</text>
                                                }
                                                else
                                                {
                                                    <text>Pending</text>
                                                }
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary" style="font-size: 0.9rem; padding: 0.5rem 0.75rem;">Unknown</span>
                                        }
                                    </dd>
                                    
                                    @if (!string.IsNullOrEmpty(Model.UserDetails.ApprovedBy))
                                    {
                                        <dt class="col-sm-4 detail-label">Approved By</dt>
                                        <dd class="col-sm-8 detail-value">
                                            @if (Model.UserDetails.ApprovedBy != null && (Model.UserDetails.ApprovedBy.Contains("OCR") || Model.UserDetails.ApprovedBy.Contains("Barangay Match")))
                                            {
                                                <span class="text-success">
                                                    <i class="fa-solid fa-robot me-1"></i> @Model.UserDetails.ApprovedBy
                                                </span>
                                            }
                                            else if (Model.UserDetails.ApprovedBy == "System (Auto)")
                                            {
                                                <span class="text-success">
                                                    <i class="fa-solid fa-robot me-1"></i> System (Automatic)
                                                </span>
                                            }
                                            else
                                            {
                                                <span>@Model.UserDetails.ApprovedBy</span>
                                            }
                                        </dd>
                                        
                                        <dt class="col-sm-4 detail-label">Approved Date</dt>
                                        <dd class="col-sm-8 detail-value">
                                            @if (Model.UserDetails.ApprovedDate.HasValue)
                                            {
                                                @Model.UserDetails.ApprovedDate.Value.ToString("MMM dd, yyyy hh:mm tt")
                                            }
                                        </dd>
                                    }
                                    
                                    @if (!string.IsNullOrEmpty(Model.UserDetails.VerifiedBarangay))
                                    {
                                        <dt class="col-sm-4 detail-label">Verified Barangay</dt>
                                        <dd class="col-sm-8 detail-value">
                                            <span class="badge bg-info">Barangay @Model.UserDetails.VerifiedBarangay</span>
                                            <small class="text-muted d-block mt-1">(Auto-detected via OCR)</small>
                                        </dd>
                                    }
                                    
                                    @if (Model.UserRoles.Any())
                                    {
                                        <dt class="col-sm-4 detail-label">Roles</dt>
                                        <dd class="col-sm-8 detail-value">
                                            @foreach (var role in Model.UserRoles)
                                            {
                                                <span class="badge bg-orange me-1">@role</span>
                                            }
                                        </dd>
                                    }
                                </dl>
                            </div>
                        </div>

                        @if (Model.IsMinor)
                        {
                            <div class="row mt-3">
                                <div class="col-12">
                                    <div class="card border-orange">
                                    <div class="card-header bg-orange text-white">
                                        <h5 class="mb-0"><i class="fa-solid fa-user-shield me-2"></i>Guardian Information</h5>
                                    </div>
                                        <div class="card-body">
                                            @if (Model.Guardian != null)
                                            {
                                                <dl class="row mb-0">
                                                    <dt class="col-sm-3">Guardian Name</dt>
                                                    <dd class="col-sm-9">@Model.Guardian.GuardianFirstName @Model.Guardian.GuardianLastName</dd>
                                                    
                                                    <dt class="col-sm-3">Consent Status</dt>
                                                    <dd class="col-sm-9">
                                                        @{
                                                            var consentStatus = Model.Guardian.ConsentStatus ?? "Pending";
                                                            var statusClass = consentStatus.ToLower() == "approved" ? "success" : 
                                                                             consentStatus.ToLower() == "rejected" ? "danger" : "warning";
                                                        }
                                                        <span class="badge bg-@statusClass">@consentStatus</span>
                                                    </dd>
                                                    
                                                    @if (!string.IsNullOrEmpty(Model.Guardian.ResidencyProofPath))
                                                    {
                                                        <dt class="col-sm-3">Residency Proof</dt>
                                                        <dd class="col-sm-9">
                                                            <a href="@Model.Guardian.ResidencyProofPath" target="_blank" class="btn btn-sm btn-outline-primary">
                                                                <i class="fa-solid fa-file-lines me-1"></i> View Document
                                                            </a>
                                                        </dd>
                                                    }
                                                    
                                                    <dt class="col-sm-3">Created At</dt>
                                                    <dd class="col-sm-9">@Model.FormatDateOnly(Model.Guardian.CreatedAt)</dd>
                                                </dl>
                                            }
                                            else
                                            {
                                                <div class="alert alert-warning">
                                                    <i class="fa-solid fa-triangle-exclamation me-2"></i>
                                                    <strong>Guardian information is required but missing.</strong>
                                                    <p class="mb-0 mt-2">This user is under 18 years old and requires guardian consent, but no guardian information has been provided.</p>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="col-md-4 section-container">
                        <h5 class="border-bottom pb-2 text-orange">Identity Documents</h5>
                        @if (Model.UserDetails.Status == "Verified" && Model.UserDocuments.Any())
                        {
                            <div class="alert alert-success mb-3">
                                <i class="fa-solid fa-check-circle me-2"></i>
                                <strong>Documents Verified</strong>
                            </div>
                        }
                        @if (Model.UserDocuments.Any())
                        {
                            @foreach (var doc in Model.UserDocuments)
                            {
                                <div class="card mb-3 shadow-sm">
                                    <div class="card-body p-3">
                                        <h6 class="card-title text-dark">@doc.FileName</h6>
                                        <p class="card-text small text-muted">
                                            Uploaded on @Model.FormatDateOnly(doc.UploadDate)
                                            <br>
                                            Status: <span class="badge @(doc.Status == "Verified" ? "bg-success" : doc.Status == "Pending" ? "bg-warning text-dark" : "bg-secondary")">@doc.Status</span>
                                        </p>
                                        <div>
                                            @if (doc.ContentType != null && doc.ContentType.StartsWith("image/"))
                                            {
                                                <img src="@doc.FilePath" 
                                                     class="document-preview img-fluid mb-2 rounded border" 
                                                     alt="User ID" 
                                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                                                <div class="alert alert-warning mb-2" style="display:none;">
                                                    <i class="fa-solid fa-exclamation-triangle me-2"></i>
                                                    Document file not found. Please contact support.
                                                </div>
                                            }
                                            <div class="d-grid gap-2">
                                                <button type="button"
                                                        class="btn btn-sm btn-orange"
                                                        onclick="showDocumentPreview('@doc.FilePath','@doc.FileName','@doc.ContentType')">
                                                    <i class="fa-solid fa-eye"></i> View Document
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="alert alert-warning">
                                <p>No documents uploaded</p>
                                <div class="text-center">
                                    <i class="fa-solid fa-file-image fa-3x text-muted mb-2"></i>
                                    <p class="small text-muted">User has not uploaded any identity documents yet.</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <div class="d-flex justify-content-between align-items-center">
                    <a href="/Admin/UserManagement" class="btn btn-secondary">
                        <i class="fa-solid fa-arrow-left"></i> Back
                    </a>
                    <div>
                        @if (Model.UserDetails.IsApproved && Model.UserDetails.VerificationStatus == "Auto Verified")
                        {
                            <!-- Already auto-approved - show read-only status with green badge -->
                            <div class="alert alert-success mb-0 py-2 px-3">
                                <i class="fa-solid fa-robot me-2"></i>
                                <strong>Auto-Approved</strong>
                                @if (!string.IsNullOrEmpty(Model.UserDetails.VerifiedBarangay))
                                {
                                    <small class="d-block">Barangay @Model.UserDetails.VerifiedBarangay detected via OCR on @Model.UserDetails.ApprovedDate?.ToString("MMM dd, yyyy hh:mm tt")</small>
                                }
                                else
                                {
                                    <small class="d-block">Verified automatically by OCR on @Model.UserDetails.ApprovedDate?.ToString("MMM dd, yyyy hh:mm tt")</small>
                                }
                            </div>
                        }
                        else if (Model.UserDetails.IsApproved)
                        {
                            <!-- Already manually approved - show read-only status -->
                            <div class="alert alert-success mb-0 py-2 px-3">
                                <i class="fa-solid fa-user-check me-2"></i>
                                <strong>Manually Approved</strong>
                                <small class="d-block">Approved by @Model.UserDetails.ApprovedBy on @Model.UserDetails.ApprovedDate?.ToString("MMM dd, yyyy hh:mm tt")</small>
                            </div>
                        }
                        else
                        {
                            <!-- Pending review - show scan ID, manual approve/reject buttons -->
                            <div class="alert alert-warning mb-0 py-2 px-3 me-2 d-inline-block">
                                <i class="fa-solid fa-exclamation-triangle me-2"></i>
                                <strong>Requires Manual Review</strong>
                                <small class="d-block">
                                    @if (string.IsNullOrEmpty(Model.UserDetails.Barangay))
                                    {
                                        <text>Barangay not specified. Upload ID to auto-verify or approve manually.</text>
                                    }
                                    else if (Model.UserDetails.Barangay.Contains("158") || Model.UserDetails.Barangay.Contains("159") || 
                                             Model.UserDetails.Barangay.Contains("160") || Model.UserDetails.Barangay.Contains("161"))
                                    {
                                        <text>Auto-verification may have failed. Scan ID to retry or approve manually.</text>
                                    }
                                    else
                                    {
                                        <text>Barangay @Model.UserDetails.Barangay.Replace("Barangay", "").Trim() not in service area (158-161). Manual approval required.</text>
                                    }
                                </small>
                            </div>
                            <button type="button" class="btn btn-info me-2" onclick="scanIdForApproval('@Model.UserDetails.Id')" id="btnScanId">
                                <i class="fa-solid fa-id-card me-1"></i> Scan ID for Auto-Approval
                            </button>
                            <button type="button" class="btn btn-approve-minimal me-2" onclick="approveUser('@Model.UserDetails.Id')">
                                <i class="fa-solid fa-check"></i> Approve Manually
                            </button>
                            <button type="button" class="btn btn-reject-minimal" onclick="rejectUser('@Model.UserDetails.Id')">
                                <i class="fa-solid fa-xmark"></i> Reject
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Confirmation Modal -->
<div class="modal fade" id="confirmActionModal" tabindex="-1" aria-labelledby="confirmActionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" id="confirmModalHeader">
                <h5 class="modal-title" id="confirmActionModalLabel">Confirm Action</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="confirmActionText">Are you sure you want to proceed?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fa-solid fa-xmark me-1"></i> Cancel
                </button>
                <button type="button" class="btn" id="confirmActionBtn">
                    <i class="fa-solid fa-check me-1"></i> Confirm
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Document Preview Modal (Admin/UserDetails) -->
<div class="modal fade" id="udDocumentPreviewModal" tabindex="-1" aria-labelledby="udDocumentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-orange text-white">
                <h5 class="modal-title" id="udDocumentModalLabel">Document Preview</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div id="udDocumentPreviewContainer" class="text-center overflow-auto p-3" style="max-height: 500px;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <a id="udDownloadDocBtn" href="#" class="btn btn-orange" download>
                    <i class="fa-solid fa-download"></i> Download
                </a>
                <a id="udViewDocBtn" href="#" class="btn btn-primary" target="_blank">
                    <i class="fa-solid fa-up-right-from-square"></i> Open in Browser
                </a>
            </div>
        </div>
    </div>
    </div>

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        // Preview document in orange-themed modal (matches User Management)
        function showDocumentPreview(filePath, fileName, contentType) {
            const modalEl = document.getElementById('udDocumentPreviewModal');
            const bsModal = new bootstrap.Modal(modalEl);
            const titleEl = document.getElementById('udDocumentModalLabel');
            const container = document.getElementById('udDocumentPreviewContainer');
            const downloadBtn = document.getElementById('udDownloadDocBtn');
            const viewBtn = document.getElementById('udViewDocBtn');

            titleEl.textContent = fileName || 'Document Preview';
            container.innerHTML = '';

            downloadBtn.setAttribute('href', filePath);
            downloadBtn.setAttribute('download', fileName);
            viewBtn.setAttribute('href', filePath);

            if (contentType && contentType.startsWith('image/')) {
                const img = document.createElement('img');
                img.src = filePath;
                img.alt = fileName;
                img.classList.add('img-fluid','rounded','shadow-sm');
                img.style.maxHeight = '450px';
                
                // Handle image load error
                img.onerror = function() {
                    container.innerHTML = `
                        <div class="alert alert-warning text-center">
                            <i class="fa-solid fa-exclamation-triangle fa-3x mb-3"></i>
                            <h5>Document Not Found</h5>
                            <p>The document file could not be loaded. This may be due to:</p>
                            <ul class="text-start">
                                <li>File was moved or deleted</li>
                                <li>Incorrect file path in database</li>
                                <li>File upload was incomplete</li>
                            </ul>
                            <p class="mb-0">Please contact support for assistance.</p>
                        </div>`;
                };
                
                container.appendChild(img);
            } else if (contentType && contentType.includes('pdf')) {
                const embed = document.createElement('embed');
                embed.src = filePath;
                embed.type = 'application/pdf';
                embed.style.width = '100%';
                embed.style.height = '450px';
                embed.classList.add('rounded','shadow-sm');
                container.appendChild(embed);
            } else {
                const fallback = document.createElement('div');
                fallback.classList.add('p-4','bg-light','rounded','shadow-sm');
                fallback.innerHTML = '<div class="text-center my-4">\
                    <i class="fa-solid fa-file fa-3x mb-3 text-orange"></i>\
                    <p class="h5 mb-3">Preview not available for this file type</p>\
                    <p>Please download or open in browser to view</p>\
                    <p class="text-muted mt-3">File: ' + (fileName || '') + '</p>\
                    </div>';
                container.appendChild(fallback);
            }

            bsModal.show();
        }

        function approveUser(userId) {
            showConfirmModal('approve', userId);
        }

        function rejectUser(userId) {
            showConfirmModal('reject', userId);
        }
        
        // Re-Verify with OCR function
        function reVerifyWithOCR() {
            const btn = document.getElementById('btnReVerifyOCR');
            if (!btn) {
                alert('Button not found');
                return;
            }
            
            const userId = btn.getAttribute('data-user-id');
            console.log('Re-Verify OCR - User ID:', userId);
            
            if (!userId) {
                alert('User ID not found. Please refresh the page and try again.');
                return;
            }
            
            if (!confirm('Auto-verify this user based on their Barangay field in their profile? If they are from Barangay 158-161, they will be automatically approved.')) {
                return;
            }
            
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const originalHtml = btn.innerHTML;
            
            // Show loading state
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Verifying...';
            
            console.log('Sending OCR request for user:', userId);
            
            fetch('/Admin/UserDetails?handler=ReVerifyWithOCR', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ id: userId })
            })
            .then(response => {
                console.log('Response status:', response.status);
                return response.json();
            })
            .then(data => {
                console.log('Response data:', data);
                btn.disabled = false;
                btn.innerHTML = originalHtml;
                
                if (data.success) {
                    alert(` ${data.message}\n\nBarangay: ${data.barangay}\n\nThe page will reload to show updated status.`);
                    location.reload();
                } else {
                    alert(` ${data.message}`);
                }
            })
            .catch(error => {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
                console.error('Error:', error);
                alert('An error occurred during OCR re-verification. Please check the console and try again.');
            });
        }

        function showConfirmModal(action, userId) {
            const modal = document.getElementById('confirmActionModal');
            const modalHeader = document.getElementById('confirmModalHeader');
            const modalText = document.getElementById('confirmActionText');
            const confirmBtn = document.getElementById('confirmActionBtn');
            
            // Style based on action
            if (action === 'approve') {
                modalHeader.className = 'modal-header text-white';
                modalHeader.style.backgroundColor = '#FF8C42';
                confirmBtn.className = 'btn btn-approve-minimal';
                confirmBtn.innerHTML = '<i class="fa-solid fa-check me-1"></i> Approve';
                modalText.textContent = 'Are you sure you want to approve this user?';
            } else {
                modalHeader.className = 'modal-header text-white';
                modalHeader.style.backgroundColor = '#FF8C42';
                confirmBtn.className = 'btn btn-reject-minimal';
                confirmBtn.innerHTML = '<i class="fa-solid fa-xmark me-1"></i> Reject';
                modalText.textContent = 'Are you sure you want to reject this user?';
            }
            
            // Remove old event listeners by cloning
            const newConfirmBtn = confirmBtn.cloneNode(true);
            confirmBtn.parentNode.replaceChild(newConfirmBtn, confirmBtn);
            
            // Add new event listener
            newConfirmBtn.addEventListener('click', function() {
                const bsModal = bootstrap.Modal.getInstance(modal);
                bsModal.hide();
                
                // Get the anti-forgery token
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const handler = action === 'approve' ? 'Approve' : 'Reject';
                
                fetch(`/Admin/UserDetails?handler=${handler}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: `id=${userId}`
                })
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.json();
                })
                .then(data => {
                    if (data.success) {
                        // Show success message with styled alert
                        const alertClass = action === 'approve' ? 'alert-success' : 'alert-info';
                        const alertHtml = `
                            <div class="alert ${alertClass} alert-dismissible fade show" role="alert">
                                <i class="fa-solid fa-check-circle me-2"></i>${data.message}
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        `;
                        document.body.insertAdjacentHTML('afterbegin', alertHtml);
                        
                        // Redirect after a short delay
                        setTimeout(() => {
                            window.location.href = '/Admin/UserManagement';
                        }, 1500);
                    } else {
                        alert(data.message || 'An error occurred');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert(`Failed to ${action} user. Please try again.`);
                });
            });
            
            // Show modal
            const bsModal = new bootstrap.Modal(modal);
            bsModal.show();
        }
        
        // Scan ID for Auto-Approval function
        function scanIdForApproval(userId) {
            const btn = document.getElementById('btnScanId');
            if (!btn) {
                alert('Button not found');
                return;
            }
            
            // Create file input
            const fileInput = document.createElement('input');
            fileInput.type = 'file';
            fileInput.accept = 'image/jpeg,image/jpg,image/png';
            fileInput.style.display = 'none';
            
            fileInput.onchange = async function(e) {
                const file = e.target.files[0];
                if (!file) {
                    return;
                }
                
                // Validate file type
                if (!file.type.match(/^image\/(jpeg|jpg|png)$/)) {
                    alert('Please select a JPG or PNG image file.');
                    return;
                }
                
                // Validate file size (max 5MB)
                if (file.size > 5 * 1024 * 1024) {
                    alert('File size exceeds 5MB limit. Please select a smaller image.');
                    return;
                }
                
                // Show loading state
                const originalHtml = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Scanning ID...';
                
                // Create form data
                const formData = new FormData();
                formData.append('idImage', file);
                formData.append('id', userId);
                
                // Get anti-forgery token
                const token = document.querySelector('input[name="__RequestVerificationToken"]');
                if (token) {
                    formData.append('__RequestVerificationToken', token.value);
                }
                
                try {
                    const response = await fetch('/Admin/UserDetails?handler=ScanIdForApproval', {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'RequestVerificationToken': token ? token.value : ''
                        }
                    });
                    
                    const data = await response.json();
                    
                    if (data.success) {
                        // Show success message
                        const alertHtml = `
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                <i class="fa-solid fa-check-circle me-2"></i>${data.message}
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        `;
                        document.body.insertAdjacentHTML('afterbegin', alertHtml);
                        
                        // Reload page after a short delay
                        setTimeout(() => {
                            window.location.reload();
                        }, 1500);
                    } else {
                        alert(data.message || 'Failed to scan ID. Please try again.');
                        btn.disabled = false;
                        btn.innerHTML = originalHtml;
                    }
                } catch (error) {
                    console.error('Error scanning ID:', error);
                    alert('An error occurred while scanning the ID. Please try again.');
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                }
                
                // Remove file input
                document.body.removeChild(fileInput);
            };
            
            // Trigger file input
            document.body.appendChild(fileInput);
            fileInput.click();
        }
    </script>
} 