    // Helper function to clean encrypted fields that haven't been properly decrypted
    function cleanEncryptedFields(record) {
        const cleaned = {};
        Object.entries(record).forEach(([key, value]) => {
            if (value && typeof value === 'string') {
                // Check if value looks like encrypted data (long random string)
                if (value.length > 50 && /^[A-Za-z0-9+/=]+$/.test(value) && !value.includes(' ')) {
                    cleaned[key] = '[Encrypted Data]';
                } else {
                    cleaned[key] = value;
                }
            } else {
                cleaned[key] = value;
            }
        });
        return cleaned;
    }
    

