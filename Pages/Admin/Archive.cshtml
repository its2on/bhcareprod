        // Lifestyle
        html += '<div class="section-header">Lifestyle Factors</div>';
        ['SmokingStatus', 'AlcoholConsumption', 'PhysicalActivity', 'EatsVegetablesDaily', 
         'EatsFruitsDaily', 'HasHighSaltIntake', 'ExerciseRegularly'].forEach(field => {
            if (record[field] !== undefined) {
                html += `<div class="field-item">
                    <span class="field-label">${formatFieldLabel(field)}:</span>
                    <span class="field-value">${formatFieldValue(record[field])}</span>
                </div>`;
            }
        });
        
        // Assessment Results
        if (record.RiskLevel || record.Recommendations) {
            html += '<div class="section-header">Assessment Results</div>';
            ['RiskLevel', 'Recommendations', 'FollowUpDate', 'Medications'].forEach(field => {
                if (record[field]) {
                    html += `<div class="field-item">
                        <span class="field-label">${formatFieldLabel(field)}:</span>
                        <span class="field-value assessment-result">${formatFieldValue(record[field])}</span>
                    </div>`;
                }
            });
        }
        
        html += '</div>';
        return html;
    }

    function formatVitalSignsRecord(record) {
        let html = '<div class="record-fields">';
        
        // Patient Info
        html += '<div class="section-header">Patient Information</div>';
        ['PatientName', 'Age', 'Gender', 'RecordedDate'].forEach(field => {
            if (record[field]) {
                html += `<div class="field-item">
                    <span class="field-label">${formatFieldLabel(field)}:</span>
                    <span class="field-value">${formatFieldValue(record[field])}</span>
                </div>`;
            }
        });
        
        // Vital Signs
        html += '<div class="section-header">Vital Signs</div>';
        ['BloodPressureSystolic', 'BloodPressureDiastolic', 'HeartRate', 'RespiratoryRate', 
         'Temperature', 'OxygenSaturation', 'PulseRate'].forEach(field => {
            if (record[field]) {
                html += `<div class="field-item">
                    <span class="field-label">${formatFieldLabel(field)}:</span>
                    <span class="field-value vital-sign">${formatFieldValue(record[field])}</span>
                </div>`;
            }
        });
        
        // Physical Measurements
        html += '<div class="section-header">Physical Measurements</div>';
        ['Height', 'Weight', 'BMI', 'BloodGlucose', 'PainScale'].forEach(field => {
            if (record[field]) {
                html += `<div class="field-item">
                    <span class="field-label">${formatFieldLabel(field)}:</span>
                    <span class="field-value measurement">${formatFieldValue(record[field])}</span>
                </div>`;
            }
        });
        
        // Additional Info
        if (record.Notes || record.TakenBy) {
            html += '<div class="section-header">Additional Information</div>';
            ['Consciousness', 'Notes', 'TakenBy', 'Location'].forEach(field => {
                if (record[field]) {
                    html += `<div class="field-item">
                        <span class="field-label">${formatFieldLabel(field)}:</span>
                        <span class="field-value">${formatFieldValue(record[field])}</span>
                    </div>`;
                }
            });
        }
        
        html += '</div>';
        return html;
    }

    function formatGenericRecord(record, type) {
        let html = '<div class="record-fields">';
        
        // Show all available fields for unknown record types
        Object.entries(record).forEach(([key, value]) => {
            if (value && value !== 'N/A' && key !== 'Id' && key !== '__type') {
                html += `<div class="field-item">
                    <span class="field-label">${formatFieldLabel(key)}:</span>
                    <span class="field-value">${formatFieldValue(value)}</span>
                </div>`;
            }
        });
        
        html += '</div>';
        return html;
    }

