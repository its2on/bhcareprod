    function lockAllRecords() {
        decryptionCache.clearAll();
        showNotification('All records have been locked', 'info');
    }

    function clearDecryptionCache() {
        decryptionCache.clearAll();
        showNotification('Decryption cache cleared', 'info');
    }

    function togglePasswordVisibility() {
        const passwordInput = document.getElementById('passwordInput');
        const toggleIcon = document.getElementById('passwordToggleIcon');
        
        if (passwordInput.type === 'password') {
            passwordInput.type = 'text';
            toggleIcon.className = 'fas fa-eye-slash';
        } else {
            passwordInput.type = 'password';
            toggleIcon.className = 'fas fa-eye';
        }
    }

    function showError(message) {
        const errorEl = document.getElementById('decryptionError');
        const errorMessage = document.getElementById('errorMessage');
        
        if (errorEl && errorMessage) {
            errorMessage.textContent = message;
            errorEl.style.display = 'block';
        }
    }

    function showNotification(message, type = 'info') {
        // Create a toast notification
        const toast = document.createElement('div');
        toast.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
        toast.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
        toast.innerHTML = `
            ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;
        
        document.body.appendChild(toast);
        
        // Auto remove after 3 seconds
        setTimeout(() => {
            if (toast.parentNode) {
                toast.parentNode.removeChild(toast);
            }
        }, 3000);
    }

    // Search functionality
    function filterFamilies() {
        const searchInput = document.getElementById('familySearchInput');
        const searchTerm = searchInput.value.toLowerCase().trim();
        const familyCards = document.querySelectorAll('.family-card-wrapper');
        
        let visibleCount = 0;
        
        familyCards.forEach(card => {
            const familyId = card.getAttribute('data-family-id');
            const isMatch = !searchTerm || familyId.toLowerCase().includes(searchTerm);
            
            card.style.display = isMatch ? 'block' : 'none';
            if (isMatch) visibleCount++;
        });
        
        // Show/hide no results message
        showNoResultsMessage(visibleCount === 0 && searchTerm);
    }

    function clearSearch() {
        const searchInput = document.getElementById('familySearchInput');
        searchInput.value = '';
        filterFamilies();
    }

    function showNoResultsMessage(show) {
        let noResultsMsg = document.getElementById('noResultsMessage');
        
        if (show && !noResultsMsg) {
            noResultsMsg = document.createElement('div');
            noResultsMsg.id = 'noResultsMessage';
            noResultsMsg.className = 'text-center py-5';
            noResultsMsg.innerHTML = `
                <div class="empty-state">
                    <i class="fas fa-search empty-icon"></i>
                    <h6>No families found</h6>
                    <p>Try adjusting your search terms</p>
                </div>
            `;
            document.querySelector('.families-grid').appendChild(noResultsMsg);
        }
        
        if (noResultsMsg) {
            noResultsMsg.style.display = show ? 'block' : 'none';
        }
    }

    // View Records - Show in modal with real decrypted content
    function viewFamilyDetails(familyId) {
        // Check if already decrypted
        const cachedData = decryptionCache.get(familyId);
        if (cachedData && cachedData.familyName && cachedData.contentHtml) {
            // Show decrypted content in modal
            showFamilyDetailsModal(familyId, cachedData.familyName, cachedData.contentHtml);
            return;
        }
        
        // Otherwise initiate decryption for modal view
        initiateDecryptionForModal(familyId);
    }

    // Initiate decryption specifically for modal view
    function initiateDecryptionForModal(familyId) {
        const modal = document.getElementById('passwordModal');
        const modalTitle = modal.querySelector('.modal-title');
        const familyIdSpan = document.getElementById('modalFamilyId');
        
        // Set context for modal view
        modal.setAttribute('data-target-view', 'modal');
        modal.setAttribute('data-family-id', familyId);
        
        if (modalTitle) {
            modalTitle.innerHTML = '<i class="fas fa-key me-2"></i>Decrypt Records for Modal View';
        }
        if (familyIdSpan) {
            familyIdSpan.textContent = familyId;
        }
        
        // Show the password modal
        const bootstrapModal = new bootstrap.Modal(modal);
        bootstrapModal.show();
    }



    // Helper functions removed - content now provided by API

    function toggleExpandCard(familyId) {
        const cachedData = decryptionCache.get(familyId);
        console.log('=== DEBUG toggleExpandCard ===');
        console.log('FamilyId:', familyId);
        console.log('CachedData:', cachedData);
        
        if (cachedData && cachedData.decryptedData) {
            console.log('DecryptedData:', cachedData.decryptedData);
            console.log('DecryptedData keys:', Object.keys(cachedData.decryptedData));
            
            // Show decrypted content in modal instead of expanding inline
            const realFamilyName = extractFamilyName(cachedData.decryptedData);
            console.log('Real family name:', realFamilyName);
            
            const contentHtml = generateRealContentHTML(cachedData.decryptedData);
            console.log('Generated HTML length:', contentHtml.length);
            console.log('Generated HTML preview:', contentHtml.substring(0, 200));
            
            showFamilyDetailsModal(familyId, realFamilyName, contentHtml);
        } else {
            console.log('No cached data or decryptedData found');
        }
    }

    // Initialize on page load
    document.addEventListener('DOMContentLoaded', function() {
        // Set up search input listener
        const searchInput = document.getElementById('familySearchInput');
        if (searchInput) {
            searchInput.addEventListener('keyup', filterFamilies);
        }
        
        // Initialize cache UI
        decryptionCache.updateUI();
        
        console.log('Enhanced Family Health Records Archive initialized');
    });
</script>

