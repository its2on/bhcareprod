    async function performDecryption() {
        const familyId = document.getElementById('passwordModal').getAttribute('data-family-id');
        const password = document.getElementById('passwordInput').value;
        const errorEl = document.getElementById('decryptionError');
        const errorMessage = document.getElementById('errorMessage');
        const decryptBtn = document.getElementById('decryptBtn');
        
        if (!password) {
            showError('Please enter a password');
            return;
        }
        
        // Show loading state
        const originalBtnText = decryptBtn.innerHTML;
        decryptBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Decrypting...';
        decryptBtn.disabled = true;
        errorEl.style.display = 'none';
        
        try {
            // Use existing Razor Pages handler for decryption
            const response = await fetch(`/Admin/Archive?handler=FamilyDetails&familyId=${encodeURIComponent(familyId)}`);
            
            if (!response.ok) {
                throw new Error(`Failed to fetch data: ${response.status} ${response.statusText}`);
            }
            
            const data = await response.json();
            
            if (!data.success) {
                throw new Error(data.error || 'Failed to fetch family data');
            }
            
            // Attempt decryption with the provided password
            const decryptResult = await attemptDecryption(data.data, password);
            
            if (!decryptResult.success) {
                throw new Error(decryptResult.error || 'Decryption failed');
            }
            
            // Store in cache
            decryptionCache.store(familyId, password, decryptResult.decryptedData);
            
            // Update UI
            displayDecryptedData(familyId, decryptResult.decryptedData);
            
            // Close modal
            const modal = bootstrap.Modal.getInstance(document.getElementById('passwordModal'));
            modal.hide();
            
            // Show success message
            showNotification('Records decrypted successfully!', 'success');
            
        } catch (error) {
            console.error('Decryption error:', error);
            showError(error.message);
        } finally {
            decryptBtn.innerHTML = originalBtnText;
            decryptBtn.disabled = false;
        }
    }

    // Legacy decryption function - keeping for fallback if needed
    async function attemptDecryption(encryptedData, password) {
        // Try to decrypt various fields in the data
        const decrypted = {};
        
        for (const [key, records] of Object.entries(encryptedData)) {
            if (Array.isArray(records)) {
                decrypted[key] = [];
                
                for (const record of records) {
                    const decryptedRecord = {};
                    
                    for (const [fieldName, fieldValue] of Object.entries(record)) {
                        if (typeof fieldValue === 'string' && fieldValue.length > 50) {
                            // Attempt to decrypt
                            const result = encryption.decryptData(fieldValue, password);
                            decryptedRecord[fieldName] = result.success ? result.decryptedData : fieldValue;
                        } else {
                            decryptedRecord[fieldName] = fieldValue;
                        }
                    }
                    
                    decrypted[key].push(decryptedRecord);
                }
            } else {
                decrypted[key] = records;
            }
        }
        
        return { success: true, decryptedData: decrypted };
    }

