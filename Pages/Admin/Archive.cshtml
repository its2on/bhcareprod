@page
@model Barangay.Pages.Admin.ArchiveModel
@{
    ViewData["Title"] = "Family Health Records Archive";
}

<div class="archive-container">
    <div class="archive-header">
        <div class="header-content">
            <div class="header-title">
                <h1 class="page-title">
                    <i class="fas fa-archive me-2"></i>Family Health Records Archive
                </h1>
                <p class="page-subtitle">Secure access to encrypted family health records</p>
            </div>
            <div class="header-actions">
                <button id="lockAllBtn" class="btn btn-lock" onclick="lockAllRecords()" style="display: none;">
                    <i class="fas fa-lock me-2"></i>Lock All
                </button>
                <button id="clearCacheBtn" class="btn btn-clear-cache" onclick="clearDecryptionCache()" style="display: none;">
                    <i class="fas fa-trash me-2"></i>Clear Cache
                </button>
            </div>
        </div>
        <div class="cache-status" id="cacheStatus" style="display: none;">
            <span class="status-text">Decryption cache active - expires in <span id="cacheTimer">--</span></span>
        </div>
        <div class="search-section">
            <div class="search-wrapper">
                <div class="search-input-group">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" class="search-input" id="familySearchInput" 
                           placeholder="Search by Family Number (e.g., F001, fam123)..." 
                           onkeyup="filterFamilies()">
                    <button class="search-clear-btn" onclick="clearSearch()">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <small class="search-hint">
                    <i class="fas fa-info-circle me-1"></i>Enter Family Number or Family ID to filter results
                </small>
            </div>
        </div>
    </div>

    <div class="families-grid">
        @{
            // Group all records by family number - UNIFIED APPROACH
            var allFamilies = new Dictionary<string, object>();
            
            // Use family identifiers from the model (populated from database)
            var familyIdentifiers = new HashSet<string>(Model.FamilyIdentifiers);
        }
        
        @foreach (var familyId in familyIdentifiers)
        {
            <div class="family-card-wrapper" data-family-id="@familyId">
                <div class="family-card">
                    <div class="card-header">
                        <div class="family-info">
                            <h3 class="family-title">
                                <i class="fas fa-users me-2"></i>Family @(familyId.Length > 20 ? familyId.Substring(0, 20) + "..." : familyId)
                            </h3>
                            <div class="family-number">
                                <span class="label">Family Number:</span>
                                <span class="value" title="@familyId">@(familyId.Length > 15 ? familyId.Substring(0, 15) + "..." : familyId)</span>
                            </div>
                            <div class="decryption-status" id="status-@familyId" style="display: none;">
                                <span class="status-badge decrypted">
                                    <i class="fas fa-shield-check me-1"></i>
                                    Decrypted — expires in <span class="timer" id="timer-@familyId">--</span>
                                </span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="card-body" id="body-@familyId">
                        <div class="record-summary">
                            <div class="summary-text">
                                <i class="fas fa-info-circle me-2 text-muted"></i>
                                Click "Decrypt Records" to securely access Immunization, HEEADSSS, and NCD forms for this family
                            </div>
                            
                            <div class="record-types-preview">
                                <span class="type-badge immunization">
                                    <i class="fas fa-syringe me-1"></i>Immunization
                                </span>
                                <span class="type-badge heeadsss">
                                    <i class="fas fa-user-md me-1"></i>HEEADSSS
                                </span>
                                <span class="type-badge ncd">
                                    <i class="fas fa-heartbeat me-1"></i>NCD
                                </span>
                                <span class="type-badge vitals">
                                    <i class="fas fa-stethoscope me-1"></i>Vitals
                                </span>
                            </div>
                        </div>
                        <div class="decrypted-content" id="decrypted-@familyId" style="display: none;">
                            <!-- Decrypted content will be loaded here -->
                        </div>
                    </div>
                    
                    <div class="card-actions">
                        <button class="btn btn-decrypt" id="decrypt-btn-@familyId" onclick="initiateDecryption('@familyId')">
                            <i class="fas fa-key me-2"></i>Decrypt Records
                        </button>
                        <button class="btn btn-expand" id="expand-btn-@familyId" onclick="toggleExpandCard('@familyId')" style="display: none;">
                            <i class="fas fa-expand me-2"></i>Expand
                        </button>
                        <button class="btn btn-collapse" id="collapse-btn-@familyId" onclick="toggleExpandCard('@familyId')" style="display: none;">
                            <i class="fas fa-compress me-2"></i>Collapse
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>


    <!-- Password Decryption Modal -->
    <div class="modal fade" id="passwordModal" tabindex="-1" aria-labelledby="passwordModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="passwordModalLabel">
                        <i class="fas fa-key me-2"></i>Decrypt Family Records
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="decryption-form">
                        <div class="family-info-display">
                            <p class="text-muted mb-3">
                                <i class="fas fa-info-circle me-2"></i>
                                Enter password to decrypt records for Family <strong id="modalFamilyId"></strong>
                            </p>
                        </div>
                        
                        <div class="mb-3">
                            <label for="passwordInput" class="form-label">Password</label>
                            <div class="password-input-group">
                                <input type="password" class="form-control" id="passwordInput" placeholder="Enter decryption password">
                                <button type="button" class="btn-toggle-password" onclick="togglePasswordVisibility()">
                                    <i class="fas fa-eye" id="passwordToggleIcon"></i>
                                </button>
                            </div>
                        </div>
                        
                        <div class="decryption-options">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="rememberSession" checked>
                                <label class="form-check-label" for="rememberSession">
                                    Remember for this session (5 minutes)
                                </label>
                            </div>
                        </div>
                        
                        <div class="alert alert-danger" id="decryptionError" style="display: none;">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <span id="errorMessage"></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-2"></i>Cancel
                    </button>
                    <button type="button" class="btn btn-primary" id="decryptBtn" onclick="performDecryption()">
                        <i class="fas fa-unlock me-2"></i>Decrypt Records
                    </button>
                </div>
            </div>
        </div>
    </div>

<!-- New Family Health Records Modal -->
<div class="modal fade" id="familyDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="fas fa-folder-open me-2"></i><span id="modalFamilyName">Family Health Records</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <div class="modal-family-header p-3 bg-light border-bottom">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="family-info">
                            <h6 class="mb-0 family-id" id="modalFamilyId">Family ID</h6>
                            <small class="text-muted">Decrypted Health Records</small>
                        </div>
                        <div class="decryption-status">
                            <i class="fas fa-check-circle text-success me-1"></i>
                            <small class="text-success fw-bold">Successfully Decrypted</small>
                        </div>
                    </div>
                </div>
                <div class="modal-content-area p-3" id="familyDetailsContent">
                    <!-- Decrypted content will be loaded here -->
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

    /* Root Variables - Orange Theme */
    :root {
        --primary-orange: #e27e38;
        --accent-green: #54956c;
        --background-light: #F9FAFB;
        --text-dark: #1F2937;
        --text-muted: #6B7280;
        --border-light: #E5E7EB;
        --white: #FFFFFF;
        --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
        --radius-sm: 0.375rem;
        --radius-md: 0.5rem;
        --radius-lg: 0.75rem;
        --transition-base: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Base Styles */
    body {
        font-family: 'Inter', sans-serif;
        background-color: var(--background-light);
        color: var(--text-dark);
    }

    /* Archive Container */
    .archive-container {
        min-height: 100vh;
        padding: 2rem;
        background: linear-gradient(135deg, #FFF7ED 0%, var(--background-light) 100%);
    }

    /* Header Styles */
    .archive-header {
        margin-bottom: 2rem;
    }

    .header-content {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .header-title {
        flex: 1;
        min-width: 300px;
    }

    .page-title {
        font-size: 2.25rem;
        font-weight: 700;
        color: var(--text-dark);
        margin: 0 0 0.5rem 0;
        line-height: 1.2;
    }

    .page-title i {
        color: var(--primary-orange);
    }

    .page-subtitle {
        color: var(--text-muted);
        font-size: 1.125rem;
        margin: 0;
        font-weight: 500;
    }

    .header-actions {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        align-items: center;
    }

    /* Button Styles */
    .btn {
        padding: 0.75rem 1.5rem;
        border-radius: var(--radius-md);
        font-weight: 600;
        font-size: 0.875rem;
        transition: var(--transition-base);
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        text-decoration: none;
        line-height: 1;
    }

    .btn:hover {
        transform: translateY(-1px);
        box-shadow: var(--shadow-md);
    }

    .btn-secondary {
        background-color: var(--text-muted);
        color: var(--white);
    }

    .btn-secondary:hover {
        background-color: #4B5563;
        color: var(--white);
    }

    .btn-lock {
        background-color: #DC2626;
        color: var(--white);
    }

    .btn-lock:hover {
        background-color: #B91C1C;
    }

    .btn-clear-cache {
        background-color: #7C3AED;
        color: var(--white);
    }

    .btn-clear-cache:hover {
        background-color: #6D28D9;
    }

    /* Cache Status */
    .cache-status {
        background: linear-gradient(135deg, var(--accent-green), #48A574);
        color: var(--white);
        padding: 0.75rem 1.5rem;
        border-radius: var(--radius-lg);
        margin-bottom: 1rem;
        box-shadow: var(--shadow-sm);
    }

    .status-text {
        font-weight: 500;
        font-size: 0.875rem;
    }

    /* Search Section */
    .search-section {
        background: var(--white);
        border-radius: var(--radius-lg);
        padding: 1.5rem;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--border-light);
    }

    .search-wrapper {
        max-width: 600px;
    }

    .search-input-group {
        position: relative;
        display: flex;
        align-items: center;
        background: var(--background-light);
        border: 2px solid var(--border-light);
        border-radius: var(--radius-md);
        transition: var(--transition-base);
    }

    .search-input-group:focus-within {
        border-color: var(--primary-orange);
        box-shadow: 0 0 0 3px rgba(226, 126, 56, 0.1);
    }

    .search-icon {
        position: absolute;
        left: 1rem;
        color: var(--text-muted);
        font-size: 1rem;
        z-index: 1;
    }

    .search-input {
        flex: 1;
        padding: 0.875rem 1rem 0.875rem 3rem;
        border: none;
        background: transparent;
        font-size: 1rem;
        outline: none;
        color: var(--text-dark);
    }

    .search-input::placeholder {
        color: var(--text-muted);
    }

    .search-clear-btn {
        padding: 0.5rem;
        background: none;
        border: none;
        color: var(--text-muted);
        cursor: pointer;
        border-radius: var(--radius-sm);
        transition: var(--transition-base);
    }

    .search-clear-btn:hover {
        background-color: var(--border-light);
        color: var(--text-dark);
    }

    .search-hint {
        display: block;
        margin-top: 0.5rem;
        color: var(--text-muted);
        font-size: 0.875rem;
    }

    /* Family Grid */
    .families-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
        gap: 1.5rem;
        margin-top: 2rem;
    }

    /* Family Card */
    .family-card-wrapper {
        transition: var(--transition-base);
    }

    .family-card {
        background: var(--white);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--border-light);
        overflow: hidden;
        transition: var(--transition-base);
        position: relative;
    }

    .family-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-xl);
        border-color: var(--primary-orange);
    }

    .family-card.expanded {
        grid-column: 1 / -1;
        max-width: none;
    }

    .card-header {
        background: linear-gradient(135deg, var(--primary-orange), #D97636);
        color: var(--white);
        padding: 1.5rem;
        position: relative;
    }

    .card-header::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grain" x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="50" cy="50" r="1" fill="white" opacity="0.1"/></pattern></defs><rect width="100%" height="100%" fill="url(%23grain)"/></svg>');
        opacity: 0.1;
    }

    .family-info {
        position: relative;
        z-index: 1;
    }

    .family-title {
        font-size: 1.25rem;
        font-weight: 700;
        margin: 0 0 0.75rem 0;
        line-height: 1.2;
    }

    .family-number {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1rem;
    }

    .family-number .label {
        font-size: 0.875rem;
        opacity: 0.9;
    }

    .family-number .value {
        font-weight: 600;
        font-size: 0.875rem;
        background: rgba(255, 255, 255, 0.2);
        padding: 0.25rem 0.75rem;
        border-radius: var(--radius-sm);
    }

    .decryption-status {
        margin-top: 0.75rem;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.5rem 1rem;
        border-radius: var(--radius-md);
        font-size: 0.875rem;
        font-weight: 600;
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    .status-badge.decrypted {
        background: rgba(84, 149, 108, 0.9);
        color: var(--white);
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.8; }
    }

    .timer {
        font-weight: 700;
        margin-left: 0.25rem;
    }

    /* Card Body */
    .card-body {
        padding: 1.5rem;
    }

    .record-summary {
        text-align: center;
    }

    .summary-text {
        color: var(--text-muted);
        font-size: 0.875rem;
        line-height: 1.5;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .record-types-preview {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        justify-content: center;
    }

    .type-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.5rem 0.75rem;
        border-radius: var(--radius-md);
        font-size: 0.75rem;
        font-weight: 600;
        border: 1px solid var(--border-light);
        background: var(--background-light);
        color: var(--text-dark);
        transition: var(--transition-base);
    }

    .type-badge:hover {
        transform: scale(1.05);
    }

    .type-badge.immunization {
        background: #FEF3C7;
        border-color: #F59E0B;
        color: #92400E;
    }

    .type-badge.heeadsss {
        background: #DBEAFE;
        border-color: #3B82F6;
        color: #1E40AF;
    }

    .type-badge.ncd {
        background: #FEE2E2;
        border-color: #EF4444;
        color: #DC2626;
    }

    .type-badge.vitals {
        background: #D1FAE5;
        border-color: #10B981;
        color: #047857;
    }

    /* Decrypted Content */
    .decrypted-content {
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 2px solid var(--border-light);
        animation: slideDown 0.3s ease-out;
    }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Card Actions */
    .card-actions {
        padding: 1rem 1.5rem;
        background: var(--background-light);
        border-top: 1px solid var(--border-light);
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .btn-view {
        background-color: var(--text-muted);
        color: var(--white);
        flex: 1;
        min-width: 140px;
    }

    .btn-view:hover {
        background-color: #4B5563;
        color: var(--white);
    }

    .btn-decrypt {
        background-color: var(--accent-green);
        color: var(--white);
        flex: 1;
        min-width: 140px;
    }

    .btn-decrypt:hover {
        background-color: #48A574;
        color: var(--white);
    }

    .btn-expand, .btn-collapse {
        background-color: var(--primary-orange);
        color: var(--white);
        flex: 1;
        min-width: 140px;
    }

    .btn-expand:hover, .btn-collapse:hover {
        background-color: #D97636;
        color: var(--white);
    }

    /* Modal Styles */
    .modal-content {
        border-radius: var(--radius-lg);
        border: none;
        box-shadow: var(--shadow-xl);
    }

    .modal-header {
        background: linear-gradient(135deg, var(--primary-orange), #D97636);
        color: var(--white);
        border-bottom: none;
        border-radius: var(--radius-lg) var(--radius-lg) 0 0;
        padding: 1.5rem;
    }

    .modal-title {
        font-weight: 700;
        font-size: 1.25rem;
    }

    .btn-close {
        filter: invert(1);
        opacity: 0.8;
    }

    .btn-close:hover {
        opacity: 1;
    }

    .modal-body {
        padding: 2rem;
    }

    .password-input-group {
        position: relative;
    }

    .btn-toggle-password {
        position: absolute;
        right: 0.75rem;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: var(--text-muted);
        cursor: pointer;
        padding: 0.5rem;
        border-radius: var(--radius-sm);
        transition: var(--transition-base);
    }

    .btn-toggle-password:hover {
        color: var(--text-dark);
        background: var(--background-light);
    }

    .form-control {
        border: 2px solid var(--border-light);
        border-radius: var(--radius-md);
        padding: 0.875rem 3rem 0.875rem 1rem;
        font-size: 1rem;
        transition: var(--transition-base);
    }

    .form-control:focus {
        border-color: var(--primary-orange);
        box-shadow: 0 0 0 3px rgba(226, 126, 56, 0.1);
        outline: none;
    }

    .form-label {
        font-weight: 600;
        color: var(--text-dark);
        margin-bottom: 0.5rem;
    }

    .modal-footer {
        padding: 1.5rem 2rem;
        border-top: 1px solid var(--border-light);
        background: var(--background-light);
        border-radius: 0 0 var(--radius-lg) var(--radius-lg);
    }

    .modal-footer .btn {
        min-width: 120px;
    }

    /* Animations */
    .family-card-wrapper[style*="display: none"] {
        opacity: 0;
        transform: scale(0.95);
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .archive-container {
            padding: 1rem;
        }

        .header-content {
            flex-direction: column;
            align-items: stretch;
        }

        .header-actions {
            justify-content: stretch;
        }

        .header-actions .btn {
            flex: 1;
            justify-content: center;
        }

        .families-grid {
            grid-template-columns: 1fr;
            gap: 1rem;
        }

        .page-title {
            font-size: 1.75rem;
        }

        .card-actions {
            flex-direction: column;
        }

        .card-actions .btn {
            flex: none;
        }
    }
</style>

<style>
    /* Ensure modal body scrolls even if Bootstrap JS is missing */
    .modal-dialog-scrollable .modal-body {
        max-height: calc(100vh - 200px);
        overflow-y: auto;
    }
</style>

<!-- Required Libraries -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/crypto-js/4.1.1/crypto-js.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<!-- Enhanced Session-Based Decryption System -->
<script>
    // Session-based Decryption Cache Manager
    class DecryptionCache {
        constructor() {
            this.memoryCache = new Map();
            this.sessionTTL = 5 * 60 * 1000; // 5 minutes
            this.timers = new Map();
            this.globalTimer = null;
            
            // Initialize cache from sessionStorage if available
            this.initializeFromStorage();
        }

        initializeFromStorage() {
            try {
                const stored = sessionStorage.getItem('bhcare_decryption_cache');
                if (stored) {
                    const data = JSON.parse(stored);
                    if (data.expires && Date.now() < data.expires) {
                        this.memoryCache = new Map(data.families);
                        this.startGlobalTimer(data.expires - Date.now());
                    } else {
                        sessionStorage.removeItem('bhcare_decryption_cache');
                    }
                }
            } catch (error) {
                console.warn('Failed to initialize cache from storage:', error);
            }
        }

        updateStorage() {
            try {
                const expires = Date.now() + this.sessionTTL;
                const data = {
                    families: Array.from(this.memoryCache.entries()),
                    expires: expires
                };
                sessionStorage.setItem('bhcare_decryption_cache', JSON.stringify(data));
            } catch (error) {
                console.warn('Failed to update sessionStorage cache:', error);
            }
        }

        store(familyId, password, decryptedData) {
            const entry = {
                password,
                decryptedData,
                timestamp: Date.now(),
                expires: Date.now() + this.sessionTTL
            };

            this.memoryCache.set(familyId, entry);
            this.updateStorage();
            this.startTimer(familyId);
            this.startGlobalTimer(this.sessionTTL);
            this.updateUI();
        }

        get(familyId) {
            const entry = this.memoryCache.get(familyId);
            if (entry && Date.now() < entry.expires) {
                return entry;
            }
            
            // Remove expired entry
            if (entry) {
                this.remove(familyId);
            }
            return null;
        }

        remove(familyId) {
            this.memoryCache.delete(familyId);
            this.clearTimer(familyId);
            this.updateStorage();
            this.updateFamilyUI(familyId, false);
        }

        clearAll() {
            this.memoryCache.clear();
            this.timers.forEach((timer, familyId) => {
                clearTimeout(timer);
                this.updateFamilyUI(familyId, false);
            });
            this.timers.clear();
            
            if (this.globalTimer) {
                clearTimeout(this.globalTimer);
                this.globalTimer = null;
            }
            
            // Clear sessionStorage backup
            try {
                sessionStorage.removeItem('bhcare_decryption_cache');
            } catch (e) {
                console.warn('Failed to remove from sessionStorage:', e);
            }
            
            this.updateUI();
        }

        startTimer(familyId) {
            // Clear existing timer if any
            this.clearTimer(familyId);
            
            const timer = setTimeout(() => {
                this.remove(familyId);
            }, this.sessionTTL);
            this.timers.set(familyId, timer);
        }

        clearTimer(familyId) {
            const timer = this.timers.get(familyId);
            if (timer) {
                clearTimeout(timer);
                this.timers.delete(familyId);
            }
        }

        startGlobalTimer(ttl) {
            if (this.globalTimer) {
                clearTimeout(this.globalTimer);
            }
            
            this.globalTimer = setTimeout(() => {
                this.updateGlobalCacheDisplay();
            }, ttl);
            
            this.updateGlobalCacheDisplay();
        }

        updateUI() {
            const hasCache = this.memoryCache.size > 0;
            const lockBtn = document.getElementById('lockAllBtn');
            const clearBtn = document.getElementById('clearCacheBtn');
            const cacheStatus = document.getElementById('cacheStatus');
            
            if (lockBtn) lockBtn.style.display = hasCache ? 'block' : 'none';
            if (clearBtn) clearBtn.style.display = hasCache ? 'block' : 'none';
            if (cacheStatus) cacheStatus.style.display = hasCache ? 'block' : 'none';
            
            this.updateGlobalCacheDisplay();
        }

        updateGlobalCacheDisplay() {
            const timerEl = document.getElementById('cacheTimer');
            if (!timerEl) return;
            
            if (this.memoryCache.size === 0) {
                return;
            }
            
            // Find the earliest expiration time
            let earliestExpiry = Infinity;
            for (const entry of this.memoryCache.values()) {
                if (entry.expires < earliestExpiry) {
                    earliestExpiry = entry.expires;
                }
            }
            
            if (earliestExpiry === Infinity) return;
            
            const remaining = Math.max(0, earliestExpiry - Date.now());
            const minutes = Math.floor(remaining / 60000);
            const seconds = Math.floor((remaining % 60000) / 1000);
            
            timerEl.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;
            
            if (remaining > 0) {
                setTimeout(() => this.updateGlobalCacheDisplay(), 1000);
            }
        }

        updateFamilyUI(familyId, isDecrypted) {
            const statusEl = document.getElementById(`status-${familyId}`);
            const timerEl = document.getElementById(`timer-${familyId}`);
            const decryptBtn = document.getElementById(`decrypt-btn-${familyId}`);
            
            if (statusEl) {
                statusEl.style.display = isDecrypted ? 'block' : 'none';
            }
            
            if (decryptBtn) {
                decryptBtn.innerHTML = isDecrypted 
                    ? '<i class="fas fa-shield-check me-2"></i>Decrypted' 
                    : '<i class="fas fa-key me-2"></i>Decrypt Records';
                decryptBtn.disabled = isDecrypted;
            }
            
            if (isDecrypted && timerEl) {
                this.updateFamilyTimer(familyId);
            }
        }

        updateFamilyTimer(familyId) {
            const entry = this.get(familyId);
            const timerEl = document.getElementById(`timer-${familyId}`);
            
            if (!entry || !timerEl) return;
            
            const remaining = Math.max(0, entry.expires - Date.now());
            const minutes = Math.floor(remaining / 60000);
            const seconds = Math.floor((remaining % 60000) / 1000);
            
            timerEl.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;
            
            if (remaining > 0) {
                setTimeout(() => this.updateFamilyTimer(familyId), 1000);
            }
        }

        hasDecryptedData(familyId) {
            return this.memoryCache.has(familyId);
        }

        // Store real decrypted content from backend
        storeDecryptedContent(familyId, decryptedContent) {
            const expires = Date.now() + (decryptedContent.ttlSeconds * 1000);
            
            const entry = {
                familyName: decryptedContent.familyName,
                contentHtml: decryptedContent.contentHtml,
                token: decryptedContent.token,
                expires: expires
            };
            
            this.memoryCache.set(familyId, entry);
            
            // Store in sessionStorage (no password, just decrypted content)
            try {
                sessionStorage.setItem(`decrypt_${familyId}`, JSON.stringify(entry));
            } catch (e) {
                console.warn('Failed to store in sessionStorage:', e);
            }
            
            this.updateFamilyUI(familyId, true);
        }
    }

