    // Main Functions
    function initiateDecryption(familyId) {
        // Check if already decrypted - just show success message
        if (decryptionCache.hasDecryptedData(familyId)) {
            showNotification('Records already decrypted. Use "View Records" to see content.', 'info');
            return;
        }
        
        // Show password modal
        const modal = new bootstrap.Modal(document.getElementById('passwordModal'));
