@page
@model Barangay.Pages.Account.PendingApprovalModel
@{
    ViewData["Title"] = "Registration Pending Approval";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0">
                <div class="card-body p-5 text-center">
                    <div class="mb-4">
                        <i class="fas fa-clock text-warning" style="font-size: 80px;"></i>
                    </div>
                    <h2 class="text-warning mb-3">⏳ Pending Approval</h2>
                    <p class="lead mb-4">
                        Thank you for registering with BHCare!
                    </p>
                    
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-info mb-4">
                            <i class="fas fa-info-circle me-2"></i>
                            @TempData["SuccessMessage"]
                        </div>
                    }
                    
                    <div class="alert alert-warning">
                        <i class="fas fa-hourglass-half me-2"></i>
                        <strong>Manual Review Required</strong>
                        <p class="mb-0 mt-2 small">
                            Your account has been created but requires administrator approval before you can log in.
                        </p>
                    </div>
                    
                    <div class="text-start mb-4">
                        <p class="mb-2"><strong>What happens next?</strong></p>
                        <ul class="small">
                            <li>Your residency proof will be verified by our staff</li>
                            <li>This usually takes 1-2 business days</li>
                            <li>You will receive an email once approved</li>
                            <li>You will not be able to log in until approved</li>
                            <li>No further action is required from you</li>
                        </ul>
                    </div>
                    
                    <div class="d-grid gap-2">
                        <a href="/Account/Login" class="btn btn-primary btn-lg">
                            <i class="fas fa-sign-in-alt me-2"></i> Go to Login Page
                        </a>
                        <a href="/" class="btn btn-outline-secondary">
                            <i class="fas fa-home me-2"></i> Back to Home
                        </a>
                    </div>
                    
                    <div class="mt-4">
                        <small class="text-muted">
                            Need help? Contact us at 
                            <a href="mailto:healthcenterbaesa@gmail.com">healthcenterbaesa@gmail.com</a>
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            border-radius: 15px;
        }
        .btn-lg {
            padding: 12px 30px;
            font-size: 1.1rem;
        }
    </style>
} 