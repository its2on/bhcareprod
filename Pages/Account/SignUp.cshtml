                        // Address validation
                        const addressInput = document.getElementById('Input_Address');
                        if (addressInput) {
                            addressInput.addEventListener('blur', () => {
                                this.validateAddress();
                                this.updateStep1NextButtonState();
                            });
                            addressInput.addEventListener('input', () => {
                                const value = addressInput.value.trim();
                                // Only clear error if value doesn't have obvious spam
                                if (value && !this.hasExcessiveRepetition(value, 4)) {
                                    this.clearError('address');
                                } else if (value && this.hasExcessiveRepetition(value, 4)) {
                                    this.showError('address', 'Address contains too many repeated characters');
                                }
                                this.updateStep1NextButtonState();
                            });
                        }

                        // Birth date validation
                        const birthDateInput = document.getElementById('Input_BirthDate');
                        if (birthDateInput) {
                            birthDateInput.addEventListener('change', () => {
                                this.validateBirthDate();
                                this.updateStep1NextButtonState();
