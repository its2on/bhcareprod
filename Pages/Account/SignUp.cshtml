                    }
                } catch (error) {
                    console.error('Error processing ID:', error);
                    
                    // Skip if validation failed (already showed error)
                    if (error.message === 'Image quality validation failed') {
                        return;
                    }
                    
                    // Provide more specific error messages when possible
                    let errorTitle = 'Error Processing ID';
                    let errorMessage = error.message || 'Error processing ID. Please try again or fill the form manually.';
                    let tipMessage = '';
                    
                    // Check for Philippine ID validation errors
                    if (error.message?.includes('PHILIPPINE_ID_REQUIRED') || 
                        error.message?.includes('Invalid document') ||
                        error.message?.includes('not a valid Philippine ID') ||
                        error.message?.includes('actual Philippine ID')) {
                        errorTitle = '⚠️ Philippine ID Required';
                        errorMessage = error.message.replace('PHILIPPINE_ID_REQUIRED: ', '');
                        tipMessage = '<strong>Only actual Philippine ID documents are accepted:</strong><ul class="mb-0 mt-2"><li>Driver\'s License</li><li>National ID (PhilSys)</li><li>PhilHealth ID</li><li>Postal ID</li><li>UMID</li><li>TIN ID</li></ul><p class="mb-0 mt-2">Screenshots, photos of screens, or other documents will be rejected.</p>';
                    } else if (error.message?.includes('network') || error.message?.includes('Failed to fetch')) {
                        errorTitle = 'Connection Error';
                        errorMessage = 'Could not connect to the server.';
                        tipMessage = 'Tips: Check your internet connection, try again in a few moments.';
                    } else if (error.message?.includes('resolution') || error.message?.includes('blurry') || error.message?.includes('blur')) {
                        errorTitle = 'Image Quality Issue';
                        tipMessage = 'Tips: Use good lighting, hold camera steady, ensure entire ID is visible.';
                    } else if (error.message?.includes('No readable text') || error.message?.includes('Common causes:')) {
                        errorTitle = 'No Text Detected';
                        // Use the detailed error message from server
                        tipMessage = '';
                    } else if (error.message?.includes('Unsupported') || error.message?.includes('file type')) {
                        errorTitle = 'Invalid File';
                        tipMessage = 'Please use JPG, PNG, BMP, or WebP images.';
                    } else {
                        tipMessage = 'Tips: Try with a clearer image in good lighting with all text visible.';
