                        // Name validation
                        ['FirstName', 'LastName'].forEach(field => {
                            const input = document.getElementById(`Input_${field}`);
                            if (input) {
                                input.addEventListener('blur', () => {
                                    this.validateName(field);
                                    this.updateStep1NextButtonState();
                                });
                                input.addEventListener('input', () => {
                                    const value = input.value.trim();
                                    // Only clear error if value doesn't have obvious spam
                                    if (value && !this.hasExcessiveRepetition(value, 3)) {
                                        this.clearError(field.toLowerCase());
                                    } else if (value && this.hasExcessiveRepetition(value, 3)) {
                                        this.showError(field.toLowerCase(), `${field} contains too many repeated characters`);
                                    }
                                    this.updateStep1NextButtonState();
                                });
