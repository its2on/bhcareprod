    <!-- ID Scanner Script -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const scanIdButton = document.getElementById('scanIdButton');
            const idScannerInput = document.getElementById('idScannerInput');
            const scannerStatus = document.getElementById('scannerStatus');
            const scannerResult = document.getElementById('scannerResult');
            
            if (!scanIdButton || !idScannerInput) return;
            
            // Initialize Tesseract worker
            let worker = null;
            let isWorkerInitialized = false;
            
            async function initializeWorker() {
                if (worker) return true;
                try {
                    console.log('Initializing Tesseract worker...');
                    
                    // Use version 2.x API
                    worker = Tesseract.createWorker({
                        logger: m => {
                            console.log(m);
                            // Update progress bar during loading if visible
                            const statusText = document.getElementById('scanStatusText');
                            if (statusText && m.status && m.status !== 'recognizing text') {
                                statusText.textContent = `Initializing scanner: ${m.status}`;
                            }
                        }
                    });
                    
                    await worker.load();
                    await worker.loadLanguage('eng');
                    await worker.initialize('eng');
                    await worker.setParameters({
                        tessedit_char_whitelist: 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789.,/\\-():; '
                    });
                    
                    console.log('OCR worker initialized successfully');
                    scannerResult.innerHTML = `<div class="alert alert-success">
                        <i class="fas fa-check-circle me-2"></i> Scanner ready to use!
                    </div>`;
                    scannerResult.classList.remove('d-none');
                    isWorkerInitialized = true;
                    return true;
                } catch (error) {
                    console.error('Failed to initialize OCR worker:', error);
                    scannerResult.innerHTML = `<div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i> Scanner initialization failed. Please try again or use a different browser.
                    </div>`;
                    scannerResult.classList.remove('d-none');
                    return false;
                }
            }
            
            // Don't initialize in background to avoid memory issues
            
            // Handle file selection change
            idScannerInput.addEventListener('change', function() {
                if (scanIdButton && this.files && this.files[0]) {
                    const file = this.files[0];
                    
                    // Early screenshot detection based on filename
                    const fileName = file.name.toLowerCase();
                    const screenshotPatterns = [
                        'screenshot', 'screen shot', 'screen_capture', 'screen-capture',
                        'snapshot', 'snap', 'capture', 'img_', 'photo_', 'image_',
                        'scrn', 'scr', 'pic_', 'picture_'
                    ];
                    
                    const isScreenshotFilename = screenshotPatterns.some(pattern => 
                        fileName.includes(pattern)
                    );
                    
                    // Show warning if screenshot filename detected
                    if (isScreenshotFilename && scannerResult) {
                        scannerResult.innerHTML = `<div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle me-2"></i> 
