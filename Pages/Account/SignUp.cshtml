            // ========== IMAGE QUALITY VALIDATION FUNCTIONS ==========
            
            /**
             * Validate image quality before uploading
             */
            async function validateImageQuality(file) {
                return new Promise((resolve, reject) => {
                    const img = new Image();
                    const reader = new FileReader();
                    
                    reader.onload = function(e) {
                        img.onload = function() {
                            const results = {
                                isValid: true,
                                errors: [],
                                warnings: []
                            };
                            
                            // ========== PHILIPPINE ID DOCUMENT VALIDATION ==========
                            // Check filename for screenshot patterns
                            const fileName = file.name.toLowerCase();
                            const screenshotPatterns = [
                                'screenshot', 'screen shot', 'screen_capture', 'screen-capture',
                                'snapshot', 'snap', 'capture', 'img_', 'photo_', 'image_',
                                'scrn', 'scr', 'pic_', 'picture_'
                            ];
                            
                            const isScreenshotFilename = screenshotPatterns.some(pattern => 
                                fileName.includes(pattern)
                            );
                            
                            // Check image characteristics
                            const aspectRatio = img.width / img.height;
                            const isPortrait = img.height > img.width;
                            const isLandscape = img.width > img.height;
                            
                            // Philippine ID cards typically have these aspect ratios:
                            // - Portrait IDs: ~0.6 to 0.7 (height/width) or ~1.4 to 1.6 (width/height)
                            // - Landscape IDs: ~1.4 to 1.6 (width/height) or ~0.6 to 0.7 (height/width)
                            // Screenshots typically have wide ratios: 1.5 to 2.0 (16:9, 16:10)
                            
                            const isWideScreenRatio = aspectRatio >= 1.5 && aspectRatio <= 2.0; // Common screen ratios (reject)
                            const isVeryWideRatio = aspectRatio > 2.0 || aspectRatio < 0.5; // Too extreme (reject)
                            const isVeryHighRes = img.width >= 1920 || img.height >= 1080;
                            const isLargeFileForRes = file.size > 1000000 && (img.width * img.height) < 5000000;
                            
                            // Check for common screen resolutions (screenshots)
                            const commonScreenResolutions = [
                                { w: 1920, h: 1080 }, { w: 2560, h: 1440 }, { w: 3840, h: 2160 },
                                { w: 1366, h: 768 }, { w: 1440, h: 900 }, { w: 1680, h: 1050 },
                                { w: 1280, h: 720 }, { w: 1600, h: 900 }, { w: 1024, h: 768 }
                            ];
                            
                            const matchesCommonResolution = commonScreenResolutions.some(res => 
                                (Math.abs(img.width - res.w) < 50 && Math.abs(img.height - res.h) < 50) ||
                                (Math.abs(img.width - res.h) < 50 && Math.abs(img.height - res.w) < 50)
                            );
                            
                            // Check for ID card-like aspect ratios (acceptable)
                            // Portrait ID: height > width, ratio around 1.4-1.6
                            // Landscape ID: width > height, ratio around 1.4-1.6
                            const idPortraitRatio = isPortrait && aspectRatio >= 0.6 && aspectRatio <= 0.8;
                            const idLandscapeRatio = isLandscape && aspectRatio >= 1.4 && aspectRatio <= 1.7;
                            const idSquareRatio = aspectRatio >= 0.9 && aspectRatio <= 1.1; // Square-ish (some IDs)
                            const hasIdLikeRatio = idPortraitRatio || idLandscapeRatio || idSquareRatio;
                            
                            // Scoring system for rejection
                            let rejectionScore = 0;
                            if (isScreenshotFilename) rejectionScore += 4; // Strong indicator
                            if (matchesCommonResolution) rejectionScore += 3; // Very likely screenshot
                            if (isWideScreenRatio && isVeryHighRes) rejectionScore += 3; // Screen ratio + high res
                            if (isVeryWideRatio) rejectionScore += 2; // Too extreme to be an ID
                            if (isLargeFileForRes && isWideScreenRatio) rejectionScore += 1;
                            
                            // Reject if score is high OR if it doesn't look like an ID document
                            if (rejectionScore >= 3) {
                                results.isValid = false;
                                results.errors.push('⚠️ This does not appear to be an actual Philippine ID document.');
                                results.errors.push('Please upload a photo of your actual Philippine ID (Driver\'s License, National ID, PhilHealth ID, Postal ID, etc.).');
                                results.errors.push('Screenshots, photos of screens, or other documents are not accepted.');
                                resolve(results);
                                return;
                            }
                            
                            // Warn if aspect ratio doesn't match typical ID cards (but allow it to proceed)
                            // The backend OCR will do final validation by checking for Philippine ID markers
                            if (!hasIdLikeRatio && !isWideScreenRatio) {
                                results.warnings.push('Image aspect ratio may not match typical ID documents. Please ensure you are uploading an actual Philippine ID.');
                            }
                            
                            // Check resolution
                            if (img.width < 600 || img.height < 400) {
                                results.isValid = false;
                                results.errors.push(`Resolution too low (${img.width}x${img.height}). Minimum: 600x400 pixels.`);
                            }
                            
                            // Check file size
                            if (file.size < 50000) {
                                results.warnings.push('Image file very small (may indicate low quality).');
                            }
                            
                            resolve(results);
                        };
                        
                        img.onerror = function() {
                            reject(new Error('Failed to load image. File may be corrupted.'));
                        };
                        
                        img.src = e.target.result;
                    };
                    
                    reader.onerror = function() {
                        reject(new Error('Failed to read file.'));
                    };
                    
                    reader.readAsDataURL(file);
                });
