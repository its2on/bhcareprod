                    // Validation Methods
                    async validateUsername() {
                        return true;
                    }

                    async validateEmail() {
                        const input = document.getElementById('Input_Email');
                        const value = input?.value?.trim();
                        
                        if (!value) {
                            this.showError('email', 'Email address is required');
                            return false;
                        }
                        
                        const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                        if (!emailRegex.test(value)) {
                            this.showError('email', 'Please enter a valid email address');
                            return false;
                        }
                        
                        // Check if email already exists via AJAX
                        try {
                            const response = await fetch(`/Account/SignUp?handler=CheckEmail&email=${encodeURIComponent(value)}`);
                            const data = await response.json();
                            
                            if (data.exists) {
                                this.showError('email', 'An account with this email address already exists. Please use a different email or try logging in.');
                                return false;
                            }
                        } catch (error) {
                            console.error('Error checking email:', error);
                        }
                        
                        this.clearError('email');
                        return true;
                    }

                    validateName(field) {
                        const input = document.getElementById(`Input_${field}`);
                        const value = input?.value?.trim();
                        
                        if (!value) {
                            this.showError(field.toLowerCase(), `${field} is required`);
                            return false;
                        }
                        
                        if (value.length < 2) {
                            this.showError(field.toLowerCase(), `${field} must be at least 2 characters long`);
                            return false;
                        }
                        
                        const namePattern = /^[a-zA-Z\s'\-]+$/;
                        if (!namePattern.test(value)) {
                            this.showError(field.toLowerCase(), `${field} can only contain letters, spaces, hyphens, and apostrophes`);
                            return false;
                        }
                        
                        // Prevent spam: check for excessive repetition
                        if (this.hasExcessiveRepetition(value, 3)) {
                            this.showError(field.toLowerCase(), `${field} contains too many repeated characters`);
                            return false;
                        }
                        
                        this.clearError(field.toLowerCase());
                        return true;
                    }

                    async validateContactNumber() {
                        const input = document.getElementById('Input_ContactNumber');
                        const value = input?.value?.trim();
                        
                        if (!value) {
                            this.showError('contactNumber', 'Contact number is required');
                            return false;
                        }
                        
                        // Allow only digits, spaces, hyphens, parentheses, and plus sign
                        const phonePattern = /^[0-9\s()+-]+$/;
                        if (!phonePattern.test(value)) {
                            this.showError('contactNumber', 'Contact number can only contain digits and formatting characters (+, -, (), spaces)');
                            return false;
                        }
                        
                        // Remove all non-digit characters for validation
                        const digits = value.replace(/\D/g, '');
                        
                        if (digits.length < 10 || digits.length > 13) {
                            this.showError('contactNumber', 'Contact number must be 10-13 digits long');
                            return false;
                        }
                        
                        // Check for dummy numbers (all same digits)
                        const sameDigitPattern = /^(\d)\1+$/;
                        if (sameDigitPattern.test(digits)) {
                            this.showError('contactNumber', 'Please enter a valid contact number');
                            return false;
                        }
                        
                        // Prevent spam: check for excessive repetition in original value
                        if (this.hasExcessiveRepetition(digits, 4)) {
                            this.showError('contactNumber', 'Contact number contains too many repeated digits');
                            return false;
                        }
                        
                        // Check if contact number already exists via AJAX
                        try {
                            const response = await fetch(`/Account/SignUp?handler=CheckContactNumber&contactNumber=${encodeURIComponent(value)}`);
                            const data = await response.json();
                            
                            if (data.exists) {
                                this.showError('contactNumber', 'This contact number is already registered. Please use a different number.');
                                return false;
                            }
                        } catch (error) {
                            console.error('Error checking contact number:', error);
                        }
                        
                        this.clearError('contactNumber');
                        return true;
                    }

                    validateAddress() {
                        const input = document.getElementById('Input_Address');
                        const value = input?.value?.trim();
                        
                        if (!value) {
                            this.showError('address', 'Complete address is required');
                            return false;
                        }
                        
                        if (value.length < 10) {
                            this.showError('address', 'Please provide a more detailed address');
                            return false;
                        }
                        
                        // Allow letters, numbers, spaces, and common address punctuation
                        const addressPattern = /^[a-zA-Z0-9\s.,#@@'\-/()]+$/;
                        if (!addressPattern.test(value)) {
                            this.showError('address', 'Address contains invalid characters');
                            return false;
                        }
                        
                        // Prevent spam: check for excessive repetition
                        if (this.hasExcessiveRepetition(value, 4)) {
                            this.showError('address', 'Address contains too many repeated characters');
                            return false;
                        }
                        
                        this.clearError('address');
                        return true;
                    }

                    validateBirthDate() {
                        const input = document.getElementById('Input_BirthDate');
                        const value = input?.value;
                        
                        if (!value) {
                            this.showError('birthDate', 'Birth date is required');
                            return false;
                        }
                        
                        const birthDate = new Date(value);
                        const today = new Date();
                        const age = today.getFullYear() - birthDate.getFullYear();
                        
                        if (birthDate > today) {
                            this.showError('birthDate', 'Birth date cannot be in the future');
                            return false;
                        }
                        
                        if (age > 120) {
                            this.showError('birthDate', 'Please enter a valid birth date');
                            return false;
                        }
                        
                        this.clearError('birthDate');
                        return true;
                    }

                    validateGender() {
                        const genderInputs = document.querySelectorAll('input[name="Input.Gender"]:checked');
                        
                        if (genderInputs.length === 0) {
                            this.showError('gender', 'Please select your gender');
                            return false;
                        }
                        
                        this.clearError('gender');
                        return true;
                    }

                    validatePassword() {
                        const input = document.getElementById('password');
                        const value = input?.value;
                        
                        if (!value) {
                            this.showError('password', 'Password is required');
                            this.updatePasswordRequirements(value);
                            return false;
                        }
                        
                        if (value.length < 8) {
                            this.showError('password', 'Password must be at least 8 characters long');
                            this.updatePasswordRequirements(value);
                            return false;
                        }
                        
                        const hasUpperCase = /[A-Z]/.test(value);
                        const hasLowerCase = /[a-z]/.test(value);
                        const hasNumbers = /\d/.test(value);
                        const hasSpecialChar = /[!@@#$%^&*(),.?":{}|<>]/.test(value);
                        
                        // Update password requirements visual indicators
                        this.updatePasswordRequirements(value);
                        
                        if (!hasUpperCase || !hasLowerCase || !hasNumbers || !hasSpecialChar) {
                            this.showError('password', 'Password must contain uppercase, lowercase, number, and special character');
                            return false;
                        }
                        
                        this.clearError('password');
                        return true;
                    }

                    updatePasswordRequirements(password) {
                        if (!password) {
                            password = '';
                        }
                        
                        const requirements = {
                            length: password.length >= 8,
                            uppercase: /[A-Z]/.test(password),
                            lowercase: /[a-z]/.test(password),
                            number: /\d/.test(password),
                            special: /[!@@#$%^&*(),.?":{}|<>]/.test(password)
                        };
                        
                        // Update visual indicators
                        Object.keys(requirements).forEach(req => {
                            const element = document.getElementById(req);
                            if (element) {
                                const icon = element.querySelector('i');
                                if (requirements[req]) {
                                    icon.className = 'fas fa-check text-success me-1';
                                } else {
                                    icon.className = 'fas fa-times text-danger me-1';
                                }
                            }
                        });
                        
                        // Update password strength indicator
                        this.updatePasswordStrength(password);
                        
                        // Update Next button state based on requirements
                        this.updateNextButtonState();
                    }

                    updateNextButtonState() {
                        const nextButton = document.getElementById('nextToVerification');
                        if (!nextButton) return;
                        
                        const password = document.getElementById('password')?.value;
                        const confirmPassword = document.getElementById('confirmPassword')?.value;
                        
                        const allRequirementsMet = this.checkAllPasswordRequirements(password);
                        const passwordsMatch = password && confirmPassword && password === confirmPassword;
                        
                        if (allRequirementsMet && passwordsMatch) {
                            nextButton.disabled = false;
                            nextButton.classList.remove('btn-secondary');
                            nextButton.classList.add('btn-primary');
                        } else {
                            nextButton.disabled = true;
                            nextButton.classList.remove('btn-primary');
                            nextButton.classList.add('btn-secondary');
                        }
                    }

                    updateRegisterButtonState() {
                        const registerButton = document.getElementById('signupButton');
                        if (!registerButton) return;
                        
                        const fileValid = this.validateFile();
                        const termsChecked = document.getElementById('privacyTerms')?.checked;
                        const residencyChecked = document.getElementById('residencyConfirm')?.checked;
                        
                        const allValid = fileValid && termsChecked && residencyChecked;
                        
                        if (allValid) {
                            registerButton.disabled = false;
                            registerButton.classList.remove('btn-secondary');
                            registerButton.classList.add('btn-primary');
                            registerButton.innerHTML = '<i class="fas fa-user-plus me-2"></i> Register Account';
                        } else {
                            registerButton.disabled = true;
                            registerButton.classList.remove('btn-primary');
                            registerButton.classList.add('btn-secondary');
                            registerButton.innerHTML = '<i class="fas fa-user-plus me-2"></i> Register Account';
                        }
                    }

                    updatePasswordStrength(password) {
                        const strengthElement = document.getElementById('passwordStrength');
                        const strengthTextElement = document.querySelector('.password-strength-text');
                        
                        if (!password) {
                            if (strengthElement) strengthElement.style.width = '0%';
                            if (strengthTextElement) strengthTextElement.textContent = 'Too weak';
                            return;
                        }
                        
                        const requirements = {
                            length: password.length >= 8,
                            uppercase: /[A-Z]/.test(password),
                            lowercase: /[a-z]/.test(password),
                            number: /\d/.test(password),
                            special: /[!@@#$%^&*(),.?":{}|<>]/.test(password)
                        };
                        
                        const metRequirements = Object.values(requirements).filter(Boolean).length;
                        const strengthPercentage = (metRequirements / 5) * 100;
                        
                        if (strengthElement) {
                            strengthElement.style.width = strengthPercentage + '%';
                            
                            // Update color based on strength
                            strengthElement.className = 'progress-bar';
                            if (strengthPercentage < 40) {
                                strengthElement.classList.add('bg-danger');
                            } else if (strengthPercentage < 80) {
                                strengthElement.classList.add('bg-warning');
                            } else {
                                strengthElement.classList.add('bg-success');
                            }
                        }
                        
                        if (strengthTextElement) {
                            if (strengthPercentage < 40) {
                                strengthTextElement.textContent = 'Very Weak';
                                strengthTextElement.className = 'password-strength-text text-danger';
                            } else if (strengthPercentage < 60) {
                                strengthTextElement.textContent = 'Weak';
                                strengthTextElement.className = 'password-strength-text text-warning';
                            } else if (strengthPercentage < 80) {
                                strengthTextElement.textContent = 'Fair';
                                strengthTextElement.className = 'password-strength-text text-warning';
                            } else {
                                strengthTextElement.textContent = 'Strong';
                                strengthTextElement.className = 'password-strength-text text-success';
                            }
                        }
                    }

                    validateConfirmPassword() {
                        const password = document.getElementById('password')?.value;
                        const confirmPassword = document.getElementById('confirmPassword')?.value;
                        
                        if (!confirmPassword) {
                            this.showError('confirmPassword', 'Please confirm your password');
                            return false;
                        }
                        
                        if (password !== confirmPassword) {
                            this.showError('confirmPassword', 'Passwords do not match');
                            return false;
                        }
                        
                        this.clearError('confirmPassword');
                        return true;
                    }

                    validateFile() {
                        const fileInput = document.getElementById('Input_ResidencyProof');
                        const file = fileInput?.files?.[0];
                        
                        if (!file) {
                            this.showError('file', 'Please upload your residency proof document');
                            return false;
                        }
                        
                        const allowedTypes = ['application/pdf', 'image/jpeg', 'image/jpg', 'image/png'];
                        if (!allowedTypes.includes(file.type)) {
                            this.showError('file', 'Please upload a PDF, JPG, or PNG file');
                            return false;
                        }
                        
                        const maxSize = 5 * 1024 * 1024; // 5MB
                        if (file.size > maxSize) {
                            this.showError('file', 'File size must be less than 5MB');
                            return false;
                        }
                        
                        this.clearError('file');
                        return true;
                    }

                    validateCheckboxes() {
                        const termsChecked = document.getElementById('privacyTerms')?.checked;
                        const residencyChecked = document.getElementById('residencyConfirm')?.checked;
                        
                        if (!termsChecked || !residencyChecked) {
                            this.showError('checkboxes', 'You must agree to the terms and confirm your residency');
                            return false;
                        }
                        
                        this.clearError('checkboxes');
                        return true;
                    }

                    // Step Validation Methods
                    async validateStep1() {
                        const emailValid = await this.validateEmail();
                        const contactNumberValid = await this.validateContactNumber();
                        const isValid = 
                            emailValid &&
                            this.validateName('FirstName') &&
                            this.validateName('LastName') &&
                            contactNumberValid &&
                            this.validateAddress() &&
                            this.validateBirthDate() &&
                            this.validateGender();
                        
                        // Don't show duplicate error - signup.js already handles this
                        return isValid;
                    }

                    validateStep2() {
                        const passwordValid = this.validatePassword();
                        const confirmPasswordValid = this.validateConfirmPassword();
                        
                        // Additional check: ensure ALL password requirements are met
                        const password = document.getElementById('password')?.value;
                        const allRequirementsMet = this.checkAllPasswordRequirements(password);
                        
                        const isValid = passwordValid && confirmPasswordValid && allRequirementsMet;
                        
                        // Don't show duplicate error - signup.js already handles this
                        
                        return isValid;
                    }

                    checkAllPasswordRequirements(password) {
                        if (!password) return false;
                        
                        const requirements = {
                            length: password.length >= 8,
                            uppercase: /[A-Z]/.test(password),
                            lowercase: /[a-z]/.test(password),
                            number: /\d/.test(password),
                            special: /[!@@#$%^&*(),.?":{}|<>]/.test(password)
                        };
                        
                        return Object.values(requirements).every(Boolean);
                    }

                    validateStep3() {
                        const fileValid = this.validateFile();
                        const checkboxesValid = this.validateCheckboxes();
                        
                        const isValid = fileValid && checkboxesValid;
                        
                        // Don't show duplicate error - validation feedback is already shown inline
                        
                        // Update register button state
                        this.updateRegisterButtonState();
                        
                        return isValid;
                    }

                    async validateAllSteps() {
                        const step1Valid = await this.validateStep1();
                        return step1Valid && this.validateStep2() && this.validateStep3();
                    }

                    // UI Helper Methods
                    showError(field, message) {
                        const errorElement = document.getElementById(`${field}Error`);
                        const inputElement = document.querySelector(`[id*="${field}"], [name*="${field}"]`);
                        
                        if (errorElement) {
                            errorElement.textContent = message;
                            errorElement.style.display = 'block';
                        }
                        
                        if (inputElement) {
                            inputElement.classList.add('is-invalid');
                            inputElement.classList.remove('is-valid');
                        }
                        
                        this.validationErrors[field] = message;
                    }

                    clearError(field) {
                        const errorElement = document.getElementById(`${field}Error`);
                        const inputElement = document.querySelector(`[id*="${field}"], [name*="${field}"]`);
                        
                        if (errorElement) {
                            errorElement.style.display = 'none';
                        }
                        
                        if (inputElement) {
                            inputElement.classList.remove('is-invalid');
                            inputElement.classList.add('is-valid');
                        }
                        
                        delete this.validationErrors[field];
                    }

                    // Anti-spam validation: detect excessive character repetition
                    hasExcessiveRepetition(value, maxRepeat = 3) {
                        if (!value) return false;
                        
                        // Check for consecutive repeated characters (e.g., "aaaa", "dddd")
                        const consecutivePattern = new RegExp(`(.)\\1{${maxRepeat},}`, 'i');
                        if (consecutivePattern.test(value)) {
                            return true;
                        }
                        
                        // Check for alternating patterns (e.g., "adadad", "121212")
                        const alternatingPattern = /(.)(.)\1\2\1\2/;
                        if (alternatingPattern.test(value)) {
                            return true;
                        }
                        
                        // Check for repeated patterns (e.g., "abcabc")
                        const patternRepeatRegex = /(.{2,})\1{2,}/;
                        if (patternRepeatRegex.test(value)) {
                            return true;
                        }
                        
                        return false;
                    }

                    showStepError(message) {
                        // Create or update step error alert
                        let alertElement = document.getElementById('stepErrorAlert');
                        if (!alertElement) {
                            alertElement = document.createElement('div');
                            alertElement.id = 'stepErrorAlert';
                            alertElement.className = 'alert alert-danger mt-3';
                            alertElement.innerHTML = `<i class="fas fa-exclamation-triangle me-2"></i><span id="stepErrorMessage">${message}</span>`;
                            
                            // Insert after the current step content
                            const currentSection = document.getElementById(`section${this.currentStep}`);
                            if (currentSection) {
                                currentSection.appendChild(alertElement);
                            }
                        } else {
                            document.getElementById('stepErrorMessage').textContent = message;
                        }
                        
                        // Auto-hide after 5 seconds
                        setTimeout(() => {
                            if (alertElement) {
                                alertElement.remove();
                            }
                        }, 5000);
                    }

                    showValidationSummary() {
                        // Validation errors are already shown inline - no need for summary
                    }

                    goToStep(stepNumber) {
                        // Hide all steps
                        document.querySelectorAll('.step-content').forEach(step => {
                            step.classList.remove('active');
                        });
                        
                        // Show selected step
                        const targetStep = document.getElementById(`step${stepNumber}`);
                        if (targetStep) {
                            targetStep.classList.add('active');
                        }
                        
                        // Update step indicators
                        document.querySelectorAll('.step-indicator').forEach((indicator, index) => {
                            if (index + 1 < stepNumber) {
                                indicator.classList.add('completed');
                                indicator.classList.remove('active');
                            } else if (index + 1 === stepNumber) {
                                indicator.classList.add('active');
                                indicator.classList.remove('completed');
                            } else {
                                indicator.classList.remove('active', 'completed');
                            }
                        });
                        
                        this.currentStep = stepNumber;
                        
                        // Update button states based on current step
                        if (stepNumber === 1) {
                            setTimeout(() => this.updateStep1NextButtonState(), 100);
                        } else if (stepNumber === 2) {
                            this.updateNextButtonState();
                        } else if (stepNumber === 3) {
                            this.updateRegisterButtonState();
                        }
                        
                        const progressText = document.getElementById('progressText');
                        if (progressText) {
                            const stepTexts = {
                                1: 'Step 1: Personal Information',
                                2: 'Step 2: Account Security',
                                3: 'Step 3: Residency Verification'
                            };
                            progressText.textContent = stepTexts[stepNumber] || '';
                        }
                        
                        this.currentStep = stepNumber;
                        
                        // Remove any existing step error alerts
                        const existingAlert = document.getElementById('stepErrorAlert');
                        if (existingAlert) {
                            existingAlert.remove();
                        }
                    }
                }

