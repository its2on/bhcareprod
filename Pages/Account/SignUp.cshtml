                            if (registerButton && window.signUpValidator) {
                                window.signUpValidator.updateRegisterButtonState();
                            } else if (registerButton) {
                                // Directly check and enable button if conditions are met
                                const termsChecked = document.getElementById('privacyTerms')?.checked;
                                const residencyChecked = document.getElementById('residencyConfirm')?.checked;
                                // Note: File validation is for step 3 which was removed, so we skip it
                                if (termsChecked && residencyChecked) {
                                    registerButton.disabled = false;
                                    registerButton.classList.remove('btn-secondary');
                                    registerButton.classList.add('btn-primary');
                                    registerButton.innerHTML = '<i class="fas fa-user-plus me-2"></i> Register Account';
                                    registerButton.title = '';
                                }
                            }
                        } else if (result.isBarangayValid && result.autoApproved) {
                            // For barangays 158 and 161, also set the hidden field and show verification status
                            const ocrBarangayInput = document.getElementById('OcrDetectedBarangay');
                            if (ocrBarangayInput && result.barangay) {
                                ocrBarangayInput.value = result.barangay;
                                console.log('✅ Set OcrDetectedBarangay to:', result.barangay);
                            }
                            
                            // Remove non-eligible barangay flag if exists
                            const nonEligibleBarangayInput = document.getElementById('NonEligibleBarangayDetected');
                            if (nonEligibleBarangayInput) {
                                nonEligibleBarangayInput.remove();
                            }
                            if (window.signUpValidator) {
                                window.signUpValidator.updateRegisterButtonState();
                            }
                            
                            notificationMessage = `<div class="mt-1"><small class="text-success"><i class="fas fa-check-circle me-1"></i>Eligible barangay detected (${result.barangay}) - account will be auto-approved!</small></div>`;
                        } else if (result.barangay && !result.isBarangayValid) {
                            alertClass = 'alert-warning';
                            notificationMessage = `<div class="mt-1"><small class="text-warning"><i class="fas fa-exclamation-triangle me-1"></i>Barangay ${result.barangay} detected but not eligible (must be 158, 159, 160, or 161). Please select a valid barangay.</small></div>`;
                        } else if (!result.barangay) {
                            alertClass = 'alert-warning';
                            notificationMessage = `<div class="mt-1"><small class="text-warning"><i class="fas fa-exclamation-triangle me-1"></i>Unable to verify residency. No valid Barangay number (158, 159, 160, 161) found in the document.</small></div>`;
                        }
                        
                        if (showVerificationStatus) {
                            // Show verification status indicator (old style) for barangays 159-160
                            let extractedHtml = '';
                            if (filledFields.length > 0) {
                                extractedHtml += `<div class="alert alert-info mb-2">
                                    <div class="mt-2"><small><strong>Auto-filled fields:</strong> ${filledFields.join(', ')}</small></div>
                                    <div class="mt-1"><small class="text-muted"><i class="fas fa-info-circle me-1"></i>Please verify the auto-filled information before submitting.</small></div>
                                </div>`;
                            }
                            extractedHtml += notificationMessage;
                            scannerResult.innerHTML = extractedHtml;
                            scannerResult.classList.remove('d-none');
                        } else if (filledFields.length > 0 || notificationMessage) {
                            let extractedHtml = `<div class="alert ${alertClass}">`;
                            if (filledFields.length > 0) {
                                extractedHtml += `<div class="mt-2"><small><strong>Auto-filled fields:</strong> ${filledFields.join(', ')}</small></div>`;
                            }
                            extractedHtml += notificationMessage;

                            // If critical fields were not detected from the ID, show a clear hint
                            const missingFromId = [];
                            if (result && result.hasBirthDateFromId === false) {
                                missingFromId.push('Birth Date');
                            }
                            if (result && result.hasGenderFromId === false) {
                                missingFromId.push('Gender');
                            }
                            if (result && result.hasMiddleNameFromId === false) {
                                missingFromId.push('Middle Name');
                            }

                            extractedHtml += '<div class="mt-1"><small class="text-muted">'
                                + '<i class="fas fa-info-circle me-1"></i>'
                                + 'Please verify the auto-filled information before submitting.'
                                + '</small></div>';

                            if (missingFromId.length > 0) {
                                extractedHtml += `<div class="mt-1"><small class="text-warning">`
                                    + `<i class="fas fa-exclamation-triangle me-1"></i>`
                                    + `The following fields were <strong>not detected from the ID image</strong> and must be entered manually: ${missingFromId.join(', ')}.`
                                    + `</small></div>`;
                            }

                            extractedHtml += '</div>';
                            scannerResult.innerHTML = extractedHtml;
                            scannerResult.classList.remove('d-none');
                        } else {
                            // Hide result if nothing was filled
                            scannerResult.innerHTML = '';
                            scannerResult.classList.add('d-none');
                        }
                    } else {
                        // Handle backend validation errors (e.g., not a Philippine ID)
                        const errorMsg = result.message || result.errorDetails || 'OCR processing failed';
                        const isInvalidDocument = errorMsg.includes('Invalid document') || 
                                                  errorMsg.includes('not a valid Philippine ID') ||
                                                  errorMsg.includes('screenshot') ||
                                                  errorMsg.includes('actual Philippine ID');
                        
                        if (isInvalidDocument) {
                            throw new Error(`PHILIPPINE_ID_REQUIRED: ${errorMsg}`);
                        } else {
                            throw new Error(errorMsg);
