                    // Format error message with line breaks
                    const formattedMessage = errorMessage.replace(/\n/g, '<br>').replace(/•/g, '&bull;');
                    
                    scannerResult.innerHTML = `<div class="alert alert-danger">
                        <strong><i class="fas fa-exclamation-circle me-2"></i> ${errorTitle}</strong>
                        <div class="mt-2" style="white-space: pre-line;">${formattedMessage}</div>
                        ${tipMessage ? `<div class="small mt-2 pt-2 border-top">${tipMessage}</div>` : ''}
                        <div class="mt-3">
                            <button type="button" class="btn btn-sm btn-outline-primary me-2" 
                                    onclick="document.getElementById('idScannerInput').click()">
