                const middleNamePattern = /(MIDDLE\s*NAME|GITNANG\s*APELYIDO)[:\-\s\/]+([A-Z][A-Z\s]+?)(?:\n|$)/i;
                
                // Pattern 5: "Last Name, First Name, Middle Name" format
                const fullNameCommaPattern = /^([A-Z]{2,}),\s*([A-Z\s]+),\s*([A-Z\s]+)$/;
                
                // Helper function to validate if extracted value is not just a label
                function isValidNameValue(value) {
                    if (!value) return false;
                    const upper = value.toUpperCase().trim();
                    
                    // Skip if it's just a label phrase
                    const labelPhrases = [
                        'GIVEN NAME', 'GIVEN NAMES', 'FIRST NAME', 'LAST NAME', 'MIDDLE NAME',
                        'SURNAME', 'APELYIDO', 'MGA PANGALAN', 'GITNANG APELYIDO',
                        'FAMILY NAME', 'UNANG PANGALAN'
                    ];
                    
                    if (labelPhrases.some(phrase => upper === phrase || upper === phrase + 'S')) {
                        return false;
                    }
                    
                    // Skip if it contains a period followed by space (indicates multiple labels)
                    if (value.includes('. ')) {
                        return false;
                    }
                    
                    // Must have at least 2 characters
                    return value.length >= 2;
                }
                
                // Try to find name from lines
                for (let i = 0; i < lines.length; i++) {
                    const line = lines[i];
                    const upperLine = line.toUpperCase();
                    
                    // Skip lines that are just label headers (e.g., "Last Name. First Name. Middle Name")
                    if (upperLine.match(/LAST\s*NAME.*FIRST\s*NAME.*MIDDLE\s*NAME/i) ||
                        upperLine.match(/APELYIDO.*PANGALAN.*GITNANG/i)) {
                        console.log('Skipping label header line:', line);
                        continue;
                    }
                    
                    // Check for labeled surname
                    if (!result.lastName) {
                        const surnameMatch = upperLine.match(surnamePattern);
                        if (surnameMatch && isValidNameValue(surnameMatch[2])) {
                            result.lastName = surnameMatch[2].trim();
                            console.log('Found surname:', result.lastName);
                        }
                    }
                    
                    // Check for labeled given name
                    if (!result.firstName) {
                        const givenMatch = upperLine.match(givenNamePattern);
                        if (givenMatch && isValidNameValue(givenMatch[2])) {
                            result.firstName = givenMatch[2].trim();
                            console.log('Found given name:', result.firstName);
                        }
                    }
                    
                    // Check for labeled middle name
                    if (!result.middleName) {
                        const middleMatch = upperLine.match(middleNamePattern);
                        if (middleMatch && isValidNameValue(middleMatch[2])) {
                            result.middleName = middleMatch[2].trim();
                            console.log('Found middle name:', result.middleName);
                        }
                    }
                    
                    // Check for "Last Name, First Name Middle Name" format (Driver's License)
                    // But skip if previous line was a label header
                    if (!result.lastName && !result.firstName) {
                        const commaMatch = line.match(nameCommaPattern);
                        if (commaMatch && isValidNameValue(commaMatch[1])) {
                            result.lastName = commaMatch[1].trim();
                            const firstAndMiddle = commaMatch[2].trim().split(/\s+/);
                            result.firstName = firstAndMiddle[0];
                            if (firstAndMiddle.length > 1) {
                                result.middleName = firstAndMiddle.slice(1).join(' ');
                            }
                            console.log('Found comma format name:', result);
                        }
                    }
                    
                    // Check for "Last, First, Middle" format
                    if (!result.lastName && !result.firstName && !result.middleName) {
                        const fullCommaMatch = line.match(fullNameCommaPattern);
                        if (fullCommaMatch && isValidNameValue(fullCommaMatch[1])) {
                            result.lastName = fullCommaMatch[1].trim();
                            result.firstName = fullCommaMatch[2].trim();
                            result.middleName = fullCommaMatch[3].trim();
                            console.log('Found full comma format:', result);
                        }
                    }
                }
                
                // ========== ADDRESS DETECTION ==========
                const addressKeywords = ['BLK', 'LOT', 'HOUSE', 'ST', 'STREET', 'BARANGAY', 'BRGY', 'CITY', 'PROVINCE', 'REGION', 'ZONE', 'PHASE', 'PUROK', 'SITIO'];
                const addressLines = [];
                let addressStarted = false;
                
                // Skip fields that should NOT be treated as address
                const skipPatterns = [
                    /LAST\s*NAME|SURNAME|APELYIDO/i,
                    /FIRST\s*NAME|GIVEN|PANGALAN/i,
                    /MIDDLE\s*NAME|GITNANG/i,
                    /NATIONALITY|NASYONALIDAD/i,
                    /LICENSE|LISENSYA/i
                ];
                
                for (let i = 0; i < lines.length; i++) {
                    const line = lines[i];
                    const upperLine = line.toUpperCase();
                    
                    // Skip if line contains name-related keywords
                    if (skipPatterns.some(pattern => pattern.test(upperLine))) {
                        continue;
                    }
                    
                    // Skip comma-separated name format (e.g., "LOPEZ, ANTHONY JR LLONA")
                    if (upperLine.match(/^[A-Z]{2,},\s*[A-Z\s]+$/)) {
                        continue;
                    }
                    
                    // Check if line contains address label (English or Filipino)
                    if ((upperLine.includes('ADDRESS') || upperLine.includes('TIRAHAN')) && upperLine.includes(':')) {
                        // Address value might be on same line or next line
                        const parts = line.split(':');
                        if (parts.length > 1 && parts[1].trim().length > 0) {
                            const addrPart = parts[1].trim();
                            // Only add if it's not a name format
                            if (!addrPart.match(/^[A-Z]{2,},\s*[A-Z\s]+$/)) {
                                addressLines.push(addrPart);
                            }
                        }
                        addressStarted = true;
                        continue;
                    }
                    
                    // If address started or line contains address keywords
                    if (addressStarted || addressKeywords.some(kw => upperLine.includes(kw))) {
                        // Skip if it looks like a label line or other field
                        if (upperLine.match(/^(BIRTH|DATE|SEX|GENDER|HEIGHT|WEIGHT|BLOOD|PETSA|KASARIAN|EXPIRATION|AGENCY|CODE|RESTRICTIONS|CONDITIONS)/i)) {
                            addressStarted = false;
                            break;
                        }
                        
                        // Skip lines with metadata: expiration dates, codes, etc.
                        if (upperLine.match(/EXPIRATION|AGENCY\s*CODE|RESTRICTIONS|CONDITIONS|LICENSE\s*NO/i)) {
                            addressStarted = false;
                            break;
                        }
                        
                        // Skip lines that look like dates (YYYY/MM/DD or similar)
                        if (line.match(/\d{4}[\/\-]\d{2}[\/\-]\d{2}/)) {
                            addressStarted = false;
                            break;
                        }
                        
                        // Skip lines that look like agency codes (e.g., N10-22-300176)
                        if (line.match(/[A-Z]\d{2}-\d{2}-\d{6}/)) {
                            addressStarted = false;
                            break;
                        }
                        
                        // Skip if it's just a name (no address characteristics)
                        if (!line.match(/\d+/) && !addressKeywords.some(kw => upperLine.includes(kw))) {
                            if (addressStarted && line.length > 10 && line.length < 50) {
                                // Might be second line of address (but not too long)
                                addressLines.push(line);
                            }
                            continue;
                        }
                        
                        // Add line if it has address characteristics
                        if (line.match(/\d+/) || addressKeywords.some(kw => upperLine.includes(kw))) {
                            addressLines.push(line);
                            addressStarted = true;
                        }
                        
                        // Stop if we collected enough address lines (reduced from 3 to 2)
                        if (addressLines.length >= 2) break;
                    }
                }
                
                if (addressLines.length > 0) {
                    // Clean up address: remove dates, codes, and extra metadata
                    let cleanAddress = addressLines.join(', ');
                    
                    // Remove expiration dates and codes
                    cleanAddress = cleanAddress.replace(/,\s*Expiration\s*Date[^,]*/gi, '');
                    cleanAddress = cleanAddress.replace(/,\s*Agency\s*Code[^,]*/gi, '');
                    cleanAddress = cleanAddress.replace(/,\s*[A-Z]\d{2}-\d{2}-\d{6}[^,]*/g, '');
                    cleanAddress = cleanAddress.replace(/,?\s*\d{4}[\/\-]\d{2}[\/\-]\d{2}/g, '');
                    
                    // Remove trailing commas and extra spaces
                    cleanAddress = cleanAddress.replace(/,\s*$/, '').trim();
                    
                    result.address = cleanAddress;
                    console.log('Found address:', result.address);
                }
                
                // ========== BIRTH DATE DETECTION ==========
                // Pattern: MM/DD/YYYY, DD/MM/YYYY, YYYY-MM-DD, or labeled (English or Filipino)
                const birthDatePatterns = [
                    /(BIRTH\s*DATE|DATE\s*OF\s*BIRTH|BIRTHDAY|PETSA\s*NG\s*KAPANGANAKAN|KAARAWAN)[:\-\s\/]*(\d{2}[\/\-]\d{2}[\/\-]\d{4})/i,
                    /\b(\d{2}[\/\-]\d{2}[\/\-]\d{4})\b/,
                    /\b(\d{4}[\/\-]\d{2}[\/\-]\d{2})\b/
                ];
                
                for (const pattern of birthDatePatterns) {
                    const match = text.match(pattern);
                    if (match) {
                        let dateStr = match[match.length - 1]; // Get the last capture group
                        
                        // Convert to YYYY-MM-DD format for HTML5 date input
                        if (dateStr.includes('/')) {
                            const parts = dateStr.split('/');
                            if (parts[0].length === 4) {
                                // YYYY/MM/DD
                                result.birthDate = dateStr.replace(/\//g, '-');
                            } else if (parts[2].length === 4) {
                                // MM/DD/YYYY or DD/MM/YYYY
                                // Assume MM/DD/YYYY (US format common in PH IDs)
                                result.birthDate = `${parts[2]}-${parts[0].padStart(2, '0')}-${parts[1].padStart(2, '0')}`;
                            }
                        } else if (dateStr.includes('-')) {
                            const parts = dateStr.split('-');
                            if (parts[0].length === 4) {
                                result.birthDate = dateStr;
                            } else {
                                // DD-MM-YYYY
                                result.birthDate = `${parts[2]}-${parts[1].padStart(2, '0')}-${parts[0].padStart(2, '0')}`;
                            }
                        }
                        
                        console.log('Found birth date:', result.birthDate);
                        break;
                    }
                }
                
                // ========== GENDER DETECTION ==========
                const genderPatterns = [
                    /(SEX|GENDER|KASARIAN)[:\-\s\/]*(M|F|MALE|FEMALE|LALAKI|BABAE)/i,
                    /\b(MALE|FEMALE|LALAKI|BABAE)\b/i
                ];
                
                for (const pattern of genderPatterns) {
                    const match = upperText.match(pattern);
                    if (match) {
                        const genderText = match[match.length - 1];
                        if (genderText.startsWith('M') || genderText.startsWith('L')) {
                            result.gender = 'Male';
                        } else if (genderText.startsWith('F') || genderText.startsWith('B')) {
                            result.gender = 'Female';
                        }
                        console.log('Found gender:', result.gender);
                        break;
                    }
                }
                
                // ========== BARANGAY DETECTION (158, 159, 160, 161) ==========
                const barangayPattern = /BARANGAY\s*(158|159|160|161)/i;
                const barangayMatch = upperText.match(barangayPattern);
                if (barangayMatch) {
                    result.barangay = barangayMatch[1];
                    console.log('Found barangay:', result.barangay);
                }
                
                console.log('Final parsed result:', result);
                return result;
            }
            
            // Handle scan button click with Azure OCR
            scanIdButton.addEventListener('click', async function() {
                if (!idScannerInput.files || !idScannerInput.files[0]) {
                    idScannerInput.click();
                    return;
                }
                
                const file = idScannerInput.files[0];
                
                // Basic file type validation (JPG and PNG only for Azure OCR)
                const validTypes = ['image/jpeg', 'image/jpg', 'image/png'];
                if (!validTypes.includes(file.type.toLowerCase())) {
                    scannerResult.innerHTML = `<div class="alert alert-danger">
                        <i class="fas fa-exclamation-circle me-2"></i> 
                        <strong>Invalid file type: ${file.type}</strong>
                        <p class="mb-0 mt-2">Please upload JPG or PNG images only.</p>
                    </div>`;
                    scannerResult.classList.remove('d-none');
                    return;
                }
                
                // File size validation (max 5MB for Azure OCR)
                if (file.size > 5 * 1024 * 1024) {
                    scannerResult.innerHTML = `<div class="alert alert-danger">
                        <i class="fas fa-exclamation-circle me-2"></i> 
                        <strong>File too large (${(file.size / 1024 / 1024).toFixed(1)}MB)</strong>
                        <p class="mb-0 mt-2">Maximum file size is 5MB. Please use a smaller image.</p>
                    </div>`;
                    scannerResult.classList.remove('d-none');
                    return;
                }
                
                scannerStatus.classList.remove('d-none');
                scannerResult.classList.add('d-none');
                scanIdButton.disabled = true;
                
                const progressBar = document.getElementById('scanProgressBar');
                const scanStatusText = document.getElementById('scanStatusText');
                
                try {
                    // Step 1: Validate image quality
                    scanStatusText.textContent = 'Validating image quality...';
                    progressBar.style.width = '10%';
                    
                    const validation = await validateImageQuality(file);
                    
                    if (!validation.isValid) {
                        let errorHtml = '<div class="alert alert-danger"><strong><i class="fas fa-exclamation-circle"></i> Image Quality Issues:</strong><ul class="mb-0 mt-2">';
                        validation.errors.forEach(error => {
                            errorHtml += `<li>${error}</li>`;
                        });
                        errorHtml += '</ul><div class="mt-2"><button type="button" class="btn btn-sm btn-primary" onclick="document.getElementById(\'idScannerInput\').click()"><i class="fas fa-camera me-1"></i> Retake Photo</button></div></div>';
                        
                        scannerResult.innerHTML = errorHtml;
                        scannerResult.classList.remove('d-none');
                        throw new Error('Image quality validation failed');
                    }
                    
                    // Step 2: Upload to Azure OCR
                    scanStatusText.textContent = 'Processing image...';
                    progressBar.style.width = '30%';
                    
                    console.log('Processing ID with Azure OCR:', file.name, file.type, file.size);
                    
                    // Create form data with the image
                    const formData = new FormData();
                    formData.append('idImage', file);
                    const idTypeField = document.querySelector('select[name="Input.GovernmentIdType"]');
                    if (idTypeField) {
                        formData.append('selectedIdType', idTypeField.value || '');
                    }
                    
                    // Add anti-forgery token for Razor Pages
                    const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]');
                    if (antiForgeryToken) {
                        formData.append('__RequestVerificationToken', antiForgeryToken.value);
                        console.log('Anti-forgery token added');
                    } else {
                        console.warn('Anti-forgery token not found on page');
                    }
                    
                    scanStatusText.textContent = 'Processing image...';
                    progressBar.style.width = '30%';
                    
                    // Call the Azure OCR handler
                    const response = await fetch('/Account/SignUp?handler=ScanId', {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'RequestVerificationToken': antiForgeryToken ? antiForgeryToken.value : ''
                        }
                    });
                    
                    progressBar.style.width = '60%';
                    scanStatusText.textContent = 'Processing with Azure Computer Vision (this may take a few minutes with enhanced recognition)...';
                    
                    progressBar.style.width = '80%';
                    scanStatusText.textContent = 'Analyzing results...';
                    
                    if (!response.ok) {
                        throw new Error(`Server error: ${response.status}`);
                    }
                    
                    // Parse the response
                    const result = await response.json();
                    console.log('Azure OCR response:', result);
                    
                    progressBar.style.width = '100%';
                    
                    if (result.success) {
                        // Enhanced auto-fill from Azure Vision OCR response
                        console.log('Azure Vision OCR response:', result);
                        
                        let filledFields = [];
                        
                        // Auto-fill First Name
                        if (result.firstName) {
                            // Try multiple selectors to find the field
                            let firstNameInput = document.querySelector('input[name="Input.FirstName"]') ||
                                                document.querySelector('input[id="Input_FirstName"]') ||
                                                document.querySelector('input[asp-for="Input.FirstName"]');
                            if (firstNameInput) {
                                firstNameInput.value = result.firstName;
                                // Trigger input event for validation
                                firstNameInput.dispatchEvent(new Event('input', { bubbles: true }));
                                firstNameInput.dispatchEvent(new Event('change', { bubbles: true }));
                                filledFields.push('First Name');
                                console.log('Filled First Name:', result.firstName);
                            } else {
                                console.error('First Name input not found');
                            }
                        }
                        
                        // Auto-fill Middle Name
                        if (result.middleName) {
                            let middleNameInput = document.querySelector('input[name="Input.MiddleName"]') ||
                                                  document.querySelector('input[id="Input_MiddleName"]');
                            if (middleNameInput) {
                                middleNameInput.value = result.middleName;
                                middleNameInput.dispatchEvent(new Event('input', { bubbles: true }));
                                middleNameInput.dispatchEvent(new Event('change', { bubbles: true }));
                                filledFields.push('Middle Name');
                                console.log('Filled Middle Name:', result.middleName);
                            }
                        }
                        
                        // Auto-fill Last Name
                        if (result.lastName) {
                            let lastNameInput = document.querySelector('input[name="Input.LastName"]') ||
                                                document.querySelector('input[id="Input_LastName"]');
                            if (lastNameInput) {
                                lastNameInput.value = result.lastName;
                                lastNameInput.dispatchEvent(new Event('input', { bubbles: true }));
                                lastNameInput.dispatchEvent(new Event('change', { bubbles: true }));
                                filledFields.push('Last Name');
                                console.log('Filled Last Name:', result.lastName);
                            }
                        }
                        
                        // Auto-fill Suffix
                        if (result.suffix) {
                            let suffixInput = document.querySelector('input[name="Input.Suffix"]') ||
                                              document.querySelector('input[id="Input_Suffix"]');
                            if (suffixInput) {
                                suffixInput.value = result.suffix;
                                suffixInput.dispatchEvent(new Event('input', { bubbles: true }));
                                suffixInput.dispatchEvent(new Event('change', { bubbles: true }));
                                filledFields.push('Suffix');
                                console.log('Filled Suffix:', result.suffix);
                            }
                        }
                        
                        // Auto-fill Contact Number
                        if (result.contactNumber) {
                            let contactNumberInput = document.querySelector('input[name="Input.ContactNumber"]') ||
                                                     document.querySelector('input[id="Input_ContactNumber"]');
                            if (contactNumberInput) {
                                contactNumberInput.value = result.contactNumber;
                                contactNumberInput.dispatchEvent(new Event('input', { bubbles: true }));
                                contactNumberInput.dispatchEvent(new Event('change', { bubbles: true }));
                                filledFields.push('Contact Number');
                                console.log('Filled Contact Number:', result.contactNumber);
                            }
                        }
                        
                        // Auto-fill Address
                        if (result.address) {
                            let addressInput = document.querySelector('textarea[name="Input.Address"]') ||
                                               document.querySelector('textarea[id="Input_Address"]') ||
                                               document.querySelector('input[name="Input.Address"]');
                            if (addressInput) {
                                addressInput.value = result.address;
                                addressInput.dispatchEvent(new Event('input', { bubbles: true }));
                                addressInput.dispatchEvent(new Event('change', { bubbles: true }));
                                filledFields.push('Address');
                                console.log('Filled Address:', result.address);
                            }
                            
                            // Store in hidden field for auto-approval
                            const ocrAddressInput = document.getElementById('OcrExtractedAddress');
                            if (ocrAddressInput) {
                                ocrAddressInput.value = result.address;
                            }
                        }
                        
                        // Auto-fill Birth Date
                        // Auto-fill Birth Date
                        if (result.birthDate) {
                            let birthDateInput = document.querySelector('input[name="Input.BirthDate"]') ||
                                                 document.querySelector('input[id="Input_BirthDate"]');
                            if (birthDateInput) {
                                let dateVal = result.birthDate.trim();
                                // convert common formats to ISO yyyy-mm-dd
                                const slashParts = dateVal.split(/[\/]/);
                                if (slashParts.length === 3) {
                                    if (slashParts[0].length === 4) { // yyyy/mm/dd
                                        dateVal = `${slashParts[0]}-${slashParts[1].padStart(2,'0')}-${slashParts[2].padStart(2,'0')}`;
                                    } else if (slashParts[2].length === 4) { // mm/dd/yyyy or dd/mm/yyyy
                                        dateVal = `${slashParts[2]}-${slashParts[0].padStart(2,'0')}-${slashParts[1].padStart(2,'0')}`;
                                    }
                                }
                                birthDateInput.value = dateVal;
                                birthDateInput.dispatchEvent(new Event('input', { bubbles: true }));
                                birthDateInput.dispatchEvent(new Event('change', { bubbles: true }));
                                filledFields.push('Birth Date');
                                console.log('Filled Birth Date:', dateVal);
                            }
                        }
                        
                        // Auto-fill Barangay
                        if (result.barangay) {
                                const barangaySelect = document.querySelector('select[name="Input.Barangay"]');
                                if (barangaySelect) {
                                    const option = Array.from(barangaySelect.options).find(opt => 
                                    opt.value === result.barangay || opt.text.includes(result.barangay)
                                );
                                if (option) {
                                    barangaySelect.value = option.value;
                                    filledFields.push('Barangay');
                                }
                            }
                            
                            // Store OCR-detected barangay in hidden field for auto-approval
                            const ocrBarangayInput = document.getElementById('OcrDetectedBarangay');
                            if (ocrBarangayInput) {
                                ocrBarangayInput.value = result.barangay;
                                console.log('Stored OCR-detected barangay:', result.barangay);
                            }
                        }
                        
                        // Store extracted text in hidden field
                        if (result.extractedText) {
                            const ocrTextInput = document.getElementById('OcrExtractedText');
                            if (ocrTextInput) {
                                ocrTextInput.value = result.extractedText;
                            }
                        }
                        
                        // Show success notification
                        let notificationMessage = '';
                        let alertClass = 'alert-success';
                        let showVerificationStatus = false;
                        
                        // Check if barangay 159 or 160 for auto-verification with old verification indicator style
                        if (result.isBarangayValid && result.autoApproved && (result.barangay === '159' || result.barangay === '160')) {
                            // Show old verification indicator style for barangays 159-160
                            showVerificationStatus = true;
                            notificationMessage = `<div class="alert alert-success">
                                <i class="fas fa-check-circle me-2"></i>
                                <strong>Residency Verified!</strong>
                                <div class="mt-2">Barangay ${result.barangay} detected - Your account will be automatically approved!</div>
                            </div>`;
                            
                            // Store detected barangay in hidden field for form submission
