                            }
                        });

                        // Step 2 now submits the form directly
                        document.getElementById('signupButton')?.addEventListener('click', async (e) => {
                            // Validate Step 2 (password) and checkboxes before submitting
                        const step2Valid = this.validateStep2();
                        const checkboxesValid = this.validateStep3(); // Checkboxes validation
                        const barangayVerified = this.isBarangayAutoVerified();
                            
                            // Log OCR-detected barangay value before submission
