                        }
                        
                        // Check if all Step 1 fields are filled
                        const email = document.getElementById('Input_Email')?.value?.trim();
                        const firstName = document.getElementById('Input_FirstName')?.value?.trim();
                        const lastName = document.getElementById('Input_LastName')?.value?.trim();
                        const contactNumber = document.getElementById('Input_ContactNumber')?.value?.trim();
                        const address = document.getElementById('Input_Address')?.value?.trim();
                        const birthDate = document.getElementById('Input_BirthDate')?.value;
