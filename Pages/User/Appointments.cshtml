@page
@model Barangay.Pages.User.AppointmentsModel
@{
    ViewData["Title"] = "My Appointments";
    ViewData["ShowDashboardNav"] = true;
    Layout = "_UserLayout";
}

@Html.AntiForgeryToken()

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="alert alert-info" role="alert">
                <div class="d-flex align-items-center">
                    <i class="fa-solid fa-calendar-check me-3 fs-4"></i>
                    <div>
                        <strong>My Appointments</strong>
                        <p class="mb-0">View and manage your scheduled appointments with our healthcare providers.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Elegant Accordion Appointments Section -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="appointments-container">
                <!-- Header with Book Appointment Button -->
                <div class="appointments-header mb-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="appointments-title mb-0">
                            <i class="fa-solid fa-calendar-check me-2"></i>
                            My Appointments
                        </h4>
                        <a href="/BookAppointment" class="btn btn-primary btn-book-appointment">
                            <i class="fa-solid fa-plus me-2"></i>Book New Appointment
                        </a>
                    </div>
                </div>

                <!-- Accordion Container -->
                <div class="accordion appointments-accordion" id="appointmentsAccordion" role="tablist" aria-multiselectable="true">
                    
                    <!-- Ongoing Appointments Section -->
                    <div class="accordion-item appointment-section" data-status="ongoing">
                        <h2 class="accordion-header" id="ongoingHeader">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" 
                                    data-bs-target="#ongoingCollapse" aria-expanded="false" aria-controls="ongoingCollapse"
                                    aria-label="Toggle ongoing appointments section">
                                <div class="section-header-content">
                                    <span class="section-title">Ongoing Appointments</span>
                                    <span class="badge ms-auto" style="background-color: #FFB380; color: white;" id="ongoingCount">0</span>
                                </div>
                            </button>
                        </h2>
                        <div id="ongoingCollapse" class="accordion-collapse collapse" aria-labelledby="ongoingHeader" 
                             data-bs-parent="#appointmentsAccordion">
                            <div class="accordion-body p-0">
                                <div class="table-container">
                                    <div class="table-responsive">
                                        <table class="table appointments-table mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Date & Time</th>
                                                    <th>Consultation Type</th>
                                                    <th>Reason for Visit</th>
                                                    <th>Status</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody id="ongoingAppointmentsTable">
                                                <!-- Dynamic content will be populated here -->
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="empty-state" id="ongoingEmptyState" style="display: none;">
                                        <div class="text-center py-5">
                                            <i class="fa-solid fa-clock fa-3x text-muted mb-3"></i>
                                            <h5 class="text-muted">No ongoing appointments</h5>
                                            <p class="text-muted">You don't have any appointments in progress at the moment.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Draft Appointments Section -->
                    <div class="accordion-item appointment-section" data-status="draft">
                        <h2 class="accordion-header" id="draftHeader">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" 
                                    data-bs-target="#draftCollapse" aria-expanded="false" aria-controls="draftCollapse"
                                    aria-label="Toggle draft appointments section">
                                <div class="section-header-content">
                                    <span class="section-title">Draft Appointments</span>
                                    <span class="badge ms-auto" style="background-color: #FF8C42; color: white;" id="draftCount">0</span>
                                </div>
                            </button>
                        </h2>
                        <div id="draftCollapse" class="accordion-collapse collapse" aria-labelledby="draftHeader">
                            <div class="accordion-body">
                                <div class="table-wrapper">
                                    <div class="table-responsive">
                                        <table class="table table-striped" id="draftAppointmentsTableWrapper">
                                            <thead>
                                                <tr>
                                                    <th>Date & Time</th>
                                                    <th>Consultation Type</th>
                                                    <th>Reason for Visit</th>
                                                    <th>Status</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody id="draftAppointmentsTable">
                                                <!-- Dynamic content will be populated here -->
                                            </tbody>
                                        </table>
                                    </div>
                                    <!-- Empty state for when there are no appointments -->
                                    <div class="empty-state" id="draftEmptyState" style="display: none;">
                                        <div class="text-center py-5">
                                            <i class="fa-solid fa-file-pen fa-3x text-muted mb-3"></i>
                                            <h5 class="text-muted">No draft appointments</h5>
                                            <p class="text-muted">You don't have any incomplete appointment forms.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Cancelled Appointments Section -->
                    <div class="accordion-item appointment-section" data-status="cancelled">
                        <h2 class="accordion-header" id="cancelledHeader">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" 
                                    data-bs-target="#cancelledCollapse" aria-expanded="false" aria-controls="cancelledCollapse"
                                    aria-label="Toggle cancelled appointments section">
                                <div class="section-header-content">
                                    <span class="section-title">Cancelled Appointments</span>
                                    <span class="badge ms-auto" style="background-color: #D96B2A; color: white;" id="cancelledCount">0</span>
                                </div>
                            </button>
                        </h2>
                        <div id="cancelledCollapse" class="accordion-collapse collapse" aria-labelledby="cancelledHeader" 
                             data-bs-parent="#appointmentsAccordion">
                            <div class="accordion-body p-0">
                                <div class="table-container">
                                    <div class="table-responsive">
                                        <table class="table appointments-table mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Date & Time</th>
                                                    <th>Consultation Type</th>
                                                    <th>Reason for Visit</th>
                                                    <th>Status</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody id="cancelledAppointmentsTable">
                                                <!-- Dynamic content will be populated here -->
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="empty-state" id="cancelledEmptyState" style="display: none;">
                                        <div class="text-center py-5">
                                            <i class="fa-solid fa-xmark-circle fa-3x text-muted mb-3"></i>
                                            <h5 class="text-muted">No cancelled appointments</h5>
                                            <p class="text-muted">You don't have any cancelled appointments.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Complete Appointments Section -->
                    <div class="accordion-item appointment-section" data-status="completed">
                        <h2 class="accordion-header" id="completedHeader">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" 
                                    data-bs-target="#completedCollapse" aria-expanded="false" aria-controls="completedCollapse"
                                    aria-label="Toggle completed appointments section">
                                <div class="section-header-content">
                                    <span class="section-title">Complete Appointments</span>
                                    <span class="badge ms-auto" style="background-color: #FF9F5C; color: white;" id="completedCount">0</span>
                                </div>
                            </button>
                        </h2>
                        <div id="completedCollapse" class="accordion-collapse collapse" aria-labelledby="completedHeader" 
                             data-bs-parent="#appointmentsAccordion">
                            <div class="accordion-body p-0">
                                <div class="table-container">
                                    <div class="table-responsive">
                                        <table class="table appointments-table mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Date & Time</th>
                                                    <th>Consultation Type</th>
                                                    <th>Reason for Visit</th>
                                                    <th>Status</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody id="completedAppointmentsTable">
                                                <!-- Dynamic content will be populated here -->
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="empty-state" id="completedEmptyState" style="display: none;">
                                        <div class="text-center py-5">
                                            <i class="fa-solid fa-check-circle fa-3x text-muted mb-3"></i>
                                            <h5 class="text-muted">No completed appointments</h5>
                                            <p class="text-muted">You don't have any completed appointments yet.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Appointment History</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Date & Time</th>
                                    <th>Consultation Type</th>
                                    <th>Reason for Visit</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.PastAppointments.Any())
                                {
                                    @foreach (var appointment in Model.PastAppointments)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-bold">@appointment.AppointmentDate.ToString("MMMM dd, yyyy")</div>
                                                <div class="fw-semibold text-primary">@appointment.GetFormattedTime()</div>
                                                <div class="small text-muted">Age: @appointment.AgeValue</div>
                                            </td>
                                            <td>@Model.GetFullConsultationType(appointment.Type)</td>
                                            <td>@appointment.ReasonForVisit</td>
                                            <td><span class="badge bg-@GetStatusClass(appointment.Status)">@appointment.Status</span></td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-primary" onclick="viewAppointmentDetails(@appointment.Id)">
                                                    <i class="fa-solid fa-eye"></i> View
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center">No appointment history</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Include Appointment Details Modal -->
<div class="modal fade" id="appointmentDetailsModal" tabindex="-1" aria-labelledby="appointmentDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="appointmentDetailsModalLabel">Appointment Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="appointmentDetails">
                    <!-- Loading state -->
                    <div class="text-center py-4" id="loadingState">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2 text-muted">Loading appointment details...</p>
                    </div>
                    <!-- Details content (populated by JavaScript) -->
                    <div id="detailsContent" style="display: none;"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetStatusClass(AppointmentStatus status)
    {
        return status switch
        {
            AppointmentStatus.Confirmed => "success",
            AppointmentStatus.Pending => "warning text-dark",
            AppointmentStatus.Cancelled => "danger",
            AppointmentStatus.Completed => "secondary",
            AppointmentStatus.InProgress => "info",
            AppointmentStatus.Urgent => "danger",
            AppointmentStatus.NoShow => "dark",
            AppointmentStatus.Draft => "primary",
            _ => "secondary"
        };
    }
}

@section Styles {
    <style>
        /* Elegant Appointments Accordion Styles */
        .appointments-container {
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            overflow: hidden;
            transition: all 0.3s ease;
        }

        .appointments-header {
            background: #FF8C42;
            padding: 1.5rem 2rem;
            color: white;
            border-radius: 12px 12px 0 0;
        }

        .appointments-title {
            font-weight: 600;
            font-size: 1.5rem;
            color: white;
        }

        .btn-book-appointment {
            background: rgba(255, 255, 255, 0.2);
            border: 2px solid rgba(255, 255, 255, 0.3);
            color: white;
            font-weight: 500;
            padding: 0.75rem 1.5rem;
            border-radius: 8px;
            transition: all 0.3s ease;
            backdrop-filter: blur(10px);
        }

        .btn-book-appointment:hover {
            background: rgba(255, 255, 255, 0.3);
            border-color: rgba(255, 255, 255, 0.5);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
        }

        /* Accordion Styles */
        .appointments-accordion {
            border: none;
            background: transparent;
        }

        .appointment-section {
            border: none;
            margin-bottom: 0.5rem;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
            transition: all 0.3s ease;
        }

        .appointment-section:hover {
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
            transform: translateY(-1px);
        }

        .accordion-button {
            background: #ffffff;
            border: none;
            padding: 1.25rem 1.5rem;
            font-weight: 500;
            color: #2c3e50;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .accordion-button:not(.collapsed) {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            color: #495057;
            box-shadow: inset 0 -2px 8px rgba(0, 0, 0, 0.05);
        }

        .accordion-button:focus {
            box-shadow: 0 0 0 0.2rem rgba(255, 107, 53, 0.25);
            border-color: transparent;
        }

        .accordion-button::after {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='%23666'%3e%3cpath fill-rule='evenodd' d='M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z'/%3e%3c/svg%3e");
            transition: transform 0.3s ease;
        }

        .accordion-button:not(.collapsed)::after {
            transform: rotate(180deg);
        }

        .section-header-content {
            display: flex;
            align-items: center;
            width: 100%;
        }

        .section-title {
            font-size: 1.1rem;
            font-weight: 500;
            margin-left: 0.5rem;
        }

        .badge {
            font-size: 0.85rem;
            padding: 0.4rem 0.8rem;
            border-radius: 20px;
            font-weight: 500;
        }

        /* Table Styles */
        .table-container {
            background: #ffffff;
            border-radius: 0 0 8px 8px;
        }

        .appointments-table {
            margin: 0;
            border: none;
        }

        .appointments-table thead th {
            background: #f8f9fa;
            border: none;
            padding: 1rem 1.5rem;
            font-weight: 600;
            color: #495057;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .appointments-table tbody td {
            padding: 1rem 1.5rem;
            border: none;
            border-bottom: 1px solid #f1f3f4;
            vertical-align: middle;
            transition: background-color 0.2s ease;
        }

        .appointments-table tbody tr:hover td {
            background: #f8f9fa;
        }

        .appointments-table tbody tr:last-child td {
            border-bottom: none;
        }

        /* Status Badges */
        .status-badge {
            padding: 0.4rem 0.8rem;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .status-ongoing {
            background: #e3f2fd;
            color: #1976d2;
        }

        .status-draft {
            background: #fff3e0;
            color: #f57c00;
        }

        .status-cancelled {
            background: #ffebee;
            color: #d32f2f;
        }

        .status-completed {
            background: #e8f5e9;
            color: #2e7d32;
        }

        /* Action Buttons */
        .action-btn {
            padding: 0.5rem 1rem;
            border-radius: 6px;
            font-size: 0.85rem;
            font-weight: 500;
            margin-right: 0.5rem;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
        }

        .btn-complete {
            background: #4caf50;
            color: white;
        }

        .btn-complete:hover {
            background: #45a049;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(76, 175, 80, 0.3);
        }

        .btn-cancel {
            background: #f8f9fa;
            color: #6c757d;
            border: 1px solid #dee2e6;
            font-weight: 500;
        }

        .btn-cancel:hover {
            background: #e9ecef;
            color: #495057;
            border-color: #adb5bd;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(108, 117, 125, 0.2);
        }

        /* Empty State */
        .empty-state {
            padding: 3rem 2rem;
            text-align: center;
            background: #fafafa;
        }

        .empty-state i {
            opacity: 0.5;
        }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .appointments-header {
                padding: 1rem;
                text-align: center;
            }

            .appointments-title {
                font-size: 1.25rem;
                margin-bottom: 1rem;
            }

            .btn-book-appointment {
                width: 100%;
                margin-top: 1rem;
            }

            .accordion-button {
                padding: 1rem;
            }

            .appointments-table thead th,
            .appointments-table tbody td {
                padding: 0.75rem 1rem;
            }

            .section-title {
                font-size: 1rem;
            }

            .badge {
                font-size: 0.75rem;
                padding: 0.3rem 0.6rem;
            }
        }

        /* Animation for accordion collapse */
        .accordion-collapse {
            transition: height 0.35s ease;
        }

        /* Loading states */
        .loading {
            opacity: 0.6;
            pointer-events: none;
        }

        .loading::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 20px;
            height: 20px;
            margin: -10px 0 0 -10px;
            border: 2px solid #f3f3f3;
            border-top: 2px solid #ff6b35;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        /* Smooth transitions for all interactive elements */
        * {
            transition: all 0.3s ease;
        }

        /* Focus states for accessibility */
        .accordion-button:focus,
        .action-btn:focus,
        .btn-book-appointment:focus {
            outline: 2px solid #ff6b35;
            outline-offset: 2px;
        }
    </style>
}

@section Scripts {
    <!-- SweetAlert2 for notifications -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        // Appointments Management Class
        class AppointmentsManager {
            constructor() {
                this.appointments = [];
                this.antiForgeryToken = this.getAntiForgeryTokenFromPage();
                this.initializeEventListeners();
                this.loadAppointments();
            }

            initializeEventListeners() {
                // Accordion event listeners
                document.addEventListener('DOMContentLoaded', () => {
                    this.setupAccordionEvents();
                });
            }

            setupAccordionEvents() {
                const accordionButtons = document.querySelectorAll('.accordion-button');
                accordionButtons.forEach(button => {
                    button.addEventListener('click', (e) => {
                        // Add smooth animation
                        const target = document.querySelector(button.getAttribute('data-bs-target'));
                        if (target) {
                            target.style.transition = 'height 0.35s ease';
                        }
                    });
                });
            }

            // Load appointments from server-side data
            loadAppointments() {
                console.log('=== DEBUG: loadAppointments called ===');
                console.log('DEBUG: Timestamp:', new Date().toISOString());
                
                // Get appointments from the model data
                const serverAppointments = this.getServerAppointments();
                console.log('DEBUG: Server appointments loaded:', serverAppointments.length);
                console.log('DEBUG: Server appointments data:', serverAppointments);
                
                this.appointments = serverAppointments;
                
                // Log appointment counts by type
                const ongoingCount = this.appointments.filter(a => a.statusType === 'ongoing').length;
                const draftCount = this.appointments.filter(a => a.statusType === 'draft').length;
                const cancelledCount = this.appointments.filter(a => a.statusType === 'cancelled').length;
                const completedCount = this.appointments.filter(a => a.statusType === 'completed').length;
                
                console.log(`DEBUG: Appointment counts - Ongoing: ${ongoingCount}, Draft: ${draftCount}, Cancelled: ${cancelledCount}, Completed: ${completedCount}`);
                
                this.populateTables();
            }

            getServerAppointments() {
                // This would typically come from an API call
                // For now, we'll use the server-side rendered data
                const appointments = [];
                
                // Extract ongoing appointments
                @foreach (var appointment in Model.OngoingAppointments)
                {
                    <text>
                    appointments.push({
                        id: @appointment.Id,
                        date: '@appointment.AppointmentDate.ToString("MMMM dd, yyyy")',
                        time: '@appointment.GetFormattedTime()',
                        age: @appointment.AgeValue,
                        patientName: '@(!string.IsNullOrEmpty(appointment.DependentFullName) ? appointment.DependentFullName : appointment.PatientName)',
                        consultationType: '@Model.GetFullConsultationType(appointment.Type)',
                        reason: '@appointment.ReasonForVisit',
                        status: '@appointment.Status.ToString()',
                        statusType: 'ongoing',
                        canComplete: false,
                        canCancel: true
                    });
                    </text>
                }

                // Extract draft appointments
                @foreach (var appointment in Model.DraftAppointments)
                {
                    <text>
                    appointments.push({
                        id: @appointment.Id,
                        date: '@appointment.AppointmentDate.ToString("MMMM dd, yyyy")',
                        time: '@appointment.GetFormattedTime()',
                        age: @appointment.AgeValue,
                        patientName: '@(!string.IsNullOrEmpty(appointment.DependentFullName) ? appointment.DependentFullName : appointment.PatientName)',
                        consultationType: '@Model.GetFullConsultationType(appointment.Type)',
                        reason: '@appointment.ReasonForVisit',
                        status: '@appointment.Status.ToString()',
                        statusType: 'draft',
                        canComplete: true,
                        canCancel: true
                    });
                    </text>
                }

                // Extract cancelled appointments
                @foreach (var appointment in Model.CancelledAppointments)
                {
                    <text>
                    appointments.push({
                        id: @appointment.Id,
                        date: '@appointment.AppointmentDate.ToString("MMMM dd, yyyy")',
                        time: '@appointment.GetFormattedTime()',
                        age: @appointment.AgeValue,
                        patientName: '@(!string.IsNullOrEmpty(appointment.DependentFullName) ? appointment.DependentFullName : appointment.PatientName)',
                        consultationType: '@Model.GetFullConsultationType(appointment.Type)',
                        reason: '@appointment.ReasonForVisit',
                        status: '@appointment.Status.ToString()',
                        statusType: 'cancelled',
                        canComplete: false,
                        canCancel: false
                    });
                    </text>
                }

                // Extract completed appointments
                @foreach (var appointment in Model.CompletedAppointments)
                {
                    <text>
                    appointments.push({
                        id: @appointment.Id,
                        date: '@appointment.AppointmentDate.ToString("MMMM dd, yyyy")',
                        time: '@appointment.GetFormattedTime()',
                        age: @appointment.AgeValue,
                        patientName: '@(!string.IsNullOrEmpty(appointment.DependentFullName) ? appointment.DependentFullName : appointment.PatientName)',
                        consultationType: '@Model.GetFullConsultationType(appointment.Type)',
                        reason: '@appointment.ReasonForVisit',
                        status: '@appointment.Status.ToString()',
                        statusType: 'completed',
                        canComplete: false,
                        canCancel: false
                    });
                    </text>
                }

                return appointments;
            }

            populateTables() {
                this.populateTable('ongoing', this.appointments.filter(a => a.statusType === 'ongoing'));
                this.populateTable('draft', this.appointments.filter(a => a.statusType === 'draft'));
                this.populateTable('cancelled', this.appointments.filter(a => a.statusType === 'cancelled'));
                this.populateTable('completed', this.appointments.filter(a => a.statusType === 'completed'));
            }

            populateTable(type, appointments) {
                const tableBody = document.getElementById(`${type}AppointmentsTable`);
                const emptyState = document.getElementById(`${type}EmptyState`);
                const countBadge = document.getElementById(`${type}Count`);

                if (!tableBody || !emptyState || !countBadge) return;

                // Update count
                countBadge.textContent = appointments.length;

                if (appointments.length === 0) {
                    tableBody.innerHTML = '';
                    emptyState.style.display = 'block';
                    return;
                }

                emptyState.style.display = 'none';
                tableBody.innerHTML = appointments.map(appointment => this.createTableRow(appointment)).join('');
            }

            createTableRow(appointment) {
                const statusClass = this.getStatusClass(appointment.statusType);
                const statusText = this.getStatusText(appointment.statusType);

                return `
                    <tr data-appointment-id="${appointment.id}">
                        <td>
                            <div class="fw-bold">${appointment.date}</div>
                            <div class="fw-semibold text-primary">${appointment.time}</div>
                            <div class="small text-muted">Age: ${appointment.age}</div>
                            ${appointment.patientName ? `<div class="small text-info"><i class="fa-solid fa-user"></i> ${appointment.patientName}</div>` : ''}
                        </td>
                        <td>${appointment.consultationType}</td>
                        <td>${appointment.reason}</td>
                        <td><span class="status-badge ${statusClass}">${statusText}</span></td>
                        <td>
                            ${this.createActionButtons(appointment)}
                        </td>
                    </tr>
                `;
            }

            createActionButtons(appointment) {
                let buttons = '';

                if (appointment.canComplete) {
                    buttons += `
                        <button class="action-btn btn-complete" 
                                onclick="appointmentsManager.handleCompleteForm(${appointment.id}, ${appointment.age}, '${appointment.consultationType}')"
                                title="Age: ${appointment.age} - ${appointment.age >= 20 ? 'NCD Risk Assessment' : 
                                    (appointment.age >= 10 ? 'HEEADSSS Assessment' : 'No form available')}">
                            <i class="fa-solid fa-check"></i> Complete Form
                        </button>
                    `;
                }

                if (appointment.canCancel) {
                    buttons += `
                        <button type="button" class="action-btn btn-cancel" 
                                onclick="appointmentsManager.handleCancelAppointment(${appointment.id})">
                            <i class="fa-solid fa-xmark"></i> Cancel
                        </button>
                    `;
                }

                return buttons || '<span class="text-muted">No actions available</span>';
            }

            getStatusClass(statusType) {
                const classes = {
                    'ongoing': 'status-ongoing',
                    'draft': 'status-draft',
                    'cancelled': 'status-cancelled',
                    'completed': 'status-completed'
                };
                return classes[statusType] || 'status-ongoing';
            }

            getStatusText(statusType) {
                const texts = {
                    'ongoing': 'On-Going',
                    'draft': 'Draft',
                    'cancelled': 'Cancelled',
                    'completed': 'Completed'
                };
                return texts[statusType] || 'Unknown';
            }

            handleCompleteForm(appointmentId, age, consultationType) {
                console.log('Complete Form clicked:', { age: age, appointmentId: appointmentId, consultationType: consultationType });
                
                // Check if this is a General Consult appointment
                const isGeneralConsult = consultationType && consultationType.toLowerCase().includes('general consult');
                
                if (!isGeneralConsult) {
                    // For non-General Consult appointments, show message that no assessment is required
                    Swal.fire({
                        title: 'No Assessment Required',
                        text: `${consultationType} appointments do not require additional assessment forms.`,
                        icon: 'info',
                        confirmButtonText: 'OK',
                        confirmButtonColor: '#17a2b8'
                    });
                    return;
                }
                
                // Determine the correct assessment form based on age for General Consult only
                let redirectUrl;
                if (age >= 20) {
                    redirectUrl = `/User/NCDRiskAssessment?appointmentId=${appointmentId}`;
                    console.log('Redirecting to NCD Risk Assessment for age:', age);
                } else if (age >= 10) {
                    redirectUrl = `/User/HEEADSSSAssessment?appointmentId=${appointmentId}`;
                    console.log('Redirecting to HEEADSSS Assessment for age:', age);
                } else {
                    alert('No assessment form is required for patients under 10 years old.');
                    return;
                }
                
                // Test the URL first
                console.log('Testing URL accessibility...');
                fetch(redirectUrl, { method: 'HEAD' })
                    .then(response => {
                        console.log('URL test response:', response.status, response.statusText);
                        if (response.ok) {
                            console.log('URL is accessible, redirecting...');
                            window.location.href = redirectUrl;
                        } else {
                            console.error('URL not accessible:', response.status);
                            alert(`Assessment form is not accessible (Status: ${response.status}). Please contact support.`);
                        }
                    })
                    .catch(error => {
                        console.error('Error testing URL:', error);
                        alert('Error accessing assessment form. Please try again or contact support.');
                    });
            }

            // Method to refresh appointments (for future API integration)
            refreshAppointments() {
                this.loadAppointments();
            }

            getAntiForgeryTokenFromPage() {
                const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
                return tokenElement ? tokenElement.value : '';
            }

            getAntiForgeryToken() {
                return this.antiForgeryToken;
            }

            async handleCancelAppointment(appointmentId) {
                console.log('DEBUG: handleCancelAppointment called with appointmentId:', appointmentId);
                
                // Use SweetAlert2 for confirmation instead of browser confirm
                const result = await Swal.fire({
                    title: 'Cancel Appointment',
                    text: 'Are you sure you want to cancel this appointment?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Yes, cancel it!',
                    cancelButtonText: 'No, keep it'
                });

                if (!result.isConfirmed) {
                    console.log('DEBUG: User cancelled the confirmation dialog');
                    return;
                }

                console.log('DEBUG: User confirmed cancellation, proceeding...');

                try {
                    // Show loading state
                    const cancelButton = document.querySelector(`button[onclick*="${appointmentId}"]`);
                    if (cancelButton) {
                        console.log('DEBUG: Found cancel button, setting loading state');
                        cancelButton.disabled = true;
                        cancelButton.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Cancelling...';
                    } else {
                        console.log('DEBUG: Cancel button not found!');
                    }

                    // Prepare form data
                    const formData = new FormData();
                    formData.append('appointmentId', appointmentId);
                    formData.append('__RequestVerificationToken', this.getAntiForgeryToken());
                    
                    console.log('DEBUG: Prepared form data:', {
                        appointmentId: appointmentId,
                        token: this.getAntiForgeryToken()
                    });

                    // Send AJAX request to the correct handler
                    const cancelUrl = '?handler=CancelAppointment';
                    console.log('DEBUG: Sending AJAX request to:', cancelUrl);
                    const response = await fetch(cancelUrl, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    console.log('DEBUG: Received response:', {
                        status: response.status,
                        statusText: response.statusText,
                        ok: response.ok
                    });

                    if (response.ok) {
                        console.log('DEBUG: Response OK, reloading page to reflect changes');
                        
                        // Show success message using SweetAlert2 and reload page
                        await Swal.fire({
                            title: 'Success!',
                            text: 'Appointment cancelled successfully!',
                            icon: 'success',
                            confirmButtonText: 'OK',
                            timer: 2000,
                            timerProgressBar: true
                        });
                        
                        // Reload the page to get fresh data from the server
                        console.log('DEBUG: Reloading page...');
                        window.location.reload();
                    } else {
                        // Error handling
                        const errorText = await response.text();
                        console.error('DEBUG: Cancellation failed:', errorText);
                        
                        // Show error message using SweetAlert2
                        Swal.fire({
                            title: 'Error!',
                            text: 'Failed to cancel appointment. Please try again.',
                            icon: 'error',
                            confirmButtonText: 'OK'
                        });
                        
                        // Reset button state
                        if (cancelButton) {
                            cancelButton.disabled = false;
                            cancelButton.innerHTML = '<i class="fa-solid fa-xmark"></i> Cancel';
                        }
                    }
                } catch (error) {
                    console.error('DEBUG: Error cancelling appointment:', error);
                    
                    // Show error message using SweetAlert2
                    Swal.fire({
                        title: 'Error!',
                        text: 'An error occurred while cancelling the appointment. Please try again.',
                        icon: 'error',
                        confirmButtonText: 'OK'
                    });
                    
                    // Reset button state
                    const cancelButton = document.querySelector(`button[onclick*="${appointmentId}"]`);
                    if (cancelButton) {
                        cancelButton.disabled = false;
                        cancelButton.innerHTML = '<i class="fa-solid fa-xmark"></i> Cancel';
                    }
                }
            }

            moveAppointmentToCancelled(appointmentId) {
                console.log('Moving appointment to cancelled:', appointmentId);
                console.log('Current appointments:', this.appointments);
                
                // Find the appointment in the current data
                const appointment = this.appointments.find(a => a.id === appointmentId);
                if (!appointment) {
                    console.error('Appointment not found:', appointmentId);
                    console.log('Available appointment IDs:', this.appointments.map(a => a.id));
                    return;
                }

                console.log('Found appointment:', appointment);

                // Update the appointment status
                appointment.statusType = 'cancelled';
                appointment.status = 'Cancelled';
                appointment.canCancel = false;

                console.log('Updated appointment:', appointment);

                // Remove from ongoing table
                const ongoingTable = document.getElementById('ongoingAppointmentsTable');
                if (ongoingTable) {
                    const row = ongoingTable.querySelector(`tr[data-appointment-id="${appointmentId}"]`);
                    if (row) {
                        row.remove();
                    }
                }

                // Add to cancelled table
                this.populateTable('cancelled', this.appointments.filter(a => a.statusType === 'cancelled'));

                // Update counts
                this.updateCounts();

                // Expand the cancelled section to show the newly cancelled appointment
                const cancelledSection = document.getElementById('cancelledAppointments');
                if (cancelledSection) {
                    const accordionButton = cancelledSection.querySelector('.accordion-button');
                    if (accordionButton && accordionButton.classList.contains('collapsed')) {
                        accordionButton.click();
                    }
                }
            }

            updateCounts() {
                const counts = {
                    ongoing: this.appointments.filter(a => a.statusType === 'ongoing').length,
                    draft: this.appointments.filter(a => a.statusType === 'draft').length,
                    cancelled: this.appointments.filter(a => a.statusType === 'cancelled').length,
                    completed: this.appointments.filter(a => a.statusType === 'completed').length
                };

                // Update count badges by ID
                const ongoingCount = document.getElementById('ongoingCount');
                const draftCount = document.getElementById('draftCount');
                const cancelledCount = document.getElementById('cancelledCount');
                const completedCount = document.getElementById('completedCount');

                if (ongoingCount) ongoingCount.textContent = counts.ongoing;
                if (draftCount) draftCount.textContent = counts.draft;
                if (cancelledCount) cancelledCount.textContent = counts.cancelled;
                if (completedCount) completedCount.textContent = counts.completed;

                console.log('Updated counts:', counts);
            }

            showSuccessMessage(message) {
                // Create a temporary success message
                const successDiv = document.createElement('div');
                successDiv.className = 'alert alert-success alert-dismissible fade show position-fixed';
                successDiv.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
                successDiv.innerHTML = `
                    <i class="fa-solid fa-check-circle me-2"></i>
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                `;

                document.body.appendChild(successDiv);

                // Auto-remove after 3 seconds
                setTimeout(() => {
                    if (successDiv.parentNode) {
                        successDiv.remove();
                    }
                }, 3000);
            }
        }

        // Initialize the appointments manager
        let appointmentsManager;
        document.addEventListener('DOMContentLoaded', function() {
            appointmentsManager = new AppointmentsManager();
        });

        // Function to view appointment details
        async function viewAppointmentDetails(appointmentId) {
            console.log('Viewing appointment details for ID:', appointmentId);
            
            // Show modal
            const modal = new bootstrap.Modal(document.getElementById('appointmentDetailsModal'));
            modal.show();
            
            // Show loading state
            document.getElementById('loadingState').style.display = 'block';
            document.getElementById('detailsContent').style.display = 'none';
            
            try {
                // Fetch appointment details
                const response = await fetch(`?handler=AppointmentDetails&id=${appointmentId}`);
                const data = await response.json();
                
                if (data.success) {
                    // Populate modal with appointment details
                    const appointment = data.appointment;
                    
                    // Build immunization schedule section if available
                    let immunizationSection = '';
                    if (appointment.immunizationSchedule && appointment.immunizationSchedule !== 'N/A') {
                        const scheduleItems = appointment.immunizationSchedule.split('; ');
                        let scheduleHtml = '<table class="table table-sm table-bordered mt-2"><thead><tr><th>Vaccine</th><th>Date Given</th><th>Remarks</th></tr></thead><tbody>';
                        
                        scheduleItems.forEach(item => {
                            const parts = item.split(': ');
                            if (parts.length === 2) {
                                const vaccine = parts[0];
                                const dateAndRemarks = parts[1].split(' - ');
                                const date = dateAndRemarks[0] || 'N/A';
                                const remarks = dateAndRemarks[1] || 'N/A';
                                scheduleHtml += `<tr><td>${vaccine}</td><td>${date}</td><td>${remarks}</td></tr>`;
                            }
                        });
                        
                        scheduleHtml += '</tbody></table>';
                        immunizationSection = `
                            <div class="col-12 mb-3">
                                <label class="fw-bold text-muted small">Immunization Schedule</label>
                                ${scheduleHtml}
                            </div>
                        `;
                    }
                    
                    const detailsHtml = `
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="fw-bold text-muted small">Appointment ID</label>
                                <div class="fs-6">#${appointment.id}</div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="fw-bold text-muted small">Status</label>
                                <div class="fs-6"><span class="badge bg-${getStatusBadgeClass(appointment.status)}">${appointment.status}</span></div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="fw-bold text-muted small">Date</label>
                                <div class="fs-6"><i class="fa-solid fa-calendar text-primary me-2"></i>${appointment.date}</div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="fw-bold text-muted small">Time</label>
                                <div class="fs-6"><i class="fa-solid fa-clock text-primary me-2"></i>${appointment.time}</div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="fw-bold text-muted small">Consultation Type</label>
                                <div class="fs-6">${appointment.consultationType}</div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="fw-bold text-muted small">Age</label>
                                <div class="fs-6">${appointment.age}</div>
                            </div>
                            <div class="col-12 mb-3">
                                <label class="fw-bold text-muted small">Reason for Visit</label>
                                <div class="fs-6">${appointment.reasonForVisit}</div>
                            </div>
                            ${immunizationSection}
                        </div>
                    `;
                    
                    document.getElementById('detailsContent').innerHTML = detailsHtml;
                    document.getElementById('loadingState').style.display = 'none';
                    document.getElementById('detailsContent').style.display = 'block';
                } else {
                    // Show error message
                    document.getElementById('detailsContent').innerHTML = `
                        <div class="alert alert-danger">
                            <i class="fa-solid fa-exclamation-circle me-2"></i>
                            ${data.error || 'Failed to load appointment details.'}
                        </div>
                    `;
                    document.getElementById('loadingState').style.display = 'none';
                    document.getElementById('detailsContent').style.display = 'block';
                }
            } catch (error) {
                console.error('Error loading appointment details:', error);
                document.getElementById('detailsContent').innerHTML = `
                    <div class="alert alert-danger">
                        <i class="fa-solid fa-exclamation-circle me-2"></i>
                        An error occurred while loading appointment details.
                    </div>
                `;
                document.getElementById('loadingState').style.display = 'none';
                document.getElementById('detailsContent').style.display = 'block';
            }
        }

        // Helper function to get badge class based on status
        function getStatusBadgeClass(status) {
            const statusMap = {
                'Confirmed': 'success',
                'Pending': 'warning',
                'Cancelled': 'danger',
                'Completed': 'secondary',
                'InProgress': 'info',
                'Urgent': 'danger',
                'NoShow': 'dark',
                'Draft': 'primary'
            };
            return statusMap[status] || 'secondary';
        }
    </script>
} 
