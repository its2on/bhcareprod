                const isBoolean = type === 'boolean';
                const isString = type === 'string';
                const isValidBoolean = isBoolean || (isString && (value === 'true' || value === 'false'));
                
                console.log(`${fieldName}: value="${value}", type=${type}, isBoolean=${isBoolean}, isValidBoolean=${isValidBoolean}`);
                
                if (!isValidBoolean && value !== undefined && value !== null) {
                    console.warn(`⚠️  INVALID BOOLEAN FIELD: ${fieldName} = "${value}" (type: ${type})`);
                }
            });
            
            console.log("=== END BOOLEAN FIELDS VALIDATION ===");

            const token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (!token) {
                alert('Security token not found. Please refresh the page.');
                return;
            }

            try {
                const jsonData = prepareData(data);
                
                const submitButton = document.getElementById('submit-btn');
                const originalText = submitButton.textContent;
                submitButton.textContent = 'Loading...';
                submitButton.disabled = true;

                const formData = new FormData();
                formData.append('jsonData', jsonData);
                formData.append('__RequestVerificationToken', token.value);

                fetch('/User/NCDRiskAssessment?handler=SubmitAssessment', {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: formData
                })
                .then(response => {
                    if (!response.ok) {
                        return response.text().then(text => {
                            throw new Error(`Server error: ${response.status} - ${text}`);
                        });
                    }
                    return response.json();
                })
                .then(result => {
                    console.log('Success:', result);
                    submitButton.textContent = originalText;
                    alert('Assessment submitted successfully!');
                    window.location.href = '/User/UserDashboard';
                })
                .catch(error => {
                    console.error('Error:', error);
                    submitButton.textContent = originalText;
                    submitButton.disabled = false;
                    alert('Failed to submit assessment: ' + error.message);
                });
            } catch (error) {
                console.error('Client-side error:', error);
                alert('Failed to submit assessment: ' + error.message);
                const submitButton = document.getElementById('submit-btn');
                submitButton.textContent = 'Submit Assessment';
                submitButton.disabled = false;
            }
        });

        // Function to format date as MM/DD/YYYY
        function formatDate(date) {
            const month = (date.getMonth() + 1).toString().padStart(2, '0');
            const day = date.getDate().toString().padStart(2, '0');
            const year = date.getFullYear();
            return `${month}/${day}/${year}`;
        }

        // Function to initialize conditional sections
        function initConditionalSections() {
            console.log("Initializing conditional sections");
            
            // Setup the conditional visibility for each section
            setupConditionalVisibilityGroup('alcohol_inom', ['alcohol-stopped-questions', 'alcohol-questions', 'alcohol-questions-3', 'alcohol-questions-4']);
            // Exercise section now uses checkboxes, no conditional subsections needed
            setupConditionalVisibilityGroup('SmokingStatus', ['smoking-quit-duration']);
            setupConditionalVisibilityGroup('stress_madalas', ['stress-questions', 'stress-questions-2']);
            
            // Immediately check the current state of radio buttons
            checkInitialRadioStates();
            
            // Add debugging event listeners to all form elements
            addDebuggingEventListeners();
        }
        
        // Function to add debugging event listeners to all form elements
        function addDebuggingEventListeners() {
            console.log("Adding debugging event listeners to form elements");
            
            // Add listeners to all checkboxes
            document.querySelectorAll('input[type="checkbox"]').forEach(function(checkbox) {
                checkbox.addEventListener('change', function() {
                    console.log(`Checkbox changed: ${this.name} = ${this.checked} (value: ${this.value})`);
                });
            });
            
            // Add listeners to all radio buttons
            document.querySelectorAll('input[type="radio"]').forEach(function(radio) {
                radio.addEventListener('change', function() {
                    console.log(`Radio changed: ${this.name} = ${this.value} (checked: ${this.checked})`);
                });
            });
            
            // Add listeners to all text inputs
            document.querySelectorAll('input[type="text"], input[type="date"], input[type="number"]').forEach(function(input) {
                input.addEventListener('input', function() {
                    if (this.value && this.value.trim() !== '') {
                        console.log(`Text input changed: ${this.name || this.id} = "${this.value}"`);
                    }
                });
            });
        }
        
        // Function to check all radio buttons and hide sections accordingly
        function checkInitialRadioStates() {
            // Check alcohol section
            const alcoholRadios = document.querySelectorAll('input[name="alcohol_inom"]');
            for (const radio of alcoholRadios) {
                if (radio.checked && radio.value === 'Hindi') {
                    hideGroupSections(['alcohol-stopped-questions', 'alcohol-questions', 'alcohol-questions-2', 'alcohol-questions-3', 'alcohol-questions-4']);
                    break;
                }
            }
            
            // Check smoking section
            const smokingRadios = document.querySelectorAll('input[name="SmokingStatus"]');
            for (const radio of smokingRadios) {
                if (radio.checked && radio.value === 'Non-smoker') {
                    hideGroupSections(['smoking-quit-duration']);
                    break;
                }
            }
            // Check stress section
            const stressRadios = document.querySelectorAll('input[name="stress_madalas"]');
            for (const radio of stressRadios) {
                if (radio.checked && radio.value === 'Hindi') {
                    hideGroupSections(['stress-questions', 'stress-questions-2']);
                    break;
                }
            }
        }
        
        // Helper function to hide a group of sections
        function hideGroupSections(sectionIds) {
            sectionIds.forEach(id => {
                const section = document.getElementById(id);
                if (section) {
                    section.classList.add('hidden');
                    console.log(`Initially hiding section: ${id}`);
                }
            });
        }

        // Helper function to set up conditional visibility for a group of sections
        function setupConditionalVisibilityGroup(radioName, sectionIds) {
            if (!sectionIds || sectionIds.length === 0) {
                console.error(`No section IDs provided for: ${radioName}`);
                return;
            }
            
            const sections = sectionIds.map(id => document.getElementById(id)).filter(section => section !== null);
            
            if (sections.length === 0) {
                console.error(`No valid sections found for: ${radioName}`);
                return;
            }
            
            const radioButtons = document.querySelectorAll(`input[name="${radioName}"]`);
            if (radioButtons.length === 0) {
                console.error(`No radio buttons found for: ${radioName}`);
                return;
            }
            
            console.log(`Setting up conditional visibility for ${radioName} -> ${sectionIds.join(', ')}`);
            
            // Special handling for alcohol section
            if (radioName === 'alcohol_inom') {
                radioButtons.forEach(radio => {
                    radio.addEventListener('change', function() {
                        sections.forEach(section => {
                            if (this.value === 'Hindi') {
                                // Show alcohol-stopped-questions, hide other alcohol questions
                                if (section.id === 'alcohol-stopped-questions') {
                                    console.log(`Showing section ${section.id} for value: ${this.value}`);
                                    section.classList.remove('hidden');
                                } else {
                                    console.log(`Hiding section ${section.id} for value: ${this.value}`);
                                    section.classList.add('hidden');
                                }
                            } else if (this.value === 'Oo') {
                                // Hide alcohol-stopped-questions, show other alcohol questions
                                if (section.id === 'alcohol-stopped-questions') {
                                    console.log(`Hiding section ${section.id} for value: ${this.value}`);
                                    section.classList.add('hidden');
                                } else {
                                    console.log(`Showing section ${section.id} for value: ${this.value}`);
                                    section.classList.remove('hidden');
                                }
                            }
                        });
                    });
                });
            } else if (radioName === 'SmokingStatus') {
                // Special handling for smoking status section
                radioButtons.forEach(radio => {
                    radio.addEventListener('change', function() {
                        sections.forEach(section => {
                            if (this.value === 'Non-smoker') {
                                // Hide smoking quit duration questions for non-smokers
                                console.log(`Hiding section ${section.id} for value: ${this.value}`);
                                section.classList.add('hidden');
                            } else if (this.value === 'Smoker') {
                                // Show smoking quit duration questions for smokers
                                console.log(`Showing section ${section.id} for value: ${this.value}`);
                                section.classList.remove('hidden');
                            }
                        });
                    });
                });
            } else {
                // Default handling for other sections
                radioButtons.forEach(radio => {
                    radio.addEventListener('change', function() {
                        // Check if this is a "No" option
                        const isNoOption = (this.value === 'Hindi' || this.value === 'Non-smoker' || this.value === 'Former Smoker' || this.value === 'wala');
                        
                        sections.forEach(section => {
                            if (isNoOption) {
                                console.log(`Hiding section ${section.id} for value: ${this.value}`);
                                section.classList.add('hidden');
                            } else {
                                console.log(`Showing section ${section.id} for value: ${this.value}`);
                                section.classList.remove('hidden');
                            }
                        });
                    });
                });
            }
        }
    </script>
}

