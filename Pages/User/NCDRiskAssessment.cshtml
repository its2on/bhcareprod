                        <label><input type="radio" name="SmokingStatus" value="Smoker"> Oo</label>
                        <label><input type="radio" name="SmokingStatus" value="Non-smoker"> Hindi</label>
                    </div>
                    <div class="form-group conditional-section hidden" id="smoking-quit-duration">
                        <label>Gaano ka na katagal tumigil sa paninigarilyo?</label>
                        <div class="radio-group">
                            <label><input type="radio" name="SmokingQuitDuration" value="wala pang 1 taon"> wala pang 1 taon</label>
                            <label><input type="radio" name="SmokingQuitDuration" value=">1 taon"> >1 taon</label>
                        </div>
                    </div>
                    <div class="checkbox-group" style="margin-top: 10px;">
                        <label><input type="checkbox" name="FormerSmoker" value="true"> Oo pero tumigil na</label>
                        <label><input type="checkbox" name="NeverSmokedButExposedToSmoke" value="true"> Hindi, pero lantad sa usok ng sigarilyo</label>
                        <label><input type="checkbox" name="Smoked100Sticks" value="true"> Smoked 100 sticks or more</label>
                    </div>
                </div>

                <h4>B.5 Stress</h4>
                <div class="form-group">
                    <label>Madalas ka bang ma-stress?</label>
                    <div class="radio-group">
                        <label><input type="radio" name="stress_madalas" value="Oo"> Oo</label>
                        <label><input type="radio" name="stress_madalas" value="Hindi"> Hindi</label>
                    </div>
                </div>
                <div class="form-group conditional-section hidden" id="stress-questions">
                    <label for="stress-sino">Ano o Sino ang dahilan ng iyong stress?</label>
                    <input type="text" id="stress-sino" name="stressSino">
                </div>
                <div class="form-group conditional-section hidden" id="stress-questions-2">
                    <label>Naepektuhan ba nito ang iyong pang-araw-araw na gawain?</label>
                    <div class="radio-group">
                        <label><input type="radio" name="stress_epekto" value="Oo"> Oo</label>
                        <label><input type="radio" name="stress_epekto" value="Hindi"> Hindi</label>
                    </div>
                </div>


                <div class="wizard-nav">
                    <button type="button" class="btn btn-secondary" id="back-3">Back</button>
                    <button type="button" class="btn btn-primary" id="next-3">Review</button>
                </div>
            </section>

            <!-- Step 4: Review & Submit -->
            <section class="form-section wizard-step" data-step="4">
                <h2>Review & Submit</h2>
                
                
                <div id="review-summary" class="form-section" aria-live="polite">
                    <h3>Assessment Summary</h3>
                    <div class="form-grid" id="review-grid">
                        <!-- Populated via JS -->
                    </div>
                </div>
                <div class="wizard-nav">
                    <button type="button" class="btn btn-secondary" id="back-4">Back</button>
                    <button type="submit" class="btn btn-primary" id="submit-btn" disabled>Submit Assessment</button>
                </div>
            </section>
        </div>
        </div>
    </div>

@section Scripts {
    <!-- SweetAlert2 for notifications -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- CryptoJS for AES encryption -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/crypto-js/4.1.1/crypto-js.min.js"></script>
    <script>
        // Initialize wizard state
        let currentStep = 1;
        
        // Encryption configuration - MUST match server-side key (exactly 32 bytes)
        const ENCRYPTION_KEY = "BHCARE_2024_SECRET_KEY_32BYTES_LONG"; // Exactly 32 bytes for AES-256
        
        // Temporary function to send data as plain JSON (no encryption for now)
        function prepareData(data) {
            try {
                const timestamp = new Date().toISOString();
                console.log(`[${timestamp}] Preparing data for submission`);
                console.log(`[${timestamp}] Data:`, data);
                
                // Convert data to JSON string
                const jsonString = JSON.stringify(data);
                console.log(`[${timestamp}] JSON string length:`, jsonString.length);
                console.log(`[${timestamp}] JSON preview:`, jsonString.substring(0, 100) + "...");
                console.log(`[${timestamp}] Data preparation completed successfully`);
                
                return jsonString;
            } catch (error) {
                const timestamp = new Date().toISOString();
                console.error(`[${timestamp}] Data preparation failed:`, error);
                throw new Error(`Failed to prepare data: ${error.message}`);
            }
        }
        // Pre-load values from server or URL parameters
        // Track if form has been modified
        let formModified = false;
        
        // Function to check if form has data
        function hasFormData() {
            const inputs = document.querySelectorAll('input, select, textarea');
            for (let input of inputs) {
                if (input.type === 'checkbox' || input.type === 'radio') {
                    if (input.checked) return true;
                } else if (input.value && input.value.trim() !== '') {
                    return true;
                }
            }
            return false;
        }
        
        // Function to show navigation warning with options
        function showNavigationWarning(event) {
            if (event) {
                event.preventDefault();
                event.returnValue = '';
            }
            
            // Use SweetAlert2 if available, otherwise use confirm
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    title: 'Leave Assessment Form?',
                    text: 'You want to leave? Continue later or cancel the appointment.',
                    icon: 'question',
                    showCancelButton: true,
                    showDenyButton: true,
                    confirmButtonText: 'Continue Later',
                    denyButtonText: 'Cancel Appointment',
                    cancelButtonText: 'Stay on Form',
                    confirmButtonColor: '#17a2b8',
                    denyButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d'
                }).then((result) => {
                    if (result.isConfirmed) {
                        // User chose "Continue Later" - go to appointments page
                        console.log('User chose to continue later');
                        window.location.href = '/User/Appointments';
                    } else if (result.isDenied) {
                        // User chose "Cancel Appointment" - cancel the appointment and go to appointments page
                        console.log('User chose to cancel appointment');
                        
                        // Get appointment ID from URL
                        const urlParams = new URLSearchParams(window.location.search);
                        const appointmentId = urlParams.get('appointmentId');
                        
                        if (appointmentId) {
                            // Call API to cancel the appointment
                            fetch(`/User/NCDRiskAssessment?handler=CancelAppointment&appointmentId=${appointmentId}`, {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                                }
                            }).then(response => response.json()).then(data => {
                                console.log('Appointment cancellation response:', data);
                                if (data.success) {
                                    console.log('Appointment cancelled successfully');
                                } else {
                                    console.error('Failed to cancel appointment:', data.error);
                                }
                                // Redirect to appointments page regardless of API response
                                window.location.href = '/User/Appointments';
                            }).catch(error => {
                                console.error('Error cancelling appointment:', error);
                                // Still redirect even if cancellation fails
                                window.location.href = '/User/Appointments';
                            });
                        } else {
                            // No appointment ID, just redirect
                            window.location.href = '/User/Appointments';
                        }
                    } else {
                        // User chose "Stay on Form" - do nothing, stay on page
                        console.log('User chose to stay on form');
                    }
                });
            } else {
                // Fallback to browser confirm if SweetAlert2 fails
                console.error('SweetAlert2 not available, using browser confirm');
                const choice = confirm('You want to leave? Continue later or cancel the appointment.');
                if (choice) {
                    window.location.href = '/User/Appointments';
                }
            }
            
            return false;
        }
        
        // Function to show assessment completion reminder
        function showAssessmentCompletionReminder() {
            // Use SweetAlert2 if available, otherwise use confirm
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    title: 'Complete Assessment Form',
                    text: 'Your appointment has been saved as a draft. Would you like to complete the assessment form now? (You can also complete it later from your Appointments page)',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Complete Now',
                    cancelButtonText: 'Complete Later',
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#6c757d'
                }).then((result) => {
                    if (result.isConfirmed) {
                        // User wants to complete the assessment now - stay on the page
                        console.log('User chose to complete assessment now - staying on page');
                    } else {
                        // User wants to complete later - stay on page but show info message
                        console.log('User chose to complete later - staying on page');
                        Swal.fire({
                            title: 'Assessment Form Available',
                            text: 'You can complete this assessment form anytime. It will be saved when you submit it.',
                            icon: 'info',
                            confirmButtonText: 'OK',
                            confirmButtonColor: '#17a2b8'
                        });
                    }
                });
            } else {
                // Fallback to browser confirm
                const confirmed = confirm('Your appointment has been saved as a draft. Would you like to complete the assessment form now? (You can also complete it later from your Appointments page)');
                if (confirmed) {
                    console.log('User chose to complete assessment now - staying on page');
                } else {
                    console.log('User chose to complete later - staying on page');
                    alert('You can complete this assessment form anytime. It will be saved when you submit it.');
                }
            }
        }
        
        // Add event listeners for form modification tracking
        function trackFormChanges() {
            const form = document.getElementById('ncd-form');
            if (form) {
                form.addEventListener('input', function() {
                    formModified = true;
                });
                
                form.addEventListener('change', function() {
                    formModified = true;
                });
            }
        }
        
        // Add beforeunload event listener - DISABLED to remove browser alert
        function addBeforeUnloadListener() {
            // Removed browser beforeunload alert as requested
            // window.addEventListener('beforeunload', function(event) {
            //     if (formModified || hasFormData()) {
            //         const message = 'You have unsaved changes. Are you sure you want to leave?';
            //         event.preventDefault();
            //         event.returnValue = message;
            //         return message;
            //     }
            // });
        }
        
        // Add click listeners to navigation links
        function addNavigationListeners() {
            // Listen for clicks on navigation links
            document.addEventListener('click', function(event) {
                const target = event.target.closest('a');
                if (target && target.href && !target.href.includes('javascript:')) {
                    // Check if it's a navigation link (not a form submission)
                    if (!target.closest('form') && !target.classList.contains('btn-submit')) {
                        showNavigationWarning(event);
                        return false;
                    }
                }
            });
        }

        // Document ready function
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize form tracking
            trackFormChanges();
            addBeforeUnloadListener();
            addNavigationListeners();
            
            // Don't show popup on page load - only show when user tries to leave
            
            // Initialize wizard
            updateStepIndicator(currentStep);
            
            // Initialize conditional sections
            initConditionalSections();
            
            // Get appointment ID from URL
            const urlParams = new URLSearchParams(window.location.search);
            const appointmentId = urlParams.get('appointmentId');
            
            // Set ID No. to be the same as Family No. (if the field exists)
            const familyNo = document.getElementById('family-no').value;
            const idNoInput = document.getElementById('id-no');
            if (idNoInput) {
                idNoInput.value = familyNo;
            }
            
            // Set today's date as the assessment date
            const today = new Date();
            const formattedDate = formatDate(today); // MM/DD/YYYY format
            document.getElementById('date-assessment').value = formattedDate;
            
            // Add birthday input event listener to auto-calculate age
            document.getElementById('birthday').addEventListener('change', function() {
                if (this.value) {
                    const birthDate = new Date(this.value);
                    const age = calculateAge(birthDate);
                    document.getElementById('edad').value = age;
                    console.log('Auto-calculated age:', age);
                }
            });
            
            // Get appointment data if available
            if (appointmentId) {
                fetch(`/api/Appointments/${appointmentId}`)
                    .then(response => response.json())
                    .then(data => {
                        if (data.appointmentDate) {
                            const appointmentDate = new Date(data.appointmentDate);
                            document.getElementById('date-assessment').value = formatDate(appointmentDate);
                        }
                        
                        // Auto-fill patient information if available
                        // Prioritize dependent name if available, otherwise use patient name
                        let patientName = data.dependentFullName || data.patientName || '';
                        let patientData = data.patient || {};
                        
                        if (patientName) {
                            // Parse the patient name into components
                            const nameParts = patientName.split(' ').filter(part => part.trim() !== '');
                            if (nameParts.length > 0) {
                                document.getElementById('first-name').value = nameParts[0];
                                if (nameParts.length > 1) {
                                    document.getElementById('last-name').value = nameParts[nameParts.length - 1];
                                    if (nameParts.length > 2) {
                                        document.getElementById('middle-name').value = nameParts.slice(1, -1).join(' ');
                                    }
                                }
                            }
                        } else if (patientData) {
                            // Fallback to patient data if no dependent name
                            if (patientData.firstName) document.getElementById('first-name').value = patientData.firstName;
                            if (patientData.middleName) document.getElementById('middle-name').value = patientData.middleName;
                            if (patientData.lastName) document.getElementById('last-name').value = patientData.lastName;
                        }
                        
                        // Use appointment-specific contact info if available
                        if (data.contactNumber) {
                            document.getElementById('telefono').value = data.contactNumber;
                        } else if (patientData.contactNumber) {
                            document.getElementById('telefono').value = patientData.contactNumber;
                        }
                        
                        // Use appointment-specific address if available
                        if (data.address) {
                            document.getElementById('address').value = data.address;
                        } else if (patientData.address) {
                            document.getElementById('address').value = patientData.address;
                        }
                        
                        // Handle birth date and age calculation
                        if (data.dateOfBirth) {
                            const birthDate = new Date(data.dateOfBirth);
                            document.getElementById('birthday').value = birthDate.toISOString().split('T')[0];
                            const age = calculateAge(birthDate);
                            document.getElementById('edad').value = age;
                        } else if (data.ageValue && data.ageValue > 0) {
                            document.getElementById('edad').value = data.ageValue;
                        } else if (patientData.birthDate) {
                            const birthDate = new Date(patientData.birthDate);
                            document.getElementById('birthday').value = birthDate.toISOString().split('T')[0];
                            const age = calculateAge(birthDate);
                            document.getElementById('edad').value = age;
                        }
                        
                        // Handle gender
                        const gender = data.gender || patientData.gender;
                        if (gender) {
                            const genderRadios = document.querySelectorAll('input[name="kasarian"]');
                            for (let radio of genderRadios) {
                                if (radio.value.toLowerCase() === gender.toLowerCase()) {
                                    radio.checked = true;
                                    break;
                                }
                            }
                        }
                        
                        // Check if patient has family number
                        if (patientData.familyNo) {
                            document.getElementById('family-no').value = patientData.familyNo;
                        }
                    })
                    .catch(error => console.error('Error fetching appointment data:', error));
            }
            
            // Add family number generation event handler
            document.getElementById('generate-family-no').addEventListener('click', async function() {
                console.log("=== GENERATE FAMILY NUMBER BUTTON CLICKED ===");
                const lastName = document.getElementById('last-name').value;
                console.log("Last name from form:", lastName);
                
                if (!lastName) {
                    console.log("Last name is empty, showing alert");
                    alert('Please enter your last name first to generate a family number.');
                    return;
                }
                
                try {
                    console.log("Sending request to generate family number for:", lastName);
                    const healthFacility = document.getElementById('health-facility')?.value || 'Baesa Health Center';
                    const requestBody = { 
                        LastName: lastName,
                        HealthFacility: healthFacility,
                        PatientCategory: null  // Don't override prefix with NCD
                    };
                    console.log("Request body:", requestBody);
                    
                    const response = await fetch('/api/FamilyNumber/generate', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify(requestBody)
                    });
                    
                    console.log("Response status:", response.status);
                    console.log("Response ok:", response.ok);
                    
                    if (response.ok) {
                        let result;
                        try {
                            const responseText = await response.text();
                            console.log("Raw response text:", responseText);
                            result = JSON.parse(responseText);
                            console.log("Parsed response result:", result);
                        } catch (jsonError) {
                            console.error("JSON parsing error:", jsonError);
                            console.log("Response text that failed to parse:", await response.text());
                            throw new Error("Failed to parse JSON response");
                        }
                        
                        if (result.success) {
                            document.getElementById('family-no').value = result.familyNumber;
                            // Update ID No. to match Family No.
                            const idNoInput = document.getElementById('id-no');
                            if (idNoInput) {
                                idNoInput.value = result.familyNumber;
                            }
                            console.log("Generated family number:", result.familyNumber);
                            
                            if (result.isPreexisting) {
                                // Use SweetAlert2 for success message
                                if (typeof Swal !== 'undefined') {
                                    Swal.fire({
                                        title: 'Family Number Found',
                                        text: 'You already have a family number: ' + result.familyNumber,
                                        icon: 'info',
                                        confirmButtonText: 'OK',
                                        confirmButtonColor: '#17a2b8'
                                    });
                                } else {
                                    alert('You already have a family number: ' + result.familyNumber);
                                }
                            } else {
                                // Use SweetAlert2 for success message
                                console.log("About to show success SweetAlert2");
                                console.log("Swal available:", typeof Swal !== 'undefined');
                                console.log("Generated family number:", result.familyNumber);
                                console.log("Prefix:", result.prefix);
                                console.log("Sequence number:", result.sequenceNumber);
                                
                                if (typeof Swal !== 'undefined') {
                                    console.log("Showing SweetAlert2 success dialog");
                                    Swal.fire({
                                        title: 'Success!',
                                        text: `Family number generated successfully: ${result.familyNumber}`,
                                        icon: 'success',
                                        confirmButtonText: 'OK',
                                        confirmButtonColor: '#28a745',
                                        timer: 3000,
                                        timerProgressBar: true
                                    }).then((result) => {
                                        console.log("SweetAlert2 success dialog closed");
                                    });
                                } else {
                                    console.log("SweetAlert2 not available, using alert");
                                    alert(`Family number generated successfully: ${result.familyNumber}`);
                                }
                            }
                        } else {
                            console.log("Backend returned error:", result.error);
                            console.log("Full result object:", result);
                            // Use SweetAlert2 for error message
                            if (typeof Swal !== 'undefined') {
                                Swal.fire({
                                    title: 'Error',
                                    text: 'Error generating family number: ' + result.error,
                                    icon: 'error',
                                    confirmButtonText: 'OK',
                                    confirmButtonColor: '#dc3545'
                                });
                            } else {
                                alert('Error generating family number: ' + result.error);
                            }
                        }
                    } else {
                        console.log("Response not ok, status:", response.status);
                        const errorText = await response.text();
                        console.log("Error response text:", errorText);
                        
                        // Use SweetAlert2 for error message
                        if (typeof Swal !== 'undefined') {
                            Swal.fire({
                                title: 'Error',
                                text: 'Error generating family number. Please try again.',
                                icon: 'error',
                                confirmButtonText: 'OK',
                                confirmButtonColor: '#dc3545'
                            });
                        } else {
                            alert('Error generating family number. Please try again.');
                        }
                    }
                } catch (error) {
                    console.error('=== ERROR GENERATING FAMILY NUMBER ===');
                    console.error('Error details:', error);
                    console.error('Error message:', error.message);
                    console.error('Error stack:', error.stack);
                    
                    // Use SweetAlert2 for error message
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            title: 'Error',
                            text: 'Error generating family number. Please try again.',
                            icon: 'error',
                            confirmButtonText: 'OK',
                            confirmButtonColor: '#dc3545'
                        });
                    } else {
                        alert('Error generating family number. Please try again.');
                    }
                }
            });
            
            // Test button for debugging
            document.getElementById('test-family-no').addEventListener('click', async function() {
                console.log("=== TEST BUTTON CLICKED ===");
                
                try {
                    const response = await fetch('/User/NCDRiskAssessment?handler=TestFamilyNumber', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        }
                    });
                    
                    console.log("Test response status:", response.status);
                    console.log("Test response ok:", response.ok);
                    
                    if (response.ok) {
                        const result = await response.json();
                        console.log("Test response result:", result);
                        
                        if (result.success) {
                            document.getElementById('family-no').value = result.familyNo;
                            console.log("Test successful, family number set to:", result.familyNo);
                            alert('Test successful! Family number: ' + result.familyNo);
                        } else {
                            console.log("Test failed:", result.error);
                            alert('Test failed: ' + result.error);
                        }
                    } else {
                        const errorText = await response.text();
                        console.log("Test error response:", errorText);
                        alert('Test failed with status: ' + response.status);
                    }
                } catch (error) {
                    console.error('Test error:', error);
                    alert('Test error: ' + error.message);
                }
            });
            
            // Add phone number validation
            document.getElementById('telefono').addEventListener('input', function(e) {
                // Remove any non-numeric characters
                this.value = this.value.replace(/[^0-9]/g, '');
                
                // Enforce maximum length of 11 digits
                if (this.value.length > 11) {
                    this.value = this.value.slice(0, 11);
                }
            });
        });
        
        // Calculate age based on birthdate
        function calculateAge(birthDate) {
            const today = new Date();
            let age = today.getFullYear() - birthDate.getFullYear();
            const monthDiff = today.getMonth() - birthDate.getMonth();
            
            if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birthDate.getDate())) {
                age--;
            }
            
            return age;
        }
        
        // Wizard state and helpers
        const steps = () => Array.from(document.querySelectorAll('.wizard-step'));
        const totalSteps = 4;
        const progressEl = document.getElementById('wizard-progress');
        const stepPills = Array.from(document.querySelectorAll('[data-step-pill]'));

        function updateStepIndicator(step) {
            const pct = Math.round(((step - 1) / (totalSteps - 1)) * 100);
            progressEl.style.width = pct + '%';
            stepPills.forEach(p => {
                const n = parseInt(p.getAttribute('data-step-pill'));
                p.classList.toggle('active', n === step);
                p.classList.toggle('done', n < step);
            });
        }

        function showStep(step) {
            console.log(`showStep called with step: ${step}`);
            steps().forEach(s => s.classList.remove('active'));
            const active = document.querySelector(`.wizard-step[data-step="${step}"]`);
            if (active) active.classList.add('active');
            currentStep = step;
            updateStepIndicator(step);
            if (step === 4) {
                console.log('Reached step 4, populating summary and validating');
                populateSummary();
                // Enable submit only if all required fields valid
                const isValid = validateAll();
                console.log('Step 4 reached. Validation result:', isValid);
                document.getElementById('submit-btn').disabled = !isValid;
                console.log('Submit button disabled:', !isValid);
            }
            // Focus first field of the step
            const firstInput = active?.querySelector('input, select, textarea, button');
            firstInput?.focus();
        }

        function validateAll() {
            let ok = true;
            console.log('Validating all steps...');
            for (let s = 1; s <= 3; s++) {
                const stepValid = validateStep(s);
                console.log(`Step ${s} validation:`, stepValid);
                ok = stepValid && ok;
            }
            console.log('Overall validation result:', ok);
            return ok;
        }

        function validateStep(step) {
            const container = document.querySelector(`.wizard-step[data-step="${step}"]`);
            if (!container) return true;
            let isValid = true;
            container.querySelectorAll('.error-text').forEach(e => e.remove());
            const requiredFields = container.querySelectorAll('[required]');
            requiredFields.forEach(field => {
                field.classList.remove('error');
                const type = field.getAttribute('type');
                if ((type === 'text' || type === 'date' || type === 'number') && !field.value.trim()) {
                    isValid = false;
                    field.classList.add('error');
                    addError(field, 'Required');
                } else if (type === 'radio') {
                    const group = container.querySelectorAll(`input[name="${field.name}"]`);
                    if (![...group].some(r => r.checked)) {
                        isValid = false;
                        addError(field.closest('.form-group') || field, 'Select an option');
                    }
                }
            });
            // Additional logical validation for Step 1 (Edad)
            if (step === 1) {
                const edadField = document.getElementById('edad');
                const v = parseInt(edadField.value, 10);
                if (isNaN(v)) { isValid = false; edadField.classList.add('error'); addError(edadField, 'Enter a valid number'); }
            }
            return isValid;
        }

