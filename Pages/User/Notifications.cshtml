@page
@model Barangay.Pages.User.NotificationsModel
@{
    ViewData["Title"] = "Notifications";
    ViewData["ShowDashboardNav"] = true;
    Layout = "_UserLayout";
}

<style>
    /* Notifications Page Styling */
    .notifications-page {
        padding: 1.5rem;
        max-width: 1400px;
        margin: 0 auto;
    }
    
    .notifications-header {
        background: linear-gradient(135deg, rgba(253, 125, 20, 0.79) 0%, rgb(226, 114, 22) 100%);
        padding: 2rem;
        border-radius: 12px;
        color: white;
        margin-bottom: 2rem;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
    
    .notifications-header h2 {
        margin: 0;
        font-size: 1.75rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }
    
    .notifications-header .unread-badge {
        background: rgba(255, 255, 255, 0.3);
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 500;
    }
    
    .notifications-actions {
        display: flex;
        gap: 1rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }
    
    .notifications-actions .btn {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        border-radius: 6px;
        font-size: 0.9rem;
        font-weight: 500;
        transition: all 0.3s ease;
    }
    
    .btn-mark-read {
        background-color: #ff8a3d;
        color: white;
        border: none;
    }
    
    .btn-mark-read:hover {
        background-color: #e67428;
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(255, 138, 61, 0.3);
    }
    
    .btn-delete-all {
        background-color: #6c757d;
        color: white;
        border: none;
    }
    
    .btn-delete-all:hover {
        background-color: #5a6268;
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(108, 117, 125, 0.3);
    }
    
    /* Notification List */
    .notifications-list {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        overflow: hidden;
    }
    
    .notification-item {
        display: flex;
        align-items: flex-start;
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid #f0f0f0;
        transition: all 0.3s ease;
        position: relative;
    }
    
    .notification-item:last-child {
        border-bottom: none;
    }
    
    .notification-item:hover {
        background-color: #f8f9fa;
    }
    
    .notification-item.unread {
        background-color: #fff7f0;
        border-left: 4px solid #ff8a3d;
    }
    
    .notification-item.unread:hover {
        background-color: #ffefe6;
    }
    
    .notification-checkbox {
        margin-right: 1rem;
        width: 20px;
        height: 20px;
        cursor: pointer;
    }
    
    .notification-icon {
        flex-shrink: 0;
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 1rem;
        font-size: 1.25rem;
    }
    
    .notification-icon.appointment {
        background-color: #e8f4fd;
        color: #1e88e5;
    }
    
    .notification-icon.reminder {
        background-color: #fff3e0;
        color: #fb8c00;
    }
    
    .notification-icon.consultation {
        background-color: #e8f5e9;
        color: #43a047;
    }
    
    .notification-icon.cancelled {
        background-color: #ffebee;
        color: #e53935;
    }
    
    .notification-icon.immunization {
        background-color: #f3e5f5;
        color: #8e24aa;
    }
    
    .notification-content {
        flex: 1;
        min-width: 0;
    }
    
    .notification-header-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.5rem;
    }
    
    .notification-type {
        font-weight: 600;
        font-size: 0.95rem;
        color: #ff8a3d;
    }
    
    .notification-message {
        color: #4a5568;
        font-size: 0.95rem;
        line-height: 1.5;
        margin-bottom: 0.5rem;
    }
    
    .notification-timestamp {
        font-size: 0.85rem;
        color: #9ca3af;
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }
    
    .notification-actions-buttons {
        display: flex;
        gap: 0.5rem;
        align-items: center;
    }
    
    .notification-actions-buttons .btn {
        padding: 0.35rem 0.75rem;
        font-size: 0.85rem;
        border-radius: 6px;
        transition: all 0.2s;
    }
    
    .btn-mark-single {
        background-color: transparent;
        color: #ff8a3d;
        border: 1px solid #ff8a3d;
    }
    
    .btn-mark-single:hover {
        background-color: #ff8a3d;
        color: white;
    }
    
    .btn-delete {
        background-color: transparent;
        color: #dc3545;
        border: 1px solid #dc3545;
    }
    
    .btn-delete:hover {
        background-color: #dc3545;
        color: white;
    }
    
    .read-status {
        font-size: 0.85rem;
        padding: 0.25rem 0.75rem;
        border-radius: 12px;
        font-weight: 500;
    }
    
    .read-status.unread {
        background-color: #fff7f0;
        color: #ff8a3d;
        border: 1px solid #ff8a3d;
    }
    
    .read-status.read {
        background-color: #f0f0f0;
        color: #6c757d;
    }
    
    .empty-state {
        padding: 4rem 2rem;
        text-align: center;
    }
    
    .empty-state i {
        font-size: 4rem;
        color: #d1d5db;
        margin-bottom: 1rem;
    }
    
    .empty-state h4 {
        color: #6b7280;
        margin-bottom: 0.5rem;
    }
    
    .empty-state p {
        color: #9ca3af;
    }
    
    /* Mobile Responsive */
    @@media (max-width: 768px) {
        .notifications-header h2 {
            font-size: 1.5rem;
        }
        
        .notification-item {
            flex-direction: column;
            gap: 1rem;
        }
        
        .notification-icon {
            margin-right: 0;
        }
        
        .notification-actions-buttons {
            width: 100%;
            justify-content: flex-start;
        }
        
        .notifications-actions {
            flex-direction: column;
        }
        
        .notifications-actions .btn {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="notifications-page">
    <!-- Page Header -->
    <div class="notifications-header">
        <h2>
            <i class="fa-solid fa-bell"></i>
            Notifications
            @if (Model.UnreadCount > 0)
            {
                <span class="unread-badge">@Model.UnreadCount Unread</span>
            }
        </h2>
        <p class="mb-0 mt-2" style="opacity: 0.9;">Stay updated with your appointments, consultations, and health reminders</p>
    </div>
    
    <!-- Action Buttons -->
    @if (Model.Notifications.Any())
    {
        <div class="notifications-actions">
            @if (Model.UnreadCount > 0)
            {
                <form method="post" asp-page-handler="MarkAllAsRead" style="display: inline;">
                    <button type="submit" class="btn btn-mark-read">
                        <i class="fa-solid fa-check-double"></i>
                        Mark All as Read
                    </button>
                </form>
            }
            
            @if (Model.Notifications.Any(n => n.IsRead))
            {
                <form method="post" asp-page-handler="DeleteAllRead" style="display: inline;"
                      onsubmit="return confirm('Are you sure you want to delete all read notifications?');">
                    <button type="submit" class="btn btn-delete-all">
                        <i class="fa-solid fa-trash-can"></i>
                        Delete All Read
                    </button>
                </form>
            }
        </div>
    }
    
    <!-- Notifications List -->
    <div class="notifications-list">
        @if (Model.Notifications.Any())
        {
            @foreach (var notification in Model.Notifications)
            {
                var iconClass = "appointment";
                var iconSymbol = "fa-calendar-check";
                
                if (notification.Type?.ToLower().Contains("reminder") == true || notification.Type?.ToLower().Contains("immunization") == true)
                {
                    iconClass = notification.Type?.ToLower().Contains("immunization") == true ? "immunization" : "reminder";
                    iconSymbol = "fa-syringe";
                }
                else if (notification.Type?.ToLower().Contains("cancel") == true)
                {
                    iconClass = "cancelled";
                    iconSymbol = "fa-calendar-xmark";
                }
                else if (notification.Type?.ToLower().Contains("complet") == true || notification.Type?.ToLower().Contains("consultation") == true)
                {
                    iconClass = "consultation";
                    iconSymbol = "fa-check-circle";
                }
                
                <div class="notification-item @(notification.IsRead ? "read" : "unread")">
                    <div class="notification-icon @iconClass">
                        <i class="fa-solid @iconSymbol"></i>
                    </div>
                    
                    <div class="notification-content">
                        <div class="notification-header-row">
                            <span class="notification-type">@notification.Type</span>
                            <span class="read-status @(notification.IsRead ? "read" : "unread")">
                                @(notification.IsRead ? "Read" : "Unread")
                            </span>
                        </div>
                        
                        <div class="notification-message">
                            @notification.Message
                        </div>
                        
                        <div class="notification-timestamp">
                            <i class="fa-regular fa-clock"></i>
                            @notification.CreatedAt.ToString("MMM dd, yyyy 'at' h:mm tt")
                        </div>
                    </div>
                    
                    <div class="notification-actions-buttons">
                        @if (!notification.IsRead)
                        {
                            <form method="post" asp-page-handler="MarkAsRead" asp-route-id="@notification.Id" style="display: inline;">
                                <button type="submit" class="btn btn-mark-single" title="Mark as Read">
                                    <i class="fa-solid fa-check"></i>
                                </button>
                            </form>
                        }
                        
                        <form method="post" asp-page-handler="Delete" asp-route-id="@notification.Id" style="display: inline;"
                              onsubmit="return confirm('Are you sure you want to delete this notification?');">
                            <button type="submit" class="btn btn-delete" title="Delete">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <i class="fa-regular fa-bell"></i>
                <h4>No Notifications Yet</h4>
                <p>You'll see your appointment updates, health reminders, and consultation notifications here.</p>
            </div>
        }
    </div>
</div>
