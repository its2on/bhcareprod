        function updateRadioValue(radioId, hiddenFieldName) {
            const radio = document.getElementById(radioId);
            const hiddenField = document.querySelector(`input[name="${hiddenFieldName}"]`);
            if (radio && hiddenField) {
                // Clear all radio buttons in the same group first
                const radioGroup = document.querySelectorAll(`input[name="${radio.name}"]`);
                radioGroup.forEach(r => r.checked = false);
                
                // Set the clicked radio button
                radio.checked = true;
                hiddenField.value = radio.value;
                console.log(`Radio ${radioId}: ${radio.value} -> ${hiddenField.value}`);
