            // Function to generate family number and sync both fields
            async function generateFamilyNumber() {
                try {
                    // Get patient name from ViewData
                    const patientName = '@ViewData["PatientName"]';
                    
                    if (!patientName || patientName === '' || patientName === 'null' || patientName === 'undefined') {
                        alert('Patient name not found. Please refresh the page and try again.');
                        return;
                    }
                    
                    const lastName = patientName.split(' ').pop();
                    
                    if (!lastName || lastName.length === 0) {
                        alert('Please enter your last name first to generate a family number.');
                        return;
                    }
                    
                    // Get CSRF token
                    const csrfToken = $('input[name="__RequestVerificationToken"]').val();
                    
                    const response = await fetch('/User/HEEADSSSAssessment?handler=GenerateFamilyNumber', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': csrfToken
                        },
                        body: JSON.stringify({ lastName: lastName })
                    });
                    
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    
                    const result = await response.json();
                    
                    if (result.success) {
                        // Update both fields with the same value
                        $('#family-no').val(result.familyNo);
                        $('#client-no').val(result.familyNo);
                        
                        // Show generator information
                        const generatorText = 'Generated by: ' + (result.generatedBy || 'Unknown');
                        $('#family-generator-info').text(generatorText).show();
                        $('#client-generator-info').text(generatorText).show();
                        
                        if (result.isPreexisting) {
                            alert('Using existing family number: ' + result.familyNo + '\nGenerated by: ' + (result.generatedBy || 'Unknown'));
                        } else {
                            alert('New family number generated: ' + result.familyNo + '\nGenerated by: ' + (result.generatedBy || 'Unknown'));
                        }
                    } else {
                        alert('Error generating family number: ' + (result.error || 'Unknown error'));
                    }
                } catch (error) {
                    console.error('Error generating family number:', error);
                    alert('Error generating family number. Please try again.');
                }
            });
            
            // Test if form submission is working
            console.log('=== FORM SUBMISSION TEST ===');
            console.log('Form element found:', $('#heeadsssForm').length > 0);
            console.log('Form ID:', $('#heeadsssForm').attr('id'));
            console.log('Form action:', $('#heeadsssForm').attr('action'));
            console.log('Form method:', $('#heeadsssForm').attr('method'));
            
            // Test button functionality
            $('#testButton').on('click', function() {
                console.log('=== TEST BUTTON CLICKED ===');
                console.log('Form element found:', $('#heeadsssForm').length > 0);
                console.log('Form validation:', $('#heeadsssForm')[0].checkValidity());
                
                // Test checkbox values
                console.log('=== CHECKBOX VALUES TEST ===');
                const testCheckboxes = ['IsNHPTS', 'Is4Ps', 'DrugsTobaccoUse', 'DrugsAlcoholUse'];
                testCheckboxes.forEach(id => {
                    const checkbox = document.getElementById(id);
                    const hiddenField = document.querySelector(`input[name="Assessment.${id}"]`);
                    console.log(`Checkbox ${id}: checked=${checkbox?.checked}, hidden value="${hiddenField?.value}"`);
                });
                
                // Test radio button values
                console.log('=== RADIO BUTTON VALUES TEST ===');
                const testRadios = ['SexualityIntimateRelationships', 'SexualityPregnancyExperience'];
                testRadios.forEach(name => {
                    const selected = document.querySelector(`input[name="${name}"]:checked`);
                    const hiddenField = document.querySelector(`input[name="Assessment.${name}"]`);
                    console.log(`Radio ${name}: selected="${selected?.value}", hidden value="${hiddenField?.value}"`);
                });
                
                alert('Check console for debug information');
            });
            
            // Test button click
            $('button[type="submit"], input[type="submit"]').on('click', function(e) {
                console.log('=== SUBMIT BUTTON CLICKED ===');
                console.log('Button element:', this);
                console.log('Button type:', $(this).attr('type'));
                console.log('Button text:', $(this).text() || $(this).val());
            });
            
            // Form validation before submission
            $('#heeadsssForm').on('submit', function(e) {
                console.log('=== FORM SUBMIT EVENT TRIGGERED ===');
                e.preventDefault();
                
                console.log('=== FORM SUBMISSION STARTED ===');
                console.log('Form element:', this);
                console.log('Form action:', this.action);
                console.log('Form method:', this.method);
                
                // Update all checkbox values before submission
                const checkboxes = [
                    'IsNHPTS', 'Is4Ps', 'IsPhilHealthBeneficiaryOnly', 'IsOwnPhilHealth',
                    'BMIUnderweight', 'BMINormal', 'BMIOverweight', 'BMIObese',
                    'EatingVomiting', 'EatingDietPills', 'EatingLaxatives', 'EatingStarvation',
                    'DrugsTobaccoUse', 'DrugsAlcoholUse', 'DrugsStreetDrugs',
                    'SexualityGay', 'SexualityLesbian', 'SexualityBisexual'
                ];

                console.log('=== UPDATING CHECKBOX VALUES ===');
                checkboxes.forEach(checkboxId => {
                    const checkbox = document.getElementById(checkboxId);
                    const hiddenField = document.querySelector(`input[name="Assessment.${checkboxId}"]`);
                    if (checkbox && hiddenField) {
                        const newValue = checkbox.checked ? "True" : "False";
                        hiddenField.value = newValue;
                        console.log(`Checkbox ${checkboxId}: ${checkbox.checked} -> ${newValue}`);
                    } else {
                        console.log(`ERROR: Missing checkbox or hidden field for ${checkboxId}`);
                    }
                });

                // Update radio button values before submission
                const radioGroups = [
                    {
                        fieldName: 'Assessment.SexualityIntimateRelationships',
                        groupName: 'SexualityIntimateRelationships',
                        yesId: 'SexualityIntimateRelationshipsYes',
                        noId: 'SexualityIntimateRelationshipsNo'
                    },
                    {
                        fieldName: 'Assessment.SexualityPregnancyExperience',
                        groupName: 'SexualityPregnancyExperience',
                        yesId: 'SexualityPregnancyExperienceYes',
                        noId: 'SexualityPregnancyExperienceNo'
                    },
                    {
                        fieldName: 'Assessment.SexualitySTIExperience',
                        groupName: 'SexualitySTIExperience',
                        yesId: 'SexualitySTIExperienceYes',
                        noId: 'SexualitySTIExperienceNo'
                    },
                    {
                        fieldName: 'Assessment.SexualityProtectionUse',
                        groupName: 'SexualityProtectionUse',
                        yesId: 'SexualityProtectionUseYes',
                        noId: 'SexualityProtectionUseNo',
                        sometimesId: 'SexualityProtectionUseSometimes'
                    }
                ];

                console.log('=== UPDATING RADIO BUTTON VALUES ===');
                radioGroups.forEach(group => {
                    const hiddenField = document.querySelector(`input[name="${group.fieldName}"]`);
                    const yesRadio = document.getElementById(group.yesId);
                    const noRadio = document.getElementById(group.noId);
                    const sometimesRadio = group.sometimesId ? document.getElementById(group.sometimesId) : null;
                    
                    if (hiddenField && yesRadio && noRadio) {
                        if (yesRadio.checked) {
                            hiddenField.value = "Yes";
                        } else if (noRadio.checked) {
                            hiddenField.value = "No";
                        } else if (sometimesRadio && sometimesRadio.checked) {
                            hiddenField.value = "Sometimes";
                        } else {
                            hiddenField.value = "";
                        }
                        console.log(`Radio ${group.fieldName}: ${hiddenField.value}`);
                    } else {
                        console.log(`ERROR: Missing radio button elements for ${group.fieldName}`);
                    }
                });
                
                // Validate required fields
                console.log('=== VALIDATING REQUIRED FIELDS ===');
                var isValid = true;
                var firstInvalidField = null;
                var missingFields = [];
                
                // Check specific required fields first
                const requiredFields = [
                    { name: 'Assessment.Birthday', id: 'Assessment_Birthday', label: 'Birthday' },
                    { name: 'Assessment.FullName', id: 'Assessment_FullName', label: 'Patient Name' },
                    { name: 'Assessment.ContactNumber', id: 'Assessment_ContactNumber', label: 'Contact Number' }
                ];
                
                requiredFields.forEach(field => {
                    const $field = $(`#${field.id}`);
                    const value = $field.val();
                    console.log(`Validating ${field.label} (${field.name}): value="${value}"`);
                    
                    if (!value || value.trim() === '') {
                        isValid = false;
                        missingFields.push(field.label);
                        $field.addClass('is-invalid');
                        if (!firstInvalidField) {
                            firstInvalidField = $field;
                        }
                        console.log(`MISSING REQUIRED FIELD: ${field.label}`);
                    } else {
                        $field.removeClass('is-invalid');
                        console.log(`✓ ${field.label} has value: "${value}"`);
                    }
                });
                
                // Also check all other required fields
                $('input[required], select[required], textarea[required]').each(function() {
                    var $field = $(this);
                    var value = $field.val();
                    var fieldName = $field.attr('name') || $field.attr('id');
                    
                    // Skip if we already checked this field above
                    if (requiredFields.some(f => f.id === fieldName || f.name === fieldName)) {
                        return;
                    }
                    
                    console.log(`Validating field ${fieldName}: value="${value}"`);
                    
                    if (!value || value.trim() === '') {
                        isValid = false;
                        missingFields.push(fieldName);
                        $field.addClass('is-invalid');
                        if (!firstInvalidField) {
                            firstInvalidField = $field;
                        }
                        console.log(`MISSING REQUIRED FIELD: ${fieldName}`);
                    } else {
                        $field.removeClass('is-invalid');
                    }
                });
                
                // Validate specific fields
                var phoneNumber = $('input[name="Assessment.ContactNumber"]').val();
                if (phoneNumber && !/^\d{11}$/.test(phoneNumber.replace(/\D/g, ''))) {
                    isValid = false;
                    $('input[name="Assessment.ContactNumber"]').addClass('is-invalid');
                    if (!firstInvalidField) {
                        firstInvalidField = $('input[name="Assessment.ContactNumber"]');
                    }
                    console.log('INVALID PHONE NUMBER:', phoneNumber);
                }
                
                if (!isValid) {
                    console.log('=== VALIDATION FAILED ===');
                    console.log('Missing fields:', missingFields);
                    
                    // TEMPORARY: Skip validation for testing
                    console.log('=== SKIPPING VALIDATION FOR TESTING ===');
                    isValid = true;
                    
                    // Scroll to first invalid field
                    if (firstInvalidField) {
                        $('html, body').animate({
                            scrollTop: firstInvalidField.offset().top - 100
                        }, 500);
                    }
                    
                    // Comment out the validation error for testing
                    /*
                    Swal.fire({
                        title: 'Validation Error',
                        text: `Please fill in all required fields correctly. Missing: ${missingFields.join(', ')}`,
                        icon: 'error',
                        confirmButtonText: 'OK'
                    });
                    return;
                    */
                }
                
                console.log('=== VALIDATION PASSED ===');
                
                // Show loading
                Swal.fire({
                    title: 'Submitting...',
                    text: 'Please wait while we save your assessment.',
                    allowOutsideClick: false,
                    showConfirmButton: false,
                    willOpen: () => {
                        Swal.showLoading();
                    }
                });
                
                // Submit form
                var formData = $(this).serialize();
                console.log('=== FORM DATA BEING SENT ===');
                console.log('Form data:', formData);
                
                // Log all form fields for debugging
                console.log('=== ALL FORM FIELD VALUES ===');
                $(this).find('input, select, textarea').each(function() {
                    var fieldName = $(this).attr('name') || $(this).attr('id');
                    var fieldValue = $(this).val();
                    var fieldType = $(this).attr('type') || $(this).prop('tagName').toLowerCase();
                    var isChecked = $(this).is(':checked');
                    
                    if (fieldValue || isChecked) {
                        console.log(`${fieldName} (${fieldType}): "${fieldValue}" (checked: ${isChecked})`);
                    }
                });
                
                $.ajax({
                    url: window.location.pathname,
                    type: 'POST',
                    data: formData,
                    success: function(response) {
                        console.log('=== AJAX SUCCESS ===');
                        console.log('Success response:', response);
                        
                        // Check if the response indicates success
                        if (response && response.success === true) {
                            Swal.fire({
                                title: 'Success!',
                                text: 'Your HEEADSSS assessment has been submitted successfully.',
                                icon: 'success',
                                confirmButtonText: 'OK'
                            }).then(() => {
                                window.location.href = '/User/Appointments';
                            });
                        } else {
                            // Handle backend error response
                            const errorMessage = response && response.error ? response.error : 'An error occurred while saving the assessment.';
                            console.error('Backend error:', errorMessage);
                            Swal.fire({
                                title: 'Error',
                                text: errorMessage,
                                icon: 'error',
                                confirmButtonText: 'OK'
                            });
                        }
                    },
                    error: function(xhr) {
                        console.log('=== AJAX ERROR ===');
                        console.error('Error response:', xhr);
                        console.error('Error status:', xhr.status);
                        console.error('Error text:', xhr.responseText);
                        
                        let errorMessage = 'An error occurred while submitting your assessment. Please try again.';
                        
                        if (xhr.responseText) {
                            try {
                                const errorResponse = JSON.parse(xhr.responseText);
                                errorMessage = errorResponse.error || errorMessage;
                            } catch (e) {
                                // Use default error message
                            }
                        }
                        
                        Swal.fire({
                            title: 'Error',
                            text: errorMessage,
                            icon: 'error',
                            confirmButtonText: 'OK'
                        });
                    }
                });
            });
            
            // Real-time validation
            $('input[required], select[required], textarea[required]').on('blur', function() {
                var $field = $(this);
                var value = $field.val();
                
                if (!value || value.trim() === '') {
                    $field.addClass('is-invalid');
                } else {
                    $field.removeClass('is-invalid');
                }
            });
            
            // Validation for "Referred by" field - letters and spaces only
            $('#referredByInput').on('input', function() {
                let value = this.value;
                // Remove any characters that are not letters or spaces
                value = value.replace(/[^A-Za-z\s]/g, '');
                this.value = value;
            });
            
            // Validation for "PhilHealth PIN" field - numbers only
            $('#philHealthPINInput').on('input', function() {
                let value = this.value;
                // Remove any characters that are not numbers
                value = value.replace(/[^0-9]/g, '');
                this.value = value;
            });
            
            // Function to show navigation warning with options
            function showNavigationWarning(event) {
                if (event) {
                    event.preventDefault();
                    event.returnValue = '';
                }
                
                // Use SweetAlert2 if available
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        title: 'Leave Assessment Form?',
                        text: 'You want to leave? Continue later or cancel the appointment.',
                        icon: 'question',
                        showCancelButton: true,
                        showDenyButton: true,
                        confirmButtonText: 'Continue Later',
                        denyButtonText: 'Cancel Appointment',
                        cancelButtonText: 'Stay on Form',
                        confirmButtonColor: '#17a2b8',
                        denyButtonColor: '#dc3545',
                        cancelButtonColor: '#6c757d'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            // User chose "Continue Later" - go to appointments page
                            console.log('User chose to continue later');
                            window.location.href = '/User/Appointments';
                        } else if (result.isDenied) {
                            // User chose "Cancel Appointment" - cancel the appointment and go to appointments page
                            console.log('User chose to cancel appointment');
                            
                            // Get appointment ID from URL
                            const urlParams = new URLSearchParams(window.location.search);
                            const appointmentId = urlParams.get('appointmentId');
                            
                            if (appointmentId) {
                                // Call API to cancel the appointment
                                fetch(`/User/HEEADSSSAssessment?handler=CancelAppointment&appointmentId=${appointmentId}`, {
                                    method: 'POST',
                                    headers: {
                                        'Content-Type': 'application/json',
                                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                                    }
                                }).then(response => response.json()).then(data => {
                                    console.log('Appointment cancellation response:', data);
                                    if (data.success) {
                                        console.log('Appointment cancelled successfully');
                                    } else {
                                        console.error('Failed to cancel appointment:', data.error);
                                    }
                                    // Redirect to appointments page regardless of API response
                                    window.location.href = '/User/Appointments';
                                }).catch(error => {
                                    console.error('Error cancelling appointment:', error);
                                    // Still redirect even if cancellation fails
                                    window.location.href = '/User/Appointments';
                                });
                            } else {
                                // No appointment ID, just redirect
                                window.location.href = '/User/Appointments';
                            }
                        } else {
                            // User chose "Stay on Form" - do nothing, stay on page
                            console.log('User chose to stay on form');
                        }
                    });
                } else {
                    // Fallback to browser confirm if SweetAlert2 fails
                    console.error('SweetAlert2 not available, using browser confirm');
                    const choice = confirm('You want to leave? Continue later or cancel the appointment.');
                    if (choice) {
                        window.location.href = '/User/Appointments';
                    }
                }
                
                return false;
            }
            
            // Add click listeners to navigation links
            function addNavigationListeners() {
                // Listen for clicks on navigation links
                document.addEventListener('click', function(event) {
                    const target = event.target.closest('a');
                    if (target && target.href && !target.href.includes('javascript:')) {
                        // Check if it's a navigation link (not a form submission)
                        if (!target.closest('form') && !target.classList.contains('btn-submit')) {
                            showNavigationWarning(event);
                            return false;
                        }
                    }
                });
            }
            
            // Initialize navigation listeners
            addNavigationListeners();
        });
    </script>
}