@page
@model Barangay.Pages.User.HEEADSSSAssessmentModel
@{
    ViewData["Title"] = "HEEADSSS Health Assessment";
    Layout = "~/Pages/Shared/_UserLayout.cshtml";
    ViewData["ShowDashboardNav"] = true;
}

@section Styles {
    <style>
        /* Scoped variables for this page */
        :root {
            --primary-color: #FF8C42;
            --secondary-color: #6c757d;
            --background-color: #f8f9fa;
            --form-bg-color: #ffffff;
            --text-color: #333;
            --border-color: #dee2e6;
            --danger-color: #dc3545;
        }

        /* Page-scoped container styles */
        .heeadsss-container {
            max-width: 900px;
            margin: 0 auto;
            background: var(--form-bg-color);
            padding: 2rem;
            border-radius: 8px;
            box-shadow: 0 0 15px rgba(0,0,0,0.1);
        }

        .heeadsss-container h1,
        .heeadsss-container h2,
        .heeadsss-container h3 {
            color: var(--primary-color);
            border-bottom: 2px solid var(--border-color);
            padding-bottom: 10px;
            margin-bottom: 20px;
        }

        .heeadsss-container .form-section {
            margin-bottom: 2rem;
            padding: 1.5rem;
            border: 1px solid var(--border-color);
            border-radius: 5px;
            background: #fff;
        }
        
        .form-label.required::after {
            content: " *";
            color: red;
        }
        
        .age-indicator {
            background: #FF8C42;
            color: white;
            padding: 8px 16px;
            border-radius: 20px;
            display: inline-block;
            margin-bottom: 20px;
            font-weight: bold;
        }
        
        /* Wizard navigation buttons */
        .wizard-nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 1.5rem;
        }
        
        .wizard-nav .prev-step {
            order: 1;
        }
        
        .wizard-nav .next-step,
        .wizard-nav button[type="submit"] {
            order: 2;
            margin-left: auto;
        }
    </style>
}

<div class="container heeadsss-container">
    <h1>HEEADSSS Health Assessment Form (for 10–19 years old)</h1>
    
    
    @{
        var patientAge = ViewData["PatientAge"] as int? ?? 19;
    }
    
    @if (patientAge < 10 || patientAge > 19)
    {
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle me-2"></i>
            <strong>Age Restriction Notice:</strong> This HEEADSSS assessment is designed for patients aged 10-19 years old. 
            Your current age (@patientAge years) is outside this recommended range. 
            Please consult with your healthcare provider about the appropriate assessment form for your age group.
        </div>
    }

    <form method="post" id="heeadsssForm" class="wizard-form">
    <!-- Wizard Stepper Indicator -->
    <div id="wizard-stepper" class="mb-4"></div>
    @Html.AntiForgeryToken()
    <!-- Hidden fields -->
    <input type="hidden" asp-for="Assessment.UserId" />
    <input type="hidden" asp-for="Assessment.HealthFacility" />
    <input type="hidden" asp-for="Assessment.FamilyNo" />
    <input type="hidden" asp-for="Assessment.AppointmentId" />
    <input type="hidden" asp-for="Assessment.Age" />
    <input type="hidden" asp-for="Assessment.Birthday" />

    <!-- Step 1: Demographics/Intro -->
    <div class="wizard-step" data-step="1">

        <!-- Header Section -->
        <div class="form-section">
            <div class="row">
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">Date of Registration:</label>
                        <input type="text" class="form-control" value="@DateTime.Now.ToString("MM/dd/yyyy")" readonly />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">Client No.:</label>
                        <div class="d-flex">
                            <input type="text" class="form-control" asp-for="Assessment.FamilyNo" id="client-no" />
                            <button type="button" id="generate-client-no" class="btn btn-secondary ms-2">Generate</button>
                        </div>
                        <small class="form-text text-muted">If you have a family number, enter it or click Generate to create a new one.</small>
                        <small class="form-text text-info" id="client-generator-info" style="display: none;"></small>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">Referred by:</label>
                        <input type="text" class="form-control" asp-for="Assessment.ReferredBy" />
                    </div>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Options:</label>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="IsNHPTS" onchange="updateCheckboxValue('IsNHPTS', 'Assessment.IsNHPTS')" />
                    <input type="hidden" asp-for="Assessment.IsNHPTS" />
                    <label class="form-check-label" for="IsNHPTS">NHTS</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="Is4Ps" onchange="updateCheckboxValue('Is4Ps', 'Assessment.Is4Ps')" />
                    <input type="hidden" asp-for="Assessment.Is4Ps" />
                    <label class="form-check-label" for="Is4Ps">4Ps</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="IsPhilHealthBeneficiaryOnly" onchange="updateCheckboxValue('IsPhilHealthBeneficiaryOnly', 'Assessment.IsPhilHealthBeneficiaryOnly')" />
                    <input type="hidden" asp-for="Assessment.IsPhilHealthBeneficiaryOnly" />
                    <label class="form-check-label" for="IsPhilHealthBeneficiaryOnly">PhilHealth Beneficiary Only</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="IsOwnPhilHealth" onchange="updateCheckboxValue('IsOwnPhilHealth', 'Assessment.IsOwnPhilHealth')" />
                    <input type="hidden" asp-for="Assessment.IsOwnPhilHealth" />
                    <label class="form-check-label" for="IsOwnPhilHealth">Own PhilHealth / PIN:</label>
                    <input type="text" class="form-control d-inline-block ms-2" style="width: 200px;" asp-for="Assessment.PhilHealthPIN" id="philHealthPINInput" />
                    <small class="form-text text-muted d-block ms-2">Numbers only</small>
                </div>
            </div>
        </div>
        <!-- Confidentiality Notice -->
        <div class="form-section">
            <h3>Palaala</h3>
            <div class="alert alert-info">
                <p><strong>Pamantayan ng klinika na ito na panatilihing CONFIDENTIAL o SIKRETO ang mga impormasyong personal.</strong> Ang iyong sagot ay hindi ibabahagi kaninuman, maliban kung kinakailangan upang matulungan ka sa mga sitwasyong tulad ng:</p>
                <ul>
                    <li>Ang kabataan ay may planong saktan ang sarili o iba.</li>
                    <li>Biktima ng pang-aabuso.</li>
                    <li>Sangkot sa krimen o iba pang aktibidad na may kaugnayan sa batas.</li>
                </ul>
            </div>
        </div>
        <!-- Profile Section -->
        <div class="form-section">
            <h3>1. Profile</h3>
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Health Facility</label>
                        <input type="text" class="form-control" value="Baesa Health Center" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Date of Assessment</label>
                        <input type="text" class="form-control" value="@DateTime.Now.ToString("MM/dd/yyyy")" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">Birthday</label>
                        <input type="date" class="form-control" asp-for="Assessment.Birthday" value="@ViewData["PatientBirthdate"]" required readonly style="background-color: #e9ecef;" />
                        <span asp-validation-for="Assessment.Birthday" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label required">Patient Name</label>
                        <input type="text" class="form-control" asp-for="Assessment.FullName" value="@ViewData["PatientName"]" required readonly style="background-color: #e9ecef;" />
                        <span asp-validation-for="Assessment.FullName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Family No.</label>
                        <div class="d-flex">
                            <input type="text" class="form-control" asp-for="Assessment.FamilyNo" id="family-no" />
                            <button type="button" id="generate-family-no" class="btn btn-secondary ms-2">Generate</button>
                        </div>
                        <small class="form-text text-muted">If you have a family number, enter it or click Generate to create a new one.</small>
                        <small class="form-text text-info" id="family-generator-info" style="display: none;"></small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">Contact Number</label>
                        <input type="text" class="form-control" asp-for="Assessment.ContactNumber" value="@ViewData["PatientPhone"]" required readonly style="background-color: #e9ecef;" />
                        <small class="form-text text-muted">11 digits only, Philippine format (e.g. 09123456789)</small>
                        <span asp-validation-for="Assessment.ContactNumber" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>
        <div class="wizard-nav mt-3">
            <button type="button" class="btn btn-primary next-step">Next</button>
        </div>
    </div>

    <!-- Step 2: Psychosocial/Home/Education -->
    <div class="wizard-step" data-step="2" style="display:none;">
        <div class="form-section">
            <h3>C. Psychosocial History and Assessment</h3>
            <p><em>Ang matatapat mong kasagutan ay makakatulong upang makapagbigay ng tamang pangangalaga.</em></p>
        </div>
        <div class="form-section">
            <h3>HOME</h3>
            <div class="mb-3">
                <label class="form-label">Meron bang problema sa inyong pamilya na maaring makaapekto sa iyo?</label>
                <textarea class="form-control" asp-for="Assessment.HomeFamilyProblems" rows="3"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">Pinakikitaan ka ba ng iyong mga magulang o guardian sa tuwing may problema ka?</label>
                <textarea class="form-control" asp-for="Assessment.HomeParentalListening" rows="3"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">May pagkakataon bang naisip mong maglayas?</label>
                <textarea class="form-control" asp-for="Assessment.HomeRunawayThoughts" rows="3"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">Sa nakaraang taon, may pagbabago ba sa loob ng iyong pamilya?</label>
                <textarea class="form-control" asp-for="Assessment.HomeFamilyChanges" rows="3"></textarea>
            </div>
        </div>
        <div class="form-section">
            <h3>EDUCATION</h3>
            <div class="mb-3">
                <label class="form-label">Ikaw ba ay kasalukuyang nag-aaral?</label>
                <textarea class="form-control" asp-for="Assessment.EducationCurrentlyStudying" rows="3"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">Ikaw ba ay nagtatrabaho? Kung oo, anong trabaho?</label>
                <textarea class="form-control" asp-for="Assessment.EducationWorking" rows="3"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">May problema ka ba sa iskuwela o trabaho?</label>
                <textarea class="form-control" asp-for="Assessment.EducationSchoolWorkProblems" rows="3"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">Nakaranas ka bang ma-api (bully) sa iskuwela o ibang pagkakataon?</label>
                <textarea class="form-control" asp-for="Assessment.EducationBullyingExperience" rows="3"></textarea>
            </div>
        </div>
        <div class="wizard-nav mt-3">
            <button type="button" class="btn btn-secondary prev-step">Previous</button>
            <button type="button" class="btn btn-primary next-step">Next</button>
        </div>
    </div>

    <!-- Step 3: Eating/Activities -->
    <div class="wizard-step" data-step="3" style="display:none;">
        <div class="form-section">
            <h3>EATING HABITS</h3>
            <div class="mb-3">
                <label class="form-label">Kuntento ka ba sa iyong itsura, anyo, o kasalukuyang timbang?</label>
                <textarea class="form-control" asp-for="Assessment.EatingBodyImageSatisfaction" rows="3"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">Sinubukan mo na bang magbawas ng timbang sa pamamagitan ng:</label>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="EatingVomiting" onchange="updateCheckboxValue('EatingVomiting', 'Assessment.EatingVomiting')" />
                    <input type="hidden" asp-for="Assessment.EatingVomiting" />
                    <label class="form-check-label" for="EatingVomiting">Pagduwal/pagsuka (vomiting)</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="EatingDietPills" onchange="updateCheckboxValue('EatingDietPills', 'Assessment.EatingDietPills')" />
                    <input type="hidden" asp-for="Assessment.EatingDietPills" />
                    <label class="form-check-label" for="EatingDietPills">Pag-inom ng diet pills</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="EatingLaxatives" onchange="updateCheckboxValue('EatingLaxatives', 'Assessment.EatingLaxatives')" />
                    <input type="hidden" asp-for="Assessment.EatingLaxatives" />
                    <label class="form-check-label" for="EatingLaxatives">Laxatives</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="EatingStarvation" onchange="updateCheckboxValue('EatingStarvation', 'Assessment.EatingStarvation')" />
                    <input type="hidden" asp-for="Assessment.EatingStarvation" />
                    <label class="form-check-label" for="EatingStarvation">Hindi pagkain (starvation)</label>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">May nagpuna na ba na ikaw ay tumaba o pumayat?</label>
                <textarea class="form-control" asp-for="Assessment.EatingWeightComments" rows="3"></textarea>
            </div>
        </div>
        <div class="form-section">
            <h3>ACTIVITIES</h3>
            <div class="mb-3">
                <label class="form-label">Mayroon ka bang sinasalihang sports/libangan sa iskuwela, trabaho o bahay?</label>
                <textarea class="form-control" asp-for="Assessment.ActivitiesParticipation" rows="3"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">Madalas ka bang nag-e-ehersisyo?</label>
                <textarea class="form-control" asp-for="Assessment.ActivitiesRegularExercise" rows="3"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">Madalas ka bang gumamit ng internet/computer o gadgets?</label>
                <textarea class="form-control" asp-for="Assessment.ActivitiesInternetGadgetUse" rows="3"></textarea>
            </div>
        </div>
        <div class="wizard-nav mt-3">
            <button type="button" class="btn btn-secondary prev-step">Previous</button>
            <button type="button" class="btn btn-primary next-step">Next</button>
        </div>
    </div>

    <!-- Step 4: Drugs/Sexuality -->
    <div class="wizard-step" data-step="4" style="display:none;">
        <div class="form-section">
            <h3>DRUGS</h3>
            <div class="mb-3">
                <label class="form-label">Naranasan mo na bang gumamit ng mga sumusunod:</label>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="DrugsTobaccoUse" onchange="updateCheckboxValue('DrugsTobaccoUse', 'Assessment.DrugsTobaccoUse')" />
                    <input type="hidden" asp-for="Assessment.DrugsTobaccoUse" />
                    <label class="form-check-label" for="DrugsTobaccoUse">Tobacco (Sigarilyo)</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="DrugsAlcoholUse" onchange="updateCheckboxValue('DrugsAlcoholUse', 'Assessment.DrugsAlcoholUse')" />
                    <input type="hidden" asp-for="Assessment.DrugsAlcoholUse" />
                    <label class="form-check-label" for="DrugsAlcoholUse">Alcohol (Alak)</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="DrugsStreetDrugs" onchange="updateCheckboxValue('DrugsStreetDrugs', 'Assessment.DrugsStreetDrugs')" />
                    <input type="hidden" asp-for="Assessment.DrugsStreetDrugs" />
                    <label class="form-check-label" for="DrugsStreetDrugs">Street/Prohibited drugs</label>
                </div>
            </div>
        </div>
        <div class="form-section">
            <h3>SEXUALITY</h3>
            <div class="mb-3">
                <label class="form-label">Nababalisa ka ba tungkol sa iyong kalusugan o mga pagbabago sa katawan?</label>
                <textarea class="form-control" asp-for="Assessment.SexualityHealthConcerns" rows="3"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">Ikaw ba ay may karanasan na sa pakikipagtalik?</label>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="SexualityIntimateRelationships" value="Yes" id="SexualityIntimateRelationshipsYes" onchange="updateRadioValue('SexualityIntimateRelationshipsYes', 'Assessment.SexualityIntimateRelationships')" />
                    <input type="hidden" asp-for="Assessment.SexualityIntimateRelationships" />
                    <label class="form-check-label" for="SexualityIntimateRelationshipsYes">Oo</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="SexualityIntimateRelationships" value="No" id="SexualityIntimateRelationshipsNo" onchange="updateRadioValue('SexualityIntimateRelationshipsNo', 'Assessment.SexualityIntimateRelationships')" />
                    <label class="form-check-label" for="SexualityIntimateRelationshipsNo">Hindi</label>
                </div>
                <div class="mt-2">
                    <label class="form-label">Kung Oo, ilan na ang nakatalik mo sa nakaraang taon?</label>
                    <input type="text" class="form-control" asp-for="Assessment.SexualityPartnersCount" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Naisip mo ba na ikaw ay:</label>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="SexualityGay" onchange="updateCheckboxValue('SexualityGay', 'Assessment.SexualityGay')" />
                    <input type="hidden" asp-for="Assessment.SexualityGay" />
                    <label class="form-check-label" for="SexualityGay">Gay</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="SexualityLesbian" onchange="updateCheckboxValue('SexualityLesbian', 'Assessment.SexualityLesbian')" />
                    <input type="hidden" asp-for="Assessment.SexualityLesbian" />
                    <label class="form-check-label" for="SexualityLesbian">Lesbian</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="SexualityBisexual" onchange="updateCheckboxValue('SexualityBisexual', 'Assessment.SexualityBisexual')" />
                    <input type="hidden" asp-for="Assessment.SexualityBisexual" />
                    <label class="form-check-label" for="SexualityBisexual">Bisexual</label>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Ikaw ba ay nakaranas nang magbuntis o makabuntis?</label>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="SexualityPregnancyExperience" value="Yes" id="SexualityPregnancyExperienceYes" onchange="updateRadioValue('SexualityPregnancyExperienceYes', 'Assessment.SexualityPregnancyExperience')" />
                    <input type="hidden" asp-for="Assessment.SexualityPregnancyExperience" />
                    <label class="form-check-label" for="SexualityPregnancyExperienceYes">Oo</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="SexualityPregnancyExperience" value="No" id="SexualityPregnancyExperienceNo" onchange="updateRadioValue('SexualityPregnancyExperienceNo', 'Assessment.SexualityPregnancyExperience')" />
                    <label class="form-check-label" for="SexualityPregnancyExperienceNo">Hindi</label>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Ikaw ba ay nagkaroon na ng nakakahawang sakit dulot ng pakikipagtalik?</label>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="SexualitySTIExperience" value="Yes" id="SexualitySTIExperienceYes" onchange="updateRadioValue('SexualitySTIExperienceYes', 'Assessment.SexualitySTIExperience')" />
                    <input type="hidden" asp-for="Assessment.SexualitySTIExperience" />
                    <label class="form-check-label" for="SexualitySTIExperienceYes">Oo</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="SexualitySTIExperience" value="No" id="SexualitySTIExperienceNo" onchange="updateRadioValue('SexualitySTIExperienceNo', 'Assessment.SexualitySTIExperience')" />
                    <label class="form-check-label" for="SexualitySTIExperienceNo">Hindi</label>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">May ginagamit ka bang proteksyon kapag sa tuwing nakikipagtalik?</label>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="SexualityProtectionUse" value="Yes" id="SexualityProtectionUseYes" onchange="updateRadioValue('SexualityProtectionUseYes', 'Assessment.SexualityProtectionUse')" />
                    <input type="hidden" asp-for="Assessment.SexualityProtectionUse" />
                    <label class="form-check-label" for="SexualityProtectionUseYes">Oo</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="SexualityProtectionUse" value="No" id="SexualityProtectionUseNo" onchange="updateRadioValue('SexualityProtectionUseNo', 'Assessment.SexualityProtectionUse')" />
                    <label class="form-check-label" for="SexualityProtectionUseNo">Hindi</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="SexualityProtectionUse" value="Sometimes" id="SexualityProtectionUseSometimes" onchange="updateRadioValue('SexualityProtectionUseSometimes', 'Assessment.SexualityProtectionUse')" />
                    <label class="form-check-label" for="SexualityProtectionUseSometimes">Minsan</label>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">May nakaranas ba na magbunot o maglunsad laban sa iyo?</label>
                <textarea class="form-control" asp-for="Assessment.SexualityHarassment" rows="3"></textarea>
            </div>
        </div>
        <div class="wizard-nav mt-3">
            <button type="button" class="btn btn-secondary prev-step">Previous</button>
            <button type="button" class="btn btn-primary next-step">Next</button>
        </div>
    </div>

    <!-- Step 5: Safety/Suicide -->
    <div class="wizard-step" data-step="5" style="display:none;">
        <div class="form-section">
            <h3>SAFETY / WEAPONS / VIOLENCE</h3>
            <div class="mb-3">
                <label class="form-label">Ikaw ba ay nakakaranas mahipuan/masuntok/masampal/matulak ng kahit sino?</label>
                <textarea class="form-control" asp-for="Assessment.SafetyPhysicalAbuse" rows="3"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">Nakaranas ka na bang masaktan o takutin ng iyong karelasyon?</label>
                <textarea class="form-control" asp-for="Assessment.SafetyRelationshipViolence" rows="3"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">Gumagamit ka ba ng helmet o protective gear kapag sumasakay ng motor/iba pang sasakyan?</label>
                <textarea class="form-control" asp-for="Assessment.SafetyProtectiveGear" rows="3"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">May kasambahay ka bang nagmamay-ari ng baril o rifle?</label>
                <textarea class="form-control" asp-for="Assessment.SafetyGunsAtHome" rows="3"></textarea>
            </div>
            <div class="mb-3">
