        </div>
        <div class="wizard-nav mt-3">
            <button type="button" class="btn btn-secondary prev-step">Previous</button>
            <button type="button" class="btn btn-primary next-step">Next</button>
        </div>
    </div>

    <!-- Step 6: HopeLine/Notes/Submit -->
    <div class="wizard-step" data-step="6" style="display:none;">
        <div class="form-section">
            <h3>HOPE Line (for suicide prevention and emotional crisis)</h3>
            <div class="alert alert-info text-center">
                <strong>📞 804-4673 (HOPE) / 0917-558-4673 (HOPE)</strong>
