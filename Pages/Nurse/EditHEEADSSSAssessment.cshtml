@page
@model Barangay.Pages.Nurse.EditHEEADSSSAssessmentModel
@{
    ViewData["Title"] = "Edit HEEADSSS Assessment";
    var isDoctor = User.IsInRole("Doctor") || User.IsInRole("Head Doctor") || User.IsInRole("Admin");
    Layout = isDoctor ? "_DoctorLayout" : "~/Pages/Shared/_NurseLayout.cshtml";
}

@section Styles {
    <style>
        /* Scoped variables for this page */
        :root {
            --primary-color: #007bff;
            --secondary-color: #6c757d;
            --background-color: #f8f9fa;
            --form-bg-color: #ffffff;
            --text-color: #333;
            --border-color: #dee2e6;
            --danger-color: #dc3545;
        }

        /* Page-scoped container styles */
        .heeadsss-container {
            max-width: 900px;
            margin: 0 auto;
            background: var(--form-bg-color);
            padding: 2rem;
            border-radius: 8px;
            box-shadow: 0 0 15px rgba(0,0,0,0.1);
        }

        .heeadsss-container h1,
        .heeadsss-container h2,
        .heeadsss-container h3 {
            color: var(--primary-color);
            border-bottom: 2px solid var(--border-color);
            padding-bottom: 10px;
            margin-bottom: 20px;
        }

        .heeadsss-container .form-section {
            margin-bottom: 2rem;
            padding: 1.5rem;
            border: 1px solid var(--border-color);
            border-radius: 5px;
            background: #fff;
        }
        
        .form-label.required::after {
            content: " *";
            color: red;
        }
        
        .age-indicator {
            background: #007bff;
            color: white;
            padding: 8px 16px;
            border-radius: 20px;
            display: inline-block;
            margin-bottom: 20px;
            font-weight: bold;
        }
        
        .is-invalid {
            border-color: #dc3545 !important;
            box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25) !important;
        }
    </style>
}

<div class="container heeadsss-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="m-0">
            <i class="fas fa-edit text-primary me-2"></i>
            Edit HEEADSSS Assessment
        </h1>
        @if (isDoctor)
        {
            <a href="/Doctor/Consultation?id=@Model.Assessment.AppointmentId" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i>
                Back to Consultation
            </a>
        }
        else
        {
            <a href="/Nurse/AppointmentDetails?id=@Model.Assessment.AppointmentId" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i>
                Back to Appointment
            </a>
        }
    </div>

    @if (!string.IsNullOrEmpty(TempData["StatusMessage"]?.ToString()))
    {
        <div class="alert @(TempData["StatusMessage"].ToString().Contains("Error") ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
            @TempData["StatusMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!form method="post" id="heeadsssAssessmentForm">
        @Html.AntiForgeryToken()
        <input asp-for="Assessment.AppointmentId" type="hidden" />
        <input asp-for="Assessment.UserId" type="hidden" />

        <!-- Header Section -->
        <div class="form-section">
            <div class="row">
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">Date of Registration:</label>
                        <input type="text" class="form-control" value="@DateTime.Now.ToString("MM/dd/yyyy")" readonly />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">Client No.:</label>
                        <input type="text" class="form-control" asp-for="Assessment.FamilyNo" id="family-no" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">Referred by:</label>
                        <input type="text" class="form-control" asp-for="Assessment.ReferredBy" />
                    </div>
                </div>
            </div>
            
            <div class="mb-3">
                <label class="form-label">Options:</label>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="IsNHPTS" onchange="updateCheckboxValue('IsNHPTS', 'Assessment.IsNHPTS')" />
                    <input type="hidden" asp-for="Assessment.IsNHPTS" />
                    <label class="form-check-label" for="IsNHPTS">NHTS</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="Is4Ps" onchange="updateCheckboxValue('Is4Ps', 'Assessment.Is4Ps')" />
                    <input type="hidden" asp-for="Assessment.Is4Ps" />
                    <label class="form-check-label" for="Is4Ps">4Ps</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="IsPhilHealthBeneficiaryOnly" onchange="updateCheckboxValue('IsPhilHealthBeneficiaryOnly', 'Assessment.IsPhilHealthBeneficiaryOnly')" />
                    <input type="hidden" asp-for="Assessment.IsPhilHealthBeneficiaryOnly" />
                    <label class="form-check-label" for="IsPhilHealthBeneficiaryOnly">PhilHealth Beneficiary Only</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="IsOwnPhilHealth" onchange="updateCheckboxValue('IsOwnPhilHealth', 'Assessment.IsOwnPhilHealth')" />
                    <input type="hidden" asp-for="Assessment.IsOwnPhilHealth" />
                    <label class="form-check-label" for="IsOwnPhilHealth">Own PhilHealth / PIN:</label>
                    <input type="text" class="form-control d-inline-block ms-2" style="width: 200px;" asp-for="Assessment.PhilHealthPIN" />
                </div>
            </div>
        </div>

        <!-- Confidentiality Notice -->
        <div class="form-section">
            <h3>Palaala</h3>
            <div class="alert alert-info">
                <p><strong>Pamantayan ng klinika na ito na panatilihing CONFIDENTIAL o SIKRETO ang mga impormasyong personal.</strong> Ang iyong sagot ay hindi ibabahagi kaninuman, maliban kung kinakailangan upang matulungan ka sa mga sitwasyong tulad ng:</p>
                <ul>
                    <li>Ang kabataan ay may planong saktan ang sarili o iba.</li>
                    <li>Biktima ng pang-aabuso.</li>
                    <li>Sangkot sa krimen o iba pang aktibidad na may kaugnayan sa batas.</li>
                </ul>
            </div>
        </div>

        <!-- Profile Section -->
        <div class="form-section">
            <h3>1. Profile</h3>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Health Facility</label>
                        <input type="text" class="form-control" value="Baesa Health Center" readonly />
                    </div>
                
                    <div class="mb-3">
                        <label class="form-label">Date of Assessment</label>
                        <input type="text" class="form-control" value="@DateTime.Now.ToString("MM/dd/yyyy")" readonly />
                    </div>
                
                    <div class="mb-3">
                        <label class="form-label required">Birthday</label>
                        <input type="date" class="form-control" asp-for="Assessment.Birthday" required />
                    </div>
                </div>
                
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label required">Patient Name</label>
                        <input type="text" class="form-control" asp-for="Assessment.FullName" required />
                        <span asp-validation-for="Assessment.FullName" class="text-danger"></span>
                    </div>
                
                    <div class="mb-3">
                        <label class="form-label">Family No.</label>
                        <div class="d-flex">
                            <input type="text" class="form-control" asp-for="Assessment.FamilyNo" id="family-no" />
                            <button type="button" id="generate-family-no" class="btn btn-secondary ms-2">Generate</button>
                        </div>
                        <small class="form-text text-muted">If you have a family number, enter it or click Generate to create a new one.</small>
                    </div>
                
                    <div class="mb-3">
                        <label class="form-label required">Contact Number</label>
                        <input type="text" class="form-control" asp-for="Assessment.ContactNumber" required />
                        <span asp-validation-for="Assessment.ContactNumber" class="text-danger"></span>
                        <small class="form-text text-muted">11 digits only, Philippine format (e.g. 09123456789)</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- B. Adolescent Health Information Section -->
        <div class="form-section">
            <h3>B. ADOLESCENT HEALTH INFORMATION</h3>
            
            <!-- Measurements -->
            <div class="row">
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">Height (cm)</label>
                        <input type="text" class="form-control" asp-for="Assessment.Height" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">Weight (kg)</label>
                        <input type="text" class="form-control" asp-for="Assessment.Weight" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">BMI (kg/m²)</label>
                        <input type="text" class="form-control" asp-for="Assessment.BMI" readonly />
                    </div>
                </div>
            </div>
            
            <div class="mb-3">
                <label class="form-label">BMI Status:</label>
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="bmiStatus" id="BMIUnderweight" onchange="updateBMIRadioValue('Underweight')" />
                            <input type="hidden" asp-for="Assessment.BMIUnderweight" />
                            <label class="form-check-label" for="BMIUnderweight">Underweight</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="bmiStatus" id="BMINormal" onchange="updateBMIRadioValue('Normal')" />
                            <input type="hidden" asp-for="Assessment.BMINormal" />
                            <label class="form-check-label" for="BMINormal">Normal</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="bmiStatus" id="BMIOverweight" onchange="updateBMIRadioValue('Overweight')" />
                            <input type="hidden" asp-for="Assessment.BMIOverweight" />
                            <label class="form-check-label" for="BMIOverweight">Overweight</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="bmiStatus" id="BMIObese" onchange="updateBMIRadioValue('Obese')" />
                            <input type="hidden" asp-for="Assessment.BMIObese" />
                            <label class="form-check-label" for="BMIObese">Obese</label>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Immunization Status + For Females Only (top-right) -->
            <div class="mb-3">
                <div class="row">
                    <div class="col-md-8">
                        <label class="form-label">Immunization Status:</label>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label class="form-label">MR/MMR date given:</label>
                                    <input type="date" class="form-control" asp-for="Assessment.ImmunizationMR" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label class="form-label">Td date given:</label>
                                    <input type="date" class="form-control" asp-for="Assessment.ImmunizationTd" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label class="form-label">HPV date given:</label>
                                    <input type="date" class="form-control" asp-for="Assessment.ImmunizationHPV" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div id="female-only-section" style="display: none;">
                            <label class="form-label">For Females Only: (if applicable)</label>
                            <div class="mb-2">
                                <label class="form-label">Date of Menarche:</label>
                                <input type="date" class="form-control" asp-for="Assessment.DateOfMenarche" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label">Age of 1st Pregnancy:</label>
                                <input type="text" class="form-control" asp-for="Assessment.AgeOfFirstPregnancy" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label">OB Score:</label>
                                <input type="text" class="form-control" asp-for="Assessment.OBScore" placeholder="G__ P__ (__ __ __ __)" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Vital Signs and Medical Information -->
        <div class="form-section">
            <div class="row">
                <div class="col-md-6">
                    <!-- Vital Signs -->
                    <h4>Vital Signs</h4>
                    <div class="table-responsive">
                        <table class="table table-bordered" style="width: 100%;">
                            <tr>
                                <td style="width: 50%;"><strong>Temp</strong></td>
                                <td><input type="text" class="form-control form-control-sm" asp-for="Assessment.VitalTemp" /></td>
                            </tr>
                            <tr>
                                <td><strong>RR</strong></td>
                                <td><input type="text" class="form-control form-control-sm" asp-for="Assessment.VitalRR" /></td>
                            </tr>
                            <tr>
                                <td><strong>PR/CR</strong></td>
                                <td><input type="text" class="form-control form-control-sm" asp-for="Assessment.VitalPR" /></td>
                            </tr>
                            <tr>
                                <td><strong>BP</strong></td>
                                <td><input type="text" class="form-control form-control-sm" asp-for="Assessment.VitalBP" /></td>
                            </tr>
                        </table>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Chief Complaint:
                        <textarea class="form-control" asp-for="Assessment.ChiefComplaint" rows="3"></textarea>
                    </div>
                    
                    <div class="mb-3">
                        <label class="label">History of Present Illness:</label>
                        <textarea class="form-control" asp-for="Assessment.HistoryOfPresentIllness" rows="3"></textarea>
                    </div>
                </div>
                
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Pertinent Physical Examination Findings:</label>
                        <textarea class="form-control" asp-for="Assessment.PhysicalExaminationFindings" rows="13"></textarea>
                    </div>
                </div>
            </div>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Past Medical History:</label>
                        <textarea class="form-control" asp-for="Assessment.PastMedicalHistory" rows="3"></textarea>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Working Diagnosis:</label>
                        <textarea class="form-control" asp-for="Assessment.WorkingDiagnosis" rows="3"></textarea>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Management:</label>
                        <textarea class="form-control" asp-for="Assessment.Management" rows="3"></textarea>
                    </div>
                </div>
                
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Family History:</label>
                        <textarea class="form-control" asp-for="Assessment.FamilyHistory" rows="9"></textarea>
                    </div>
                </div>
            </div>
            
            <!-- Referral Information -->
            <div class="row">
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">Referred to:</label>
                        <input type="text" class="form-control" asp-for="Assessment.ReferredTo" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">Reason for Referral:</label>
                        <input type="text" class="form-control" asp-for="Assessment.ReasonForReferral" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">Follow-up Date:</label>
                        <input type="date" class="form-control" asp-for="Assessment.FollowUpDate" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Psychosocial History Header -->
        <div class="form-section">
            <h3>C. Psychosocial History and Assessment</h3>
            <p><em>Ang matatapat mong kasagutan ay makakatulong upang makapagbigay ng tamang pangangalaga.</em></p>
        </div>

        <!-- HOME Section -->
        <div class="form-section">
            <h3>HOME</h3>
            
            <div class="mb-3">
                <label class="form-label">Meron bang problema sa inyong pamilya na maaring makaapekto sa iyo?</label>
                <textarea class="form-control" asp-for="Assessment.HomeFamilyProblems" rows="3"></textarea>
            </div>
            
            <div class="mb-3">
                <label class="form-label">Pinakikitaan ka ba ng iyong mga magulang o guardian sa tuwing may problema ka?</label>
                <textarea class="form-control" asp-for="Assessment.HomeParentalListening" rows="3"></textarea>
            </div>
            
            <div class="mb-3">
                <label class="form-label">May pagkakataon bang naisip mong maglayas?</label>
                <textarea class="form-control" asp-for="Assessment.HomeRunawayThoughts" rows="3"></textarea>
            </div>
            
            <div class="mb-3">
                <label class="form-label">Pinakikitaan ka ba ng iyong mga magulang o guardian sa tuwing may problema ka?</label>
                <textarea class="form-control" asp-for="Assessment.HomeParentalBlame" rows="3"></textarea>
            </div>
            
            <div class="mb-3">
                <label class="form-label">Sa nakaraang taon, may pagbabago ba sa loob ng iyong pamilya?</label>
                <textarea class="form-control" asp-for="Assessment.HomeFamilyChanges" rows="3"></textarea>
            </div>
        </div>

        <!-- EDUCATION Section -->
        <div class="form-section">
            <h3>EDUCATION</h3>
            
            <div class="mb-3">
                <label class="form-label">Ikaw ba ay kasalukuyang nag-aaral?</label>
                <textarea class="form-control" asp-for="Assessment.EducationCurrentlyStudying" rows="3"></textarea>
            </div>
            
            <div class="mb-3">
                <label class="form-label">Ikaw ba ay nagtatrabaho? Kung oo, anong trabaho?</label>
                <textarea class="form-control" asp-for="Assessment.EducationWorking" rows="3"></textarea>
            </div>
            
            <div class="mb-3">
                <label class="form-label">May problema ka ba sa iskuwela o trabaho?</label>
                <textarea class="form-control" asp-for="Assessment.EducationSchoolWorkProblems" rows="3"></textarea>
            </div>
            
            <div class="mb-3">
                <label class="form-label">Nakaranas ka bang ma-api (bully) sa iskuwela o ibang pagkakataon?</label>
                <textarea class="form-control" asp-for="Assessment.EducationBullyingExperience" rows="3"></textarea>
            </div>
            
            <div class="mb-3">
                <label class="form-label">Nakaranas ka bang ma-api (bully) sa iskuwela o ibang pagkakataon?</label>
                <textarea class="form-control" asp-for="Assessment.EducationBullying" rows="3"></textarea>
            </div>
        </div>

        <!-- EATING HABITS Section -->
        <div class="form-section">
            <h3>EATING HABITS</h3>
                
            <div class="mb-3">
                <label class="form-label">Kuntento ka ba sa iyong itsura, anyo, o kasalukuyang timbang?</label>
                <textarea class="form-control" asp-for="Assessment.EatingBodyImageSatisfaction" rows="3"></textarea>
            </div>
            
            <div class="mb-3">
                <label class="form-label">Sinubukan mo na bang magbawas ng timbang sa pamamagitan ng:</label>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="EatingVomiting" onchange="updateCheckboxValue('EatingVomiting', 'Assessment.EatingVomiting')" />
                    <input type="hidden" asp-for="Assessment.EatingVomiting" />
                    <label class="form-check-label" for="EatingVomiting">Pagduwal/pagsuka (vomiting)</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="EatingDietPills" onchange="updateCheckboxValue('EatingDietPills', 'Assessment.EatingDietPills')" />
                    <input type="hidden" asp-for="Assessment.EatingDietPills" />
                    <label class="form-check-label" for="EatingDietPills">Pag-inom ng diet pills</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="EatingLaxatives" onchange="updateCheckboxValue('EatingLaxatives', 'Assessment.EatingLaxatives')" />
                    <input type="hidden" asp-for="Assessment.EatingLaxatives" />
                    <label class="form-check-label" for="EatingLaxatives">Laxatives</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="EatingStarvation" onchange="updateCheckboxValue('EatingStarvation', 'Assessment.EatingStarvation')" />
                    <input type="hidden" asp-for="Assessment.EatingStarvation" />
                    <label class="form-check-label" for="EatingStarvation">Hindi pagkain (starvation)</label>
                </div>
            </div>
            
            <div class="mb-3">
                <label class="form-label">May nagpuna na ba na ikaw ay tumaba o pumayat?</label>
                <textarea class="form-control" asp-for="Assessment.EatingWeightComments" rows="3"></textarea>
            </div>
        </div>

        <!-- ACTIVITIES Section -->
        <div class="form-section">
            <h3>ACTIVITIES</h3>
                
            <div class="mb-3">
                <label class="form-label">Mayroon ka bang sinasalihang sports/libangan sa iskuwela, trabaho o bahay?</label>
                <textarea class="form-control" asp-for="Assessment.ActivitiesParticipation" rows="3"></textarea>
            </div>
            
            <div class="mb-3">
                <label class="form-label">Madalas ka bang nag-e-ehersisyo?</label>
                <textarea class="form-control" asp-for="Assessment.ActivitiesRegularExercise" rows="3"></textarea>
            </div>
            
            <div class="mb-3">
                <label class="form-label">Madalas ka bang gumamit ng internet/computer o gadgets?</label>
                <textarea class="form-control" asp-for="Assessment.ActivitiesInternetGadgetUse" rows="3"></textarea>
            </div>
            
            <div class="mb-3">
                <label class="form-label">Madalas ka bang gumamit ng internet/computer o gadgets?</label>
                <textarea class="form-control" asp-for="Assessment.ActivitiesScreenTime" rows="3"></textarea>
            </div>
        </div>

        <!-- DRUGS Section -->
        <div class="form-section">
            <h3>DRUGS</h3>
                
            <div class="mb-3">
                <label class="form-label">Naranasan mo na bang gumamit ng mga sumusunod:</label>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="DrugsTobaccoUse" onchange="updateCheckboxValue('DrugsTobaccoUse', 'Assessment.DrugsTobaccoUse')" />
                    <input type="hidden" asp-for="Assessment.DrugsTobaccoUse" />
                    <label class="form-check-label" for="DrugsTobaccoUse">Tobacco (Sigarilyo)</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="DrugsAlcoholUse" onchange="updateCheckboxValue('DrugsAlcoholUse', 'Assessment.DrugsAlcoholUse')" />
                    <input type="hidden" asp-for="Assessment.DrugsAlcoholUse" />
                    <label class="form-check-label" for="DrugsAlcoholUse">Alcohol (Alak)</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="DrugsStreetDrugs" onchange="updateCheckboxValue('DrugsStreetDrugs', 'Assessment.DrugsStreetDrugs')" />
                    <input type="hidden" asp-for="Assessment.DrugsStreetDrugs" />
                    <label class="form-check-label" for="DrugsStreetDrugs">Street/Prohibited drugs</label>
                </div>
            </div>
        </div>

        <!-- SEXUALITY Section -->
        <div class="form-section">
            <h3>SEXUALITY</h3>
                
