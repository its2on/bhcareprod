            // BMI Calculation
            $('#Assessment_Height, #Assessment_Weight').on('input', function() {
                const height = parseFloat($('#Assessment_Height').val());
                const weight = parseFloat($('#Assessment_Weight').val());
                
                if (height && weight && height > 0 && weight > 0) {
                    const heightInMeters = height / 100; // Convert cm to meters
                    const bmi = (weight / (heightInMeters * heightInMeters)).toFixed(2);
                    $('#Assessment_BMI').val(bmi);
                    
                    // Auto-select BMI status based on value
                    $('input[name*="BMI"]').prop('checked', false); // Clear all checkboxes
                    
                    if (bmi < 18.5) {
                        $('#BMIUnderweight').prop('checked', true);
                        updateCheckboxValue('BMIUnderweight', 'Assessment.BMIUnderweight');
                    } else if (bmi >= 18.5 && bmi < 25) {
                        $('#BMINormal').prop('checked', true);
                        updateCheckboxValue('BMINormal', 'Assessment.BMINormal');
                    } else if (bmi >= 25 && bmi < 30) {
                        $('#BMIOverweight').prop('checked', true);
                        updateCheckboxValue('BMIOverweight', 'Assessment.BMIOverweight');
                    } else if (bmi >= 30) {
                        $('#BMIObese').prop('checked', true);
