@page
@model Barangay.Pages.Nurse.ImmunizationRecordModel
@using Barangay.Helpers
@{
    ViewData["Title"] = "Immunization Record";
    Layout = "_NurseLayout";
}

@section Styles {
    <style>
        /* Remove spinner controls from all number-like inputs */
        input[type="text"][inputmode="decimal"],
        input[type="text"][inputmode="numeric"],
        input[type="number"] {
            -moz-appearance: textfield;
        }
        
        input[type="text"][inputmode="decimal"]::-webkit-outer-spin-button,
        input[type="text"][inputmode="decimal"]::-webkit-inner-spin-button,
        input[type="text"][inputmode="numeric"]::-webkit-outer-spin-button,
        input[type="text"][inputmode="numeric"]::-webkit-inner-spin-button,
        input[type="number"]::-webkit-outer-spin-button,
        input[type="number"]::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }
    </style>
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="m-0">
            <i class="fas fa-syringe me-2"></i>Immunization Record
        </h2>
        <a href="/Nurse/Appointments" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>
            Back to Appointments
        </a>
    </div>
    
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert @(Model.StatusMessage.Contains("Error") ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.Appointment != null)
    {
        <!-- Appointment Information -->
        <div class="card mb-4">
            <div class="card-header" style="background-color: #ff8c42 !important; color: white !important;">
                <h5 class="mb-0" style="color: white !important;">
                    <i class="fas fa-calendar-check me-2"></i>Appointment Information
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Date:</strong> @DateTimeHelper.GetFormattedDatePhilippine(Model.Appointment.AppointmentDate)</p>
                        <p><strong>Time:</strong> @Model.Appointment.AppointmentTime.Hours.ToString("00"):@Model.Appointment.AppointmentTime.Minutes.ToString("00")</p>
                        <p><strong>Type:</strong> @Model.Appointment.Type</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Parent/Guardian:</strong> @Model.Appointment.PatientName</p>
                        @if (!string.IsNullOrEmpty(Model.Appointment.DependentFullName))
                        {
                            <p><strong>Child:</strong> @Model.Appointment.DependentFullName</p>
                        }
                        <p><strong>Status:</strong> 
                            <span class="badge bg-@(Model.Appointment.Status == AppointmentStatus.Pending ? "warning" : 
                                                   Model.Appointment.Status == AppointmentStatus.InProgress ? "primary" : "success")">
                                @Model.Appointment.Status
                            </span>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Immunization Record Form -->
    <form method="post" asp-page="/Nurse/ImmunizationRecord" asp-route-appointmentId="@Model.AppointmentId" id="immunizationForm" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="AppointmentId" />
        
        <!-- Child Information -->
        <div class="card mb-4">
            <div class="card-header" style="background-color: #ff8c42 !important; color: white !important;">
                <h5 class="mb-0" style="color: white !important;">
                    <i class="fas fa-child me-2"></i>Child Information
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group mb-3">
                            <label asp-for="ChildFirstName" class="form-label">Child's First Name <span class="text-danger">*</span></label>
                            <input asp-for="ChildFirstName" class="form-control" required />
                            <span asp-validation-for="ChildFirstName" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mb-3">
                            <label asp-for="ChildMiddleName" class="form-label">Child's Middle Name</label>
                            <input asp-for="ChildMiddleName" class="form-control" />
                            <span asp-validation-for="ChildMiddleName" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mb-3">
                            <label asp-for="ChildLastName" class="form-label">Child's Last Name <span class="text-danger">*</span></label>
                            <input asp-for="ChildLastName" class="form-control" required />
                            <span asp-validation-for="ChildLastName" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group mb-3">
                            <label asp-for="DateOfBirth" class="form-label">Date of Birth <span class="text-danger">*</span></label>
                            <input asp-for="DateOfBirth" type="date" class="form-control" required />
                            <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mb-3">
                            <label asp-for="PlaceOfBirth" class="form-label">Place of Birth</label>
                            <input asp-for="PlaceOfBirth" class="form-control" />
                            <span asp-validation-for="PlaceOfBirth" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mb-3">
                            <label class="form-label">Current Age</label>
                            <input type="text" class="form-control" id="currentAge" readonly style="background-color: #f8f9fa;" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group mb-3">
                            <label asp-for="Sex" class="form-label">Sex <span class="text-danger">*</span></label>
                            <select asp-for="Sex" class="form-select" required>
                                <option value="">Select Sex</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                            </select>
                            <span asp-validation-for="Sex" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mb-3">
                            <label asp-for="BirthWeight" class="form-label">Birth Weight (kg)</label>
                            <input asp-for="BirthWeight" type="text" class="form-control" inputmode="decimal" maxlength="4" placeholder="e.g., 2.5, 3.2, 4.1" autocomplete="off" />
                            <small class="form-text text-muted">Normal range: 2.5-4.5 kg</small>
                            <span asp-validation-for="BirthWeight" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mb-3">
                            <label asp-for="BirthHeight" class="form-label">Birth Height (cm)</label>
                            <input asp-for="BirthHeight" type="text" class="form-control" inputmode="decimal" maxlength="5" placeholder="e.g., 48, 50, 52" autocomplete="off" />
                            <small class="form-text text-muted">Normal range: 45-55 cm</small>
                            <span asp-validation-for="BirthHeight" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mb-3">
                            <label asp-for="Address" class="form-label">Address</label>
                            <textarea asp-for="Address" class="form-control" rows="1"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Parent Information -->
        <div class="card mb-4">
            <div class="card-header" style="background-color: #ff8c42 !important; color: white !important;">
                <h5 class="mb-0" style="color: white !important;">
                    <i class="fas fa-users me-2"></i>Parent Information
                </h5>
            </div>
            <div class="card-body">
                <!-- Mother Information -->
                <h6 class="text-primary mb-3">Mother's Information</h6>
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group mb-3">
                            <label asp-for="MotherFirstName" class="form-label">Mother's First Name</label>
                            <input asp-for="MotherFirstName" class="form-control" />
                            <span asp-validation-for="MotherFirstName" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mb-3">
                            <label asp-for="MotherMiddleName" class="form-label">Mother's Middle Name</label>
                            <input asp-for="MotherMiddleName" class="form-control" />
                            <span asp-validation-for="MotherMiddleName" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mb-3">
                            <label asp-for="MotherLastName" class="form-label">Mother's Last Name</label>
                            <input asp-for="MotherLastName" class="form-control" />
                            <span asp-validation-for="MotherLastName" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                
                <!-- Father Information -->
                <h6 class="text-primary mb-3">Father's Information</h6>
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group mb-3">
                            <label asp-for="FatherFirstName" class="form-label">Father's First Name</label>
                            <input asp-for="FatherFirstName" class="form-control" />
                            <span asp-validation-for="FatherFirstName" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mb-3">
                            <label asp-for="FatherMiddleName" class="form-label">Father's Middle Name</label>
                            <input asp-for="FatherMiddleName" class="form-control" />
                            <span asp-validation-for="FatherMiddleName" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mb-3">
                            <label asp-for="FatherLastName" class="form-label">Father's Last Name</label>
                            <input asp-for="FatherLastName" class="form-control" />
                            <span asp-validation-for="FatherLastName" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                
                <!-- Contact Information -->
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group mb-3">
                            <label asp-for="ContactNumber" class="form-label">Contact Number</label>
                            <input asp-for="ContactNumber" type="tel" class="form-control" />
                            <span asp-validation-for="ContactNumber" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Health Center Information -->
        <div class="card mb-4">
            <div class="card-header" style="background-color: #ff8c42 !important; color: white !important;">
                <h5 class="mb-0" style="color: white !important;">
                    <i class="fas fa-hospital me-2"></i>Health Center Information
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group mb-3">
                            <label asp-for="HealthCenter" class="form-label">Health Center</label>
                            <input asp-for="HealthCenter" class="form-control" value="Barangay Health Care Center" readonly />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mb-3">
                            <label asp-for="Barangay" class="form-label">Barangay</label>
                            <select asp-for="Barangay" class="form-select" required>
                                <option value="">Select Barangay</option>
                                <option value="158">Barangay 158</option>
                                <option value="159">Barangay 159</option>
                                <option value="160">Barangay 160</option>
                                <option value="161">Barangay 161</option>
                            </select>
                            <span asp-validation-for="Barangay" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mb-3">
                            <label asp-for="FamilyNumber" class="form-label">Family Number</label>
                            <input asp-for="FamilyNumber" id="familyNumberField" class="form-control" readonly style="background-color: #f8f9fa;" />
                            <small class="form-text text-muted">Auto-generated based on family last name</small>
                            
                            @if (string.IsNullOrWhiteSpace(Model.FamilyNumber))
                            {
                                <div class="mt-2" id="familyNumberGenerator">
                                    <button type="button" class="btn btn-sm btn-primary" id="generateFamilyNumberBtn">
                                        <i class="fas fa-plus-circle me-1"></i>Generate Family Number
                                    </button>
                                    <small class="form-text text-muted d-block mt-1">Generate family number based on mother's last name</small>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Vaccines Administered -->
        <div class="card mb-4">
            <div class="card-header" style="background-color: #ff8c42 !important; color: white !important;">
                <h5 class="mb-0" style="color: white !important;">
                    <i class="fas fa-syringe me-2"></i>Vaccines Administered
                </h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th>Vaccine</th>
                                <th>Dose</th>
                                <th>Date Given</th>
                                <th>Remarks</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- BCG Vaccine - 1 dose -->
                            <tr>
                                <td><strong>BCG Vaccine</strong><br><small class="text-muted">At birth</small></td>
                                <td class="text-center">①</td>
                                <td><input asp-for="BCGVaccineDate" type="date" class="form-control form-control-sm" /></td>
                                <td><input asp-for="BCGVaccineRemarks" type="text" class="form-control form-control-sm" placeholder="Return date or notes" /></td>
                            </tr>
                            
                            <!-- Hepatitis B Vaccine - 1 dose -->
                            <tr>
                                <td><strong>Hepatitis B Vaccine</strong><br><small class="text-muted">At birth</small></td>
                                <td class="text-center">①</td>
                                <td><input asp-for="HepBBirthDate" type="date" class="form-control form-control-sm" /></td>
                                <td><input asp-for="HepBBirthRemarks" type="text" class="form-control form-control-sm" placeholder="Return date or notes" /></td>
                            </tr>
                            
                            <!-- Pentavalent Vaccine - 3 doses horizontally -->
                            <tr>
                                <td><strong>Pentavalent Vaccine</strong><br><small class="text-muted">DPT-Hep B-HIB</small><br><small class="text-muted">1½, 2½, 3½ months</small></td>
                                <td class="text-center">③</td>
                                <td>
                                    <div class="row g-1">
                                        <div class="col-4">
                                            <label class="form-label" style="font-size: 0.8rem;">① 1½ months</label>
                                            <input asp-for="Pentavalent1Date" type="date" class="form-control form-control-sm" />
                                        </div>
                                        <div class="col-4">
                                            <label class="form-label" style="font-size: 0.8rem;">② 2½ months</label>
                                            <input asp-for="Pentavalent2Date" type="date" class="form-control form-control-sm" />
                                        </div>
                                        <div class="col-4">
                                            <label class="form-label" style="font-size: 0.8rem;">③ 3½ months</label>
                                            <input asp-for="Pentavalent3Date" type="date" class="form-control form-control-sm" />
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <input asp-for="Pentavalent1Remarks" type="text" class="form-control form-control-sm mb-1" placeholder="Dose 1 notes" />
                                    <input asp-for="Pentavalent2Remarks" type="text" class="form-control form-control-sm mb-1" placeholder="Dose 2 notes" />
                                    <input asp-for="Pentavalent3Remarks" type="text" class="form-control form-control-sm" placeholder="Dose 3 notes" />
                                </td>
                            </tr>
                            
                            <!-- Oral Polio Vaccine - 3 doses horizontally -->
                            <tr>
                                <td><strong>Oral Polio Vaccine (OPV)</strong><br><small class="text-muted">1½, 2½, 3½ months</small></td>
                                <td class="text-center">③</td>
                                <td>
                                    <div class="row g-1">
                                        <div class="col-4">
                                            <label class="form-label" style="font-size: 0.8rem;">① 1½ months</label>
                                            <input asp-for="OPV1Date" type="date" class="form-control form-control-sm" />
                                        </div>
                                        <div class="col-4">
                                            <label class="form-label" style="font-size: 0.8rem;">② 2½ months</label>
                                            <input asp-for="OPV2Date" type="date" class="form-control form-control-sm" />
                                        </div>
                                        <div class="col-4">
                                            <label class="form-label" style="font-size: 0.8rem;">③ 3½ months</label>
                                            <input asp-for="OPV3Date" type="date" class="form-control form-control-sm" />
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <input asp-for="OPV1Remarks" type="text" class="form-control form-control-sm mb-1" placeholder="Dose 1 notes" />
                                    <input asp-for="OPV2Remarks" type="text" class="form-control form-control-sm mb-1" placeholder="Dose 2 notes" />
                                    <input asp-for="OPV3Remarks" type="text" class="form-control form-control-sm" placeholder="Dose 3 notes" />
                                </td>
                            </tr>
                            
                            <!-- Inactivated Polio Vaccine - 2 doses horizontally -->
                            <tr>
                                <td><strong>Inactivated Polio Vaccine (IPV)</strong><br><small class="text-muted">3½ & 9 months</small></td>
                                <td class="text-center">②</td>
                                <td>
                                    <div class="row g-1">
                                        <div class="col-6">
                                            <label class="form-label" style="font-size: 0.8rem;">① 3½ months</label>
                                            <input asp-for="IPV1Date" type="date" class="form-control form-control-sm" />
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label" style="font-size: 0.8rem;">② 9 months</label>
                                            <input asp-for="IPV2Date" type="date" class="form-control form-control-sm" />
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <input asp-for="IPV1Remarks" type="text" class="form-control form-control-sm mb-1" placeholder="Dose 1 notes" />
                                    <input asp-for="IPV2Remarks" type="text" class="form-control form-control-sm" placeholder="Dose 2 notes" />
                                </td>
                            </tr>
                            
                            <!-- Pneumococcal Conjugate Vaccine - 3 doses horizontally -->
                            <tr>
                                <td><strong>Pneumococcal Conjugate Vaccine (PCV)</strong><br><small class="text-muted">1½, 2½, 3½ months</small></td>
                                <td class="text-center">③</td>
                                <td>
                                    <div class="row g-1">
                                        <div class="col-4">
                                            <label class="form-label" style="font-size: 0.8rem;">① 1½ months</label>
                                            <input asp-for="PCV1Date" type="date" class="form-control form-control-sm" />
                                        </div>
                                        <div class="col-4">
                                            <label class="form-label" style="font-size: 0.8rem;">② 2½ months</label>
                                            <input asp-for="PCV2Date" type="date" class="form-control form-control-sm" />
                                        </div>
                                        <div class="col-4">
                                            <label class="form-label" style="font-size: 0.8rem;">③ 3½ months</label>
                                            <input asp-for="PCV3Date" type="date" class="form-control form-control-sm" />
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <input asp-for="PCV1Remarks" type="text" class="form-control form-control-sm mb-1" placeholder="Dose 1 notes" />
                                    <input asp-for="PCV2Remarks" type="text" class="form-control form-control-sm mb-1" placeholder="Dose 2 notes" />
                                    <input asp-for="PCV3Remarks" type="text" class="form-control form-control-sm" placeholder="Dose 3 notes" />
                                </td>
                            </tr>
                            
                            <!-- Measles, Mumps, Rubella Vaccine - 2 doses horizontally -->
                            <tr>
                                <td><strong>Measles, Mumps, Rubella Vaccine (MMR)</strong><br><small class="text-muted">9 months & 1 year</small></td>
                                <td class="text-center">②</td>
                                <td>
                                    <div class="row g-1">
                                        <div class="col-6">
                                            <label class="form-label" style="font-size: 0.8rem;">① 9 months</label>
                                            <input asp-for="MMR1Date" type="date" class="form-control form-control-sm" />
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label" style="font-size: 0.8rem;">② 1 year</label>
                                            <input asp-for="MMR2Date" type="date" class="form-control form-control-sm" />
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <input asp-for="MMR1Remarks" type="text" class="form-control form-control-sm mb-1" placeholder="Dose 1 notes" />
                                    <input asp-for="MMR2Remarks" type="text" class="form-control form-control-sm" placeholder="Dose 2 notes" />
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="d-flex gap-2 mb-4">
            <button type="button" id="saveButton" class="btn btn-success">
                <i class="fas fa-save me-1"></i>Save Immunization Record
            </button>
            <a href="/Nurse/Appointments" class="btn btn-secondary">
                <i class="fas fa-times me-1"></i>Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Calculate age automatically
        function calculateAge() {
            const dobInput = document.getElementById('DateOfBirth');
            const ageInput = document.getElementById('currentAge');
            
            if (dobInput && dobInput.value) {
                const dob = new Date(dobInput.value);
                const today = new Date();
                
                let years = today.getFullYear() - dob.getFullYear();
                let months = today.getMonth() - dob.getMonth();
                let days = today.getDate() - dob.getDate();
                
                if (days < 0) {
                    months--;
                    days += new Date(today.getFullYear(), today.getMonth(), 0).getDate();
                }
                
                if (months < 0) {
                    years--;
                    months += 12;
                }
                
                if (ageInput) {
                    if (years > 0) {
                        ageInput.value = `${years} year(s), ${months} month(s)`;
                    } else if (months > 0) {
                        ageInput.value = `${months} month(s)`;
                    } else {
                        ageInput.value = `${days} day(s)`;
                    }
                }
            }
        }
        
        // Real-time validation for name fields
        function validateNameField(input) {
            const namePattern = /^[A-Za-z\s]*$/;
            const value = input.value;
            
            if (!namePattern.test(value)) {
                // Remove invalid characters
                input.value = value.replace(/[^A-Za-z\s]/g, '');
                
                // Show error message
                const errorSpan = input.parentElement.querySelector('.text-danger');
                if (errorSpan) {
                    errorSpan.textContent = 'Only letters and spaces are allowed';
                    errorSpan.style.display = 'block';
                }
            } else {
                // Clear error message
                const errorSpan = input.parentElement.querySelector('.text-danger');
                if (errorSpan) {
                    errorSpan.textContent = '';
                    errorSpan.style.display = 'none';
                }
            }
        }
        
        // Real-time validation for place of birth
        function validatePlaceOfBirth(input) {
            const placePattern = /^[A-Za-z\s,.-]*$/;
            const value = input.value;
            
            if (!placePattern.test(value)) {
                input.value = value.replace(/[^A-Za-z\s,.-]/g, '');
                
                const errorSpan = input.parentElement.querySelector('.text-danger');
                if (errorSpan) {
                    errorSpan.textContent = 'Only letters, spaces, commas, periods, and hyphens are allowed';
                    errorSpan.style.display = 'block';
                }
            } else {
                const errorSpan = input.parentElement.querySelector('.text-danger');
                if (errorSpan) {
                    errorSpan.textContent = '';
                    errorSpan.style.display = 'none';
                }
            }
        }
        
        // Real-time validation for weight/height
        function validateNumberField(input) {
            const numberPattern = /^[0-9.]*$/;
            const value = input.value;
            
            if (!numberPattern.test(value)) {
                input.value = value.replace(/[^0-9.]/g, '');
                
                const errorSpan = input.parentElement.querySelector('.text-danger');
                if (errorSpan) {
                    errorSpan.textContent = 'Only numbers and decimal points are allowed';
                    errorSpan.style.display = 'block';
                }
            } else {
                const errorSpan = input.parentElement.querySelector('.text-danger');
                if (errorSpan) {
                    errorSpan.textContent = '';
                    errorSpan.style.display = 'none';
                }
            }
        }
        
        // Add event listeners
        document.addEventListener('DOMContentLoaded', function() {
            const dobInput = document.querySelector('input[name="DateOfBirth"]');
            if (dobInput) {
                dobInput.addEventListener('change', calculateAge);
                calculateAge(); // Calculate on page load if date is already set
            }
            
            // Add validation event listeners to all name fields using attribute selectors
            const nameFieldSelectors = [
                'input[name="ChildFirstName"]', 'input[name="ChildMiddleName"]', 'input[name="ChildLastName"]',
                'input[name="MotherFirstName"]', 'input[name="MotherMiddleName"]', 'input[name="MotherLastName"]',
                'input[name="FatherFirstName"]', 'input[name="FatherMiddleName"]', 'input[name="FatherLastName"]'
            ];
            
            nameFieldSelectors.forEach(selector => {
                const field = document.querySelector(selector);
                if (field) {
                    field.addEventListener('input', function() {
                        validateNameField(this);
                    });
                    field.addEventListener('paste', function(e) {
                        setTimeout(() => validateNameField(this), 10);
                    });
                    field.addEventListener('keypress', function(e) {
                        // Prevent numbers and special characters from being typed
                        const char = String.fromCharCode(e.which);
                        if (!/[A-Za-z\s]/.test(char)) {
                            e.preventDefault();
                        }
                    });
                }
            });
            
            // Add validation to place of birth
            const placeField = document.querySelector('input[name="PlaceOfBirth"]');
            if (placeField) {
                placeField.addEventListener('input', function() {
                    validatePlaceOfBirth(this);
                });
                placeField.addEventListener('paste', function(e) {
                    setTimeout(() => validatePlaceOfBirth(this), 10);
                });
                placeField.addEventListener('keypress', function(e) {
                    const char = String.fromCharCode(e.which);
                    if (!/[A-Za-z\s,.-]/.test(char)) {
                        e.preventDefault();
                    }
                });
            }
            
            // Add validation to weight/height fields
            const weightField = document.querySelector('input[name="BirthWeight"]');
            const heightField = document.querySelector('input[name="BirthHeight"]');
            
            [weightField, heightField].forEach(field => {
                if (field) {
                    field.addEventListener('input', function() {
                        validateNumberField(this);
                    });
                    field.addEventListener('paste', function(e) {
                        setTimeout(() => validateNumberField(this), 10);
                    });
                    field.addEventListener('keypress', function(e) {
                        const char = String.fromCharCode(e.which);
                        if (!/[0-9.]/.test(char)) {
                            e.preventDefault();
                        }
                    });
                }
            });
            
            // Remove 'required' attribute from all vaccine date inputs to prevent browser validation
            const allDateInputs = document.querySelectorAll('input[type="date"]');
            allDateInputs.forEach(input => {
                input.removeAttribute('required');
                // Also disable HTML5 validation on these inputs
                input.setAttribute('aria-required', 'false');
            });
            
            // Handle save button click
            const saveButton = document.getElementById('saveButton');
            const form = document.querySelector('form');
            
            if (saveButton && form) {
                // Ensure form doesn't use HTML5 validation
                form.setAttribute('novalidate', 'novalidate');
                
                saveButton.addEventListener('click', function(e) {
                    e.preventDefault();
                    console.log('Save button clicked');
                    let hasErrors = false;
                    
                    // Validate required fields first
                    const childFirstNameField = document.querySelector('input[name="ChildFirstName"]');
                    const childLastNameField = document.querySelector('input[name="ChildLastName"]');
                    const dobField = document.querySelector('input[name="DateOfBirth"]');
                    const sexField = document.querySelector('select[name="Sex"]');
                    const barangayField = document.querySelector('select[name="Barangay"]');
                    
                    console.log('Validating required fields...');
                    
                    // Check required fields
                    if (!childFirstNameField || !childFirstNameField.value.trim()) {
                        alert('Child\'s First Name is required');
                        if (childFirstNameField) childFirstNameField.focus();
                        return;
                    }
                    
                    if (!childLastNameField || !childLastNameField.value.trim()) {
                        alert('Child\'s Last Name is required');
                        if (childLastNameField) childLastNameField.focus();
                        return;
                    }
                    
                    if (!dobField || !dobField.value) {
                        alert('Date of Birth is required');
                        if (dobField) dobField.focus();
                        return;
                    }
                    
                    if (!sexField || !sexField.value) {
                        alert('Sex is required');
                        if (sexField) sexField.focus();
                        return;
                    }
                    
                    if (!barangayField || !barangayField.value) {
                        alert('Barangay is required');
                        if (barangayField) barangayField.focus();
                        return;
                    }
                    
                    console.log('Required fields validated');
                    
                    // Validate all name fields (only if they have values - middle names are optional)
                    nameFieldSelectors.forEach(selector => {
                        const field = document.querySelector(selector);
                        if (field && field.value && field.value.trim()) {
                            const namePattern = /^[A-Za-z\s]*$/;
                            if (!namePattern.test(field.value)) {
                                hasErrors = true;
                                const errorSpan = field.parentElement.querySelector('.text-danger');
                                if (errorSpan) {
                                    errorSpan.textContent = 'Only letters and spaces are allowed';
                                    errorSpan.style.display = 'block';
                                }
                            }
                        }
                    });
                    
                    // Validate place of birth (optional field)
                    if (placeField && placeField.value && placeField.value.trim()) {
                        const placePattern = /^[A-Za-z\s,.-]*$/;
                        if (!placePattern.test(placeField.value)) {
                            hasErrors = true;
                            const errorSpan = placeField.parentElement.querySelector('.text-danger');
                            if (errorSpan) {
                                errorSpan.textContent = 'Only letters, spaces, commas, periods, and hyphens are allowed';
                                errorSpan.style.display = 'block';
                            }
                        }
                    }
                    
                    // Validate weight/height fields (optional)
                    [weightField, heightField].forEach(field => {
                        if (field && field.value && field.value.trim()) {
                            const numberPattern = /^[0-9.]*$/;
                            if (!numberPattern.test(field.value)) {
                                hasErrors = true;
                                const errorSpan = field.parentElement.querySelector('.text-danger');
                                if (errorSpan) {
                                    errorSpan.textContent = 'Only numbers and decimal points are allowed';
                                    errorSpan.style.display = 'block';
                                }
                            }
                        }
                    });
                    
                    if (hasErrors) {
                        alert('Please fix the validation errors before submitting the form.');
                        return;
                    }
                    
                    console.log('All validation passed, submitting form...');
                    
                    // Log form data being submitted for debugging
                    const formData = new FormData(form);
                    console.log('Form data being submitted:');
                    for (let [key, value] of formData.entries()) {
                        console.log(`${key}: ${value}`);
                    }
                    
                    // Submit the form to Razor Page handler
                    // The form action is set to /Nurse/ImmunizationRecord with appointmentId parameter
                    // This will trigger OnPostAsync() in ImmunizationRecord.cshtml.cs
                    form.submit();
                });
            }
        });
        
        // Prevent auto-fill and validate Birth Height/Weight fields
        function setupNumericValidation() {
            const birthHeightInput = document.querySelector('input[name="BirthHeight"]');
            const birthWeightInput = document.querySelector('input[name="BirthWeight"]');
            
            // Function to validate and format decimal input
            function validateDecimalInput(input, maxDecimals) {
                if (!input) return;
                
                // Prevent auto-fill on focus
                input.addEventListener('focus', function(e) {
                    // Clear any auto-filled value
                    if (this.value && this.value.length > 0) {
                        const currentValue = this.value;
                        this.value = '';
                        setTimeout(() => {
                            this.value = currentValue;
                        }, 0);
                    }
                });
                
                // Validate on input
                input.addEventListener('input', function(e) {
                    let value = this.value;
                    
                    // Remove any non-numeric characters except decimal point
                    value = value.replace(/[^0-9.]/g, '');
                    
                    // Ensure only one decimal point
                    const parts = value.split('.');
                    if (parts.length > 2) {
                        value = parts[0] + '.' + parts.slice(1).join('');
                    }
                    
                    // Limit decimal places
                    if (parts.length === 2 && parts[1].length > maxDecimals) {
                        value = parts[0] + '.' + parts[1].substring(0, maxDecimals);
                    }
                    
                    this.value = value;
                });
                
                // Prevent paste of invalid data
                input.addEventListener('paste', function(e) {
                    e.preventDefault();
                    const pastedText = (e.clipboardData || window.clipboardData).getData('text');
                    const cleanedText = pastedText.replace(/[^0-9.]/g, '');
                    
                    // Insert cleaned text at cursor position
                    const start = this.selectionStart;
                    const end = this.selectionEnd;
                    const currentValue = this.value;
                    this.value = currentValue.substring(0, start) + cleanedText + currentValue.substring(end);
                    
                    // Trigger input event to apply validation
                    this.dispatchEvent(new Event('input'));
                });
            }
            
            // Apply validation to Birth Height (max 1 decimal place)
            validateDecimalInput(birthHeightInput, 1);
            
            // Apply validation to Birth Weight (max 2 decimal places)
            validateDecimalInput(birthWeightInput, 2);
        }
        
        // Initialize validation on page load
        setupNumericValidation();
        
        // Handle family number generation
        $('#generateFamilyNumberBtn').on('click', function() {
            const mothersNameField = document.querySelector('input[name="MothersName"]');
            const mothersName = mothersNameField ? mothersNameField.value : '';
            
            if (!mothersName) {
                alert('Please enter the mother\'s name before generating a family number.');
                if (mothersNameField) {
                    mothersNameField.focus();
                }
                return;
            }
            
            // Extract last name (assume last word is the last name)
            const nameParts = mothersName.trim().split(' ');
            const lastName = nameParts[nameParts.length - 1];
            
            if (!lastName) {
                alert('Could not extract last name from mother\'s name.');
                return;
            }
            
            // Show loading state
            $(this).prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i>Generating...');
            
            // Call API to generate family number
            $.ajax({
                url: '?handler=GenerateFamilyNumber',
                type: 'POST',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                contentType: 'application/json',
                data: JSON.stringify({ lastName: lastName }),
                success: function(response) {
                    if (response.success) {
                        $('#familyNumberField').val(response.familyNumber);
                        $('#FamilyNumber').val(response.familyNumber);
                        $('#familyNumberGenerator').hide();
                        
                        alert('Family number ' + response.familyNumber + ' has been generated and assigned.');
                    } else {
                        alert('Failed to generate family number: ' + (response.error || 'Unknown error'));
                        $('#generateFamilyNumberBtn').prop('disabled', false).html('<i class="fas fa-plus-circle me-1"></i>Generate Family Number');
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Error generating family number:', error);
                    alert('An error occurred while generating the family number.');
                    $('#generateFamilyNumberBtn').prop('disabled', false).html('<i class="fas fa-plus-circle me-1"></i>Generate Family Number');
                }
            });
        });
    </script>
}
