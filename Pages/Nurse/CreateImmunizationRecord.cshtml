@page
@model Barangay.Pages.Nurse.CreateImmunizationRecordModel
@{
    ViewData["Title"] = "Create Immunization Record";
    Layout = "_NurseLayout";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="m-0">
            <i class="fas fa-syringe me-2"></i>
            Child Immunization Record
        </h2>
        <a href="/Nurse/ImmunizationRecords" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>
            Back to Immunization Records
        </a>
    </div>

    <form method="post">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="fas fa-baby me-2"></i>
                    Child Information
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="Record.ChildName" class="form-label">Child's Name *</label>
                            <input asp-for="Record.ChildName" class="form-control" required />
                            <span asp-validation-for="Record.ChildName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Record.DateOfBirth" class="form-label">Date of Birth *</label>
                            <input asp-for="Record.DateOfBirth" type="date" class="form-control" required />
                            <span asp-validation-for="Record.DateOfBirth" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Record.PlaceOfBirth" class="form-label">Place of Birth</label>
                            <input asp-for="Record.PlaceOfBirth" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Record.Address" class="form-label">Address</label>
                            <textarea asp-for="Record.Address" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="Record.MotherName" class="form-label">Mother's Name *</label>
                            <input asp-for="Record.MotherName" class="form-control" required />
                            <span asp-validation-for="Record.MotherName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Record.FatherName" class="form-label">Father's Name</label>
                            <input asp-for="Record.FatherName" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Record.Sex" class="form-label">Sex *</label>
                            <select asp-for="Record.Sex" class="form-control" required>
                                <option value="">Select Sex</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                            </select>
                            <span asp-validation-for="Record.Sex" class="text-danger"></span>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Record.BirthHeight" class="form-label">Birth Height</label>
                                    <input asp-for="Record.BirthHeight" class="form-control" placeholder="e.g., 50 cm" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Record.BirthWeight" class="form-label">Birth Weight</label>
                                    <input asp-for="Record.BirthWeight" class="form-control" placeholder="e.g., 3.2 kg" />
                                </div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Record.HealthCenter" class="form-label">Health Center</label>
                            <input asp-for="Record.HealthCenter" class="form-control" value="Baesa Health Center" readonly />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Record.Barangay" class="form-label">Barangay</label>
                            <input asp-for="Record.Barangay" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Record.FamilyNumber" class="form-label">Family Number</label>
                            <input asp-for="Record.FamilyNumber" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Record.Email" class="form-label">Email Address *</label>
                            <input asp-for="Record.Email" type="email" class="form-control" required placeholder="parent@email.com" />
                            <small class="form-text text-muted">Email will be sent to confirm immunization record creation</small>
                            <span asp-validation-for="Record.Email" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Record.ContactNumber" class="form-label">Contact Number</label>
                            <input asp-for="Record.ContactNumber" class="form-control" placeholder="09XX-XXX-XXXX" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Vaccination Records -->
        <div class="card mt-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">
                    <i class="fas fa-syringe me-2"></i>
                    Vaccines Administered
                </h5>
            </div>
            <div class="card-body">
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    <strong>Note:</strong> Vaccine dates are <strong>optional</strong>. Fill in the date only when the vaccine has been administered. 
                    You can save the record now and update vaccine dates later as the child receives each dose.
                </div>
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 25%;">Vaccine (Bakuna)</th>
                                <th style="width: 10%;">Doses</th>
                                <th style="width: 40%;">Date Given (Petsa ng bakuna)</th>
                                <th style="width: 25%;">Remarks</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- BCG Vaccine - 1 dose -->
                            <tr>
                                <td><strong>BCG Vaccine</strong><br><small class="text-muted">At birth</small></td>
                                <td class="text-center">①</td>
                                <td>
                                    <input asp-for="Record.BCGVaccineDate" type="date" class="form-control form-control-sm" />
                                </td>
                                <td>
                                    <input asp-for="Record.BCGVaccineRemarks" class="form-control form-control-sm" placeholder="Return date or notes" />
                                </td>
                            </tr>

                            <!-- Hepatitis B Vaccine - 1 dose -->
                            <tr>
                                <td><strong>Hepatitis B Vaccine</strong><br><small class="text-muted">At birth</small></td>
                                <td class="text-center">①</td>
                                <td>
                                    <input asp-for="Record.HepatitisBVaccineDate" type="date" class="form-control form-control-sm" />
                                </td>
                                <td>
                                    <input asp-for="Record.HepatitisBVaccineRemarks" class="form-control form-control-sm" placeholder="Return date or notes" />
                                </td>
                            </tr>

                            <!-- Pentavalent Vaccine - 3 doses -->
                            <tr>
                                <td><strong>Pentavalent Vaccine</strong><br><small class="text-muted">DPT-Hep B-HIB</small><br><small class="text-muted">1, 2, 3 months</small></td>
                                <td class="text-center">③</td>
                                <td>
                                    <div class="row g-1">
                                        <div class="col-4">
                                            <label class="form-label-sm">① 1½ months</label>
                                            <input asp-for="Record.Pentavalent1Date" type="date" class="form-control form-control-sm" />
                                        </div>
                                        <div class="col-4">
                                            <label class="form-label-sm">② 2½ months</label>
                                            <input asp-for="Record.Pentavalent2Date" type="date" class="form-control form-control-sm" />
                                        </div>
                                        <div class="col-4">
                                            <label class="form-label-sm">③ 3½ months</label>
                                            <input asp-for="Record.Pentavalent3Date" type="date" class="form-control form-control-sm" />
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <input asp-for="Record.Pentavalent1Remarks" class="form-control form-control-sm mb-1" placeholder="Dose 1 notes" />
                                    <input asp-for="Record.Pentavalent2Remarks" class="form-control form-control-sm mb-1" placeholder="Dose 2 notes" />
                                    <input asp-for="Record.Pentavalent3Remarks" class="form-control form-control-sm" placeholder="Dose 3 notes" />
                                </td>
                            </tr>

                            <!-- Oral Polio Vaccine - 3 doses -->
                            <tr>
                                <td><strong>Oral Polio Vaccine (OPV)</strong><br><small class="text-muted">1, 2, 3 months</small></td>
                                <td class="text-center">③</td>
                                <td>
                                    <div class="row g-1">
                                        <div class="col-4">
                                            <label class="form-label-sm">① 1½ months</label>
                                            <input asp-for="Record.OPV1Date" type="date" class="form-control form-control-sm" />
                                        </div>
                                        <div class="col-4">
                                            <label class="form-label-sm">② 2½ months</label>
                                            <input asp-for="Record.OPV2Date" type="date" class="form-control form-control-sm" />
                                        </div>
                                        <div class="col-4">
                                            <label class="form-label-sm">③ 3½ months</label>
                                            <input asp-for="Record.OPV3Date" type="date" class="form-control form-control-sm" />
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <input asp-for="Record.OPV1Remarks" class="form-control form-control-sm mb-1" placeholder="Dose 1 notes" />
                                    <input asp-for="Record.OPV2Remarks" class="form-control form-control-sm mb-1" placeholder="Dose 2 notes" />
                                    <input asp-for="Record.OPV3Remarks" class="form-control form-control-sm" placeholder="Dose 3 notes" />
                                </td>
                            </tr>

                            <!-- Inactivated Polio Vaccine - 2 doses -->
                            <tr>
                                <td><strong>Inactivated Polio Vaccine (IPV)</strong><br><small class="text-muted">3 & 9 months</small></td>
                                <td class="text-center">②</td>
                                <td>
                                    <div class="row g-1">
                                        <div class="col-6">
                                            <label class="form-label-sm">① 3½ months</label>
                                            <input asp-for="Record.IPV1Date" type="date" class="form-control form-control-sm" />
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label-sm">② 9 months</label>
                                            <input asp-for="Record.IPV2Date" type="date" class="form-control form-control-sm" />
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <input asp-for="Record.IPV1Remarks" class="form-control form-control-sm mb-1" placeholder="Dose 1 notes" />
                                    <input asp-for="Record.IPV2Remarks" class="form-control form-control-sm" placeholder="Dose 2 notes" />
                                </td>
                            </tr>

                            <!-- Pneumococcal Conjugate Vaccine - 3 doses -->
                            <tr>
                                <td><strong>Pneumococcal Conjugate Vaccine (PCV)</strong><br><small class="text-muted">1, 2, 3 months</small></td>
                                <td class="text-center">③</td>
                                <td>
                                    <div class="row g-1">
                                        <div class="col-4">
                                            <label class="form-label-sm">① 1½ months</label>
                                            <input asp-for="Record.PCV1Date" type="date" class="form-control form-control-sm" />
                                        </div>
                                        <div class="col-4">
                                            <label class="form-label-sm">② 2½ months</label>
                                            <input asp-for="Record.PCV2Date" type="date" class="form-control form-control-sm" />
                                        </div>
                                        <div class="col-4">
                                            <label class="form-label-sm">③ 3½ months</label>
                                            <input asp-for="Record.PCV3Date" type="date" class="form-control form-control-sm" />
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <input asp-for="Record.PCV1Remarks" class="form-control form-control-sm mb-1" placeholder="Dose 1 notes" />
                                    <input asp-for="Record.PCV2Remarks" class="form-control form-control-sm mb-1" placeholder="Dose 2 notes" />
                                    <input asp-for="Record.PCV3Remarks" class="form-control form-control-sm" placeholder="Dose 3 notes" />
                                </td>
                            </tr>

                            <!-- MMR Vaccine - 2 doses -->
                            <tr>
                                <td><strong>Measles, Mumps, Rubella Vaccine (MMR)</strong><br><small class="text-muted">9 months & 1 year</small></td>
                                <td class="text-center">②</td>
                                <td>
                                    <div class="row g-1">
                                        <div class="col-6">
                                            <label class="form-label-sm">① 9 months</label>
                                            <input asp-for="Record.MMR1Date" type="date" class="form-control form-control-sm" />
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label-sm">② 1 year</label>
                                            <input asp-for="Record.MMR2Date" type="date" class="form-control form-control-sm" />
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <input asp-for="Record.MMR1Remarks" class="form-control form-control-sm mb-1" placeholder="Dose 1 notes" />
                                    <input asp-for="Record.MMR2Remarks" class="form-control form-control-sm" placeholder="Dose 2 notes" />
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="mt-4 text-center">
            <button type="submit" class="btn btn-primary btn-lg me-3">
                <i class="fas fa-save me-2"></i>
                Save Immunization Record
            </button>
            <a href="/Nurse/ImmunizationRecords" class="btn btn-secondary btn-lg">
                <i class="fas fa-times me-2"></i>
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
