@page
@model Barangay.Pages.Nurse.AppointmentDetailsModel
@{
    ViewData["Title"] = "Appointment Details";
    Layout = "/Pages/Shared/_DoctorLayout.cshtml";
}

@section Styles {
    <style>
        .list-group-item-warning {
            border-left: 4px solid #ffc107;
        }
        
        .list-group-item-danger {
            border-left: 4px solid #dc3545;
        }
        
        .assessment-section {
            margin-bottom: 1.5rem;
        }
        
        .assessment-history {
            background-color: #f8f9fa;
            padding: 15px;
            border-radius: 5px;
        }
        
        .tab-pane {
            padding-top: 15px;
        }
        
        .section-heading {
            border-bottom: 1px solid #e9ecef;
            padding-bottom: 10px;
            margin-bottom: 15px;
            font-weight: 600;
        }
    </style>
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="m-0">Appointment Details</h2>
        <a href="/Nurse/Appointments" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>
            Back to Appointments
        </a>
    </div>
    
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert @(Model.StatusMessage.Contains("Error") ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    <div class="row">
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Patient Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Patient Name</dt>
                        <dd class="col-sm-8">@Model.Appointment.PatientName</dd>

                        <dt class="col-sm-4">Appointment Date</dt>
                        <dd class="col-sm-8">@Model.Appointment.AppointmentDate.ToString("MMM d, yyyy")</dd>

                        <dt class="col-sm-4">Appointment Time</dt>
                        <dd class="col-sm-8">@Model.Appointment.AppointmentTime.ToString(@"hh\:mm")</dd>

                        <dt class="col-sm-4">Doctor</dt>
                        <dd class="col-sm-8">@Model.Appointment.DoctorName</dd>

                        <dt class="col-sm-4">Type</dt>
                        <dd class="col-sm-8">@Model.Appointment.Type</dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">
                            <span class="badge @(Model.Appointment.Status == AppointmentStatus.Pending ? "bg-warning" : 
                                            Model.Appointment.Status == AppointmentStatus.Confirmed ? "bg-info" :
                                            Model.Appointment.Status == AppointmentStatus.InProgress ? "bg-primary" : 
                                            Model.Appointment.Status == AppointmentStatus.Completed ? "bg-success" : 
                                            Model.Appointment.Status == AppointmentStatus.Cancelled ? "bg-danger" : 
                                            Model.Appointment.Status == AppointmentStatus.Urgent ? "bg-danger" : 
                                            Model.Appointment.Status == AppointmentStatus.NoShow ? "bg-secondary" : "bg-secondary")">
                                @Model.Appointment.Status.ToString()
                            </span>
                        </dd>

                        <dt class="col-sm-4">Description</dt>
                        <dd class="col-sm-8">@(Model.Appointment.Description ?? "No description provided.")</dd>

                        <dt class="col-sm-4">Age</dt>
                        <dd class="col-sm-8">@(Model.PatientAge) years</dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Assessment Forms</h5>
                </div>
                <div class="card-body">
                    <ul class="nav nav-tabs" id="assessmentTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="ncd-tab" data-bs-toggle="tab" data-bs-target="#ncd-content" 
                                    type="button" role="tab" aria-controls="ncd-content" aria-selected="true">
                                NCD Risk Assessment
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="heeadsss-tab" data-bs-toggle="tab" data-bs-target="#heeadsss-content" 
                                    type="button" role="tab" aria-controls="heeadsss-content" aria-selected="false">
                                HEEADSSS Assessment
                            </button>
                        </li>
                    </ul>
                    <div class="tab-content p-3" id="assessmentTabContent">
                        <!-- NCD Risk Assessment Tab -->
                        <div class="tab-pane fade show active" id="ncd-content" role="tabpanel" aria-labelledby="ncd-tab">
                            @if (Model.NCDRiskAssessment != null)
                            {
                                <div class="assessment-section">
                                    <h6 class="section-heading">Medical History</h6>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <ul class="list-group">
                                                <li class="list-group-item @(Model.NCDRiskAssessment.HasDiabetes ? "list-group-item-warning" : "")">
                                                    Diabetes: @(Model.NCDRiskAssessment.HasDiabetes ? "Yes" : "No")
                                                </li>
                                                <li class="list-group-item @(Model.NCDRiskAssessment.HasHypertension ? "list-group-item-warning" : "")">
                                                    Hypertension: @(Model.NCDRiskAssessment.HasHypertension ? "Yes" : "No")
                                                </li>
                                                <li class="list-group-item @(Model.NCDRiskAssessment.HasCancer ? "list-group-item-warning" : "")">
                                                    Cancer: @(Model.NCDRiskAssessment.HasCancer ? "Yes" : "No")
                                                    @if (Model.NCDRiskAssessment.HasCancer && !string.IsNullOrEmpty(Model.NCDRiskAssessment.CancerType))
                                                    {
                                                        <span class="text-danger ms-2">(@Model.NCDRiskAssessment.CancerType)</span>
                                                    }
                                                </li>
                                            </ul>
                                        </div>
                                        <div class="col-md-6">
                                            <ul class="list-group">
                                                <li class="list-group-item @(Model.NCDRiskAssessment.HasCOPD ? "list-group-item-warning" : "")">
                                                    COPD: @(Model.NCDRiskAssessment.HasCOPD ? "Yes" : "No")
                                                </li>
                                                <li class="list-group-item @(Model.NCDRiskAssessment.HasLungDisease ? "list-group-item-warning" : "")">
                                                    Lung Disease: @(Model.NCDRiskAssessment.HasLungDisease ? "Yes" : "No")
                                                </li>
                                                <li class="list-group-item @(Model.NCDRiskAssessment.HasEyeDisease ? "list-group-item-warning" : "")">
                                                    Eye Disease: @(Model.NCDRiskAssessment.HasEyeDisease ? "Yes" : "No")
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="assessment-section">
                                    <h6 class="section-heading">Respiratory Assessment</h6>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <ul class="list-group">
                                                <li class="list-group-item @(Model.NCDRiskAssessment.HasAsthma ? "list-group-item-warning" : "")">
                                                    Asthma: @(Model.NCDRiskAssessment.HasAsthma ? "Yes" : "No")
                                                </li>
                                                <li class="list-group-item @(Model.NCDRiskAssessment.HasDifficultyBreathing ? "list-group-item-warning" : "")">
                                                    Difficulty Breathing: @(Model.NCDRiskAssessment.HasDifficultyBreathing ? "Yes" : "No")
                                                </li>
                                            </ul>
                                        </div>
                                        <div class="col-md-6">
                                            <ul class="list-group">
                                                <li class="list-group-item @(!string.IsNullOrEmpty(Model.NCDRiskAssessment.ChestPain) ? "list-group-item-warning" : "")">
                                                    Chest Pain: @(!string.IsNullOrEmpty(Model.NCDRiskAssessment.ChestPain) ? Model.NCDRiskAssessment.ChestPain : "None")
                                                </li>
                                                <li class="list-group-item @(!string.IsNullOrEmpty(Model.NCDRiskAssessment.ChestPainLocation) ? "list-group-item-warning" : "")">
                                                    Chest Pain Location: @(!string.IsNullOrEmpty(Model.NCDRiskAssessment.ChestPainLocation) ? Model.NCDRiskAssessment.ChestPainLocation : "N/A")
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="assessment-section">
                                    <h6 class="section-heading">Lifestyle Factors</h6>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <ul class="list-group">
                                                <li class="list-group-item">
                                                    Smoking Status: @(Model.NCDRiskAssessment.SmokingStatus ?? "Not specified")
                                                </li>
                                                <li class="list-group-item @(Model.NCDRiskAssessment.HighSaltIntake ? "list-group-item-warning" : "")">
                                                    High Salt Intake: @(Model.NCDRiskAssessment.HighSaltIntake ? "Yes" : "No")
                                                </li>
                                            </ul>
                                        </div>
                                        <div class="col-md-6">
                                            <ul class="list-group">
                                                <li class="list-group-item">
                                                    Alcohol Consumption: @(Model.NCDRiskAssessment.AlcoholConsumption ?? "Not specified")
                                                </li>
                                                <li class="list-group-item @(Model.NCDRiskAssessment.HasNoRegularExercise ? "list-group-item-warning" : "")">
                                                    No Regular Exercise: @(Model.NCDRiskAssessment.HasNoRegularExercise ? "Yes" : "No")
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>

                                <!-- Family History Section -->
                                <div class="assessment-section">
                                    <h6 class="section-heading">Family History</h6>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <ul class="list-group">
                                                <li class="list-group-item @(Model.NCDRiskAssessment.FamilyHasHypertension ? "list-group-item-warning" : "")">
                                                    Family Hypertension: @(Model.NCDRiskAssessment.FamilyHasHypertension ? "Yes" : "No")
                                                </li>
                                                <li class="list-group-item @(Model.NCDRiskAssessment.FamilyHasHeartDisease ? "list-group-item-warning" : "")">
                                                    Family Heart Disease: @(Model.NCDRiskAssessment.FamilyHasHeartDisease ? "Yes" : "No")
                                                </li>
                                                <li class="list-group-item @(Model.NCDRiskAssessment.FamilyHasStroke ? "list-group-item-warning" : "")">
                                                    Family Stroke: @(Model.NCDRiskAssessment.FamilyHasStroke ? "Yes" : "No")
                                                </li>
                                            </ul>
                                        </div>
                                        <div class="col-md-6">
                                            <ul class="list-group">
                                                <li class="list-group-item @(Model.NCDRiskAssessment.FamilyHasDiabetes ? "list-group-item-warning" : "")">
                                                    Family Diabetes: @(Model.NCDRiskAssessment.FamilyHasDiabetes ? "Yes" : "No")
                                                </li>
                                                <li class="list-group-item @(Model.NCDRiskAssessment.FamilyHasCancer ? "list-group-item-warning" : "")">
                                                    Family Cancer: @(Model.NCDRiskAssessment.FamilyHasCancer ? "Yes" : "No")
                                                </li>
                                                <li class="list-group-item @(Model.NCDRiskAssessment.FamilyHasKidneyDisease ? "list-group-item-warning" : "")">
                                                    Family Kidney Disease: @(Model.NCDRiskAssessment.FamilyHasKidneyDisease ? "Yes" : "No")
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Assessment History Section -->
                                <div class="assessment-history mt-4 border-top pt-3">
                                    <h6 class="section-heading"><i class="fas fa-history me-2"></i>Assessment History</h6>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <p><strong>Created:</strong> @Model.NCDRiskAssessment.CreatedAt.ToString("MMM dd, yyyy HH:mm")</p>
                                        </div>
                                        <div class="col-md-6">
                                            <p><strong>Last Updated:</strong> @(Model.NCDRiskAssessment.UpdatedAt.HasValue ? Model.NCDRiskAssessment.UpdatedAt.Value.ToString("MMM dd, yyyy HH:mm") : "Not updated")</p>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info">
                                    <p>No NCD Risk Assessment data available for this patient.</p>
                                    <a href="/Nurse/CreateNCDAssessment?appointmentId=@Model.Appointment.Id" class="btn btn-primary btn-sm mt-2">
                                        <i class="fas fa-plus-circle me-1"></i>
                                        Create New Assessment
                                    </a>
                                </div>
                            }
                        </div>
                        
                        <!-- HEEADSSS Assessment Tab -->
                        <div class="tab-pane fade" id="heeadsss-content" role="tabpanel" aria-labelledby="heeadsss-tab">
                            @if (Model.HEEADSSSAssessment != null)
                            {
                                <div class="assessment-section">
                                    <h6 class="section-heading">Home Environment</h6>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <ul class="list-group">
                                                <li class="list-group-item @(!string.IsNullOrEmpty(Model.HEEADSSSAssessment.HomeFamilyProblems) ? "list-group-item-warning" : "")">
                                                    Family Problems: @(Model.HEEADSSSAssessment.HomeFamilyProblems ?? "Not specified")
                                                </li>
                                                <li class="list-group-item">
                                                    Parental Listening: @(Model.HEEADSSSAssessment.HomeParentalListening ?? "Not specified")
                                                </li>
                                            </ul>
                                        </div>
                                        <div class="col-md-6">
                                            <ul class="list-group">
                                                <li class="list-group-item">
                                                    Parental Blame: @(Model.HEEADSSSAssessment.HomeParentalBlame ?? "Not specified")
                                                </li>
                                                <li class="list-group-item @(!string.IsNullOrEmpty(Model.HEEADSSSAssessment.HomeFamilyChanges) ? "list-group-item-warning" : "")">
                                                    Family Changes: @(Model.HEEADSSSAssessment.HomeFamilyChanges ?? "Not specified")
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="assessment-section">
                                    <h6 class="section-heading">Education</h6>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <ul class="list-group">
                                                <li class="list-group-item">
                                                    Currently Studying: @(Model.HEEADSSSAssessment.EducationCurrentlyStudying ?? "Not specified")
                                                </li>
                                                <li class="list-group-item">
                                                    Working: @(Model.HEEADSSSAssessment.EducationWorking ?? "Not specified")
                                                </li>
                                            </ul>
                                        </div>
                                        <div class="col-md-6">
                                            <ul class="list-group">
                                                <li class="list-group-item @(!string.IsNullOrEmpty(Model.HEEADSSSAssessment.EducationSchoolWorkProblems) ? "list-group-item-warning" : "")">
                                                    School/Work Problems: @(Model.HEEADSSSAssessment.EducationSchoolWorkProblems ?? "Not specified")
                                                </li>
                                                <li class="list-group-item @(!string.IsNullOrEmpty(Model.HEEADSSSAssessment.EducationBullying) ? "list-group-item-warning" : "")">
                                                    Bullying: @(Model.HEEADSSSAssessment.EducationBullying ?? "Not specified")
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="assessment-section">
                                    <h6 class="section-heading">Eating and Weight</h6>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <ul class="list-group">
                                                <li class="list-group-item @(Model.HEEADSSSAssessment.WeightConcerns ? "list-group-item-warning" : "")">
                                                    Weight Concerns: @(Model.HEEADSSSAssessment.WeightConcerns ? "Yes" : "No")
                                                </li>
                                                <li class="list-group-item @(Model.HEEADSSSAssessment.EatingDisorderSymptoms ? "list-group-item-warning" : "")">
                                                    Eating Disorder Symptoms: @(Model.HEEADSSSAssessment.EatingDisorderSymptoms ? "Yes" : "No")
                                                </li>
                                            </ul>
                                        </div>
                                        <div class="col-md-6">
                                            <ul class="list-group">
                                                <li class="list-group-item">
                                                    Body Image Satisfaction: @(Model.HEEADSSSAssessment.EatingBodyImageSatisfaction ?? "Not specified")
                                                </li>
                                                <li class="list-group-item">
                                                    Diet Description: @(Model.HEEADSSSAssessment.DietDescription ?? "Not specified")
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="assessment-section">
                                    <h6 class="section-heading">Mental Health</h6>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <ul class="list-group">
                                                <li class="list-group-item @(Model.HEEADSSSAssessment.MoodChanges ? "list-group-item-danger" : "")">
                                                    Mood Changes: @(Model.HEEADSSSAssessment.MoodChanges ? "Yes" : "No")
                                                </li>
                                                <li class="list-group-item @(Model.HEEADSSSAssessment.SuicidalThoughts ? "list-group-item-danger" : "")">
                                                    Suicidal Thoughts: @(Model.HEEADSSSAssessment.SuicidalThoughts ? "Yes" : "No")
                                                </li>
                                                <li class="list-group-item @(!string.IsNullOrEmpty(Model.HEEADSSSAssessment.SuicideSelfHarmThoughts) ? "list-group-item-danger" : "")">
                                                    Self-Harm Thoughts: @(Model.HEEADSSSAssessment.SuicideSelfHarmThoughts ?? "Not specified")
                                                </li>
                                            </ul>
                                        </div>
                                        <div class="col-md-6">
                                            <ul class="list-group">
                                                <li class="list-group-item @(Model.HEEADSSSAssessment.SelfHarmBehavior ? "list-group-item-danger" : "")">
                                                    Self-Harm Behavior: @(Model.HEEADSSSAssessment.SelfHarmBehavior ? "Yes" : "No")
                                                </li>
                                                <li class="list-group-item">
                                                    Support Systems: @(Model.HEEADSSSAssessment.SupportSystems ?? "Not specified")
                                                </li>
                                                <li class="list-group-item @(!string.IsNullOrEmpty(Model.HEEADSSSAssessment.SuicideDepressionFeelings) ? "list-group-item-danger" : "")">
                                                    Depression Feelings: @(Model.HEEADSSSAssessment.SuicideDepressionFeelings ?? "Not specified")
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Additional Sections -->
                                <div class="assessment-section">
                                    <h6 class="section-heading">Activities</h6>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <ul class="list-group">
                                                <li class="list-group-item">
                                                    Participation: @(string.IsNullOrEmpty(Model.HEEADSSSAssessment.ActivitiesParticipation) ? "Not specified" : Model.HEEADSSSAssessment.ActivitiesParticipation)
                                                </li>
                                                <li class="list-group-item">
                                                    Regular Exercise: @(string.IsNullOrEmpty(Model.HEEADSSSAssessment.ActivitiesRegularExercise) ? "Not specified" : Model.HEEADSSSAssessment.ActivitiesRegularExercise)
                                                </li>
                                            </ul>
                                        </div>
                                        <div class="col-md-6">
                                            <ul class="list-group">
                                                <li class="list-group-item @(!string.IsNullOrEmpty(Model.HEEADSSSAssessment.ActivitiesScreenTime) ? "list-group-item-warning" : "")">
                                                    Screen Time: @(Model.HEEADSSSAssessment.ActivitiesScreenTime ?? "Not specified")
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>

                                <!-- Substance Use Section -->
                                <div class="assessment-section">
                                    <h6 class="section-heading">Substance Use</h6>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <ul class="list-group">
                                                <li class="list-group-item @(Model.HEEADSSSAssessment.SubstanceUse ? "list-group-item-warning" : "")">
                                                    Substance Use: @(Model.HEEADSSSAssessment.SubstanceUse ? "Yes" : "No")
                                                </li>
                                                <li class="list-group-item">
                                                    Substance Type: @(string.IsNullOrEmpty(Model.HEEADSSSAssessment.SubstanceType) ? "Not specified" : Model.HEEADSSSAssessment.SubstanceType)
                                                </li>
                                            </ul>
                                        </div>
                                        <div class="col-md-6">
                                            <ul class="list-group">
                                                <li class="list-group-item">
                                                    Drinking: @(Model.HEEADSSSAssessment.SubstanceUse ? "Possible" : "No")
                                                </li>
                                                <li class="list-group-item">
                                                    Drug Use: @(Model.HEEADSSSAssessment.SubstanceUse ? "Possible" : "No")
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>

                                <!-- Sexuality Section -->
                                <div class="assessment-section">
                                    <h6 class="section-heading">Sexuality</h6>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <ul class="list-group">
                                                <li class="list-group-item">
                                                    Sexual Activity: @(Model.HEEADSSSAssessment.SexualActivity ?? "Not specified")
                                                </li>
                                            </ul>
                                        </div>
                                        <div class="col-md-6">
                                            <ul class="list-group">
                                                <li class="list-group-item">
                                                    Sexual Orientation: @(Model.HEEADSSSAssessment.SexualOrientation ?? "Not specified")
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>

                                <!-- Assessment History Section -->
                                <div class="assessment-history mt-4 border-top pt-3">
                                    <h6 class="section-heading"><i class="fas fa-history me-2"></i>Assessment History</h6>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <p><strong>Created:</strong> @Model.HEEADSSSAssessment.CreatedAt.ToString("MMM dd, yyyy HH:mm")</p>
                                        </div>
                                        <div class="col-md-6">
                                            <p><strong>Last Updated:</strong> @(Model.HEEADSSSAssessment.UpdatedAt.HasValue ? Model.HEEADSSSAssessment.UpdatedAt.Value.ToString("MMM dd, yyyy HH:mm") : "Not updated")</p>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-12">
                                            <p><strong>Assessment Notes:</strong> @(Model.HEEADSSSAssessment.AssessmentNotes ?? "No additional notes")</p>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info">
                                    <p>No HEEADSSS Assessment data available for this patient.</p>
                                    <a href="/Nurse/CreateHEEADSSSAssessment?appointmentId=@Model.Appointment.Id" class="btn btn-primary btn-sm mt-2">
                                        <i class="fas fa-plus-circle me-1"></i>
                                        Create New Assessment
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Initialize tabs
            var triggerTabList = [].slice.call(document.querySelectorAll('#assessmentTabs button'))
            triggerTabList.forEach(function (triggerEl) {
                var tabTrigger = new bootstrap.Tab(triggerEl)
                triggerEl.addEventListener('click', function (event) {
                    event.preventDefault()
                    tabTrigger.show()
                })
            })
        });
    </script>
} 