                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" asp-for="NCDRiskAssessment.BPStatus" value="Stage 1" />
                                    <label class="form-check-label">Stage 1 (140–159/90–99)</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" asp-for="NCDRiskAssessment.BPStatus" value="Stage 2" />
                                    <label class="form-check-label">Stage 2 (≥160/≥100)</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" asp-for="NCDRiskAssessment.BPStatus" value="Elevated" />
                                    <label class="form-check-label">Elevated BP</label>
                                </div>
