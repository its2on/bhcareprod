@page
@model Barangay.Pages.Nurse.PrintNCDAssessmentModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NCD Risk Assessment - Print</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 12px;
            line-height: 1.4;
            margin: 0;
            padding: 20px;
            color: #000;
        }
        
        .header {
            text-align: center;
            margin-bottom: 30px;
            border-bottom: 2px solid #000;
            padding-bottom: 20px;
        }
        
        .header h1 {
            font-size: 18px;
            font-weight: bold;
            margin: 0 0 10px 0;
        }
        
        .header h2 {
            font-size: 14px;
            font-weight: bold;
            margin: 0;
        }
        
        .section {
            margin-bottom: 25px;
            page-break-inside: avoid;
        }
        
        .section-title {
            font-size: 14px;
            font-weight: bold;
            background-color: #f0f0f0;
            padding: 8px;
            margin-bottom: 15px;
            border: 1px solid #000;
        }
        
        .form-row {
            display: flex;
            margin-bottom: 8px;
        }
        
        .form-group {
            flex: 1;
            margin-right: 15px;
        }
        
        .form-group:last-child {
            margin-right: 0;
        }
        
        .form-label {
            font-weight: bold;
            display: block;
            margin-bottom: 3px;
        }
        
        .form-value {
            border-bottom: 1px solid #000;
            padding: 2px 0;
            min-height: 18px;
        }
        
        .checkbox-group {
            display: flex;
            align-items: center;
            margin-bottom: 5px;
        }
        
        .checkbox {
            width: 15px;
            height: 15px;
            border: 2px solid #000;
            margin-right: 8px;
            display: inline-block;
            position: relative;
            vertical-align: middle;
            text-align: center;
            line-height: 11px;
        }
        
        .checkbox.checked {
            background-color: #000;
            color: #fff;
        }
        
        .checkbox.checked::after {
            content: "";
            font-weight: bold;
            font-size: 12px;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }
        
        .checkbox-label {
            font-weight: normal;
            font-size: 11px;
            line-height: 1.3;
        }
        
        .subsection-title {
            font-weight: bold;
            font-size: 12px;
            margin: 15px 0 8px 0;
            border-bottom: 1px solid #ccc;
            padding-bottom: 3px;
        }
        
        .measurement-table {
            width: 100%;
            border-collapse: collapse;
            margin: 10px 0;
            font-size: 11px;
        }
        
        .measurement-table th,
        .measurement-table td {
            border: 1px solid #000;
            padding: 3px 5px;
            text-align: center;
        }
        
        .measurement-table th {
            background-color: #f8f8f8;
            font-weight: bold;
        }
        
        .checkbox-row {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            margin-bottom: 8px;
        }
        
        .inline-checkboxes {
            display: flex;
            gap: 25px;
            margin-bottom: 5px;
        }
        
        .table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 15px;
        }
        
        .table th,
        .table td {
            border: 1px solid #000;
            padding: 5px;
            text-align: left;
        }
        
        .table th {
            background-color: #f0f0f0;
            font-weight: bold;
        }
        
        .footer {
            margin-top: 40px;
            border-top: 1px solid #000;
            padding-top: 20px;
        }
        
        .signature-section {
            display: flex;
            justify-content: space-between;
            margin-top: 30px;
        }
        
        .signature-box {
            width: 200px;
            text-align: center;
        }
        
        .signature-line {
            border-bottom: 1px solid #000;
            height: 40px;
            margin-bottom: 5px;
        }
        
        @@media print {
            body {
                margin: 0;
                padding: 15px;
            }
            
            .no-print {
                display: none !important;
            }
            
            .page-break {
                page-break-before: always;
            }
            
            .checkbox {
                -webkit-print-color-adjust: exact;
                color-adjust: exact;
                print-color-adjust: exact;
            }
            
            .checkbox.checked {
                background-color: #000 !important;
                -webkit-print-color-adjust: exact;
                color-adjust: exact;
                print-color-adjust: exact;
            }
            
            .checkbox.checked::after {
                -webkit-print-color-adjust: exact;
                color-adjust: exact;
                print-color-adjust: exact;
            }
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>REPUBLIC OF THE PHILIPPINES</h1>
        <h2>NON-COMMUNICABLE DISEASE RISK ASSESSMENT FORM</h2>
        <p><strong>Assessment Date:</strong> @DateTime.Now.ToString("MMMM dd, yyyy")</p>
        
        <!-- Update Button -->
        <div class="no-print" style="margin-top: 20px; text-align: center;">
            <a href="/Nurse/EditNCDAssessment?appointmentId=@Model.NCDRiskAssessment.AppointmentId" class="btn btn-primary">
                <i class="fas fa-edit me-1"></i>
                Update Assessment
            </a>
        </div>
    </div>

    <div class="section">
        <div class="section-title">PART I: DEMOGRAPHIC-SOCIO-ECONOMIC PROFILE</div>
        
        <div class="form-row">
            <div class="form-group">
                <span class="form-label">Health Facility:</span>
                <div class="form-value">@Model.NCDRiskAssessment.HealthFacility</div>
            </div>
            <div class="form-group">
                <span class="form-label">Family No:</span>
                <div class="form-value">@Model.NCDRiskAssessment.FamilyNo</div>
            </div>
        </div>
        
        <div class="form-row">
            <div class="form-group">
                <span class="form-label">Name:</span>
                <div class="form-value">@Model.NCDRiskAssessment.FirstName @Model.NCDRiskAssessment.MiddleName @Model.NCDRiskAssessment.LastName</div>
            </div>
            <div class="form-group">
                <span class="form-label">Age:</span>
                <div class="form-value">@Model.NCDRiskAssessment.Edad years</div>
            </div>
            <div class="form-group">
                <span class="form-label">Gender:</span>
                <div class="form-value">@Model.NCDRiskAssessment.Kasarian</div>
            </div>
        </div>
        
        <div class="form-row">
            <div class="form-group">
                <span class="form-label">Civil Status:</span>
                <div class="form-value">@Model.NCDRiskAssessment.CivilStatus</div>
            </div>
            <div class="form-group">
                <span class="form-label">Occupation:</span>
                <div class="form-value">@Model.NCDRiskAssessment.Occupation</div>
            </div>
            <div class="form-group">
                <span class="form-label">Religion:</span>
                <div class="form-value">@Model.NCDRiskAssessment.Relihiyon</div>
            </div>
        </div>
        
        <div class="form-row">
            <div class="form-group">
                <span class="form-label">Address:</span>
                <div class="form-value">@Model.NCDRiskAssessment.Address</div>
            </div>
            <div class="form-group">
                <span class="form-label">Barangay:</span>
                <div class="form-value">@Model.NCDRiskAssessment.Barangay</div>
            </div>
        </div>
        
        <div class="form-row">
            <div class="form-group">
                <span class="form-label">Contact Number:</span>
                <div class="form-value">@Model.NCDRiskAssessment.Telepono</div>
            </div>
            <div class="form-group">
                <span class="form-label">Birthday:</span>
                <div class="form-value">@Model.NCDRiskAssessment.Birthday</div>
            </div>
        </div>
    </div>

    <div class="section">
        <div class="section-title">PART II: PAST MEDICAL HISTORY</div>
        
        <!-- Section 2.1: Past Medical History Checkboxes -->
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.HasDiabetes == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Diabetes</span>
                @if (Model.NCDRiskAssessment.HasDiabetes == "true")
                {
                    <span> - Year: @Model.NCDRiskAssessment.DiabetesYear, Medication: @Model.NCDRiskAssessment.DiabetesMedication</span>
                }
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.HasHypertension == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Hypertension</span>
                @if (Model.NCDRiskAssessment.HasHypertension == "true")
                {
                    <span> - Year: @Model.NCDRiskAssessment.HypertensionYear, Medication: @Model.NCDRiskAssessment.HypertensionMedication</span>
                }
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.HasCancer == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Cancer</span>
                @if (Model.NCDRiskAssessment.HasCancer == "true")
                {
                    <span> - Type: @Model.NCDRiskAssessment.CancerType, Year: @Model.NCDRiskAssessment.CancerYear, Medication: @Model.NCDRiskAssessment.CancerMedication</span>
                }
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.HasCOPD == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">COPD</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.HasLungDisease == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Lung Disease</span>
                @if (Model.NCDRiskAssessment.HasLungDisease == "true")
                {
                    <span> - Year: @Model.NCDRiskAssessment.LungDiseaseYear, Medication: @Model.NCDRiskAssessment.LungDiseaseMedication</span>
                }
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.HasEyeDisease == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Eye Disease</span>
            </div>
        </div>

        <!-- Section 2.2: Chest Pain Questions (Q2.1-2.8) -->
        <div style="margin-top: 20px; font-weight: bold;">2. Pananakit ng dibdib:</div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.HasChestPain == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">2.1 Nakakaramdam ka ba ng pananakit o kabigatan sa dibdib?</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.ChestPainSpreadsToArm == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">2.2 Ang sakit ba ay nasa gitna ng dibdib, kaliwang bahagi ng dibdib hanggang sa kaliwang braso?</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.NumbnessWhenWalkingFast == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">2.3 Nararamdaman mo ba ito kung nagmamadali o naglalakad ng mabilis o pakiramdam na paakyat?</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.PainRelievedWithRest == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">2.4 Napapatigil ka ba sa paglalakad kapag sumasakit ang iyong dibdib?</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.LossOfConsciousnessLessThan10Min == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">2.5 Nawawala ba ang sakit kapag hindi ka kumikilos o naglalagay ng gamot sa ilalim ng dila?</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.SeeDoctorIfYes == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">2.6 Nawawala ba ang pananakit sa loob ng 10 minuto?</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.PainLastsMoreThan30Min == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">2.7 Nakakaramdam ka ba ng sakit sa dibdib na tumatagal higit sa 30 minuto?</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.Pananakit28 == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">2.8 Nakakaramdam ka ba hirap sa pagsasalita, panghihina ng braso at/o binti o pamamanhid sa kalahating bahagi ng katawan?</span>
            </div>
        </div>
    </div>

    <div class="section">
        <div class="section-title">PART III: ASSESSMENT OF RISK FACTORS</div>
        
        <!-- B.1 Nutrition -->
        <div style="font-weight: bold; margin-bottom: 10px;">B.1 Nutrisyon</div>
        <div style="margin-bottom: 10px;">1. Madalas mo bang kainin ang mga sumusunod kada araw?</div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.EatsVegetablesDaily == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">a. gulay</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.EatsFruitsDaily == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">b. prutas</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.EatsFishDaily == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">c. isda</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.EatsMeatDaily == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">d. karne</span>
            </div>
        </div>
        
        <div style="margin: 15px 0 10px 0;">2. Kumakain ka ba ng higit sa 2 beses kada linggo ng:</div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.EatsSweetFoodMoreThan2TimesPerWeek == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">a. matatamis na pagkain (pastilya ay mga kakanin)</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.EatsFattyFoodMoreThan2TimesPerWeek == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">b. mamantikang pagkain</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.HasHighSaltIntake == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">c. maalat na pagkain (isda at karne na tinuyo o pinakurat)</span>
            </div>
        </div>
        
        <!-- B.2 Alcohol -->
        <div style="font-weight: bold; margin: 20px 0 10px 0;">B.2 Alchohol</div>
        <div style="margin-bottom: 10px;">1. Umiinom ka ba ng alak?</div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.DrinksAlcohol == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Oo</span>
            </div>
            <div class="checkbox-group" style="margin-left: 30px;">
                <span class="checkbox @(Model.NCDRiskAssessment.DrinksAlcohol != "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Hindi</span>
            </div>
        </div>
        
        @if (Model.NCDRiskAssessment.DrinksAlcohol == "true")
        {
            <div style="margin: 10px 0;">Anong klaseng alak ang inyong ginagamit?</div>
            <div class="form-row">
                <div class="checkbox-group">
                    <span class="checkbox @(Model.NCDRiskAssessment.DrinksBeer == "true" ? "checked" : "")"></span>
                    <span class="checkbox-label">Beer</span>
                </div>
                <div class="checkbox-group" style="margin-left: 30px;">
                    <span class="checkbox @(Model.NCDRiskAssessment.DrinksWine == "true" ? "checked" : "")"></span>
                    <span class="checkbox-label">Wine</span>
                </div>
                <div class="checkbox-group" style="margin-left: 30px;">
                    <span class="checkbox @(Model.NCDRiskAssessment.DrinksWhiskyGinBrandy == "true" ? "checked" : "")"></span>
                    <span class="checkbox-label">Whisky/Gin/Brandy</span>
                </div>
            </div>
        }
        
        <!-- B.3 Physical Activity -->
        <div style="font-weight: bold; margin: 20px 0 10px 0;">B.3 Ehersisyo</div>
        <div style="margin-bottom: 10px;">1. May gingawa ka bang ehersisyo?</div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.ModerateIntensityExercise == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Moderate Intensity Physical Activity (150 minutes sa loob ng isang linggo)</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.VigorousIntensityExercise == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Vigorous Intensity Exercise</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.InsufficientPhysicalActivity == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Insufficient Physical Activity</span>
            </div>
        </div>
        
        <!-- B.4 Anthropometric Measurements -->
        <div style="font-weight: bold; margin: 20px 0 10px 0;">B.4 Pagsusukat</div>
        
        <table class="table">
            <tr>
                <th>Weight:</th>
                <td>@Model.NCDRiskAssessment.Weight kg</td>
                <th>Height:</th>
                <td>@Model.NCDRiskAssessment.Height cm</td>
                <th>BMI:</th>
                <td>@Model.NCDRiskAssessment.BMI</td>
                <th>Status:</th>
                <td>@Model.NCDRiskAssessment.BMIStatus</td>
            </tr>
        </table>
        
        <div style="margin-top: 10px; font-weight: bold;">BMI</div>
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.BMIStatus?.Contains("Underweight") == true ? "checked" : "")"></span>
                <span class="checkbox-label">Underweight (&lt;18.5)</span>
            </div>
            <div class="checkbox-group" style="margin-left: 30px;">
                <span class="checkbox @(Model.NCDRiskAssessment.BMIStatus?.Contains("Normal") == true ? "checked" : "")"></span>
                <span class="checkbox-label">Normal (18.5-22.9)</span>
            </div>
        </div>
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.BMIStatus?.Contains("Overweight") == true ? "checked" : "")"></span>
                <span class="checkbox-label">Overweight (23-24.9)</span>
            </div>
            <div class="checkbox-group" style="margin-left: 30px;">
                <span class="checkbox @(Model.NCDRiskAssessment.BMIStatus?.Contains("Obese") == true ? "checked" : "")"></span>
                <span class="checkbox-label">Obese (&gt;25)</span>
            </div>
        </div>
        
        <table class="table" style="margin-top: 15px;">
            <tr>
                <th>Waist:</th>
                <td>@Model.NCDRiskAssessment.Waist</td>
                <th>Hip:</th>
                <td>@Model.NCDRiskAssessment.Hip</td>
                <th>WH Ratio:</th>
                <td>@Model.NCDRiskAssessment.WHRatio</td>
                <th>Status:</th>
                <td>@Model.NCDRiskAssessment.WHStatus</td>
            </tr>
        </table>
        
        <div style="margin-top: 10px;">W:H cm/H cm</div>
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.WHStatus?.Contains("At risk") == true ? "checked" : "")"></span>
                <span class="checkbox-label">At risk</span>
            </div>
        </div>
        
        <!-- Blood Sugar Section -->
        <div style="font-weight: bold; margin: 20px 0 10px 0;">4.2 Blood Sugar</div>
        
        <table class="table">
            <tr>
                <th></th>
                <th>Fasting Blood Sugar Venous Extraction</th>
                <th>Status</th>
            </tr>
            <tr>
                <td>Result:</td>
                <td>@Model.NCDRiskAssessment.FastingBloodSugar mg/dL</td>
                <td>@Model.NCDRiskAssessment.BloodSugarStatus</td>
            </tr>
        </table>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.BloodSugarStatus?.Contains("Normal") == true ? "checked" : "")"></span>
                <span class="checkbox-label">Normal (&lt; 100 mg/dL)</span>
            </div>
        </div>
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.BloodSugarStatus?.Contains("Impaired") == true ? "checked" : "")"></span>
                <span class="checkbox-label">Impaired fasting glucose (100-125 mg/dL)</span>
            </div>
        </div>
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.BloodSugarStatus?.Contains("Abnormal") == true ? "checked" : "")"></span>
                <span class="checkbox-label">Abnormal: ≥ 200 mg/dL</span>
            </div>
        </div>
        
        <table class="table" style="margin-top: 15px;">
            <tr>
                <th>Random Blood Sugar:</th>
                <td>@Model.NCDRiskAssessment.RandomBloodSugar mg/dL</td>
            </tr>
        </table>
        
        <div style="margin: 10px 0;">Mga sintomas (kailangan ang LAHAT):</div>
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.HasPolyuria == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Polyuria</span>
            </div>
            <div class="checkbox-group" style="margin-left: 30px;">
                <span class="checkbox @(Model.NCDRiskAssessment.HasPolydipsia == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Polydipsia</span>
            </div>
        </div>
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.HasPolyphagia == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Polyphagia</span>
            </div>
            <div class="checkbox-group" style="margin-left: 30px;">
                <span class="checkbox @(Model.NCDRiskAssessment.HasWeightLoss == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Weight loss</span>
            </div>
        </div>
        
        <!-- Blood Pressure Section -->
        <div style="font-weight: bold; margin: 20px 0 10px 0;">4.3 Blood Pressure</div>
        
        <table class="table">
            <tr>
                <th>Left arm mean BP:</th>
                <td>@Model.NCDRiskAssessment.LeftArmMeanBP</td>
                <th>Right arm mean BP:</th>
                <td>@Model.NCDRiskAssessment.RightArmMeanBP</td>
                <th>Baseline BP:</th>
                <td>@Model.NCDRiskAssessment.BaselineBP</td>
                <th>Status:</th>
                <td>@Model.NCDRiskAssessment.BPStatus</td>
            </tr>
        </table>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.BPStatus?.Contains("Normal") == true ? "checked" : "")"></span>
                <span class="checkbox-label">Normal (&lt; 120 mmHg/&lt; 80 mmHg)</span>
            </div>
        </div>
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.BPStatus?.Contains("Pre-HPN") == true ? "checked" : "")"></span>
                <span class="checkbox-label">Pre-HPN (120-139 mmHg/80-89 mmHg)</span>
            </div>
        </div>
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.BPStatus?.Contains("Stage 1") == true ? "checked" : "")"></span>
                <span class="checkbox-label">Stage 1 (140-159 mmHg/90-99 mmHg)</span>
            </div>
        </div>
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.BPStatus?.Contains("Stage 2") == true ? "checked" : "")"></span>
                <span class="checkbox-label">Stage 2 (≥160/≥ 100 mmHg)</span>
            </div>
        </div>
        
        <!-- Cholesterol Section -->
        <div style="font-weight: bold; margin: 20px 0 10px 0;">4.4 Cholesterol Level</div>
        
        <table class="table">
            <tr>
                <th>Result:</th>
                <td>@Model.NCDRiskAssessment.CholesterolResult mg/dL</td>
                <th>Status:</th>
                <td>@Model.NCDRiskAssessment.CholesterolStatus</td>
            </tr>
        </table>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.CholesterolStatus?.Contains("Normal") == true ? "checked" : "")"></span>
                <span class="checkbox-label">Normal (mga at mas mababa sa 200-239/100 mg)</span>
            </div>
        </div>
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.CholesterolStatus?.Contains("Elevated") == true ? "checked" : "")"></span>
                <span class="checkbox-label">Elevated: masyas at nasa (200-239/100 mg and above)</span>
            </div>
        </div>
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.CholesterolStatus?.Contains("High") == true ? "checked" : "")"></span>
                <span class="checkbox-label">High cholesterol (≥240/100 mg and above/elevated, at risk)</span>
            </div>
        </div>
        
        <!-- Urine Dipstick Test -->
        <div style="font-weight: bold; margin: 20px 0 10px 0;">4.5 Urine Dipstick Test</div>
        
        <table class="table">
            <tr>
                <th>Protein</th>
                <td>@Model.NCDRiskAssessment.UrineProtein</td>
                <th>Ketones</th>
                <td>@Model.NCDRiskAssessment.UrineKetones</td>
            </tr>
        </table>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.HasUrineProtein == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">(+) urine protein</span>
            </div>
            <div class="checkbox-group" style="margin-left: 30px;">
                <span class="checkbox @(Model.NCDRiskAssessment.HasUrineProtein != "true" ? "checked" : "")"></span>
                <span class="checkbox-label">(-) urine protein</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.HasUrineKetones == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">(+) urine ketones</span>
            </div>
            <div class="checkbox-group" style="margin-left: 30px;">
                <span class="checkbox @(Model.NCDRiskAssessment.HasUrineKetones != "true" ? "checked" : "")"></span>
                <span class="checkbox-label">(-) urine ketones</span>
            </div>
        </div>
        
        <!-- Risk Profile -->
        <div style="font-weight: bold; margin: 20px 0 10px 0;">4.6 Risk Profile (For Doctors Only)</div>
        <div style="margin-bottom: 10px;">7. Check ay nai-screen sa sa Breast/Cervical Cancer? (Babae na 30 years old and above)</div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.BreastCancerScreened == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Oo (Breast/Cervical screening sa nakaraang 30 years old and above)</span>
            </div>
            <div class="checkbox-group" style="margin-left: 30px;">
                <span class="checkbox @(Model.NCDRiskAssessment.BreastCancerScreened != "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Hindi (walang)</span>
            </div>
        </div>
        
        @if (!string.IsNullOrEmpty(Model.NCDRiskAssessment.RiskPercentage))
        {
            <div class="form-row">
                <div class="form-group">
                    <span class="form-label">Risk Percentage:</span>
                    <div class="form-value">@Model.NCDRiskAssessment.RiskPercentage%</div>
                </div>
            </div>
        }
    </div>

    <div class="section">
        <div class="section-title">PART IV: FAMILY HISTORY</div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.FamilyHasHypertension == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Family Hypertension</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.FamilyHasHeartDisease == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Family Heart Disease</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.FamilyHasStroke == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Family Stroke</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.FamilyHasDiabetes == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Family Diabetes</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.FamilyHasCancer == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Family Cancer</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.FamilyHasKidneyDisease == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Family Kidney Disease</span>
            </div>
        </div>
        
        @if (!string.IsNullOrEmpty(Model.NCDRiskAssessment.FamilyOtherDiseaseDetails))
        {
            <div class="form-row">
                <div class="form-group">
                    <span class="form-label">Other Family Disease Details:</span>
                    <div class="form-value">@Model.NCDRiskAssessment.FamilyOtherDiseaseDetails</div>
                </div>
            </div>
        }
    </div>

    <div class="section">
        <div class="section-title">PART V: RISK SCREENING</div>
        
        <div class="form-row">
            <div class="form-group">
                <span class="form-label">Risk Status:</span>
                <div class="form-value">@Model.NCDRiskAssessment.RiskStatus</div>
            </div>
        </div>
    </div>

    <div class="footer">
        <!-- Assessment Information -->
        <div style="margin-bottom: 20px;">
            <div class="form-row">
                <div class="form-group">
                    <span class="form-label">Interviewed/Assessed by:</span>
                    <div class="form-value">@Model.NCDRiskAssessment.InterviewedBy</div>
                </div>
                <div class="form-group">
                    <span class="form-label">Designation:</span>
                    <div class="form-value">@Model.NCDRiskAssessment.Designation</div>
                </div>
            </div>
        </div>
        
        <div class="signature-section">
            <div class="signature-box">
                <div class="signature-line"></div>
                <div>Patient Signature</div>
            </div>
            <div class="signature-box">
                <div class="signature-line"></div>
                <div>Interviewer/Assessor Signature</div>
            </div>
        </div>
        
        <div style="margin-top: 20px; text-align: center;">
            <p><strong>Date:</strong> @(!string.IsNullOrEmpty(Model.NCDRiskAssessment.AssessmentDate) ? Model.NCDRiskAssessment.AssessmentDate : DateTime.Now.ToString("MMMM dd, yyyy"))</p>
        </div>
        
        <!-- Print URL for reference -->
        <div style="margin-top: 20px; font-size: 10px; color: #666; text-align: center;">
            <p>Generated from: https://localhost:5003/Nurse/PrintNCDAssessment?appointmentId=@Model.NCDRiskAssessment.AppointmentId</p>
        </div>
    </div>

    <script>
        // Auto-print when page loads
        window.onload = function() {
            window.print();
        };
    </script>
</body>
</html>
