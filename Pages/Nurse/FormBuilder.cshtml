        function updateFieldOrders() {
            const fields = document.querySelectorAll('.question-card');
            fields.forEach((field, index) => {
                field.dataset.order = index;
            });
        }
        
        // Flag to prevent multiple executions
        let isRemovingDuplicates = false;
        
        function removeDuplicates(event) {
            // Prevent multiple executions
            if (isRemovingDuplicates) {
                console.log('Removing duplicates is already in progress, please wait...');
                return;
            }
            
            if (!confirm('This will remove all duplicate fields (fields with the same label). Keep only the first occurrence of each. Continue?')) {
                return;
            }
            
            isRemovingDuplicates = true;
            
            // Disable the button
            const button = event?.target || document.getElementById('btnRemoveDuplicates');
            if (button) {
                button.disabled = true;
                button.style.opacity = '0.6';
                button.style.cursor = 'not-allowed';
            }
            
            try {
                const container = document.getElementById('questionsContainer');
                const allElements = Array.from(container.children);
                
                // Track seen field labels and section titles
                const seenFieldLabels = new Set();
                const seenSectionTitles = new Set();
                let removedCount = 0;
                
                allElements.forEach((element, index) => {
                    // Check if it's a section break
                    if (element.dataset.sectionBreak === 'true') {
                        const sectionTitleInput = element.querySelector('[data-section="title"]');
                        const sectionTitle = sectionTitleInput?.value?.trim() || '';
                        
                        if (sectionTitle) {
                            if (seenSectionTitles.has(sectionTitle)) {
                                // This is a duplicate section, remove it
                                element.remove();
                                removedCount++;
                                console.log(`Removed duplicate section: "${sectionTitle}"`);
                            } else {
                                seenSectionTitles.add(sectionTitle);
                            }
                        }
                    }
                    // Check if it's a question card
                    else if (element.classList.contains('question-card')) {
                        const labelInput = element.querySelector('[data-field="label"]');
                        const fieldLabel = labelInput?.value?.trim() || '';
                        
                        if (fieldLabel) {
                            // Normalize the label for comparison (remove extra spaces, make lowercase)
                            const normalizedLabel = fieldLabel.toLowerCase().replace(/\s+/g, ' ').trim();
                            
                            if (seenFieldLabels.has(normalizedLabel)) {
                                // This is a duplicate field, remove it
                                element.remove();
                                removedCount++;
                                console.log(`Removed duplicate field: "${fieldLabel}"`);
                            } else {
                                seenFieldLabels.add(normalizedLabel);
                            }
                        }
                    }
                });
                
                // Update field orders after removal
                updateFieldOrders();
                
                // Show success message
                if (removedCount > 0) {
                    alert(`Successfully removed ${removedCount} duplicate field(s)!`);
                } else {
                    alert('No duplicates found. All fields are unique.');
                }
            } catch (error) {
                console.error('Error removing duplicates:', error);
                alert('An error occurred while removing duplicates. Please try again.');
            } finally {
                // Re-enable the button
                isRemovingDuplicates = false;
                if (button) {
                    button.disabled = false;
                    button.style.opacity = '1';
                    button.style.cursor = 'pointer';
                }
            }
        }
        
        function previewForm() {
            const formData = collectFormData();
            const previewWindow = window.open('', '_blank');
            previewWindow.document.write(generatePreviewHtml(formData));
        }
        
        function collectFormData() {
            const formName = document.getElementById('formName').value;
            const formDescription = document.getElementById('formDescription').value;
            const formKey = document.getElementById('formKey').value;
            const formServiceId = document.getElementById('formServiceId').value;
            const formIsActive = document.getElementById('formIsActive').checked;
            const formDisplayOrder = document.getElementById('formDisplayOrder').value;
            const showInAppointmentFlow = document.getElementById('showInAppointmentFlow').checked;
            const minAge = document.getElementById('minAge').value;
            const maxAge = document.getElementById('maxAge').value;
            
            const fields = [];
            const container = document.getElementById('questionsContainer');
            const allElements = container.children;
            
            Array.from(allElements).forEach((element, index) => {
                // Check if it's a section break
                if (element.dataset.sectionBreak === 'true') {
                    const sectionTitle = element.querySelector('[data-section="title"]')?.value || '';
                    const sectionDescription = element.querySelector('[data-section="description"]')?.value || '';
                    
                    fields.push({
                        fieldType: 'section',
                        fieldLabel: sectionTitle,
                        description: sectionDescription,
                        displayOrder: index
                    });
                }
                // Check if it's a question card
                else if (element.classList.contains('question-card')) {
                    const fieldId = element.id;
                    const fieldType = element.dataset.fieldType;
                    const fieldLabel = element.querySelector('[data-field="label"]').value;
                    const isRequired = element.querySelector('[data-field="required"]').checked;
                    const existingId = element.dataset.existingId || 0;
                    
                    // Get title and description
                    const fieldTitle = element.querySelector('[data-field="title"]')?.value || '';
                    const fieldDescription = element.querySelector('[data-field="description"]')?.value || '';
                    
                    // Get validation pattern
                    const validationPattern = element.querySelector('[data-field="validation"]')?.value || '';
                    
                    const field = {
                        formFieldId: parseInt(existingId),
                        fieldLabel: fieldLabel || 'Untitled Question',
                        fieldName: (fieldLabel || 'field').toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, ''),
                        fieldType: fieldType,
                        isRequired: isRequired,
                        displayOrder: index,
                        title: fieldTitle,
                        description: fieldDescription,
                        validationPattern: validationPattern,
                        options: []
                    };
                    
                    if (['radio', 'checkbox', 'select'].includes(fieldType)) {
                        element.querySelectorAll('[data-option="label"]').forEach((optionInput, optIndex) => {
                            const optionLabel = optionInput.value || `Option ${optIndex + 1}`;
                            field.options.push({
                                optionLabel: optionLabel,
                                optionValue: optionLabel.toLowerCase().replace(/\s+/g, '_'),
                                displayOrder: optIndex
                            });
                        });
                    }
                    
                    fields.push(field);
                }
            });
            
            return {
                formTemplateId: formTemplateId,
                formName: formName || 'Untitled Form',
                formDescription: formDescription,
                formKey: formKey || 'untitled-form',
                serviceId: formServiceId ? parseInt(formServiceId) : null,
                isActive: formIsActive,
                displayOrder: parseInt(formDisplayOrder) || 0,
                showInAppointmentFlow: showInAppointmentFlow,
                minAge: minAge ? parseInt(minAge) : null,
                maxAge: maxAge ? parseInt(maxAge) : null,
                iconClass: null,
                successMessage: null,
                redirectUrl: null,
                fields: fields
            };
        }
        
        function generatePreviewHtml(formData) {
            // Split fields into sections (pages) based on section breaks
            let sections = [];
            let currentSection = {
                title: '',
                description: '',
                fields: []
            };
            
            formData.fields.forEach(field => {
                if (field.fieldType === 'section') {
                    // Start a new section
                    if (currentSection.fields.length > 0) {
                        sections.push(currentSection);
                    }
                    currentSection = {
                        title: field.fieldLabel || 'Untitled Section',
                        description: field.description || '',
                        fields: []
                    };
                } else {
                    currentSection.fields.push(field);
                }
            });
            
            // Add the last section
            if (currentSection.fields.length > 0) {
                sections.push(currentSection);
            }
            
            // If no sections (no section breaks), treat all as one section
            if (sections.length === 0) {
                sections.push({
                    title: '',
                    description: '',
                    fields: formData.fields.filter(f => f.fieldType !== 'section')
                });
            }
            
            // Generate HTML for multi-step form if there are multiple sections
            const isMultiStep = sections.length > 1;
            let sectionsHtml = '';
            
            sections.forEach((section, sectionIndex) => {
                let fieldsHtml = '';
                
                // Add section header if it has a title
                if (section.title && isMultiStep) {
                    fieldsHtml += `
                        <div class="section-header mb-4">
                            <h3 class="text-primary mb-2">
                                <i class="fa-solid fa-clipboard-list me-2"></i>${section.title}
                            </h3>
                            ${section.description ? `<p class="text-muted">${section.description}</p>` : ''}
                        </div>
                    `;
                }
                
                // Generate fields for this section
                section.fields.forEach(field => {
                    let fieldHtml = `
                        <div class="mb-4">
                            <label class="form-label fw-bold">
                                ${field.fieldLabel}
                                ${field.isRequired ? '<span class="text-danger">*</span>' : ''}
                            </label>
                    `;
                    
                    switch(field.fieldType) {
                        case 'text':
                        case 'email':
                        case 'tel':
                        case 'number':
                            fieldHtml += `<input type="${field.fieldType}" class="form-control" ${field.isRequired ? 'required' : ''}>`;
                            break;
                            
                        case 'textarea':
                            fieldHtml += `<textarea class="form-control" rows="3" ${field.isRequired ? 'required' : ''}></textarea>`;
                            break;
                            
                        case 'radio':
                            field.options.forEach((opt, idx) => {
                                fieldHtml += `
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="${field.fieldName}" id="${field.fieldName}_${idx}" value="${opt.optionValue}" ${field.isRequired ? 'required' : ''}>
                                        <label class="form-check-label" for="${field.fieldName}_${idx}">${opt.optionLabel}</label>
                                    </div>
                                `;
                            });
                            break;
                            
                        case 'checkbox':
                            field.options.forEach((opt, idx) => {
                                fieldHtml += `
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="${field.fieldName}[]" id="${field.fieldName}_${idx}" value="${opt.optionValue}">
                                        <label class="form-check-label" for="${field.fieldName}_${idx}">${opt.optionLabel}</label>
                                    </div>
                                `;
                            });
                            break;
                            
                        case 'select':
                            fieldHtml += `<select class="form-select" ${field.isRequired ? 'required' : ''}>
                                <option value="">Choose...</option>`;
                            field.options.forEach(opt => {
                                fieldHtml += `<option value="${opt.optionValue}">${opt.optionLabel}</option>`;
                            });
                            fieldHtml += `</select>`;
                            break;
                            
                        case 'date':
                            fieldHtml += `<input type="date" class="form-control" ${field.isRequired ? 'required' : ''}>`;
                            break;
                            
                        case 'time':
                            fieldHtml += `<input type="time" class="form-control" ${field.isRequired ? 'required' : ''}>`;
                            break;
                            
                        case 'datetime-local':
                            fieldHtml += `<input type="datetime-local" class="form-control" ${field.isRequired ? 'required' : ''}>`;
                            break;
                            
                        case 'file':
                            fieldHtml += `<input type="file" class="form-control" ${field.isRequired ? 'required' : ''}>`;
                            break;
                    }
                    
                    fieldHtml += `</div>`;
                    fieldsHtml += fieldHtml;
                });
                
                // Wrap section in a page div
                sectionsHtml += `
                    <div class="form-page" data-page="${sectionIndex}" style="display: ${sectionIndex === 0 ? 'block' : 'none'};">
                        ${fieldsHtml}
                    </div>
                `;
            });
            
            // Generate progress indicator HTML for multi-step
            let progressHtml = '';
            if (isMultiStep) {
                progressHtml = '<div class="progress-indicator mb-4"><div class="d-flex justify-content-between align-items-center">';
                sections.forEach((section, idx) => {
                    const isActive = idx === 0 ? 'active' : '';
                    const stepTitle = section.title || `Step ${idx + 1}`;
                    progressHtml += `
                        <div class="step ${isActive}" data-step="${idx}">
                            <div class="step-number">${idx + 1}</div>
