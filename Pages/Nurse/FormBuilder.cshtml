@page "{id:int?}"
@model Barangay.Pages.Nurse.FormBuilderModel
@{
    ViewData["Title"] = Model.IsEdit ? "Edit Form" : "Create Form";
    Layout = "~/Pages/Shared/_NurseLayout.cshtml";
}

<style>
    :root {
        --form-builder-primary: #ff8c42;
        --form-builder-hover: #e67e22;
        --form-builder-light: #fff5f0;
        --form-builder-border: #dee2e6;
        --form-builder-shadow: 0 2px 4px rgba(0,0,0,0.08);
    }
    
    body {
        background-color: #f8f9fa;
    }
    
    .form-builder-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 20px 0;
    }
    
    .form-header-card {
        background: white;
        border-radius: 8px;
        border-top: 10px solid var(--form-builder-primary);
        box-shadow: var(--form-builder-shadow);
        padding: 30px;
        margin-bottom: 20px;
    }
    
    .form-header-card input {
        border: none;
        border-bottom: 1px solid var(--form-builder-border);
        border-radius: 0;
        font-size: 2rem;
        font-weight: 300;
        padding: 8px 0;
        transition: border-bottom-color 0.3s;
    }
    
    .form-header-card input:focus {
        border-bottom-color: var(--form-builder-primary);
        box-shadow: none;
    }
    
    .form-header-card textarea {
        border: none;
        border-bottom: 1px solid var(--form-builder-border);
        border-radius: 0;
        padding: 8px 0;
        resize: none;
    }
    
    .form-header-card textarea:focus {
        border-bottom-color: var(--form-builder-primary);
        box-shadow: none;
    }
    
    .question-card {
        background: white;
        border-radius: 8px;
        box-shadow: var(--form-builder-shadow);
        padding: 24px;
        margin-bottom: 12px;
        border-left: 6px solid transparent;
        transition: all 0.3s;
        cursor: move;
    }
    
    .question-card:hover {
        box-shadow: 0 4px 8px rgba(0,0,0,0.12);
    }
    
    .question-card.selected {
        border-left-color: var(--form-builder-primary);
        box-shadow: 0 4px 12px rgba(255, 140, 66, 0.2);
    }
    
    .question-card .question-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 16px;
    }
    
    .question-card .question-input {
        border: none;
        border-bottom: 1px solid var(--form-builder-border);
        border-radius: 0;
        padding: 8px 0;
        font-size: 1rem;
        width: 100%;
    }
    
    .question-card .question-input:focus {
        border-bottom-color: var(--form-builder-primary);
        box-shadow: none;
    }
    
    .field-type-selector {
        min-width: 200px;
        border: 1px solid var(--form-builder-border);
        border-radius: 4px;
    }
    
    .field-type-selector:focus {
        border-color: var(--form-builder-primary);
        box-shadow: 0 0 0 0.25rem rgba(255, 140, 66, 0.1);
    }
    
    .options-list {
        margin-top: 16px;
    }
    
    .option-item {
        display: flex;
        align-items: center;
        margin-bottom: 8px;
        padding: 8px;
        border-radius: 4px;
        transition: background-color 0.2s;
    }
    
    .option-item:hover {
        background-color: #f8f9fa;
    }
    
    .option-input {
        flex: 1;
        border: none;
        border-bottom: 1px dotted var(--form-builder-border);
        padding: 4px 8px;
        margin: 0 12px;
    }
    
    .option-input:focus {
        border-bottom-style: solid;
        border-bottom-color: var(--form-builder-primary);
        outline: none;
    }
    
    .question-footer {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        margin-top: 16px;
        padding-top: 16px;
        border-top: 1px solid var(--form-builder-border);
    }
    
    .field-meta-section {
        padding: 8px 0;
        border-bottom: 1px solid #f0f0f0;
    }
    
    .field-meta-content {
        padding: 8px 0;
        background-color: #f8f9fa;
        border-radius: 4px;
        padding: 12px;
    }
    
    .field-meta-content input,
    .field-meta-content textarea {
        background-color: white;
    }
    
    
    .field-type-icon {
        width: 24px;
        height: 24px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-right: 8px;
        color: #6c757d;
    }
    
    .sidebar-tools {
        position: sticky;
        top: 20px;
        max-height: calc(100vh - 40px);
        overflow-y: auto;
    }
    
    .tool-btn {
        display: flex;
        align-items: center;
        width: 100%;
        padding: 12px 16px;
        margin-bottom: 8px;
        border: 1px solid var(--form-builder-border);
        border-radius: 8px;
        background: white;
        transition: all 0.2s;
        cursor: pointer;
        text-align: left;
    }
    
    .tool-btn:hover {
        background: var(--form-builder-light);
        border-color: var(--form-builder-primary);
        transform: translateX(4px);
    }
    
    .tool-btn i {
        margin-right: 12px;
        font-size: 20px;
        color: var(--form-builder-primary);
    }
    
    .top-bar {
        background: white;
        padding: 16px 24px;
        border-bottom: 1px solid var(--form-builder-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        position: sticky;
        top: 0;
        z-index: 999;
    }
    
    .drag-handle {
        cursor: move;
        color: #6c757d;
        margin-right: 12px;
    }
    
    .drag-handle:hover {
        color: var(--form-builder-primary);
    }
    
    .section-break {
        background: linear-gradient(to right, var(--form-builder-border), var(--form-builder-primary), var(--form-builder-border));
        height: 2px;
        margin: 24px 0;
        position: relative;
    }
    
    .section-break-label {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background: white;
        padding: 4px 12px;
        border-radius: 4px;
        font-size: 12px;
        color: #6c757d;
        border: 1px solid var(--form-builder-border);
    }
    
    .sortable-ghost {
        opacity: 0.4;
        background: #f0f0f0;
    }
</style>

<div class="top-bar">
    <div class="d-flex align-items-center">
        <a href="/Nurse/ControlPanel" class="btn btn-light me-3">
            <i class="fa-solid fa-arrow-left"></i>
        </a>
        <div>
            <h5 class="mb-0" id="formTitleDisplay">@(Model.IsEdit ? Model.FormTemplate.FormName : "Untitled Form")</h5>
            <small class="text-muted">Auto-saved</small>
        </div>
    </div>
    <div>
        <button type="button" class="btn btn-outline-secondary me-2" onclick="previewForm()">
            <i class="fa-solid fa-eye me-2"></i>Preview
        </button>
        <button type="button" class="btn btn-primary" onclick="saveForm()">
            <i class="fa-solid fa-save me-2"></i>Save Form
        </button>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <!-- Main Form Builder Area -->
        <div class="col-lg-9">
            <div class="form-builder-container">
                <!-- Form Header Card -->
                <div class="form-header-card">
                    <input type="text" 
                           class="form-control" 
                           id="formName" 
                           placeholder="Form Title" 
                           value="@(Model.IsEdit ? Model.FormTemplate.FormName : "")"
                           oninput="updateFormTitle(this.value)">
                    <textarea class="form-control mt-3" 
                              id="formDescription" 
                              rows="2" 
                              placeholder="Form description">@(Model.IsEdit ? Model.FormTemplate.Description : "")</textarea>
                    
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Form Key (unique identifier)</label>
                            <input type="text" 
                                   class="form-control form-control-sm" 
                                   id="formKey" 
                                   placeholder="e.g., patient-registration"
                                   pattern="[a-z0-9-]+"
                                   value="@(Model.IsEdit ? Model.FormTemplate.FormKey : "")">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Service Type</label>
                            <select class="form-select form-select-sm" id="formServiceId">
                                <option value="">None (Standalone Form)</option>
                                @foreach (var service in Model.AvailableServices)
                                {
                                    <option value="@service.ServiceId" 
                                            selected="@(Model.IsEdit && Model.FormTemplate.ServiceId == service.ServiceId)">
                                        @service.ServiceName
                                    </option>
                                }
                            </select>
                            <small class="text-muted">Link this form to a specific consultation service</small>
                        </div>
                    </div>
                </div>

                <!-- Questions Container -->
                <div id="questionsContainer">
                    <!-- Questions will be added here dynamically -->
                </div>
            </div>
        </div>

        <!-- Sidebar Tools -->
        <div class="col-lg-3">
            <div class="sidebar-tools">
                <h6 class="text-muted mb-3">ADD FIELD</h6>
                
                <button type="button" class="tool-btn" onclick="addField('text')">
                    <i class="fa-solid fa-font"></i>
                    <span>Short Answer</span>
                </button>
                
                <button type="button" class="tool-btn" onclick="addField('textarea')">
                    <i class="fa-solid fa-align-left"></i>
                    <span>Paragraph</span>
                </button>
                
                <button type="button" class="tool-btn" onclick="addField('radio')">
                    <i class="fa-solid fa-circle-dot"></i>
                    <span>Multiple Choice</span>
                </button>
                
                <button type="button" class="tool-btn" onclick="addField('checkbox')">
                    <i class="fa-solid fa-square-check"></i>
                    <span>Checkboxes</span>
                </button>
                
                <button type="button" class="tool-btn" onclick="addField('select')">
                    <i class="fa-solid fa-caret-down"></i>
                    <span>Dropdown</span>
                </button>
                
                <button type="button" class="tool-btn" onclick="addField('date')">
                    <i class="fa-solid fa-calendar"></i>
                    <span>Date</span>
                </button>
                
                <button type="button" class="tool-btn" onclick="addField('time')">
                    <i class="fa-solid fa-clock"></i>
                    <span>Time</span>
                </button>
                
                <button type="button" class="tool-btn" onclick="addField('file')">
                    <i class="fa-solid fa-upload"></i>
                    <span>File Upload</span>
                </button>
                
                <button type="button" class="tool-btn" onclick="addField('number')">
                    <i class="fa-solid fa-hashtag"></i>
                    <span>Number</span>
                </button>
                
                <button type="button" class="tool-btn" onclick="addField('email')">
                    <i class="fa-solid fa-envelope"></i>
                    <span>Email</span>
                </button>
                
                <button type="button" class="tool-btn" onclick="addField('tel')">
                    <i class="fa-solid fa-phone"></i>
                    <span>Phone Number</span>
                </button>
                
                <hr class="my-3">
                
                <button type="button" class="tool-btn" onclick="addSectionBreak()">
                    <i class="fa-solid fa-grip-lines"></i>
                    <span>Section Break</span>
                </button>
                
                <hr class="my-3">
                
                <button type="button" class="tool-btn" id="btnAddStep4Template" style="background: #10b981; color: white;">
                    <i class="fa-solid fa-heart-pulse"></i>
                    <span>Add Step 4 Template</span>
                </button>
                <small class="text-muted d-block mt-2 px-2">Anthropometric Measurements</small>
                
                <button type="button" class="tool-btn" id="btnRemoveDuplicates" style="background: #dc3545; color: white; margin-top: 10px;">
                    <i class="fa-solid fa-trash-can"></i>
                    <span>Remove Duplicates</span>
                </button>
                <small class="text-muted d-block mt-2 px-2">Remove duplicate fields</small>

                <hr class="my-3">
                
                <h6 class="text-muted mb-3 mt-4">SETTINGS</h6>
                
                <div class="card">
                    <div class="card-body">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="formIsActive" @(Model.IsEdit && Model.FormTemplate.IsActive ? "checked" : Model.IsEdit ? "" : "checked")>
                            <label class="form-check-label" for="formIsActive">
                                <small>Form Active</small>
                            </label>
                        </div>
                        
                        <div class="mb-2">
                            <label class="form-label small">Display Order</label>
                            <input type="number" class="form-control form-control-sm" id="formDisplayOrder" value="@(Model.IsEdit ? Model.FormTemplate.DisplayOrder : 0)">
                        </div>
                        
                        <hr class="my-2">
                        
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" id="showInAppointmentFlow" @(Model.IsEdit && Model.FormTemplate.ShowInAppointmentFlow ? "checked" : "")>
                            <label class="form-check-label" for="showInAppointmentFlow">
                                <small>Show in Appointment Workflow</small>
                            </label>
                            <small class="form-text text-muted d-block">Enable for clinical forms (HEEADSSS, NCD)</small>
                        </div>
                        
                        <div class="row mb-2">
                            <div class="col-6">
                                <label class="form-label small">Min Age</label>
                                <input type="number" class="form-control form-control-sm" id="minAge" 
                                       placeholder="e.g., 10" min="0" max="120"
                                       value="@(Model.IsEdit && Model.FormTemplate.MinAge.HasValue ? Model.FormTemplate.MinAge.Value.ToString() : "")">
                                <small class="form-text text-muted">Leave empty for no restriction</small>
                            </div>
                            <div class="col-6">
                                <label class="form-label small">Max Age</label>
                                <input type="number" class="form-control form-control-sm" id="maxAge" 
                                       placeholder="e.g., 19" min="0" max="120"
                                       value="@(Model.IsEdit && Model.FormTemplate.MaxAge.HasValue ? Model.FormTemplate.MaxAge.Value.ToString() : "")">
                                <small class="form-text text-muted">Leave empty for no restriction</small>
                            </div>
                        </div>
                        
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
    <script>
        let fieldIdCounter = 0;
        let selectedFieldId = null;
        const formTemplateId = @(Model.IsEdit ? Model.FormTemplate.FormTemplateId : 0);
        const existingFields = @Html.Raw(Model.FormFieldsJson ?? "[]");
        
        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            const questionsContainer = document.getElementById('questionsContainer');
            new Sortable(questionsContainer, {
                animation: 150,
                handle: '.drag-handle',
                ghostClass: 'sortable-ghost',
                onEnd: function() {
                    updateFieldOrders();
                }
            });
            
            // Load existing fields if editing
            if (existingFields && existingFields.length > 0) {
                existingFields.forEach(field => {
                    loadExistingField(field);
                });
            }
            
            // Add event listener for Step 4 Template button
            const btnAddStep4Template = document.getElementById('btnAddStep4Template');
            if (btnAddStep4Template) {
                btnAddStep4Template.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    addStep4Template(e);
                });
            }
            
            // Add event listener for Remove Duplicates button
            const btnRemoveDuplicates = document.getElementById('btnRemoveDuplicates');
            if (btnRemoveDuplicates) {
                btnRemoveDuplicates.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    removeDuplicates(e);
                });
            }
        });
        
        function loadExistingField(field) {
            fieldIdCounter++;
            const fieldId = 'field_' + fieldIdCounter;
            
            const fieldHtml = createFieldHtml(fieldId, field.fieldType);
            document.getElementById('questionsContainer').insertAdjacentHTML('beforeend', fieldHtml);
            
            // Set field data
            const fieldCard = document.getElementById(fieldId);
            fieldCard.querySelector('[data-field="label"]').value = field.fieldLabel;
            fieldCard.querySelector('[data-field="required"]').checked = field.isRequired;
            fieldCard.dataset.existingId = field.formFieldId;
            
            // Load title and description if they exist
            const titleInput = fieldCard.querySelector('[data-field="title"]');
            const descInput = fieldCard.querySelector('[data-field="description"]');
            if (field.title && titleInput) {
                titleInput.value = field.title;
                // Show the meta section if there's content
                const metaContent = document.getElementById(`${fieldId}_meta`);
                if (metaContent) {
                    metaContent.style.display = 'block';
                    const toggleBtn = document.getElementById(`${fieldId}_meta_toggle`);
                    if (toggleBtn) {
                        toggleBtn.innerHTML = '<i class="fa-solid fa-circle-info me-1"></i>Hide title & description';
                    }
                }
            }
            if (field.description && descInput) {
                descInput.value = field.description;
            }
            
            // Load validation pattern if it exists
            const validationSelect = fieldCard.querySelector('[data-field="validation"]');
            if (field.validationPattern && validationSelect) {
                validationSelect.value = field.validationPattern;
            }
            
            // Load options if applicable
            if (['radio', 'checkbox', 'select'].includes(field.fieldType) && field.options) {
                field.options.forEach(option => {
                    addOption(fieldId, option.optionLabel);
                });
            }
        }
        
        function updateFormTitle(title) {
            document.getElementById('formTitleDisplay').textContent = title || 'Untitled Form';
        }
        
        function addNewField() {
            addField('text');
        }
        
        function addField(fieldType) {
            fieldIdCounter++;
            const fieldId = 'field_' + fieldIdCounter;
            
            const fieldHtml = createFieldHtml(fieldId, fieldType);
            document.getElementById('questionsContainer').insertAdjacentHTML('beforeend', fieldHtml);
            
            // Initialize options for choice fields
            if (['radio', 'checkbox', 'select'].includes(fieldType)) {
                addOption(fieldId, 'Option 1');
            }
            
            // Select the newly added field
            selectField(fieldId);
        }
        
        function createFieldHtml(fieldId, fieldType) {
            const fieldTypeLabels = {
                'text': 'Short Answer',
                'textarea': 'Paragraph',
                'radio': 'Multiple Choice',
                'checkbox': 'Checkboxes',
                'select': 'Dropdown',
                'date': 'Date',
                'time': 'Time',
                'file': 'File Upload',
                'number': 'Number',
                'email': 'Email',
                'tel': 'Phone Number',
                'datetime-local': 'Date & Time'
            };
            
            return `
                <div class="question-card" id="${fieldId}" data-field-type="${fieldType}">
                    <div class="question-header">
                        <div class="flex-grow-1 d-flex align-items-center">
                            <span class="drag-handle">
                                <i class="fa-solid fa-grip-vertical"></i>
                            </span>
                            <input type="text" 
                                   class="question-input flex-grow-1" 
                                   placeholder="Question" 
                                   data-field="label"
                                   onclick="selectField('${fieldId}')">
                        </div>
                        <select class="field-type-selector ms-3" data-field="type" onchange="changeFieldType('${fieldId}', this.value)">
                            ${Object.keys(fieldTypeLabels).map(type => 
                                `<option value="${type}" ${type === fieldType ? 'selected' : ''}>${fieldTypeLabels[type]}</option>`
                            ).join('')}
                        </select>
                    </div>
                    
                    <!-- Title and Description Section -->
                    <div class="field-meta-section mt-2">
                        <button type="button" class="btn btn-sm btn-link text-muted text-decoration-none p-0 mb-2" 
                                onclick="toggleFieldMeta('${fieldId}')" id="${fieldId}_meta_toggle">
                            <i class="fa-solid fa-circle-info me-1"></i>Add title & description
                        </button>
                        <div id="${fieldId}_meta" class="field-meta-content" style="display: none;">
                            <input type="text" 
                                   class="form-control form-control-sm mb-2" 
                                   placeholder="Field title (optional)" 
                                   data-field="title">
                            <textarea class="form-control form-control-sm" 
                                      rows="2" 
                                      placeholder="Field description (optional)" 
                                      data-field="description"></textarea>
                        </div>
                    </div>
                    
                    <div class="question-body">
                        ${getFieldBodyHtml(fieldType, fieldId)}
                    </div>
                    
                    <div class="question-footer">
                        <button type="button" class="btn btn-sm btn-link text-decoration-none me-2" onclick="duplicateField('${fieldId}')">
                            <i class="fa-solid fa-copy me-1"></i>Duplicate
                        </button>
                        <button type="button" class="btn btn-sm btn-link text-danger text-decoration-none me-3" onclick="deleteField('${fieldId}')">
                            <i class="fa-solid fa-trash me-1"></i>Delete
                        </button>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="${fieldId}_required" data-field="required">
                            <label class="form-check-label" for="${fieldId}_required">Required</label>
                        </div>
                    </div>
                </div>
            `;
        }
        
        function getFieldBodyHtml(fieldType, fieldId) {
            switch(fieldType) {
                case 'text':
                    return `
                        <input type="text" class="form-control mt-2" placeholder="Short answer text" disabled>
                        <div class="mt-2">
                            <label class="form-label text-muted small">Validation Pattern</label>
                            <select class="form-select form-select-sm" data-field="validation">
                                <option value="">No validation</option>
                                <option value="text-only">Text only (letters and spaces)</option>
                                <option value="letters-only">Letters only (no spaces)</option>
                                <option value="alphanumeric">Letters and numbers</option>
                            </select>
                        </div>
                    `;
                case 'email':
                case 'tel':
                    return `<input type="text" class="form-control mt-2" placeholder="Short answer text" disabled>`;
                case 'number':
                    return `
                        <input type="text" class="form-control mt-2" placeholder="Number" disabled>
                        <div class="mt-2">
                            <label class="form-label text-muted small">Validation Pattern</label>
                            <select class="form-select form-select-sm" data-field="validation">
                                <option value="number">Numbers only</option>
                                <option value="integer">Whole numbers only</option>
                                <option value="decimal">Decimal numbers allowed</option>
                            </select>
                        </div>
                    `;
                    
                case 'textarea':
                    return `<textarea class="form-control mt-2" rows="3" placeholder="Long answer text" disabled></textarea>`;
                    
                case 'radio':
                case 'checkbox':
                case 'select':
                    return `
                        <div class="options-list mt-2" id="${fieldId}_options">
                            <!-- Options will be added here -->
                        </div>
                        <button type="button" class="btn btn-sm btn-link mt-2" onclick="addOption('${fieldId}')">
                            <i class="fa-solid fa-plus me-1"></i>Add option
                        </button>
                    `;
                    
                case 'date':
                    return `<input type="date" class="form-control mt-2" disabled>`;
                    
                case 'time':
                    return `<input type="time" class="form-control mt-2" disabled>`;
                    
                case 'datetime-local':
                    return `<input type="datetime-local" class="form-control mt-2" disabled>`;
                    
                case 'file':
                    return `<input type="file" class="form-control mt-2" disabled>`;
                    
                default:
                    return '';
            }
        }
        
        function addOption(fieldId, defaultValue = '') {
            const optionsContainer = document.getElementById(`${fieldId}_options`);
            if (!optionsContainer) return;
            
            const fieldType = document.getElementById(fieldId).dataset.fieldType;
            const optionCount = optionsContainer.children.length + 1;
            const optionId = `${fieldId}_option_${optionCount}`;
            
            const iconClass = fieldType === 'radio' ? 'fa-circle' : (fieldType === 'checkbox' ? 'fa-square' : 'fa-list');
            
            const optionHtml = `
                <div class="option-item" id="${optionId}">
                    <i class="fa-regular ${iconClass} field-type-icon"></i>
                    <input type="text" 
                           class="option-input" 
                           placeholder="Option ${optionCount}" 
                           value="${defaultValue}"
                           data-option="label">
                    <button type="button" class="btn btn-sm btn-link text-danger" onclick="deleteOption('${optionId}')">
