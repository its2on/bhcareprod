                        '@@keyframes fadeIn { from { opacity: 0; transform: translateX(20px); } to { opacity: 1; transform: translateX(0); } }' +
                        '.section-header { padding: 20px; background: linear-gradient(135deg, #fff5f0 0%, #ffe8db 100%); border-left: 4px solid #ff8c42; border-radius: 8px; margin-bottom: 30px; }' +
                        '.section-header h3 { color: #ff8c42; margin: 0 0 8px 0; }' +
                        '.section-header p { margin: 0; color: #6c757d; }' +
                    '</style>' +
                '</head>' +
                '<body>' +
                    '<div class="form-container">' +
                        '<h2 class="mb-3">' + formData.formName + '</h2>' +
                        (formData.formDescription ? '<p class="text-muted mb-4">' + formData.formDescription + '</p>' : '') +
                        '<hr class="mb-4">' +
                        progressHtml +
                        '<form id="multiStepForm">' +
                            sectionsHtml +
                            navigationHtml +
                        '</form>' +
                    '</div>' +
                    '<script>' +
                        'let currentStep = 0;' +
                        'const totalSteps = ' + sections.length + ';' +
                        'function showStep(step) {' +
                            'const pages = document.querySelectorAll(".form-page");' +
                            'const steps = document.querySelectorAll(".step");' +
                            'pages.forEach((page, index) => { page.style.display = index === step ? "block" : "none"; });' +
                            'steps.forEach((stepEl, index) => {' +
                                'stepEl.classList.remove("active", "completed");' +
                                'if (index < step) { stepEl.classList.add("completed"); }' +
                                'else if (index === step) { stepEl.classList.add("active"); }' +
                            '});' +
                            'const prevBtn = document.getElementById("prevBtn");' +
                            'const nextBtn = document.getElementById("nextBtn");' +
                            'const submitBtn = document.getElementById("submitBtn");' +
                            'if (prevBtn) prevBtn.style.display = step === 0 ? "none" : "block";' +
                            'if (nextBtn) nextBtn.style.display = step === totalSteps - 1 ? "none" : "block";' +
                            'if (submitBtn) submitBtn.style.display = step === totalSteps - 1 ? "block" : "none";' +
                        '}' +
                        'function changeStep(direction) {' +
                            'currentStep += direction;' +
                            'if (currentStep < 0) currentStep = 0;' +
                            'if (currentStep >= totalSteps) currentStep = totalSteps - 1;' +
                            'showStep(currentStep);' +
                        '}' +
                        'document.getElementById("multiStepForm")?.addEventListener("submit", function(e) {' +
                            'e.preventDefault();' +
                            'alert("Form submitted! (This is a preview)");' +
                        '});' +
                        (isMultiStep ? 'showStep(0);' : '') +
                    '<' + '/script>' +
                '<' + '/body>' +
                '<' + '/html>';
            
            return htmlContent;
        }
        
        async function saveForm() {
            const formData = collectFormData();
            
            // Validate
            if (!formData.formName) {
                alert('Please enter a form name');
                return;
            }
            
            if (!formData.formKey) {
                alert('Please enter a form key');
                return;
            }
            
            if (formData.fields.length === 0) {
                alert('Please add at least one field to the form');
                return;
            }
            
            try {
                const response = await fetch('/Nurse/FormBuilder?handler=SaveForm', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify(formData)
                });
                
                if (response.ok) {
                    alert('Form saved successfully!');
                    window.location.href = '/Nurse/ControlPanel';
                } else {
                    const error = await response.text();
                    alert('Error saving form: ' + error);
                }
            } catch (error) {
                alert('Error saving form: ' + error.message);
            }
        }
        
        // Auto-generate form key from form name
        document.getElementById('formName').addEventListener('input', function(e) {
            const formKeyInput = document.getElementById('formKey');
            if (!formTemplateId && (!formKeyInput.value || formKeyInput.dataset.autoGenerated === 'true')) {
                const key = e.target.value
                    .toLowerCase()
                    .replace(/[^a-z0-9\s-]/g, '')
                    .replace(/\s+/g, '-')
                    .replace(/-+/g, '-')
                    .replace(/^-+|-+$/g, '');
                formKeyInput.value = key;
                formKeyInput.dataset.autoGenerated = 'true';
            }
        });
        
        document.getElementById('formKey').addEventListener('input', function() {
            this.dataset.autoGenerated = 'false';
        });
    </script>
}

<form method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>

