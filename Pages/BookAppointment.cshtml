                    }
                });
            });
            
            // Show generate button if user clears the family number field
            $('#familyNumber').on('input', function() {
                const value = $(this).val().trim();
                if (value === '') {
                    $('#generateFamilyNumberBtn').show();
                    console.log('[Family Number Input] Field cleared - showing generate button');
                } else {
                    // Optional: hide button if user types a family number manually
