@page
@model Barangay.Pages.BookAppointmentModel
@using Barangay.Helpers
@{
    ViewData["Title"] = "Book an Appointment";
    ViewData["ShowDashboardNav"] = true;
    Layout = "_UserLayout";
}

<style>
    /* Family Number Search Dropdown Styling */
    #familyNumberSection {
        position: relative;
    }

    #familySearchResults {
        position: absolute;
        z-index: 9999 !important;
        top: 100%;
        left: 0;
        min-width: 450px;
        max-width: 600px;
        width: auto;
        max-height: 400px;
        overflow-y: auto;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
        border: 2px solid #ff8c42;
        border-radius: 10px;
        background: white;
        margin-top: 8px;
    }

    #familySearchResults .dropdown-item {
        padding: 18px 20px;
        font-size: 16px;
        border-bottom: 1px solid #e9ecef;
        cursor: pointer;
        transition: all 0.2s;
        line-height: 1.6;
    }

    #familySearchResults .dropdown-item:last-child {
        border-bottom: none;
    }

    #familySearchResults .dropdown-item:hover {
        background-color: #fff5f0;
        border-left: 4px solid #ff8c42;
        padding-left: 16px;
    }

    #familySearchResults .dropdown-item strong {
        font-size: 18px;
        font-weight: 600;
        color: #212529;
        display: block;
        margin-bottom: 6px;
    }

    #familySearchResults .dropdown-item small {
        font-size: 15px;
        color: #6c757d;
        display: block;
        margin-top: 4px;
    }

    #familySearchResults .dropdown-item .badge {
        font-size: 14px;
        font-weight: 600;
        padding: 6px 12px;
        margin-top: 4px;
    }

    #familyNumberSearch {
        font-size: 16px;
        padding: 12px 16px;
        border: 2px solid #dee2e6;
        border-radius: 8px;
        transition: all 0.3s;
    }

    #familyNumberSearch:focus {
        border-color: #ff8c42;
        box-shadow: 0 0 0 0.2rem rgba(255, 140, 66, 0.25);
    }

    #familyNumberDisplay .badge {
        font-size: 16px;
        font-weight: 600;
        padding: 10px 16px;
    }

    #generateNewFamilyNumberBtn {
        font-size: 15px;
        padding: 10px 16px;
        font-weight: 600;
    }

    /* Ensure parent container has proper stacking */
    .card {
        overflow: visible !important;
    }

    /* Improve scrollbar for dropdown */
    #familySearchResults::-webkit-scrollbar {
        width: 10px;
    }

    #familySearchResults::-webkit-scrollbar-track {
        background: #f8f9fa;
        border-radius: 10px;
    }

    #familySearchResults::-webkit-scrollbar-thumb {
        background: #ff8c42;
        border-radius: 10px;
    }

    #familySearchResults::-webkit-scrollbar-thumb:hover {
        background: #e67a32;
    }
</style>

@if (!ModelState.IsValid)
{
    <div class="alert alert-danger">
        <ul>
            @foreach (var error in ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success">
        @Model.StatusMessage
    </div>
}

<div class="container mt-5 pt-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a href="/User/UserDashboard" class="btn btn-outline-primary">
            <i class="fa-solid fa-arrow-left me-2"></i>Back to Dashboard
        </a>
        <h1 class="fw-bold mb-0">Book an Appointment</h1>
        <div style="width: 135px;"></div>
    </div>

    <!-- Removed queue/tip alert for cleaner UI -->

    <form method="post" id="appointmentForm" asp-antiforgery="true" enctype="multipart/form-data">
        <div id="step1" class="booking-step">
            <div class="row">
                <div class="col-md-8">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">Patient Information</h5>
                        </div>
                        <div class="card-body">
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" id="bookingForOther" name="bookingForOther">
                                <input type="hidden" id="bookingForOtherHidden" name="bookingForOtherHidden" value="false">
                                <label class="form-check-label" for="bookingForOther">
                                    Booking for someone else?
                                </label>
                            </div>
                            
                            <div class="row mb-3">
                                <div class="col-md-3">
                                    <label for="lastName" class="form-label">Last Name</label>
                                    <input type="text" class="form-control" id="lastName" name="lastName" required>
                                </div>
                                <div class="col-md-3">
                                    <label for="firstName" class="form-label">First Name</label>
                                    <input type="text" class="form-control" id="firstName" name="firstName" required>
                                </div>
                                <div class="col-md-3">
                                    <label for="birthday" class="form-label">Birthday <span class="text-danger">*</span></label>
                                    <input type="date" class="form-control" id="birthday" name="birthday" required>
                                    <div class="form-text">Age will be calculated automatically</div>
                                </div>
                                <div class="col-md-3">
                                    <label for="phoneNumber" class="form-label">Phone Number</label>
                                    <input type="tel" class="form-control" id="phoneNumber" name="phoneNumber" placeholder="09123456789" pattern="^09[0-9]{9}$" minlength="11" maxlength="11" inputmode="numeric" required>
                                    <div class="form-text">Enter 11-digit mobile number starting with 09</div>
                                </div>
                                <input type="hidden" id="fullName" name="fullName">
                                <input type="hidden" id="age" name="age">
                            </div>
                            
                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <label for="gender" class="form-label">Gender</label>
                                    <select class="form-select" id="gender" name="gender" required>
                                        <option value="">Select gender</option>
                                        <option value="Male">Male</option>
                                        <option value="Female">Female</option>
                                    </select>
                                </div>
                                <div class="col-md-4" id="familyNumberSection" style="display: none;">
                                    <label class="form-label">Family Number</label>
                                    <div class="position-relative">
                                        <input type="text" 
                                               class="form-control" 
                                               id="familyNumberSearch" 
                                               placeholder="Search by name..."
                                               autocomplete="off">
                                        <input type="hidden" id="familyNumber" name="BookingModel.FamilyNumber" asp-for="BookingModel.FamilyNumber">
                                        <div id="familySearchResults" class="dropdown-menu" style="width: 100%; max-height: 300px; overflow-y: auto;">
                                            <!-- Search results will appear here -->
                                        </div>
                                    </div>
                                    <div id="familyNumberDisplay" class="mt-2" style="display: none;">
                                        <div class="alert alert-success mb-0 py-2">
                                            <i class="fas fa-check-circle me-2"></i>
                                            <strong>Family Number:</strong> <span id="selectedFamilyNumber"></span>
                                            <button type="button" class="btn btn-sm btn-link text-danger p-0 ms-2" id="clearFamilyNumber">
                                                <i class="fas fa-times"></i> Change
                                            </button>
                                        </div>
                                    </div>
                                    <div id="noFamilyFound" class="mt-2" style="display: none;">
                                        <div class="alert alert-warning mb-2 py-2">
                                            <i class="fas fa-info-circle me-2"></i>
                                            No family record found.
                                        </div>
                                        <button type="button" class="btn btn-primary btn-sm" id="generateNewFamilyNumberBtn">
                                            <i class="fas fa-plus-circle me-1"></i>Generate New Family Number
                                        </button>
                                    </div>
                                    <div class="form-text">Search for existing family members or generate a new family number</div>
                                    <input type="hidden" id="hasFamilyNumber" value="@(Model.UserProfile?.FamilyNo ?? "")">
                                </div>
                            </div>
                            
                            <div class="mb-3" id="relationshipField" style="display: none;">
                                <label for="relationship" class="form-label">Relationship to Patient</label>
                                <select class="form-select" id="relationship" name="relationship">
                                    <option value="">Select relationship</option>
                                    <option value="parent">Parent</option>
                                    <option value="spouse">Spouse</option>
                                    <option value="child">Child</option>
                                    <option value="sibling">Sibling</option>
                                    <option value="guardian">Guardian</option>
                                    <option value="other">Other</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">Appointment Details</h5>
                        </div>
                        <div class="card-body">
                            <!-- Doctor selection is now handled automatically. 
                                 A hidden input will pass the ID of the first available doctor. -->
                            <input type="hidden" id="DoctorId" name="DoctorId" value="@((!string.IsNullOrEmpty(Model.DefaultDoctorId)) ? Model.DefaultDoctorId : (Model.Doctors != null && Model.Doctors.Any() ? Model.Doctors.First().UserId : string.Empty))" />

                            <!-- Replace the date input field with a more robust implementation -->
                            <div class="mb-3">
                                <label for="appointmentDate" class="form-label">Date</label>
                                <input type="date" class="form-control" id="appointmentDate" name="appointmentDate" required min="@DateTimeHelper.Now.ToString("yyyy-MM-dd")">
                                <input type="hidden" name="BookingModel.AppointmentDate" id="hiddenAppointmentDate">
                                <div id="dateValidationMessage" class="invalid-feedback"></div>
                            </div>
                            
                            <!-- Update the consultation type dropdown to trigger time slot updates -->
                            <div class="mb-3">
                                <label for="consultationType" class="form-label">Consultation Type</label>
                                <select class="form-select" id="consultationType" name="consultationType" required>
                                    <option value="" selected disabled>Select consultation type</option>
                                    @foreach (var service in Model.ConsultationServices)
                                    {
                                        <option value="@service.ServiceName.ToLower()">@service.ServiceName</option>
                                    }
                                </select>
                                <input type="hidden" name="BookingModel.ConsultationType" id="hiddenConsultationType">
                            </div>
                            
            <!-- Update the time slot selection to use a standard select element instead of dropdown -->
            <div class="mb-3">
                <label for="timeSlot" class="form-label">Appointment Time</label>
                
                <!-- Slot Availability Banner -->
                <div id="slotAvailabilityBanner" class="alert alert-info mb-2" style="display: none;">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <i class="fa-solid fa-calendar-check me-2"></i>
                            <strong>Slots Available:</strong> 
                            <span id="slotAvailabilityText">Loading...</span>
                        </div>
                        <span class="badge bg-primary" id="slotAvailabilityBadge">0/0</span>
                    </div>
                    <div class="progress mt-2" style="height: 8px;">
                        <div id="slotAvailabilityProgress" class="progress-bar" role="progressbar" style="width: 0%"></div>
                    </div>
                </div>
                
                <select class="form-select" id="timeSlot" name="timeSlot" required>
                    <option value="" selected disabled>Select date and consultation type first</option>
                </select>
                <input type="hidden" name="BookingModel.TimeSlot" id="hiddenTimeSlot">
                
                <!-- Display selected time prominently -->
                <div id="selectedTimeDisplay" class="alert alert-success mt-2" style="display: none;">
                    <i class="fa-solid fa-clock me-2"></i>
                    <strong>Selected Time:</strong> <span id="selectedTimeText"></span>
                </div>
                <div id="timeSlotMessage" class="form-text text-muted">Available time slots will appear after selecting date and consultation type.</div>
            </div>
                            
                            <div class="mb-3">
                                <label for="reasonForConsultation" class="form-label">Reason for visit</label>
                                <textarea class="form-control" id="reasonForConsultation" name="ReasonForVisit" rows="4" required maxlength="400" aria-describedby="reasonHelp"></textarea>
                                <div id="reasonHelp" class="form-text">Please be specific and respectful. Max 400 characters.</div>
                            </div>
                            
                            <button type="button" id="toStep2Button" class="btn btn-primary btn-lg">
                                <i class="fa-solid fa-paper-plane me-2"></i>Submit Appointment
                            </button>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-4">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">Booking Instructions</h5>
                        </div>
                        <div class="card-body">
                            <ol class="ps-3">
                                <li>Select your preferred date</li>
                                <li>Choose your consultation type</li>
                                <li>Select available time slot</li>
                                <li>Fill in your details</li>
                                <li>Complete health assessment (General Consult only)</li>
                                <li>Submit your booking</li>
                            </ol>
                            
                            <div class="mt-4">
                                <h6>Consultation Types & Schedule:</h6>
                                <ul class="list-group">
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        General Consult
                                        <span class="badge bg-primary rounded-pill">8AM-11AM, 1PM-4PM (Mon-Fri)</span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        Dental
                                        <span class="badge bg-primary rounded-pill">8AM-11AM (Mon/Wed/Fri)</span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        Immunization
                                        <span class="badge bg-primary rounded-pill">8AM-12PM (Wed)</span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        Prenatal & Family Planning
                                        <span class="badge bg-primary rounded-pill">8AM-11AM, 1PM-4PM (Mon/Wed/Fri)</span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        DOTS Consult
                                        <span class="badge bg-primary rounded-pill">1PM-4PM (Mon-Fri)</span>
                                    </li>
                                </ul>
                            </div>
                            
                            <div class="alert alert-info mt-3">
                                <i class="fa-solid fa-circle-info me-2"></i>
                                <strong>Note:</strong> Please arrive 15 minutes before your appointment time.
                            </div>
                            
                            <!-- Dynamic forms list - updates based on consultation type and age -->
                            <div id="dynamicFormsContainer" style="display: none;">
                                <div class="alert alert-primary mt-3">
                                    <h6 class="alert-heading">
                                        <i class="fa-solid fa-clipboard-list me-2"></i>
                                        <strong>Clinical Assessment Forms</strong>
                                    </h6>
                                    <p class="mb-2" id="formsDescription">Based on the selected service and patient's age, the following forms may be required after booking:</p>
                                    <ul class="mb-0" id="dynamicFormsList">
                                        @foreach (var form in Model.AvailableDynamicForms)
                                        {
                                            <li>
                                                <i class="@form.IconClass me-1" style="width: 20px;"></i>
                                                <strong>@form.FormName</strong>
                                                @if (form.MinAge.HasValue || form.MaxAge.HasValue)
                                                {
                                                    <small class="text-muted">
                                                        (
                                                        @if (form.MinAge.HasValue && form.MaxAge.HasValue)
                                                        {
                                                            @:Ages @form.MinAge - @form.MaxAge
                                                        }
                                                        else if (form.MinAge.HasValue)
                                                        {
                                                            @:Ages @form.MinAge+
                                                        }
                                                        else if (form.MaxAge.HasValue)
                                                        {
                                                            @:Ages up to @form.MaxAge
                                                        }
                                                        )
                                                    </small>
                                                }
                                            </li>
                                        }
                                    </ul>
                                    <small class="text-muted d-block mt-2">
                                        <i class="fa-solid fa-info-circle me-1"></i>
                                        You'll be directed to complete the appropriate assessment form(s) based on the patient's age after booking.
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function() {
            console.log('[BookAppointment] Page ready - initializing family number section');
            
            // ========================================
            // Family Number Search and Generation Variables
            // ========================================
            // Declare these variables at the top to avoid "Assignment to constant variable" errors
            let searchTimeout = null;
            let selectedFamilyNumber = null;
            
            // Check if consultation type is already selected and show family number section if needed
            let checkFamilyNumberVisibility = function() {
                const selectedType = $('#consultationType').val();
                if (selectedType) {
                    const hasFamilyNumber = $('#hasFamilyNumber').val();
                    
                    console.log('[BookAppointment] Consultation type on load:', selectedType, 'Showing family number for all types');
                    
                    // Show family number section for ALL consultation types (now using dynamic forms)
                    $('#familyNumberSection').show();
                    
                    // Check if booking for someone else
                    const isBookingForOther = $('#bookingForOther').is(':checked');
                    
                    if (isBookingForOther) {
                        // Clear for dependents - show search
                        selectedFamilyNumber = null;
                        $('#familyNumber').val('');
                        $('#familyNumberSearch').val('').show();
                        $('#familyNumberDisplay').hide();
                        $('#noFamilyFound').hide();
                        console.log('[Page Load] Booking for other - showing search');
                    } else {
                        // If booking for self, check for existing family number
                        initializeFamilyNumber();
                    }
                }
            };
            
            // Call on page load
            checkFamilyNumberVisibility();
            
            // Initialize the form state based on user details
            const userDetails = @Html.Raw(Json.Serialize(Model.UserDetails));
            
            if (userDetails) {
                // Split full name into first and last name
                const nameParts = (userDetails.fullName || '').split(' ');
                if (nameParts.length >= 2) {
                    $('#lastName').val(nameParts[nameParts.length - 1]);
                    $('#firstName').val(nameParts.slice(0, -1).join(' '));
                } else if (nameParts.length === 1) {
                    $('#lastName').val(nameParts[0]);
                }
                $('#fullName').val(userDetails.fullName);
                $('#age').val(userDetails.age);
                // Calculate birthday from age for initial display
                if (userDetails.age >= 0) {
                    calculateBirthdayFromAge(userDetails.age);
                }
            }
            
            // Function to check if immunization should be shown
            function updateImmunizationVisibility() {
                const isBookingForOther = $('#bookingForOther').is(':checked');
                const relationship = ($('#relationship').val() || '').toLowerCase();
                const age = parseInt($('#age').val(), 10);
                
                // Show immunization only if:
                // 1. Booking for someone else
                // 2. Relationship is "child"
                // 3. Age is 1 year old or less (0 means infant/months old, which is valid)
                const shouldShowImmunization = isBookingForOther && 
                                               relationship === 'child' && 
                                               !isNaN(age) && 
                                               age >= 0 &&
                                               age <= 1;
                
                const immunizationOption = $('#consultationType option[value="immunization"]');
                
                if (shouldShowImmunization) {
                    immunizationOption.show();
                    console.log('[Immunization] Showing immunization option - Age:', age, 'Relationship:', relationship);
                } else {
                    immunizationOption.hide();
                    // If immunization is currently selected, clear the selection
                    if ($('#consultationType').val() === 'immunization') {
                        $('#consultationType').val('');
                        // Clear time slots when consultation type changes
                        $('#timeSlot').html('<option value="" selected disabled>Select date and consultation type first</option>');
                        $('#selectedTimeDisplay').hide();
                    }
                    console.log('[Immunization] Hiding immunization option - BookingForOther:', isBookingForOther, 'Age:', age, 'Relationship:', relationship);
                }
            }
            
            // Hide immunization option initially
            $('#consultationType option[value="immunization"]').hide();
            
            // Update immunization visibility when relevant fields change
            $('#bookingForOther').on('change', updateImmunizationVisibility);
            $('#relationship').on('change', updateImmunizationVisibility);
            $('#birthday').on('change', updateImmunizationVisibility);
            
            // Initial check
            updateImmunizationVisibility();
            
            // Auto-populate phone number and gender from user profile
            const userPhoneNumber = '@Model.BookingModel.PhoneNumber';
            if (userPhoneNumber && userPhoneNumber !== '') {
                $('#phoneNumber').val(userPhoneNumber);
            }
            
            // Auto-populate gender from user profile
            const userGender = '@(Model.UserDetails?.Gender ?? "")';
            if (userGender && userGender !== '') {
                $('#gender').val(userGender);
            }
            
            // Update fullName hidden field when firstName or lastName changes
            function updateFullName() {
                const firstName = $('#firstName').val().trim();
                const lastName = $('#lastName').val().trim();
                const fullName = (firstName + ' ' + lastName).trim();
                $('#fullName').val(fullName);
            }
            
            $('#firstName, #lastName').on('input', updateFullName);

            // Handle 'Booking for someone else' checkbox
            $('#bookingForOther').change(function() {
                const isChecked = $(this).is(':checked');
                $('#bookingForOtherHidden').val(isChecked ? 'true' : 'false');
                
                if (isChecked) {
                    // Clear fields for new patient details
                    $('#firstName').val('').prop('readonly', false);
                    $('#lastName').val('').prop('readonly', false);
                    $('#fullName').val('');
                    $('#birthday').val('');
                    $('#age').val(''); // Clear hidden age field
                    $('#phoneNumber').val('').prop('readonly', false);
                    $('#gender').val('').prop('readonly', false);
                    $('#relationshipField').show();
                    
                    // Clear family number for dependent (they get their own family number)
                    selectedFamilyNumber = null;
                    $('#familyNumber').val('');
                    $('#familyNumberSearch').val('').show();
                    $('#familyNumberDisplay').hide();
                    $('#noFamilyFound').hide();
                    console.log('[Booking For Other] Cleared family number - showing search');
                } else {
                    // Restore original user details
                    if (userDetails) {
                        const nameParts = (userDetails.fullName || '').split(' ');
                        if (nameParts.length >= 2) {
                            $('#lastName').val(nameParts[nameParts.length - 1]);
                            $('#firstName').val(nameParts.slice(0, -1).join(' '));
                        } else if (nameParts.length === 1) {
                            $('#lastName').val(nameParts[0]);
                        }
                        $('#fullName').val(userDetails.fullName);
                        $('#age').val(userDetails.age);
                        // Restore birthday by calculating from age
                        calculateBirthdayFromAge(userDetails.age);
                    }
                    // Restore phone number
                    const userPhoneNumber = '@Model.BookingModel.PhoneNumber';
                    if (userPhoneNumber && userPhoneNumber !== '') {
                        $('#phoneNumber').val(userPhoneNumber);
                    }
                    // Restore gender
                    const userGender = '@(Model.UserDetails?.Gender ?? "")';
                    if (userGender && userGender !== '') {
                        $('#gender').val(userGender);
                    }
                    
                    // Restore user's family number
                    initializeFamilyNumber();
                    console.log('[Booking For Other] Restored user family number state');
                    
                    $('#relationshipField').hide();
                    // Clear relationship selection when unchecking
                    $('#relationship').val('');
                }
                
                // Update immunization visibility after changing booking mode
                updateImmunizationVisibility();
            });

            // Age is now auto-calculated from birthday, no manual input needed

            // Enforce digits-only and format for phone number; ensure starts with 09 and 11 digits
            $('#phoneNumber').on('input', function(){
                let v = $(this).val().replace(/[^0-9]/g, '');
                if (v.length > 0 && !v.startsWith('09')) {
                    v = '09' + v.replace(/^0+/, '').replace(/^9?/, '');
                }
                $(this).val(v.slice(0, 11));
            });

            // Handle birthday input changes to calculate age automatically
            $('#birthday').on('change', function() {
                const birthday = new Date($(this).val());
                if (!isNaN(birthday.getTime())) {
                    const today = new Date();
                    let age = today.getFullYear() - birthday.getFullYear();
                    const monthDiff = today.getMonth() - birthday.getMonth();
                    
                    // Adjust age if birthday hasn't occurred yet this year
                    if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birthday.getDate())) {
                        age--;
                    }
                    
                    // Update hidden age field
                    $('#age').val(age);
                    console.log('[BookAppointment] Auto-calculated age from birthday:', age);
                    
                    // Trigger immunization visibility check
                    updateImmunizationVisibility();
                }
            });

            // Date validation - TEMPORARILY DISABLED FOR TESTING
            $('#appointmentDate').on('change', function() {
                const selectedDate = new Date($(this).val());
                const day = selectedDate.getDay(); // 0=Sun, 1=Mon, ..., 6=Sat
                const validationMessage = $('#dateValidationMessage');
                
                // TEMPORARILY COMMENTED OUT FOR TESTING
                // if (day === 0 || day === 6) { // Sunday or Saturday
                //     validationMessage.text('Appointments are not available on weekends. Please select a weekday.');
                //     $(this).addClass('is-invalid');
                // } else {
                //     validationMessage.text('');
                //     $(this).removeClass('is-invalid');
                // }
                
                // Always clear validation for testing
                validationMessage.text('');
                $(this).removeClass('is-invalid');
            });
            
            // Function to update available time slots based on date and consultation type
            function updateTimeSlots() {
                const selectedDate = $('#appointmentDate').val();
                const consultationType = $('#consultationType').val();
                const doctorId = $('#DoctorId').val();
                const timeSlotSelect = $('#timeSlot');
                const previouslySelectedTime = $('#selectedTimeText').text();
                
                console.log('[BookAppointment] updateTimeSlots called with:', {
                    selectedDate: selectedDate,
                    consultationType: consultationType,
                    doctorId: doctorId
                });
                
                if (!selectedDate || !consultationType || !doctorId) {
                    console.log('[BookAppointment] Missing required fields:', {
                        selectedDate: selectedDate,
                        consultationType: consultationType,
                        doctorId: doctorId
                    });
                    timeSlotSelect.html('<option value="" selected disabled>Select date and consultation type first</option>');
                    $('#timeSlotMessage').removeClass('text-danger').addClass('text-muted')
                        .text('Please select date and consultation type to see available time slots');
                    $('#selectedTimeDisplay').hide();
                    $('#slotAvailabilityBanner').hide();
                    return;
                }
                
                console.log(`[BookAppointment] Fetching time slots for doctor ${doctorId}, date ${selectedDate}, type: ${consultationType}`);
                
                // Show loading state
                timeSlotSelect.html('<option>Loading...</option>');
                $('#slotAvailabilityBanner').show();
                $('#slotAvailabilityText').text('Loading slots...');
                
                // Fetch available time slots via NEW API endpoint
                $.ajax({
                    url: `/api/appointment-slots/available?doctorId=${doctorId}&date=${selectedDate}&consultationType=${consultationType}`,
                    type: 'GET',
                    success: function(response) {
                        console.log('[Slots API] Response:', response);
                        timeSlotSelect.empty();
                        
                        if (!response.success) {
                            // Handle errors (weekend, not available, etc.)
                            timeSlotSelect.append('<option value="">Not available</option>');
                            $('#timeSlotMessage').removeClass('text-muted').addClass('text-danger')
                                .html(`<i class="fa-solid fa-exclamation-triangle me-2"></i><strong>${response.message}</strong>`);
                            $('#selectedTimeDisplay').hide();
                            
                            // Update availability banner for error state
                            $('#slotAvailabilityBanner').removeClass('alert-info alert-success').addClass('alert-warning');
                            $('#slotAvailabilityText').text(response.message);
                            $('#slotAvailabilityBadge').text('N/A');
                            $('#slotAvailabilityProgress').css('width', '0%').removeClass('bg-success bg-warning').addClass('bg-secondary');
                            return;
                        }
                        
                        // Update slot availability banner
                        const availableCount = response.availableSlots;
                        const totalSlots = response.totalSlots;
                        const bookedCount = response.bookedSlots;
                        const percentAvailable = totalSlots > 0 ? (availableCount / totalSlots) * 100 : 0;
                        
                        $('#slotAvailabilityBanner').removeClass('alert-warning').addClass('alert-info');
                        $('#slotAvailabilityText').text(`${availableCount} of ${totalSlots} slots available`);
                        $('#slotAvailabilityBadge').text(`${availableCount}/${totalSlots}`);
                        
                        // Update progress bar
                        if (response.isFullyBooked || availableCount === 0) {
                            $('#slotAvailabilityProgress').css('width', '100%').removeClass('bg-primary bg-warning').addClass('bg-danger');
                            $('#slotAvailabilityBanner').removeClass('alert-info').addClass('alert-danger');
                            $('#slotAvailabilityText').html('<i class="fa-solid fa-exclamation-circle me-2"></i>Fully Booked');
                        } else if (percentAvailable > 50) {
                            $('#slotAvailabilityProgress').css('width', percentAvailable + '%').removeClass('bg-danger bg-warning').addClass('bg-success');
                        } else if (percentAvailable > 25) {
                            $('#slotAvailabilityProgress').css('width', percentAvailable + '%').removeClass('bg-danger bg-success').addClass('bg-warning');
                        } else {
                            $('#slotAvailabilityProgress').css('width', percentAvailable + '%').removeClass('bg-success bg-warning').addClass('bg-danger');
                        }
                        
                        // Populate time slots
                        if (response.slots && response.slots.length > 0) {
                            // Only show available slots in dropdown
                            const availableSlots = response.slots.filter(slot => slot.isAvailable);
                            
                            if (availableSlots.length > 0) {
                                $.each(availableSlots, function(index, slot) {
                                    timeSlotSelect.append($('<option>', {
                                        value: slot.timeRange,
                                        text: slot.timeRange + (slot.isBooked ? ' (Booked)' : '')
                                    }));
                                });
                                timeSlotSelect.prop('disabled', false);
                                $('#timeSlotMessage').removeClass('text-danger').addClass('text-success')
                                    .html(`<i class="fa-solid fa-check-circle me-2"></i>${availableSlots.length} time slots available. Please select one.`);
                                
                                // If there was a previously selected time and it's still available, restore it
                                if (previouslySelectedTime) {
                                    const matchingSlot = availableSlots.find(s => s.timeRange === previouslySelectedTime);
                                    if (matchingSlot) {
                                        timeSlotSelect.val(previouslySelectedTime);
                                        $('#selectedTimeText').text(previouslySelectedTime);
                                        $('#selectedTimeDisplay').show();
                                    }
                                }
                            } else {
                                timeSlotSelect.append('<option value="">All slots booked</option>');
                                $('#timeSlotMessage').removeClass('text-muted').addClass('text-danger')
                                    .html('<i class="fa-solid fa-calendar-xmark me-2"></i><strong>All time slots are booked for this date.</strong> Please select a different date.');
                                $('#selectedTimeDisplay').hide();
                            }
                        } else {
                            timeSlotSelect.append('<option value="">No time slots generated</option>');
                            $('#timeSlotMessage').removeClass('text-muted').addClass('text-warning')
                                .html('<i class="fa-solid fa-info-circle me-2"></i>No time slots available for this date and consultation type.');
                            $('#selectedTimeDisplay').hide();
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('[BookAppointment] AJAX Error:', {
                            status: status,
                            error: error,
                            responseText: xhr.responseText
                        });
                        timeSlotSelect.html('<option value="">Error loading time slots</option>');
                        $('#timeSlotMessage').removeClass('text-muted').addClass('text-danger')
                            .html('<i class="fa-solid fa-exclamation-triangle me-2"></i><strong>Error loading time slots.</strong> Please try again or contact support if the problem persists.');
                        $('#selectedTimeDisplay').hide();
                        $('#slotAvailabilityBanner').removeClass('alert-info').addClass('alert-danger');
                        $('#slotAvailabilityText').text('Error loading slots');
                    }
                });
            }
            
            // Format time to 12-hour format with AM/PM
            function formatTime(hour, minute) {
                const period = hour >= 12 ? 'PM' : 'AM';
                const hour12 = hour % 12 || 12;
                return `${hour12}:${minute.toString().padStart(2, '0')} ${period}`;
            }
            
            // Helper function to get display name for consultation type
            function getConsultationTypeDisplay(consultationType) {
                switch(consultationType) {
                    case 'general consult':
                        return 'General Consult';
                    case 'dental':
                        return 'Dental';
                    case 'immunization':
                        return 'Immunization';
                    case 'prenatal & family planning':
                        return 'Prenatal & Family Planning';
                    case 'dots consult':
                        return 'DOTS Consult';
                    default:
                        return consultationType;
                }
            }
            
            // Event listener for date input changes
            $('#appointmentDate').on('change', function() {
                const selectedDate = $(this).val();
                console.log('[BookAppointment] Date changed to:', selectedDate);
                updateTimeSlots();
            });
            
            // Event listener for birth date changes to update forms
            $('#dateOfBirth, #birthDate').on('change', function() {
                console.log('[BookAppointment] Birth date changed, updating forms');
                updateAvailableForms();
            });
            
            // Function to update available forms based on consultation type and age
            function updateAvailableForms() {
                const consultationType = $('#consultationType').val();
                const dobInput = $('#dateOfBirth').val() || $('#birthDate').val();
                
                if (!consultationType) {
                    $('#dynamicFormsContainer').hide();
                    return;
                }
                
                // Calculate age from DOB
                let age = 0;
                if (dobInput) {
                    const birthDate = new Date(dobInput);
                    const today = new Date();
                    age = today.getFullYear() - birthDate.getFullYear();
                    const monthDiff = today.getMonth() - birthDate.getMonth();
                    if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birthDate.getDate())) {
                        age--;
                    }
                }
                
                console.log('[UpdateForms] Fetching forms for:', { consultationType, age });
                
                // Call API to get available forms
                $.ajax({
                    url: `/BookAppointment?handler=GetAvailableFormsForAge&age=${age}&consultationType=${encodeURIComponent(consultationType)}`,
                    type: 'GET',
                    success: function(response) {
                        console.log('[UpdateForms] Forms received:', response);
                        
                        if (response.forms && response.forms.length > 0) {
                            // Update forms list
                            const formsList = $('#dynamicFormsList');
                            formsList.empty();
                            
                            response.forms.forEach(function(form) {
                                let ageInfo = '';
                                if (form.minAge && form.maxAge) {
                                    ageInfo = ` <small class="text-muted">(Ages ${form.minAge} - ${form.maxAge})</small>`;
                                } else if (form.minAge) {
                                    ageInfo = ` <small class="text-muted">(Ages ${form.minAge}+)</small>`;
                                } else if (form.maxAge) {
                                    ageInfo = ` <small class="text-muted">(Ages up to ${form.maxAge})</small>`;
                                }
                                
                                const icon = form.iconClass || 'fa-solid fa-file-medical';
                                formsList.append(`
                                    <li>
                                        <i class="${icon} me-1" style="width: 20px;"></i>
                                        <strong>${form.formName}</strong>${ageInfo}
                                    </li>
                                `);
                            });
                            
                            $('#dynamicFormsContainer').show();
                        } else {
                            $('#dynamicFormsContainer').hide();
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('[UpdateForms] Error fetching forms:', error);
                        $('#dynamicFormsContainer').hide();
                    }
                });
            }
            
            // Event listener for consultation type changes
            $('#consultationType').on('change', function() {
                const selectedType = $(this).val();
                console.log('[BookAppointment] Consultation type changed to:', selectedType);
                updateTimeSlots();
                updateAvailableForms(); // Update forms based on selected service
                
                // Show family number section for ALL consultation types (now using dynamic forms)
                const hasFamilyNumber = $('#hasFamilyNumber').val();
                
                $('#familyNumberSection').show();
                
                // Check if booking for someone else
                const isBookingForOther = $('#bookingForOther').is(':checked');
                
                if (isBookingForOther) {
                    // Clear for dependents - show search
                    selectedFamilyNumber = null;
                    $('#familyNumber').val('');
                    $('#familyNumberSearch').val('').show();
                    $('#familyNumberDisplay').hide();
                    $('#noFamilyFound').hide();
                    console.log('[Consultation Change] Booking for other - showing search');
                } else {
                    // If booking for self, initialize with user's family number if exists
                    initializeFamilyNumber();
                    console.log('[Consultation Change] Initialized family number for user');
                }
            });
            
            // ========================================
            // Family Number Search and Generation Functions
            // ========================================
            
            // Initialize family number if user already has one
            const initializeFamilyNumber = function() {
                const hasFamilyNumber = $('#hasFamilyNumber').val();
                const isBookingForOther = $('#bookingForOther').is(':checked');
                
                if (!isBookingForOther && hasFamilyNumber && hasFamilyNumber.trim() !== '') {
                    $('#familyNumber').val(hasFamilyNumber);
                    $('#selectedFamilyNumber').text(hasFamilyNumber);
                    $('#familyNumberSearch').hide();
                    $('#familyNumberDisplay').show();
                    $('#noFamilyFound').hide();
                    selectedFamilyNumber = hasFamilyNumber;
                    console.log('[Family Number] Auto-filled user family number:', hasFamilyNumber);
                }
            };
            
            // Family number search with debounce
            $('#familyNumberSearch').on('input', function() {
                const searchTerm = $(this).val().trim();
                
                clearTimeout(searchTimeout);
                
                if (searchTerm.length < 2) {
                    $('#familySearchResults').removeClass('show').empty();
                    $('#noFamilyFound').hide();
                    return;
                }
                
                searchTimeout = setTimeout(function() {
                    // Search for family members
                    $.ajax({
                        url: '?handler=SearchFamilyMembers',
                        type: 'GET',
                        data: { searchTerm: searchTerm },
                        success: function(response) {
                            if (response.success && response.members && response.members.length > 0) {
                                displaySearchResults(response.members);
                                $('#noFamilyFound').hide();
                            } else {
                                $('#familySearchResults').removeClass('show').empty();
                                $('#noFamilyFound').show();
                            }
                        },
                        error: function() {
                            console.error('Error searching family members');
                            $('#familySearchResults').removeClass('show').empty();
                        }
                    });
                }, 300); // Debounce 300ms
            });
            
            // Display search results
            function displaySearchResults(members) {
                const $results = $('#familySearchResults');
                $results.empty();
                
                members.forEach(function(member) {
                    const $item = $('<a>').addClass('dropdown-item').attr('href', '#');
                    $item.html(`
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <strong>${member.fullName}</strong>
                                <br>
                                <small class="text-muted">
                                    <i class="fas fa-users me-1"></i>${member.familyNumber}
                                </small>
                            </div>
                            ${member.relationship ? `<span class="badge bg-secondary">${member.relationship}</span>` : ''}
                        </div>
                    `);
                    
                    $item.on('click', function(e) {
                        e.preventDefault();
                        selectFamilyNumber(member.familyNumber, member.fullName);
                    });
                    
                    $results.append($item);
                });
                
                $results.addClass('show');
            }
            
            // Select a family number from search results
            function selectFamilyNumber(familyNumber, memberName) {
                selectedFamilyNumber = familyNumber;
                $('#familyNumber').val(familyNumber);
                $('#selectedFamilyNumber').text(familyNumber);
                $('#familyNumberSearch').val('').hide();
                $('#familySearchResults').removeClass('show').empty();
                $('#familyNumberDisplay').show();
                $('#noFamilyFound').hide();
                
                Swal.fire({
                    title: 'Family Number Selected',
                    text: `Using family number ${familyNumber} (from ${memberName})`,
                    icon: 'success',
                    timer: 2000,
                    showConfirmButton: false
                });
            }
            
            // Clear/Change family number
            $('#clearFamilyNumber').on('click', function() {
                selectedFamilyNumber = null;
                $('#familyNumber').val('');
                $('#familyNumberSearch').val('').show();
                $('#familyNumberDisplay').hide();
                $('#noFamilyFound').hide();
                $('#familyNumberSearch').focus();
            });
            
