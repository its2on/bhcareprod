                };
                
                console.log('[BookAppointment] Form data:', formData);
                console.log('[BookAppointment] ===== BOOKING FOR OTHER DEBUG =====');
                console.log('[BookAppointment] Checkbox is checked:', $('#bookingForOther').is(':checked'));
                console.log('[BookAppointment] Checkbox value:', $('#bookingForOther').val());
                console.log('[BookAppointment] Checkbox prop checked:', $('#bookingForOther').prop('checked'));
                console.log('[BookAppointment] Hidden field value:', $('#bookingForOtherHidden').val());
                console.log('[BookAppointment] Full name value:', $('#fullName').val());
                console.log('[BookAppointment] Age value:', $('#age').val());
                console.log('[BookAppointment] Birthday value:', $('#birthday').val());
                console.log('[BookAppointment] Relationship value:', $('#relationship').val());
                console.log('[BookAppointment] ===== END BOOKING DEBUG =====');
                
                // Validate required fields
                let isValid = true;
                const requiredFields = $('#step1').find('[required]');
                
                console.log('[BookAppointment] Validating required fields...');
                requiredFields.each(function() {
                    if (!$(this).val()) {
                        $(this).addClass('is-invalid');
                        isValid = false;
                        console.warn('[BookAppointment] Invalid field:', $(this).attr('name'));
                    } else {
                        $(this).removeClass('is-invalid');
                        console.log('[BookAppointment] Valid field:', $(this).attr('name'), '=', $(this).val());
                    }
                });
                
                // Validate birthday field (required)
                const birthday = $('#birthday').val();
                if (!birthday || birthday.trim() === '') {
                    $('#birthday').addClass('is-invalid');
                    isValid = false;
                    console.warn('[BookAppointment] Invalid field: birthday is required');
                } else {
                    $('#birthday').removeClass('is-invalid');
                    console.log('[BookAppointment] Valid birthday:', birthday);
                    
                    // Auto-calculate age from birthday
                    const birthdayDate = new Date(birthday);
                    if (!isNaN(birthdayDate.getTime())) {
                        const today = new Date();
                        let age = today.getFullYear() - birthdayDate.getFullYear();
                        const monthDiff = today.getMonth() - birthdayDate.getMonth();
                        if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birthdayDate.getDate())) {
                            age--;
                        }
                        $('#age').val(age);
                        console.log('[BookAppointment] Calculated age from birthday:', age);
                    }
                }

                // Additional validation for relationship field when booking for someone else
                if ($('#bookingForOther').is(':checked') && !$('#relationship').val()) {
                    $('#relationship').addClass('is-invalid');
                    isValid = false;
                    console.warn('[BookAppointment] Invalid field: relationship');
                }
                
                // Additional validation for patient details when booking for someone else
                if ($('#bookingForOther').is(':checked')) {
                    if (!$('#firstName').val() || $('#firstName').val().trim() === '') {
                        $('#firstName').addClass('is-invalid');
                        isValid = false;
                        console.warn('[BookAppointment] Invalid field: firstName when booking for other');
                    }
                    if (!$('#lastName').val() || $('#lastName').val().trim() === '') {
                        $('#lastName').addClass('is-invalid');
                        isValid = false;
                        console.warn('[BookAppointment] Invalid field: lastName when booking for other');
                    }
                    if (!$('#birthday').val() || $('#birthday').val().trim() === '') {
                        $('#birthday').addClass('is-invalid');
                        isValid = false;
                        console.warn('[BookAppointment] Invalid field: birthday when booking for other');
                    }
                    if (!$('#phoneNumber').val() || $('#phoneNumber').val().trim() === '') {
                        $('#phoneNumber').addClass('is-invalid');
                        isValid = false;
                        console.warn('[BookAppointment] Invalid field: phoneNumber when booking for other');
                    }
                    if (!$('#gender').val() || $('#gender').val().trim() === '') {
                        $('#gender').addClass('is-invalid');
                        isValid = false;
                        console.warn('[BookAppointment] Invalid field: gender when booking for other');
                    }
                }
                
                // Always validate gender field
                const gender = $('#gender').val();
                if (!gender || gender.trim() === '') {
                    $('#gender').addClass('is-invalid');
                    isValid = false;
                    console.warn('[BookAppointment] Invalid field: gender not selected');
                } else {
                    $('#gender').removeClass('is-invalid');
                    console.log('[BookAppointment] Valid field: gender =', gender);
                }
                
                // Always validate phone number regardless of booking for other
                const phoneNumber = $('#phoneNumber').val();
                const phonePattern = /^09[0-9]{9}$/;
                if (!phoneNumber || phoneNumber.trim() === '' || !phonePattern.test(phoneNumber)) {
                    $('#phoneNumber').addClass('is-invalid');
                    isValid = false;
                    console.warn('[BookAppointment] Invalid field: phoneNumber - invalid format:', phoneNumber);
                } else {
                    $('#phoneNumber').removeClass('is-invalid');
                    console.log('[BookAppointment] Valid field: phoneNumber =', phoneNumber);
                }

                // Profanity filter for reason for visit (basic EN/TL list)
                const reason = $('#reasonForConsultation').val() || '';
                const badWords = [
                    'fuck','shit','bitch','asshole','bastard','damn',
                    'puta','putang ina','pakyu','ulol','gago','tarantado','tangina'
                ];
                const containsBadWord = badWords.some(w => {
                    const escaped = w.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&');
                    const pattern = new RegExp(`(^|\\b)${escaped}(\\b|$)`, 'i');
                    return pattern.test(reason);
                });
                if (containsBadWord) {
                    $('#reasonForConsultation').addClass('is-invalid');
                    isValid = false;
                    // Re-enable button since validation failed
                    $button.prop('disabled', false);
                    Swal.fire({
                        title: 'Inappropriate Language',
                        text: 'Please remove inappropriate language from the Reason for Consultation.',
                        icon: 'warning',
                        confirmButtonText: 'OK',
                        confirmButtonColor: '#ffc107'
                    });
                } else {
                    $('#reasonForConsultation').removeClass('is-invalid');
                }
                
                // Always validate time slot - check both the select and ensure hidden field is synced
                const timeSlotSelect = $('#timeSlot');
                // Reuse timeSlot variable declared earlier in this function scope
                const currentTimeSlot = timeSlotSelect.val();
                const selectedOption = timeSlotSelect.find('option:selected');
                
                console.log('[BookAppointment] Time slot validation - Raw value:', currentTimeSlot, 'Option disabled:', selectedOption.prop('disabled'), 'Option text:', selectedOption.text());
                
                // Update hidden field before validation
                if (currentTimeSlot && currentTimeSlot.trim() !== '') {
                    $('#hiddenTimeSlot').val(currentTimeSlot);
                }
                
                // Validate time slot - must have a valid non-empty value that's not a placeholder
                const placeholderTexts = [
                    'Select date and consultation type first',
                    'No available time slots',
                    'Loading...',
                    'Error loading time slots',
                    'Select date and consultation type first',
                    ''
                ];
                
                const isPlaceholderText = !currentTimeSlot || 
                                         currentTimeSlot.trim() === '' || 
                                         placeholderTexts.includes(currentTimeSlot.trim()) ||
                                         selectedOption.prop('disabled') ||
                                         selectedOption.val() === '' ||
                                         selectedOption.val() === null;
                
                // Also check if it looks like a valid time format (supports both single time and time range)
                // Accepts formats: "8:00 AM" OR "8:00 AM - 8:06 AM"
                const looksLikeTime = currentTimeSlot && /^(\d{1,2}):(\d{2})\s*(AM|PM)(\s*-\s*(\d{1,2}):(\d{2})\s*(AM|PM))?$/i.test(currentTimeSlot.trim());
                
                const isValidTimeSlot = currentTimeSlot && 
                                       currentTimeSlot.trim() !== '' && 
                                       !isPlaceholderText &&
                                       looksLikeTime;
                
                if (!isValidTimeSlot) {
                    timeSlotSelect.addClass('is-invalid');
                    $('#timeSlotMessage').removeClass('text-muted').addClass('text-danger')
                        .html('<strong>Please select a time slot.</strong>');
                    isValid = false;
                    console.warn('[BookAppointment] Invalid field: timeSlot - not selected, value:', currentTimeSlot, 'disabled:', selectedOption.prop('disabled'), 'looksLikeTime:', looksLikeTime);
                } else {
                    timeSlotSelect.removeClass('is-invalid');
                    $('#timeSlotMessage').removeClass('text-danger').addClass('text-muted')
                        .text('Please select a time slot');
                    console.log('[BookAppointment] Valid field: timeSlot =', currentTimeSlot);
                }
                
                if (!isValid) {
                    console.error('[BookAppointment] Validation failed - cannot proceed to step 2');
                    
                    // Re-enable button since validation failed
                    $button.prop('disabled', false);
                    
                    // Collect invalid field names for better error message
                    const invalidFields = [];
                    $('#step1').find('.is-invalid').each(function() {
                        const label = $('label[for="' + $(this).attr('id') + '"]').text();
                        if (label) {
                            invalidFields.push(label.replace('*', '').trim());
                        } else {
                            invalidFields.push($(this).attr('name') || $(this).attr('id') || 'Unknown field');
                        }
                    });
                    
                    const errorMessage = invalidFields.length > 0
                        ? 'Please check the following fields:\n• ' + invalidFields.join('\n• ')
                        : 'Please fill in all required fields before proceeding.';
                    
                    Swal.fire({
                        title: 'Validation Error',
                        html: errorMessage.replace(/\n/g, '<br>'),
                        icon: 'warning',
                        confirmButtonText: 'OK',
                        confirmButtonColor: '#ff8c42',
                        customClass: {
                            popup: 'swal-wide'
                        }
                    });
                    
                    // Scroll to first invalid field
                    const firstInvalid = $('.is-invalid').first();
                    if (firstInvalid.length) {
                        $('html, body').animate({
                            scrollTop: firstInvalid.offset().top - 100
                        }, 500);
                        firstInvalid.focus();
                    }
                    
                    return false;
                }
                
                // Save form data to session storage for assessment forms to access
                try {
                    sessionStorage.setItem('appointmentFormData', JSON.stringify(formData));
                    console.log('[BookAppointment] Form data saved to session storage');
                } catch (error) {
                    console.error('[BookAppointment] Error saving form data:', error);
                }
                
                // Submit via AJAX to the new endpoint
                $.ajax({
                    url: '?handler=CreateAjax',
                    type: 'POST',
                    data: new FormData($('#appointmentForm')[0]),
                    processData: false,
                    contentType: false,
                    headers: {
                        "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        console.log('[BookAppointment] AJAX response:', response);
                        if (response.success) {
                            const appointmentId = response.appointmentId;
                            const age = response.age;
                            console.log('[BookAppointment] Appointment created with ID:', appointmentId);
                            
                            // Debug SweetAlert2 before using it
                            console.log('[BookAppointment] About to show SweetAlert2 success message');
                            console.log('[BookAppointment] Swal available:', typeof Swal !== 'undefined');
                            console.log('[BookAppointment] Swal.fire available:', typeof Swal?.fire === 'function');
                            
                            // Show success message using SweetAlert2 and redirect to appointments page
                            if (typeof Swal !== 'undefined' && typeof Swal.fire === 'function') {
                                console.log('[BookAppointment] Showing SweetAlert2 success message');
                                // Check consultation type to determine appropriate message
                                const consultationType = $('#consultationType').val();
                                const isGeneralConsult = consultationType === 'general consult';
                                
                                Swal.fire({
                                    title: 'Appointment Saved!',
                                    text: isGeneralConsult 
                                        ? 'Your appointment has been saved successfully! Redirecting to assessment form...'
                                        : 'Your appointment has been saved successfully!',
                                    icon: 'success',
                                    showConfirmButton: false,
                                    showCancelButton: false,
                                    timer: 5000,
                                    timerProgressBar: true,
                                    allowOutsideClick: false,
                                    allowEscapeKey: false
                                });
                                
                                // Auto-redirect after 5 seconds
                                setTimeout(() => {
                                    // Check consultation type first
                                    console.log('[BookAppointment] Auto-redirecting after 5 seconds');
                                    const consultationType = $('#consultationType').val();
                                    
                                    // Check for available forms for ALL consultation types
                                    console.log(`[BookAppointment] Checking for forms for: ${consultationType}, age: ${age}`);
                                    
                                    // Fetch available dynamic forms for this age and consultation type
                                    fetch(`/BookAppointment?handler=GetAvailableFormsForAge&age=${age}&consultationType=${encodeURIComponent(consultationType)}`)
                                        .then(response => response.json())
                                        .then(data => {
                                            console.log('[BookAppointment] Forms API response:', data);
                                            
                                            if (data.forms && data.forms.length > 0) {
                                                // Redirect to the first available dynamic form
                                                const firstForm = data.forms[0];
                                                console.log(`[BookAppointment] Redirecting to dynamic form: ${firstForm.formName}`);
                                                window.location.href = `/Forms/SubmitForm/${firstForm.formKey}?appointmentId=${appointmentId}`;
                                            } else {
                                                // No forms available, redirect to appointments
                                                console.log(`[BookAppointment] No forms required for ${consultationType}, redirecting to appointments`);
                                                window.location.href = '/User/Appointments';
                                            }
                                        })
                                        .catch(error => {
                                            console.error('[BookAppointment] Error fetching forms:', error);
                                            // Fallback: redirect to appointments
                                            window.location.href = '/User/Appointments';
                                        });
                                }, 5000);
                            } else {
                                console.error('[BookAppointment] SweetAlert2 not available, using fallback alert');
                                // Fallback to alert if SweetAlert2 is not available
                                alert('Your appointment has been saved successfully! You can complete the assessment form later from your Appointments page.');
                                sessionStorage.removeItem('appointmentFormData');
                                window.location.href = '/User/Appointments';
                            }
                        } else {
                            console.error('[BookAppointment] Appointment creation failed:', response.error);
                            
                            // Handle specific error types
                            if (response.errorType === 'TimeSlotConflict') {
                                // Re-enable button on time slot conflict
                                $button.prop('disabled', false);
                                // Time slot conflict - update the UI to show this
                                $('#timeSlot').addClass('is-invalid');
                                $('#timeSlotMessage')
                                    .addClass('text-danger')
                                    .text(response.error);
                                
                                // Refresh the time slots to get the latest availability
                                updateTimeSlots();
                                
                                // Show error alert
                                Swal.fire({
                                    title: 'Time Slot Conflict',
                                    text: 'Time slot conflict: ' + response.error,
                                    icon: 'error',
                                    confirmButtonText: 'OK',
                                    confirmButtonColor: '#dc3545'
                                });
                            } else {
                                // General error
                                Swal.fire({
                                    title: 'Error',
                                    text: 'Error saving appointment details: ' + (response.error || 'Unknown error'),
                                    icon: 'error',
                                    confirmButtonText: 'OK',
                                    confirmButtonColor: '#dc3545'
                                });
                            }
                            // Re-enable button on error
                            $button.prop('disabled', false);
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('[BookAppointment] AJAX error:', error);
                        // Re-enable button on AJAX error
                        $button.prop('disabled', false);
                        Swal.fire({
                            title: 'Error',
                            text: 'Error saving appointment details. Please try again.',
                            icon: 'error',
                            confirmButtonText: 'OK',
                            confirmButtonColor: '#dc3545'
                        });
                    }
                });
                } catch (error) {
                    console.error('[BookAppointment] Unexpected error in submit handler:', error);
                    // Re-enable button on unexpected error
                    $button.prop('disabled', false);
                    Swal.fire({
                        title: 'Unexpected Error',
                        text: 'An unexpected error occurred. Please try again.',
                        icon: 'error',
                        confirmButtonText: 'OK',
                        confirmButtonColor: '#dc3545'
                    });
                }
            });

            // Function to calculate birthday from age
            function calculateBirthdayFromAge(age) {
                // Allow age 0 for infants (months old), reject only negative ages or invalid values
                if (age === null || age === undefined || age < 0 || age > 120 || isNaN(age)) {
                    $('#birthday').val('');
                    return;
                }

                // Calculate birthday by subtracting age from current date
                const today = new Date();
                const currentYear = today.getFullYear();
                const birthYear = currentYear - age;
                
                // For age 0 (infants), use current year
                // Create birthday date (using January 1st as default day)
                const birthday = new Date(birthYear, 0, 1);
                
                // Format as YYYY-MM-DD for date input
                const formattedDate = birthday.getFullYear() + '-' + 
                    String(birthday.getMonth() + 1).padStart(2, '0') + '-' + 
                    String(birthday.getDate()).padStart(2, '0');
                
                $('#birthday').val(formattedDate);
            }

        });
    </script>
    
