            // Prevent clicks on labels of disabled radio buttons and checkboxes
            function preventDisabledInputClicks() {
                const form = document.getElementById('dynamicForm');
                if (!form) return;
                
                // Add click prevention for disabled radio/checkbox labels
                form.addEventListener('click', function(e) {
                    const target = e.target;
                    // If clicking on a label
                    if (target.tagName === 'LABEL') {
                        const input = target.querySelector('input[type="radio"], input[type="checkbox"]');
                        if (input && input.disabled) {
                            e.preventDefault();
                            e.stopPropagation();
                            return false;
                        }
                    }
                    // If clicking on a disabled input itself
                    if ((target.type === 'radio' || target.type === 'checkbox') && target.disabled) {
                        e.preventDefault();
                        e.stopPropagation();
                        return false;
                    }
                }, true); // Use capture phase to catch early
            }
            
            preventDisabledInputClicks();
            
