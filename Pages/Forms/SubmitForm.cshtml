        // ===== BMI CALCULATOR FUNCTION =====
        function initializeBMICalculator() {
            console.log('Initializing BMI Calculator...');
            
            const form = document.getElementById('dynamicForm');
            if (!form) {
                console.log('Form not found for BMI calculator');
                return;
            }
            
            // Find height, weight, and BMI fields by common keywords
            const heightField = findFieldByKeywords(form, ['height', 'taas', 'tangkad']);
            const weightField = findFieldByKeywords(form, ['weight', 'timbang', 'bigat']);
            const bmiField = findFieldByKeywords(form, ['bmi', 'body mass index']);
            const bmiStatusField = findFieldByKeywords(form, ['bmi status', 'bmi classification', 'weight status']);
            
            if (!heightField || !weightField || !bmiField) {
                console.log('BMI fields not found:', {
                    height: !!heightField,
                    weight: !!weightField,
                    bmi: !!bmiField
                });
                return;
            }
            
            console.log('BMI Calculator initialized:', {
                height: heightField.name,
                weight: weightField.name,
                bmi: bmiField.name,
                bmiStatus: bmiStatusField ? bmiStatusField.name : 'not found'
            });
            
            // Make BMI field readonly (it will be auto-calculated)
            bmiField.readOnly = true;
            bmiField.style.backgroundColor = '#e9ecef';
            bmiField.style.cursor = 'not-allowed';
            
            if (bmiStatusField) {
                if (bmiStatusField.tagName === 'INPUT' || bmiStatusField.tagName === 'TEXTAREA') {
                    bmiStatusField.readOnly = true;
                    bmiStatusField.style.backgroundColor = '#e9ecef';
                    bmiStatusField.style.cursor = 'not-allowed';
                } else if (bmiStatusField.tagName === 'SELECT') {
                    bmiStatusField.disabled = true;
                    bmiStatusField.style.cursor = 'not-allowed';
                }
            }
            
            // Function to calculate BMI
            function calculateBMI() {
                const height = parseFloat(heightField.value);
                const weight = parseFloat(weightField.value);
                
                if (height > 0 && weight > 0) {
                    // Convert height from cm to meters
                    const heightInMeters = height / 100;
                    
                    // Calculate BMI: weight (kg) / (height (m))^2
                    const bmi = weight / (heightInMeters * heightInMeters);
                    
                    // Round to 2 decimal places
                    const bmiRounded = Math.round(bmi * 100) / 100;
                    
                    // Set BMI value
                    bmiField.value = bmiRounded;
                    
                    // Determine BMI status
                    let status = '';
                    let statusColor = '';
                    
                    if (bmi < 18.5) {
                        status = 'Underweight';
                        statusColor = '#ffc107'; // Warning yellow
                    } else if (bmi >= 18.5 && bmi < 25) {
                        status = 'Normal';
                        statusColor = '#10b981'; // Success green
                    } else if (bmi >= 25 && bmi < 30) {
                        status = 'Overweight';
                        statusColor = '#ff8c42'; // Orange
                    } else {
                        status = 'Obese';
                        statusColor = '#dc3545'; // Danger red
                    }
                    
                    // Set BMI status
                    if (bmiStatusField) {
                        if (bmiStatusField.tagName === 'SELECT') {
                            // Try to find matching option
                            const options = Array.from(bmiStatusField.options);
                            const matchingOption = options.find(opt => 
                                opt.value.toLowerCase().includes(status.toLowerCase()) ||
                                opt.text.toLowerCase().includes(status.toLowerCase())
                            );
                            if (matchingOption) {
                                bmiStatusField.value = matchingOption.value;
                            }
                        } else {
                            bmiStatusField.value = status;
                            bmiStatusField.style.color = statusColor;
                            bmiStatusField.style.fontWeight = 'bold';
                        }
                    }
                    
                    console.log(`BMI Calculated: Height=${height}cm, Weight=${weight}kg, BMI=${bmiRounded}, Status=${status}`);
                } else {
                    // Clear BMI if inputs are invalid
                    bmiField.value = '';
                    if (bmiStatusField) {
                        if (bmiStatusField.tagName === 'SELECT') {
                            bmiStatusField.selectedIndex = 0;
                        } else {
                            bmiStatusField.value = '';
                            bmiStatusField.style.color = '';
                            bmiStatusField.style.fontWeight = '';
                        }
                    }
                }
            }
            
            // Add event listeners for real-time calculation
            heightField.addEventListener('input', calculateBMI);
            weightField.addEventListener('input', calculateBMI);
            heightField.addEventListener('change', calculateBMI);
            weightField.addEventListener('change', calculateBMI);
            
            // Calculate on page load if values exist
            calculateBMI();
        }
        
        // ===== HELPER FUNCTION: FIND FIELD BY KEYWORDS =====
        function findFieldByKeywords(form, keywords) {
            const inputs = form.querySelectorAll('input[type="text"], input[type="number"], textarea, select');
            
            for (let input of inputs) {
                const name = (input.name || '').toLowerCase();
                const placeholder = (input.placeholder || '').toLowerCase();
                const label = input.closest('.mb-4')?.querySelector('label')?.textContent?.toLowerCase() || '';
                
                for (let keyword of keywords) {
                    const lowerKeyword = keyword.toLowerCase();
                    if (name.includes(lowerKeyword) || placeholder.includes(lowerKeyword) || label.includes(lowerKeyword)) {
                        return input;
                    }
                }
            }
            
            return null;
        }
        
