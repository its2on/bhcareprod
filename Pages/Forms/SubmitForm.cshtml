        // ===== HELPER FUNCTION: FIND CHECKBOX GROUP BY KEYWORDS =====
        function findCheckboxGroupByKeywords(form, keywords) {
            const allCheckboxes = form.querySelectorAll('input[type="checkbox"]');
            const checkboxGroups = new Map();
            
            // Group checkboxes by base name (remove [])
            allCheckboxes.forEach(checkbox => {
                const baseName = checkbox.name.replace('[]', '');
                if (!checkboxGroups.has(baseName)) {
                    checkboxGroups.set(baseName, []);
                }
                checkboxGroups.get(baseName).push(checkbox);
            });
            
            // Find matching group
            for (let [groupName, checkboxes] of checkboxGroups) {
                const firstCheckbox = checkboxes[0];
                const label = firstCheckbox.closest('.mb-4')?.querySelector('label')?.textContent?.toLowerCase() || '';
                
                for (let keyword of keywords) {
                    const lowerKeyword = keyword.toLowerCase();
                    if (label.includes(lowerKeyword)) {
                        return checkboxes;
                    }
                }
            }
            
            return null;
        }
        
