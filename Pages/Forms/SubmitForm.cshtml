        // ===== BLOOD PRESSURE STATUS AUTO-SELECTION =====
        function initializeBPStatus() {
            console.log('Initializing BP Status...');
            
            const form = document.getElementById('dynamicForm');
            if (!form) return;
            
            const baselineBPField = findFieldByKeywords(form, ['baseline bp', 'baseline blood pressure']);
            const bpStatusRadios = findRadioGroupByKeywords(form, ['bp status', 'blood pressure status']);
            
            if (!baselineBPField) {
                console.log('Baseline BP field not found');
                return;
            }
            
            console.log('BP Status initialized');
            
            function updateBPStatus() {
                if (!bpStatusRadios) return;
                
                const bpInput = baselineBPField.value || '';
                // Parse BP format: "120/80" or "120 80" or "12080"
                const bpMatch = bpInput.match(/(\d+)[/\s]*(\d+)/);
                
                if (bpMatch) {
                    const systolic = parseInt(bpMatch[1]);
                    const diastolic = parseInt(bpMatch[2]);
                    
                    let statusValue = '';
                    
                    if (systolic < 120 && diastolic < 80) {
                        statusValue = 'Normal';
                    } else if ((systolic >= 120 && systolic <= 129) && diastolic < 80) {
                        statusValue = 'Elevated';
                    } else if ((systolic >= 130 && systolic <= 139) || (diastolic >= 80 && diastolic <= 89)) {
                        statusValue = 'Pre-HPN';
                    } else if ((systolic >= 140 && systolic <= 159) || (diastolic >= 90 && diastolic <= 99)) {
                        statusValue = 'Stage 1';
                    } else if (systolic >= 160 || diastolic >= 100) {
                        statusValue = 'Stage 2';
                    }
                    
                    if (statusValue) {
                        // Find and select matching radio
                        let found = false;
                        bpStatusRadios.forEach(radio => {
                            const radioValue = radio.value.toLowerCase();
                            const radioLabel = radio.nextElementSibling?.textContent?.toLowerCase() || '';
                            // Check both value and label text
                            if (radioValue.includes(statusValue.toLowerCase()) || 
                                radioLabel.includes(statusValue.toLowerCase()) ||
                                (statusValue === 'Pre-HPN' && (radioValue.includes('pre-hpn') || radioLabel.includes('pre-hpn')))) {
                                radio.checked = true;
                                found = true;
                                console.log(`BP Status selected: ${radio.value} (${radioLabel})`);
                            }
                        });
                        // Disable all BP Status radio buttons after auto-selection
                        if (found) {
                            bpStatusRadios.forEach(radio => {
                                radio.disabled = true;
                            });
                            console.log('BP Status radio buttons disabled (auto-calculated)');
                        }
                        if (!found) {
                            console.warn(`Could not find matching BP Status radio for: ${statusValue}`);
                        } else {
                            console.log(`BP Status auto-selected: ${statusValue} (${systolic}/${diastolic})`);
                        }
                    }
                } else {
                    // Clear selection if BP format is invalid
                    bpStatusRadios.forEach(r => r.checked = false);
                }
            }
            
            baselineBPField.addEventListener('input', function() {
                // Auto-format as user types: "120/80"
                let value = this.value.replace(/\D/g, '');
                if (value.length > 3) {
                    value = value.substring(0, 3) + '/' + value.substring(3, 5);
                }
                this.value = value;
                updateBPStatus();
            });
            
            // Update on page load if value exists
            updateBPStatus();
        }
        
