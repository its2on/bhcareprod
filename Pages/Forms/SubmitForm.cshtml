                const ketonesValue = (urineKetonesField?.value || '').trim().toLowerCase();
                
                // Determine if positive or negative
                const hasProtein = proteinValue !== '' && proteinValue !== '0' && !proteinValue.includes('neg') && !proteinValue.includes('-');
                const hasKetones = ketonesValue !== '' && ketonesValue !== '0' && !ketonesValue.includes('neg') && !ketonesValue.includes('-');
                
                // Find and check/uncheck checkboxes
                let anyUpdated = false;
                urineTestCheckboxes.forEach(checkbox => {
                    const checkboxLabel = checkbox.nextElementSibling?.textContent?.toLowerCase() || '';
                    const checkboxValue = checkbox.value?.toLowerCase() || '';
                    
                    // Check for (+) urine protein
                    if ((checkboxLabel.includes('(+) urine protein') || checkboxValue.includes('+') && checkboxLabel.includes('protein'))) {
                        checkbox.checked = hasProtein;
                        anyUpdated = true;
                    }
                    // Check for (-) urine protein
                    else if ((checkboxLabel.includes('(-) urine protein') || checkboxLabel.includes('(–) urine protein') || 
                             (checkboxValue.includes('-') && checkboxLabel.includes('protein')))) {
                        checkbox.checked = !hasProtein && proteinValue !== '';
                        anyUpdated = true;
                    }
                    // Check for (+) urine ketones
                    else if ((checkboxLabel.includes('(+) urine ketones') || checkboxValue.includes('+') && checkboxLabel.includes('ketones'))) {
                        checkbox.checked = hasKetones;
                        anyUpdated = true;
                    }
                    // Check for (-) urine ketones
                    else if ((checkboxLabel.includes('(-) urine ketones') || checkboxLabel.includes('(–) urine ketones') || 
                             (checkboxValue.includes('-') && checkboxLabel.includes('ketones')))) {
                        checkbox.checked = !hasKetones && ketonesValue !== '';
                        anyUpdated = true;
                    }
                });
                
                // Disable all Urine Test Results checkboxes after auto-selection
                if (anyUpdated && (proteinValue !== '' || ketonesValue !== '')) {
                    urineTestCheckboxes.forEach(checkbox => {
                        checkbox.disabled = true;
                    });
                    console.log('Urine Test Results checkboxes disabled (auto-calculated)');
                }
                
                console.log(`Urine Test Results updated: Protein=${hasProtein ? 'Positive' : 'Negative'}, Ketones=${hasKetones ? 'Positive' : 'Negative'}`);
            }
            
            if (urineProteinField) {
                urineProteinField.addEventListener('input', updateUrineTestResults);
            }
            
            if (urineKetonesField) {
                urineKetonesField.addEventListener('input', updateUrineTestResults);
            }
            
            // Update on page load if values exist
            updateUrineTestResults();
        }
        
        // ===== SUCCESS MODAL WITH COUNTDOWN =====
        @if (Model.IsSubmitted || TempData["FormSubmitted"] != null)
        {
