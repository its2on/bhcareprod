            @:            
            @:            if (countdown <= 0) {
            @:                clearInterval(countdownInterval);
            @:                console.log('Redirecting to dashboard...');
            @:                window.location.href = dashboardUrl;
            @:            }
            @:        }, 1000);
            @:    } else {
            @:        console.error('Success modal element not found!');
            @:    }
            @:});
        }
    </script>
