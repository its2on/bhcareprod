            @:    console.log('ReturnUrl is empty:', !returnUrl || returnUrl === '');
            @:    
            @:    // If returnUrl exists, skip modal and redirect immediately (Nurse/Doctor edits)
            @:    if (returnUrl && returnUrl !== '') {
            @:        console.log('=== DIRECT REDIRECT (Nurse/Doctor Edit) ===');
            @:        console.log('Redirecting immediately to:', dashboardUrl);
