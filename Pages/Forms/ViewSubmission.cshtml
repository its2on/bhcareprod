@page
@model Barangay.Pages.Forms.ViewSubmissionModel
@{
    ViewData["Title"] = "View Form Submission";
    
    // Dynamic layout selection based on user role (same as SubmitForm)
    // Nurse and Head Nurse use NurseLayout
    // Doctor, Head Doctor, and Admin use DoctorLayout
    // Regular users/patients use UserLayout
    var isNurse = User.IsInRole("Nurse") || User.IsInRole("Head Nurse");
    var isDoctor = User.IsInRole("Doctor") || User.IsInRole("Head Doctor") || User.IsInRole("Admin");
    
    if (isNurse)
    {
        Layout = "~/Pages/Shared/_NurseLayout.cshtml";
    }
    else if (isDoctor)
    {
        Layout = "~/Pages/Doctor/_DoctorLayout.cshtml";
    }
    else
    {
        Layout = "~/Pages/Shared/_UserLayout.cshtml";
    }
}

<style>
    body {
        background: #f8f9fa;
    }
    
    .submission-container {
        max-width: 900px;
        margin: 30px auto 40px;
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        overflow: hidden;
    }
    
    .submission-header {
        background: #ff8c42;
        color: white;
        padding: 30px;
        border-bottom: 3px solid #e67e22;
    }
    
    .submission-header h1 {
        font-size: 2rem;
        font-weight: 600;
        margin-bottom: 8px;
    }
    
    .submission-meta {
        background: rgba(255,255,255,0.1);
        padding: 15px;
        border-radius: 8px;
        margin-top: 15px;
    }
    
    .submission-body {
        padding: 40px;
    }
    
    /* Section Pages - Hidden by default */
    .section-page {
        display: none;
        animation: fadeIn 0.3s ease-in-out;
    }
    
    .section-page.active {
        display: block;
    }
    
    /* Section Header */
    .section-header {
        margin: 0 0 30px;
        padding: 25px 30px;
        background: linear-gradient(135deg, #ff8c42 0%, #ff6b1a 100%);
        border-radius: 12px;
        box-shadow: 0 4px 12px rgba(255, 140, 66, 0.3);
    }
    
    .section-header h3 {
        color: white;
        margin: 0 0 5px 0;
        font-size: 1.8rem;
        font-weight: 700;
    }
    
    .section-header p {
        margin: 0;
        color: rgba(255, 255, 255, 0.95);
        font-size: 1rem;
        font-weight: 500;
    }
    
    /* Navigation Buttons */
    .section-navigation {
        display: flex;
        justify-content: space-between;
        margin-top: 40px;
        padding-top: 30px;
        border-top: 2px solid #e9ecef;
    }
    
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateX(20px); }
        to { opacity: 1; transform: translateX(0); }
    }
    
    /* Wizard Steps */
    .wizard-steps {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        padding: 20px;
        background: #f8f9fa;
        border-radius: 8px;
        flex-wrap: wrap;
    }
    
    .wizard-step {
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        flex: 1;
        min-width: 100px;
    }
    
    .wizard-step-number {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #e9ecef;
        color: #6c757d;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 1.1rem;
        margin-bottom: 8px;
    }
    
    .wizard-step.completed .wizard-step-number {
        background: #ff8c42;
        color: white;
    }
    
    .wizard-step-label {
        font-size: 0.85rem;
        color: #6c757d;
        text-align: center;
    }
    
    .wizard-step.completed .wizard-step-label {
        color: #ff8c42;
        font-weight: 600;
    }
    
    .wizard-step-line {
        height: 2px;
        background: #e9ecef;
        flex: 1;
        margin: 0 10px;
        position: relative;
        top: -25px;
    }
    
    .form-field {
        margin-bottom: 30px;
        padding-bottom: 20px;
        border-bottom: 1px solid #e9ecef;
    }
    
    .form-field:last-child {
        border-bottom: none;
    }
    
    .field-label {
        font-weight: 600;
        color: #495057;
        margin-bottom: 8px;
        display: block;
    }
    
    .field-value {
        font-size: 1.05rem;
        color: #212529;
        padding: 12px;
        background: #f8f9fa;
        border-radius: 6px;
        border-left: 4px solid #ff8c42;
    }
    
    .empty-value {
        color: #6c757d;
        font-style: italic;
    }
    
    .action-buttons {
        padding: 20px 40px;
        background: #f8f9fa;
        border-top: 1px solid #dee2e6;
    }
    
    .appointment-info {
        background: #e7f3ff;
        border-left: 4px solid #0d6efd;
        padding: 15px;
        margin-bottom: 30px;
        border-radius: 6px;
    }
</style>

<div class="submission-container">
    <div class="submission-header">
        <h1>
            <i class="@(Model.FormTemplate.IconClass ?? "fa-solid fa-file-alt") me-2"></i>
            @Model.FormTemplate.FormName
        </h1>
        
        @if (!string.IsNullOrEmpty(Model.FormTemplate.Description))
        {
            <p class="mb-0 opacity-75">@Model.FormTemplate.Description</p>
        }
        
        <div class="submission-meta">
            <div class="row">
                <div class="col-md-6">
                    <small><strong>Submitted:</strong> @Model.Submission.SubmittedAt.ToString("MMM dd, yyyy hh:mm tt")</small>
                </div>
                <div class="col-md-6 text-end">
                    <small><strong>Status:</strong> @Model.Submission.Status</small>
                </div>
            </div>
        </div>
    </div>

    <div class="submission-body">
        @if (Model.Appointment != null)
        {
            <div class="appointment-info">
                <h6 class="mb-2"><i class="fa-solid fa-calendar-check me-2"></i>Appointment Context</h6>
                <p class="mb-1"><strong>Patient:</strong> @Model.Appointment.PatientName</p>
                <p class="mb-1"><strong>Appointment Date:</strong> @Model.Appointment.AppointmentDate.ToString("MMM dd, yyyy")</p>
                <p class="mb-0"><strong>Status:</strong> <span class="badge bg-@(Model.Appointment.Status == Barangay.Models.AppointmentStatus.Completed ? "success" : "info")">@Model.Appointment.Status</span></p>
            </div>
        }

        @if (Model.SubmissionData != null && Model.SubmissionData.Any())
        {
            // Parse form fields to identify sections
            var allFields = Model.FormTemplate.FormFields?.OrderBy(f => f.DisplayOrder).ToList() ?? new List<Barangay.Models.FormField>();
            
            @* Debug info *@
            @if (!allFields.Any())
            {
                <div class="alert alert-danger">
                    <i class="fa-solid fa-exclamation-circle me-2"></i>
                    <strong>Error:</strong> No form fields found in template. The form structure may not be loaded properly.
                    <div class="mt-2 small">
                        <strong>Submission Data Keys:</strong> @string.Join(", ", Model.SubmissionData.Keys)
                    </div>
                </div>
            }
            var formSections = new List<(string Title, string Description, List<Barangay.Models.FormField> Fields)>();
            var currentSectionFields = new List<Barangay.Models.FormField>();
            string currentSectionTitle = "";
            string currentSectionDescription = "";
            
            foreach (var field in allFields)
            {
                if (field.FieldType == "section" || field.FieldType == "divider" || field.FieldType == "heading")
                {
                    if (currentSectionFields.Count > 0)
                    {
                        formSections.Add((currentSectionTitle, currentSectionDescription, new List<Barangay.Models.FormField>(currentSectionFields)));
                    }
                    currentSectionTitle = field.Title ?? field.FieldLabel ?? "";
                    currentSectionDescription = field.FieldLabel ?? "";
                    currentSectionFields = new List<Barangay.Models.FormField>();
                }
                else
                {
                    currentSectionFields.Add(field);
                }
            }
            if (currentSectionFields.Count > 0)
            {
                formSections.Add((currentSectionTitle, currentSectionDescription, currentSectionFields));
            }
            
            var isMultiStep = formSections.Count > 1;
            
            @* Debug: Show if no sections found *@
            if (formSections.Count == 0 && allFields.Any())
            {
                <div class="alert alert-warning">
                    <i class="fa-solid fa-exclamation-triangle me-2"></i>
                    <strong>Note:</strong> Form has @allFields.Count field(s) but no sections defined. Displaying all fields in a single section.
                </div>
                formSections.Add(("Form Data", "", allFields));
            }
            
            @* Show wizard steps *@
            if (formSections.Count > 0)
            {
                <div class="wizard-steps">
                    @for (int i = 0; i < formSections.Count; i++)
                    {
                        var formSection = formSections[i];
                        var stepTitle = !string.IsNullOrEmpty(formSection.Title) ? formSection.Title : $"Step {i + 1}";
                        
                        <div class="wizard-step @(i == 0 ? "active" : "")" data-step="@i">
                            <div class="wizard-step-number">@(i + 1)</div>
                            <span class="wizard-step-label">@stepTitle</span>
                        </div>
                        
                        @if (i < formSections.Count - 1)
                        {
                            <div class="wizard-step-line"></div>
                        }
                    }
                </div>
            }
            
            @* Render each section as a separate page *@
            @for (int sectionIndex = 0; sectionIndex < formSections.Count; sectionIndex++)
            {
                var formSection = formSections[sectionIndex];
                var displayTitle = !string.IsNullOrEmpty(formSection.Title) 
                    ? formSection.Title 
                    : $"Step {sectionIndex + 1}";
                
                <div class="section-page @(sectionIndex == 0 ? "active" : "")" data-section="@sectionIndex">
                    @* Section Header *@
                    <div class="section-header">
                        <h3>
                            <i class="fa-solid fa-clipboard-list me-2"></i>@displayTitle
                        </h3>
                        @if (!string.IsNullOrEmpty(formSection.Description) && formSection.Description != formSection.Title)
                        {
                            <p>@formSection.Description</p>
                        }
                    </div>
                    
                    @* Render fields in this section *@
                    @foreach (var field in formSection.Fields)
                    {
                        // Try to find the value for this field
                        var fieldValue = Model.SubmissionData.FirstOrDefault(kvp => 
                            kvp.Key.Equals(field.FieldName, StringComparison.OrdinalIgnoreCase));
                        
                        // Skip if no value found
                        if (fieldValue.Key == null)
                        {
                            continue;
                        }
                        
                        <div class="form-field">
                            <span class="field-label">@field.FieldLabel</span>
                            <div class="field-value">
                                @if (string.IsNullOrWhiteSpace(fieldValue.Value))
                                {
                                    <span class="empty-value">(No response)</span>
                                }
                                else
                                {
                                    @Html.Raw(fieldValue.Value.Replace("\n", "<br>"))
                                }
                            </div>
                        </div>
                    }
                    
                    @* Navigation buttons *@
                    <div class="section-navigation">
                        @if (sectionIndex > 0)
                        {
                            <button type="button" class="btn btn-outline-secondary" onclick="navigateSection(@(sectionIndex - 1))">
                                <i class="fa-solid fa-arrow-left me-2"></i>Previous
                            </button>
                        }
                        else
                        {
                            <div></div>
                        }
                        
                        @if (sectionIndex < formSections.Count - 1)
                        {
                            <button type="button" class="btn btn-primary" onclick="navigateSection(@(sectionIndex + 1))">
                                Next<i class="fa-solid fa-arrow-right ms-2"></i>
                            </button>
                        }
                        else
                        {
                            <div></div>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center text-muted py-5">
                <i class="fa-solid fa-inbox fa-3x mb-3"></i>
                <p>No data available for this submission.</p>
            </div>
        }
    </div>

    <div class="action-buttons d-flex justify-content-between">
        @{
            // Determine back button URL based on user role and appointment context
            string backUrl = "javascript:history.back()";
            if (Model.Appointment != null)
            {
                // Check role directly (isDoctor variable is in different scope)
                bool userIsDoctor = User.IsInRole("Doctor") || User.IsInRole("Head Doctor") || User.IsInRole("Admin");
                if (userIsDoctor)
                {
                    backUrl = $"/Doctor/Consultation?id={Model.Appointment.Id}";
                }
                else
                {
                    backUrl = $"/Nurse/AppointmentDetails?id={Model.Appointment.Id}";
                }
            }
        }
        <a href="@backUrl" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-2"></i>Back
        </a>
        <div>
            <button onclick="window.print()" class="btn btn-outline-primary">
                <i class="fa-solid fa-print me-2"></i>Print
            </button>
            @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
            {
                <a href="/Admin/FormResponses?id=@Model.FormTemplate.FormTemplateId" class="btn btn-outline-info">
                    <i class="fa-solid fa-chart-bar me-2"></i>View All Responses
                </a>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentSection = 0;
        
        function navigateSection(sectionIndex) {
            // Hide current section
            const currentPage = document.querySelector('.section-page.active');
            if (currentPage) {
                currentPage.classList.remove('active');
            }
            
            // Show target section
            const targetPage = document.querySelector(`.section-page[data-section="${sectionIndex}"]`);
            if (targetPage) {
                targetPage.classList.add('active');
            }
            
            // Update wizard steps
            document.querySelectorAll('.wizard-step').forEach((step, index) => {
                step.classList.remove('active', 'completed');
                if (index < sectionIndex) {
                    step.classList.add('completed');
                } else if (index === sectionIndex) {
                    step.classList.add('active');
                }
            });
            
            currentSection = sectionIndex;
            
            // Scroll to top
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
        
        // Keyboard navigation
        document.addEventListener('keydown', function(e) {
            const totalSections = document.querySelectorAll('.section-page').length;
            
            if (e.key === 'ArrowRight' && currentSection < totalSections - 1) {
                navigateSection(currentSection + 1);
            } else if (e.key === 'ArrowLeft' && currentSection > 0) {
                navigateSection(currentSection - 1);
            }
        });
        
        // Print styles
        window.addEventListener('beforeprint', function() {
            // Show all sections for printing
            document.querySelectorAll('.section-page').forEach(page => {
                page.style.display = 'block';
            });
            document.querySelectorAll('.section-navigation').forEach(nav => {
                nav.style.display = 'none';
            });
            document.querySelector('.action-buttons').style.display = 'none';
        });
        
        window.addEventListener('afterprint', function() {
            // Restore section visibility
            document.querySelectorAll('.section-page').forEach((page, index) => {
                page.style.display = index === currentSection ? 'block' : 'none';
            });
            document.querySelectorAll('.section-navigation').forEach(nav => {
                nav.style.display = 'flex';
            });
            document.querySelector('.action-buttons').style.display = 'flex';
        });
    </script>
}

